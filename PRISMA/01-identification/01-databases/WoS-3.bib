@article{ WOS:000632160800001,
Author = {Bai, ChenXing and Yu, BaoQin},
Title = {RETRACTED: Research on the value co-creation of the crowdsourcing
   services under the sharing economy (Retracted Article)},
Journal = {INTERNATIONAL JOURNAL OF ELECTRICAL ENGINEERING EDUCATION},
Year = {2021},
Month = {2021 JAN 18},
Abstract = {With the great success of crowdsourcing business models in the context
   of the sharing economy, how crowdsourcing services work has gained wide
   attention. Based on the value co-creation theory, taking ZBJ website of
   Chinese crowdsourcing service platform ranking first on the Alexa
   platform as an example, the paper constructs the value co-creation
   process model of crowdsourcing services under the sharing economy from a
   dynamic perspective through qualitative analysis of the cases of
   employers and service providers and interview data. It opens the black
   box of the value co-creation process. Its contribution is that it
   proposes the dynamic changing rule of three-dimensional interaction,
   integration and authorization of crowdsourcing service value
   co-creation, the change of the role of crowdsourcing main body, and the
   function mechanism of crowdsourcing service value co-creation on
   crowdsourcing performance. And the value co-creation mode of different
   stages is determined. The value co-creation mode is the dominant logic
   of ``service + product{''} In the release task phase. The value
   co-creation mode is the value creation of user-led logic originally in
   the stage of contract submission. The value co-creation mode is the
   dominant logic of ``product + service{''} in the evaluation and reward
   stage.},
