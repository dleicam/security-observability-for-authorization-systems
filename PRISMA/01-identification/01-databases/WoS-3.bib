@inproceedings{ WOS:000473542200012,
Author = {Tange, Koen and De Donno, Michele and Fafoutis, Xenofon and Dragoni,
   Nicola},
Editor = {Ramachandran, GS and Ortiz, J},
Title = {Towards a Systematic Survey of Industrial IoT Security Requirements:
   Research Method and Quantitative Analysis},
Booktitle = {PROCEEDINGS OF THE 2019 WORKSHOP ON FOG COMPUTING AND THE IOT (IOT-FOG
   `19)},
Year = {2019},
Pages = {56-63},
Note = {Workshop on Fog Computing and the IoT (IoT-Fog), Montreal, CANADA, APR
   15, 2019},
Abstract = {Industry 4.0 and, in particular, Industrial Internet of Things (IIoT)
   represent two of the major automation and data exchange trends of the
   21st century, driving a steady increase in the number of smart embedded
   devices used by industrial applications. However, IoT devices suffer
   from numerous security flaws, resulting in a number of large scale
   cyber-attacks. In this light, Fog computing, a relatively new paradigm
   born from the necessity of bridging the gap between Cloud computing and
   IoT, can be used as a security solution for the IIoT. To achieve this,
   the first step is to clearly identify the security requirements of the
   IIoT that can be subsequently used to design security solutions based on
   Fog computing. With this in mind, our paper represents a preliminary
   work towards a systematic literature review of IIoT security
   requirements. We focus on two key steps of the review: (1) the research
   method that will be used in the systematic work and (2) a quantitative
   analysis of the results produced by the study selection process. This
   lays the necessary foundations to enable the use of Fog computing as a
   security solution for the IIoT.},
Type = {Proceedings Paper},
Affiliation = {Tange, K (Corresponding Author), Tech Univ Denmark, Lyngby, Denmark.
   Tange, Koen; De Donno, Michele; Fafoutis, Xenofon; Dragoni, Nicola, Tech Univ Denmark, Lyngby, Denmark.
