@article{ WOS:001530159000001,
Author = {Swathi, Gundala and Reddy, A. Jayaram},
Title = {Enhanced authentication framework for data owner and data sharing in a
   cloud storage environment},
Journal = {INTERNATIONAL JOURNAL OF SYSTEM ASSURANCE ENGINEERING AND MANAGEMENT},
Year = {2025},
Month = {2025 JUL 16},
Abstract = {In the context of storage in a cloud computing environment, there is a
   dire need for evolving a reliable and adequate framework to enable users
   safely communicate with the cloud. Public cloud service providers adhere
   to strict security considerations safeguarding the privacy and security
   of the users and their stored data. Private cloud storage providers have
   developed a more robust, self-managed and regulated data security model
   for the users, to effectively manage private data accession and sharing.
   This paper proposes a more secure, efficient, convenient, and advanced
   protocol for data accession. It provides the approach of proxy
   re-encryption and its key for the cloud server with enhanced security. A
   comparative performance evaluation establishes the superiority of our
   proposed protocol against many related approaches, in terms of
   addressing several security concerns, ease in communication and
   computation, and cost efficiency in cloud storage.},
