@article{ WOS:001502526500002,
Author = {Sreelakshmi, Madaka and Naseera, Shaik},
Title = {A hybrid optimization-based key generation for secure AAC in
   cloud-enabled big data environment},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2025},
Volume = {289},
Month = {SEP 15},
Abstract = {Currently, big data analysis has emerged as a significant research area.
   Big data security protects Cloud applications and monitors very
   sensitive data for assisting Cloud platforms. However, ensuring the
   security of big data remains a challenge, limiting organizations'
   adoption of cloud services. In this article, a new model namely Adam
   One-to-One Based Optimizer for key generation (AOOBO\_Keygen) is
   presented for secure Authentication and Access Control (AAC) in a
   cloud-enabled Big Data Environment. Firstly, the initialization of
   public key and security parameters are done. Next, the registration with
   trusted authority by the data user, data owner, and cloud server are
   done. Later, the data preservation is done using several operators and
   keys. After that, a novel optimization algorithm such as AOOBO\_Keygen
   is utilized to generate the key, which is devised by combining the Adam
   optimizer and One-to-One Based Optimizer (OOBO). Then, the user is
   requested to log in. Further, the user's authenticity is validated with
   the key. Finally, the user sends a request to the trusted authority to
   access the data. Moreover, the AOOBO\_Keygen is assessed for its
   effectiveness, and the least memory usage, computational cost,
   conditional privacy, and latency of 38.400 MB, 47.340, 92.842, and 3.178
   s. are attained.},
