@article{ WOS:000832952100001,
Author = {Sattari, Fraidoon and Farooqi, Ashfaq Hussain and Qadir, Zakria and
   Raza, Basit and Nazari, Hadi and Almutiry, Muhannad},
Title = {A Hybrid Deep Learning Approach for Bottleneck Detection in IoT},
