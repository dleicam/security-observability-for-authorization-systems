@article{ WOS:001206300600001,
Author = {Abouelkheir, Eman and El-sherbiny, Shamia},
Title = {Provable Lightweight Hybrid Proxy Re-encryption Scheme without Pairings
   for Internet of Things},
Journal = {HUMAN-CENTRIC COMPUTING AND INFORMATION SCIENCES},
Year = {2024},
Volume = {14},
Month = {JUN 15},
Abstract = {Internet of Things (IoT) technology is considered as one of the most
   important topics. Data sharing and processing in many IoT applications
   is carried out in cloud environment. Fog computing is used in other IoT
   applications where cloud computing is not viable. Using fog computing in
   IoT provides some advantages including bandwidth conservation, network
   -agnostic and improved time response. Fog computing suffer from some
   security and privacy issues. Security problems can be solved by proxy re
   -encryption schemes, but these schemes suffer from heavy computational
   operations because of using so many paring operations in delegating and
   delegated sides. This work introduces a new scheme to mitigate the
   security issues and reduce the computational cost. The proposed scheme
   is a hybrid proxy re -encryption scheme without parings based on
   elliptic curve cryptography; the proposed scheme uses both the symmetric
   and asymmetric cryptography. The symmetric one is novel -T symmetric
   algorithm (NTSA) and the asymmetric is ElGamal public key encryption.
   The security proof of the proposed scheme has been done under
   indistinguishability -chosen plaintext attack. The proposed scheme
   enhances the security in addition to decreasing the processing time; it
   is highly computationally efficient when compared with other schemes in
   literature.},
