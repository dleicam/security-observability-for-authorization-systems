@inproceedings{ WOS:000850928600012,
Author = {Curmi, Axel and Inguanez, Frankie},
Editor = {Schwardmann, U and Boehme, C and Heras, DB},
Title = {Academic Achievement Recognition and Verification Using Blockchain},
