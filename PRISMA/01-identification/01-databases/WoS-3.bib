@article{ WOS:000652509900001,
Author = {Labayen, Mikel and Vea, Ricardo and Florez, Julian and Aginako, Naiara
   and Sierra, Basilio},
Title = {Online Student Authentication and Proctoring System Based on Multimodal
   Biometrics Technology},
Journal = {IEEE ACCESS},
Year = {2021},
Volume = {9},
Pages = {72398-72411},
Abstract = {Identity verification and proctoring of online students are one of the
   key challenges to online learning today. Especially for online
   certification and accreditation, the training organizations need to
   verify that the online students who completed the learning process and
   received the academic credits are those who registered for the courses.
   Furthermore, they need to ensure that these students complete all the
   activities of online training without cheating or inappropriate
   behaviours. The COVID-19 pandemic has accelerated (abruptly in certain
   cases) the migration and implementation of online education strategies
   and consequently the need for safe mechanisms to authenticate and
   proctor online students. Nowadays, there are several technologies with
   different grades of automation. In this paper, we deeply describe a
   specific solution based on the authentication of different biometric
   technologies and an automatic proctoring system (system workflow as well
   as AI algorithms), which incorporates features to solve the main
   concerns in the market: highly scalable, automatic, affordable, with few
   hardware and software requirements for the user, reliable and passive
   for the student. Finally, the technological performance test of the
   large scale system, the usability-privacy perception survey of the user
   and their results are discussed in this work.},
Type = {Article},
Affiliation = {Labayen, M (Corresponding Author), Smowltech, Donostia San Sebastian 20009, Spain.
