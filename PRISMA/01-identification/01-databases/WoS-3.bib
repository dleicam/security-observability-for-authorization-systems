   Aref, Mohammad Reza, Sharif Univ Technol, Dept Elect Engn, Tehran, Iran.
   Bayat, Majid, Shahed Univ, Dept Comp Engn, Tehran, Iran.},
DOI = {10.1016/j.iot.2020.100290},
Article-Number = {100290},
ISSN = {2543-1536},
EISSN = {2542-6605},
Keywords = {Internet of things; E-Health; Privacy; Authentication scheme; Identity;
   Cloud computing; Formal security; ProVerif},
Keywords-Plus = {ACCESS-CONTROL; SMART HEALTH; INTERNET; THINGS},
