@inproceedings{ WOS:000769660000006,
Author = {Sukmana, Muhammad Ihsan Haikal and Torkura, Kennedy Aondona and
   Prasetyo, Sezi Dwi Sagarianti and Cheng, Feng and Meinel, Christoph},
Editor = {Park, N and Sun, K and Foresti, S and Butler, K and Saxena, N},
Title = {A Brokerage Approach for Secure Multi-Cloud Storage Resource Management},
Booktitle = {SECURITY AND PRIVACY IN COMMUNICATION NETWORKS (SECURECOMM 2020), PT II},
Series = {Lecture Notes of the Institute for Computer Sciences Social Informatics
   and Telecommunications Engineering},
Year = {2020},
Volume = {336},
Pages = {102-119},
Note = {16th EAI International Conference on Security and Privacy in
   Communication Networks (SecureComm), ELECTR NETWORK, OCT 21-23, 2020},
Abstract = {Nowadays, more cloud customers are utilizing multiple cloud service
   providers (CSPs) to store their data in the cloud as it provides better
   data availability and service reliance than storing in the single CSP.
   However, there are several challenges faced by cloud customers to
   securely manage their cloud storage resources for cloud end-users (a
   user or a service) in the multi-cloud scenario, such as diverse APIs and
   service implementations in multiple CSP as CSP is not required to comply
   with cloud computing standards and multi-cloud resource management skill
   gap. In this paper, we present a unified multi-cloud storage resource
   management framework for managing cloud storage resources and their
   configurations for Object Storage and Identity and Access Management
   services following the cloud brokerage approach. We propose a unified
   cloud storage resource model continuing our previous work to tackle the
   various data and cloud access control models of cloud storage resources
   in multiple CSPs. Based on the unified model, we introduce a unified
   multi-cloud storage resource management platform to manage cloud storage
   resources and grant/revoke access for the cloud end-user developed for
   two popular public CSPs: Amazon Web Services and Google Cloud. The
   unified platform collects and processes information about the cloud
   storage resources that allows cloud customers to discover, create,
   delete, modify, evaluate, and monitor cloud storage resources across
   various CSPs.},
