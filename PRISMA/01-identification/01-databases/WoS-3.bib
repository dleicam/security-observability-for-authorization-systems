@inproceedings{ WOS:000459878100018,
Author = {Fitri, Novi Aryani and Al Rasyid, M. Udin Harun and Sudarsono, Amang},
Editor = {Ardiansyah, MF and Permatasari, DI and Muarifin and Muliawati, TH and Sari, DM},
Title = {Secure Attribute-Based Encryption With Access Control to Data Medical
   Records},
Booktitle = {2018 INTERNATIONAL ELECTRONICS SYMPOSIUM ON KNOWLEDGE CREATION AND
   INTELLIGENT COMPUTING (IES-KCIC)},
Year = {2018},
Pages = {105-111},
Note = {20th International Electronics Symposium on Knowledge Creation and
   Intelligent Computing (IES-KCIC), Politeknik Elektronika Negeri
   Surabaya, Bali, INDONESIA, OCT 29-30, 2018},
Abstract = {Medical record is a document that becomes a communication tool between
   health workers in providing health services to patients. In the health
   care system, medical record center data store much complete historical
   information about the health condition of a patient or a disease that
   had previously suffered, it is also used to accurately diagnose the
   illness suffered by the patient. Data centers are very vulnerable to
   attacks both inside and against outsiders on the system. Required
   patient control over access based on the attribute of each user at the
   time of registration to the medical record through a website-based
   medical record information system that has been integrated into the
   server. Ciphertext-Policy Attribute-Based Encryption (CP-ABE) is the
   right choice to protect the system when accessing data in the data
   center to protect data from illegal users. In this paper, we propose a
   secure attribute-based encryption with access control to medical record
   data. Our system was created using 4 access policies in different
   department groups (Gynecologist, Internist, Pediatrics, Dental and Oral)
   in a hospital. Based on experimental results with different access
   policy execution time for the encryption process of approximately 1 s
   and 0.2 s to decrypt the data.},
