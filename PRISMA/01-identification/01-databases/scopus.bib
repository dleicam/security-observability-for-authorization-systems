	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85133719746&doi=10.1109%2FTNSM.2022.3185237&partnerID=40&md5=f0745d1b9309fc066d8d8e3ab3cd3537},
	affiliations = {Southeast University, School of Cyber Science and Engineering, Nanjing, China; Qilu University of Technology, Jinan, China; Shandong University of Science and Technology, School of Science and Engineering, Qingdao, China},
	abstract = {Public clouds have drawn increasing attention from academia and industry due to their high computational and storage performance. Attribute-based encryption (ABE) is the most promising technology to simultaneously achieve confidentiality and fine-grained access control of the cloud-stored data. However, traditional ABE that relies on centralized authority faces several key management issues, such as the key escrow, key distribution, key tracking, key update, and heavy communication and computing overhead for users, which will cause security concerns and impede its widespread application. On the other hand, blockchain technology preserves distributed ledgers to ensure the immutability and transparency of data, which can further solve the security vulnerabilities caused by system centralization. This paper proposes a blockchain-assisted transformation method to solve all the key management problems mentioned above in ciphertext-policy ABE by utilizing technologies such as secret sharing protocols. In addition, our transformation method realizes two additional benefits: outsourced decryption and efficient user revocation, which are extremely valuable for practical implementations. We simulate a demonstration by adopting the most popular permissioned blockchain, Hyperledger Fabric. The security and efficiency analysis reveals that the scheme obtained from our transformation method can achieve replayable chosen-ciphertext security with extremely efficient decryption. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {blockchain; Ciphertext-policy attribute-based encryption; cloud; hyperledger fabric; key management},
	keywords = {Access control; Cloud storage; Cryptography; Distributed ledger; Information management; Attribute-based encryptions; Block-chain; Ciphertext-policy attribute-based encryptions; Cloud-computing; Hyperledg fabric; Key-management; Privacy; Security; Transformation methods; Blockchain},
