@CONFERENCE{Ilapakurthy20231,
	author = {Ilapakurthy, Sriram Vamsi},
	title = {Bolstering the Mobile Cloud: Addressing Emerging Threats and Strengthening Multi-Layered Defenses for Robust Mobile Security},
	year = {2023},
	pages = {1 - 7},
	doi = {10.1109/IOTSMS59855.2023.10325824},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85179629965&doi=10.1109%2FIOTSMS59855.2023.10325824&partnerID=40&md5=107e1680055a47a8a8a8d65911d8bcb0},
	affiliations = {University of California, Irvine, Samueli School of Engineering, Irvine, United States},
	abstract = {The proliferation of mobile devices as the primary computing platform for billions of users worldwide introduces escalating security threats, especially as mobile interactions with sensitive data and cloud services increase. This paper provides an analysis of emerging mobile security issues including malware stealing credentials and data from mobile cloud services, lower-level operating system and hardware vulnerabilities enabling exploits on mobile cloud confidentiality and integrity, weaknesses in mobile apps enabling attacks, and rising user privacy risks from excessive tracking. Current security limitations are also reviewed, including signature-based malware detection, coarse-grained access control, and fragmented visibility across the mobile ecosystem. An integrated cross-layer security strategy is proposed combining formal verification of critical mobile components, pervasive hardware-anchored security, intelligence-driven malware adaptation, robust devsecops processes, and coordinated defense visibility. As mobile continues dominating personal and enterprise computing, constructing resilient security foundations through research and awareness of mobile security issues and countermeasures is imperative for realizing the potential of mobile cloud computing. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Advanced mobile defenses; Integrated security strategies; Mobile cloud computing; Mobile exploits; Mobile hardware security; Mobile malware; Mobile security; Mobile vulnerabilities},
