	affiliations = {Vignan Institute of Technology and Science, Dept. Computer Science and Engineering-AIandML, Deshmukhi, India},
	abstract = {Cloud computing makes it is easy to store and access data and offers benefits, such as cost etc. However, its extensive use has also resulted in an increase in hacker and illegal access. These attacks can handle in traditional approach is very difficult. This work proposes a secure and effective cloud-based email search and filtering framework an employing Hidden-Policy Ciphertext-Policy Attribute-Based Encryption (HP-CP-ABE) with Keyword Search. In this approach it ensures both confidentially and controlled access by allowing recipients to conduct keyword search on encrypted mails while allowing filtering servers to handle encrypted content without decryption. Unlike conventional searchable encryption models, our schema integrates advanced access control mechanisms, ensuring that only authorized entities can retrieve relevant messages while preserving the confidentiality of email contents in JWT tokens for authentication purpose. By leveraging composite-order bilinear groups and dual-system encryption methods, our approach improves resistance to previously known attacks, such as offline guessing of keywords and chosen-ciphertext attacks. Beyond email usage, this model also supports secure and efficient encrypted file recovery and content-based filtering, making it extremely versatile for other data protection use cases in cloud contexts. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Ciphertext-Policy Attribute Encryption; Cloud Email Security; Dual System Encryption; Email Filtering; Encrypted Email Search; JWT Tokens; Privacy-Preserving Email Search},
	keywords = {Authentication; Ciphertext; Cryptography; Data privacy; Information retrieval; Network security; Search engines; Ciphertext policies; Ciphertext-policy attribute encryption; Cloud email security; Dual system encryptions; E-mails security; Email filtering; Encrypted email; Encrypted email search; JWT token; Privacy preserving; Privacy-preserving email search; Electronic mail filters},
	correspondence_address = {V. Madireddy; Vignan Institute of Technology and Science, Dept. Computer Science and Engineering-AIandML, Nalgonda, India; email: vineela.madireddy@gmail.com},
