@ARTICLE{Liu20231745,
	author = {Liu, Suhui and Yu, Jiguo and Chen, Liquan and Chai, Baobao},
	title = {Blockchain-Assisted Comprehensive Key Management in CP-ABE for Cloud-Stored Data},
	year = {2023},
	journal = {IEEE Transactions on Network and Service Management},
	volume = {20},
