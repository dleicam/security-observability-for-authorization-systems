@CONFERENCE{Shukla2025225,
	author = {Shukla, Shivangi and Patel, Sankita J.},
	title = {A Novel Pairing-Free ECC-Based Ciphertext-Policy Attribute-Based Proxy Re-Encryption for Secure Cloud Storage},
	year = {2025},
	journal = {International Conference on Information Systems Security and Privacy},
	volume = {1},
	pages = {225 - 233},
	doi = {10.5220/0013138600003899},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001830197&doi=10.5220%2F0013138600003899&partnerID=40&md5=8ff2c0b90dd21d5b56df65a0232d4568},
	affiliations = {S. V. National Institute of Technology, Department of Computer Science and Engineering, Surat, India},
	abstract = {Proxy re-encryption (PRE) is a cryptographic primitive enabling data owner to delegate ciphertext access rights without leaking underlying plaintext to honest-but-curious cloud servers. The delegation of cipher text access rights enhances the efficiency of outsourced data on cloud servers. Cipher text-policy attribute-based proxy re-encryption (CP-ABPRE) employs PRE in attribute-based encryption to enable cipher text transformation from specified access policy to new access policy without leaking underlying plaintext. However, current state-of-the-art schemes incorporate expensive bilinear pairing operations to transform cipher text access policy. The escalating adoption of cloud computing in real-time applications demands a pairing-free CP-ABPRE mechanism for resource-limited users in the network. The agenda of this paper, for the first time, is to design a novel pairing-free elliptic curve cryptography (ECC) based ciphertext-policy attribute-based proxy re-encryption, abbreviated as ECC-CP-ABPRE scheme. It incorporates linear secret sharing scheme (LSSS) for the expressiveness of access policies. To reduce overall communication and computational overheads, ECC-CP-ABPRE scheme replaces expensive bilinear pairing operations with scalar multiplication on elliptic curve. The security analysis illustrates that ECC-CP-ABPRE scheme is secure under collusion attack and ensures data confidentiality. Furthermore, the performance evaluation demonstrates that ECC-CP-ABPRE scheme incurs significant reduction in computational and communication overheads than existing CP-ABPRE schemes. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Access Control; Cloud Storage; CP-ABPRE; Elliptic Curve Cryptography; Pairing-Free},
	editor = {Di Pietro, R. and Renaud, K. and Mori, P.},
	publisher = {Science and Technology Publications, Lda},
	issn = {21844356},
	isbn = {9789897586248; 9789897585531; 9789897586835; 9789897583995; 9789897583599; 9789897584916},
	language = {English},
	abbrev_source_title = {Int. Conf. Inf. Syst. Secur. Priv.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@ARTICLE{Muthurajkumar2025260,
	author = {Muthurajkumar, Sannasy},
	title = {Blockchain Controlled Offline IoT Data Stream Secured Using Identity-Based Proxy Re-Encryption Technique},
	year = {2025},
	pages = {260 - 283},
	doi = {10.1201/9781003500391-16},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001752188&doi=10.1201%2F9781003500391-16&partnerID=40&md5=2e939bd1e0dacc76dd2ba7975e6f7484},
	affiliations = {Madras Institute of Technology, Department of Computer Technology, Chennai, India},
	abstract = {IoT has gained phenomenal growth with fast pace in the technological world. These IoT devices have limited resources and produce a lot of data that needs to be evaluated in order to yield useful information. Due to resource limitations, data processing and storage cannot be performed at IoT devices. Thus, there is a dependency on cloud computing. The majority of current systems that use cloud storage for data storage and access do not offer attributes like transparency, traceability, reliability, trustworthiness, and security. Due to centralization, they also experience a single point of failure. Thus, the proposed model makes use of the concept of blockchain and decentralized storage. In the research work, the model proposes a blockchain-based approach for IoT streaming devices with limited resources that enables offline stream data to be saved as chunks in a decentralized, transparent, traceable, dependable, safe, and trustworthy manner. The model uses the identity based proxy re-encryption (IBPRE) technique to protect the confidentiality of the data being stored. While proxy re-encryption construction permits authorized individuals to access the data, identity-based encryption allows the owner to transfer their encrypted data to the cloud. The model makes use of the interplanetary file system (IPFS) decentralized storage solution for storing the file chunks and to perform access control and file access for the blockchain network, smart contracts are used. © 2025 Elsevier B.V., All rights reserved.},
	publisher = {CRC Press},
	isbn = {9781032812960; 9781040327098},
	language = {English},
	abbrev_source_title = {AI and Blockchain in Smart Grids: Fundamentals, Methods, and Applications},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Schlaubitz2025425,
	author = {Schlaubitz, Michael and Veyisoglu, Onur and Rennhard, Marc},
	title = {A2CT: Automated Detection of Function and Object-Level Access Control Vulnerabilities in Web Applications},
	year = {2025},
	journal = {International Conference on Information Systems Security and Privacy},
	volume = {2},
	pages = {425 - 436},
	doi = {10.5220/0013092700003899},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001722536&doi=10.5220%2F0013092700003899&partnerID=40&md5=38ae53f22784db17d75350d3ae42cf80},
	affiliations = {ZHAW Zurich University of Applied Sciences, Institute of Computer Science, Winterthur, Switzerland},
	abstract = {In view of growing security risks, automated security testing of web applications is getting more and more important. There already exist capable tools to detect common vulnerability types such as SQL injection or cross-site scripting. Access control vulnerabilities, however, are still a vulnerability category that is much harder to detect in an automated fashion, while at the same time representing a highly relevant security problem in practice. In this paper, we present A2CT, a practical approach for the automated detection of access control vulnerabilities in web applications. A2CT supports most web applications and can detect vulnerabilities in the context of all HTTP request types (GET, POST, PUT, PATCH, DELETE). To demonstrate the practical usefulness of A2CT, an evaluation based on 30 publicly available web applications was done. Overall, A2CT managed to uncover 14 previously unknown vulnerabilities in two of these web applications, which resulted in six published CVE records. To encourage further research, the source code of A2CT is made available under an open-source license. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Access Control Vulnerabilities; Automated Web Application Security Testing; Zero-Day Vulnerabilities},
	editor = {Di Pietro, R. and Renaud, K. and Mori, P.},
	publisher = {Science and Technology Publications, Lda},
