	affiliations = {Xidian University, School of Cyber Engineering, Xi'an, China; Singapore Management University, School of Information Systems, Singapore City, Singapore; The University of Texas at San Antonio, Department of Information Systems and Cyber Security, San Antonio, United States; Fuzhou University, College of Mathematics and Computer Science, Fuzhou, China; National University of Singapore, Department of Computer Science, Singapore City, Singapore; University of Electronic Science and Technology of China, Department of Computer Science and Engineering, Chengdu, China},
	abstract = {Ciphertext-Policy Attribute-Based Keyword Search (CP-ABKS) schemes support both fine-grained access control and keyword-based ciphertext retrieval, which make these schemes attractive for resource-constrained users (i.e., mobile or wearable devices, sensor nodes, etc.) to store, share and search encrypted data in the public cloud. However, ciphertext length and decryption overhead in the existing CP-ABKS schemes grow with the complexity of access policies or the number of data users' attributes. Moreover, such schemes generally do not consider the practical multi-owner setting (e.g., each file needs to be signed by multiple data owners before being uploaded to the cloud server) or prevent malicious cloud servers from returning incorrect search results. To overcome these limitations, in this paper we first design an optimized Verifiable Fine-grained Keyword Search scheme in the static Multi-owner setting (termed as basic VFKSM), which achieves short ciphertext length, fast ciphertext transformation, accelerated search process, and authentic search result verification. Then, we extend the basic VFKSM to support multi-keyword search and multi-owner update (also called as extended VFKSM). Finally, we prove that the basic (or extended) VFKSM resists the Chosen-Keyword Attack (CKA) and external Keyword-Guessing Attack (KGA). We also evaluate the performance of these schemes using various public datasets. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {Ciphertext length; decryption overhead; multi-keyword search; multi-owner setting; search result verification},
	keywords = {Access control; Cloud computing; Search engines; Sensor nodes; Servers; Ciphertexts; Complexity theory; decryption overhead; Keyword search; Multi keywords; Result verifications; Cryptography},
	correspondence_address = {J. Ning; Department of Computer Science, National University of Singapore, Singapore, Singapore; email: jtning88@gmail.com},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {15455971},
	language = {English},
	abbrev_source_title = {IEEE Trans. Dependable Secure Comput.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 65}
}

