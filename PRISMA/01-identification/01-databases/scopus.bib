@CONFERENCE{Sprecher2022206,
	author = {Sprecher, Steven and Kerschbaumer, Christoph and Kirda, Engin},
	title = {SoK: All or Nothing - A Postmortem of Solutions to the Third-Party Script Inclusion Permission Model and a Path Forward},
	year = {2022},
	pages = {206 - 222},
	doi = {10.1109/EuroSP53844.2022.00021},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85134082251&doi=10.1109%2FEuroSP53844.2022.00021&partnerID=40&md5=44651c2fbe7e0faeeb0a9b67157cc9d5},
	affiliations = {Northeastern University, Boston, United States; Mozilla Corporation, Mountain View, United States},
	abstract = {The web execution model allows third-party JavaScript to be leveraged in a single execution context. Access control for these scripts is currently all or nothing. It has been this way for over a decade despite the knowledge that this model allows for privacy violations and even user data exfiltration. Consequently, users have little to no control over which third-parties operate on their Personally Identifying Information (PII) when interacting with a web application. In this work we aim to explain the lack of solutions to this problem, and to suggest more promising future directions. We first survey past proposed solutions and their trade-offs. We then create a monitoring system in the Firefox browser which captures third-party script access to user supplied PII in HTML Form Elements. We proceed to inspect 100,000 websites with our Monitor and custom web crawler to highlight the complexity of use cases of third-party scripts operating on user PII. Our findings inform the creation of a grading rubric and systematization for solutions in this space, which we then apply to many previous works. The complexity exposed through this effort allows us to start a discussion around why current technological and policy solutions fail adoption. Ultimately we propose a research direction that allows web applications to take advantage of the interoperability of the web execution model while also respecting an end user's privacy and security. © 2022 Elsevier B.V., All rights reserved.},
	author_keywords = {Browsers; JavaScript; Privacy; Third-Party Scripts; Web security},
	keywords = {Computer architecture; Economic and social effects; Grading; High level languages; Web crawler; All or nothings; Browser; Execution modeling; Javascript; Privacy; Third parties; Third-party script; WEB application; Web applications; WEB security; Access control},
