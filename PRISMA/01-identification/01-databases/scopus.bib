	title = {Data Protection Strategies: Employing IBBE and Attribute-Based CPRE for Secure Data Distribution},
	year = {2024},
	pages = {},
	doi = {10.1109/ICEECT61758.2024.10738987},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105003868554&doi=10.1109%2FICEECT61758.2024.10738987&partnerID=40&md5=f62137951de7719c417c2ab219a7dfd8},
	affiliations = {Siddharth Institute of Engineering & Technology, Department of Computer Science and Engineering, Puttur, India},
	abstract = {Worldwide, people and businesses are starting to adopt cloud computing more and more. Although there are still many issues that need to be overcome, cryptography can assist users in public clouds in protecting their data. We present a practical and safe identity-based data group sharing and distribution system for public clouds that enables data owners to simultaneously broadcast encrypted data to multiple recipients. Security issues with public cloud infrastructure are the driving force behind data confidentiality regulations. We employ conditional proxy re-encryption that is both ascribe-based and timed-release, which gives the cloud server a reencryption key. These ways, only disseminators whose characteristics comply with the encrypted data's access policy are able to distribute it to other groups beyond the release period. Through this, we are able to disseminate data groups in a secure and adaptable manner. The distribution of cipher texts can be controlled by data owners with fine-grained and timed-release access control by re-encryption conditions that are connected to characteristics and release time. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {cipher texts; cloud computing; cryptographic techniques; re-encryption key},
