@ARTICLE{Duggegowda2024,
	author = {Duggegowda, Divyashree and Ramamoorthy, Umadevi},
	title = {MedAccess HBPF: A Privacy-Preserving Hybrid-Blockchain Framework for Secure and Efficient Cloud-Based Electronic Health Record Sharing},
	year = {2024},
