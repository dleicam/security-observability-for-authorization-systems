	author = {Deng, Lunzhi and Wang, Bo and Wang, Tao and Feng, Shuai and Li, Siwei},
	title = {Certificateless Provable Data Possession Scheme With Provable Security in the Standard Model Suitable for Cloud Storage},
	year = {2023},
	journal = {IEEE Transactions on Services Computing},
	volume = {16},
