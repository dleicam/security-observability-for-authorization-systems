	author = {De Capitani di Vimercati, Sabrina and Foresti, Sara and Jajodia, Sushil and Livraga, Giovanni and Paraboschi, Stefano and Samarati, Pierangela},
	title = {Distributed query execution under access restrictions},
	year = {2023},
	journal = {Computers and Security},
