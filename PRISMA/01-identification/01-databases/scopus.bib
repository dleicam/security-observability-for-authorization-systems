@CONFERENCE{Pham2023519,
	author = {Pham, Steven and Oliveira, Kaue and Lung, Chung Horng},
	title = {WebAssembly Modules as Alternative to Docker Containers in IoT Application Development},
	year = {2023},
	pages = {519 - 524},
	doi = {10.1109/ICEIB57887.2023.10170519},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85166377101&doi=10.1109%2FICEIB57887.2023.10170519&partnerID=40&md5=29d2c0fd9f0d14cb8c41c593fae80bbd},
	affiliations = {Carleton University, Ottawa, Canada},
	abstract = {Containers have been commonly used in recent years for application deployment in many fields of computing, including the Internet of Things (IoT). Thus, there is an opportunity for the use of WebAssembly (WASM) to improve application security and fault tolerance. Applications using WebAssembly expose small and purpose-built APIs to different application modules when combined with WASM's strong sandboxing capabilities and increase application security under the principle of least privilege. Applications leverage the small startup time of WASM modules compared to Docker containers to create small unit-of-work-sized modules. These small, sandboxed modules can increase application fault tolerance when combined with providing modules with focused APIs. We investigated the viability of WASM as an alternative to Docker containers for IoT applications. Experiments were conducted to evaluate the overhead of WASM on heavy code throughput and latency. The results showed that WASM has a modest performance cost and provides secure application modularity. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {application security; containerization; Docker; fault tolerance; Internet of things; WebAssembly},
	keywords = {Application programming interfaces (API); Fault tolerance; Internet of things; Application deployment; Application development; Application module; Application security; Containerization; Docker; Least privilege; Sandboxing; Startup time; Webassembly; Containers},
	editor = {Meen, T.},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9798350333862},
	language = {English},
	abbrev_source_title = {IEEE Int. Conf. Electron. Commun., Internet Things Big Data, ICEIB},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5}
}

@CONFERENCE{Gajendran2023928,
	author = {Gajendran, P. and Setty, G. Shabarish and Vasanth, S. and Ajay Kumar, C. and Manoj Kumar, R.},
	title = {IoT based Circuit Breaker with Access Control},
	year = {2023},
	pages = {928 - 933},
	doi = {10.1109/ICSCSS57650.2023.10169319},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85166215462&doi=10.1109%2FICSCSS57650.2023.10169319&partnerID=40&md5=bd7137b812682de7790c11c267ffe66c},
	affiliations = {Karpagam College of Engineering, Department of Electrical and Electronic Engineering, Coimbatore, India},
	abstract = {The Internet of Things (IoT) has revolutionized the way we interact with the world around us. One of the many applications of IoT is in the field of home automation. In this project, we propose an IoT-based Circuit Breaker with Access Control using Telegram, RFID Module, ESP32, and Website. The circuit breaker is an essential safety device in any home or building. It protects the electrical system from overloading, short-circuiting, and other electrical faults. The traditional circuit breaker is manually operated, and it can be inconvenient to turn it on or off if you are not physically present. With the IoT-based circuit breaker, you can remotely control the power supply to your home or office. The system is designed to provide access control to authorized persons only. The user can use a Telegram bot to send a message to the circuit breaker's ESP32 module to turn on or off the power supply. The ESP32 module receives the message, and if the user is authorized, it switches on or off the power supply. The user's identity is verified using an RFID module that is connected to the ESP32 module. The user has to swipe the RFID card to access the power supply. The ESP32 module reads the RFID card's unique ID and checks if it matches the authorized user's ID. The system's access control feature ensures that only authorized personnel can operate the circuit breaker. This is achieved through a user login system that requires a username and password. The administrator can create user accounts and assign permissions to control the circuit breaker. The system also has a web interface that allows the user to monitor and control the circuit breaker's status. The web interface displays the current power status and allows the user to turn on or off the power supply remotely. The user can also add or remove authorized users from the system. In conclusion, an IoT-based Circuit Breaker with Access Control using Telegram, RFID Module, ESP32, and Website is a reliable and secure way to control the power supply to your home or office. It provides access control to authorized persons only and allows remote monitoring and control of the circuit breaker's status. This system can make your life more comfortable and safer by automating the process of controlling the power supply. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Circuit Breaker; Dynamic Website. Unique ID; Electrical accidents; line man.; Radio Frequency IDentification card; Telegram; Whatsapp},
	keywords = {Access control; Electric power systems; Internet of things; Radio frequency identification (RFID); Timing circuits; Websites; Circuit-breakers; Dynamic website; Dynamic website.; Electrical accident; Identification cards; Line man.; Radio frequency identification card; Radio-frequency-identification; Telegram; Unique ID; Whatsapp; Electric circuit breakers},
	correspondence_address = {P. Gajendran; Karpagam College of Engineering, Electrical and Electronics Engineering, Coimbatore, 641032, India; email: gajendran.p@kce.ac.in},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9798350333602},
	language = {English},
	abbrev_source_title = {Int. Conf. Sustain. Comput. Smart Syst., ICSCSS - Proc.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@ARTICLE{Witczak2023211,
	author = {Witczak, Marcin and Seybold, Lothar and Bulach, Eric and Maucher, Niko},
	title = {KIS.API: Towards External Communication},
	year = {2023},
	journal = {Studies in Systems, Decision and Control},
	volume = {476},
	pages = {211 - 249},
	doi = {10.1007/978-3-031-33623-2_7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165996227&doi=10.1007%2F978-3-031-33623-2_7&partnerID=40&md5=d063f7f30b5744d5a4d969556805b4a5},
	affiliations = {Uniwersytet Zielonogórski, Institute of Control and Computation Engineering, Zielona Gora, Poland; RAFI GmbH & Co. KG, Berg, Germany},
	abstract = {The objective of this chapter is to provide a concise overview of KIS.API, which can be used for effective communication with external applications. In particular, the chapter starts with a general overview of KIS.API along with preliminary steps pertaining to KIS.API user registration and authorization in KIS.MANAGER. Subsequently, it is shown how to access essential functionalities explained in the preceding chapters through the KIS.API framework. Thus, the reader will be able to access the asset and user groups as well as the assets themselves. Another crucial point of this chapter is concerned with accessing data through Datapoints as well as calculated Datapoints and KPIs. Subsequently, the mechanism of Rule engine is confronted with KIS.API. In particular, it is show how to access information about the rules designed in KIS.MANGER as well as how to trigger the rules from external applications. With all the above-listed components, the concept of websockets is introduced along with sample applications concerning two-way communication with KIS.ME. Finally, the chapter is summarized with a set of training exercises concerning KIS.API-oriented skills. © 2023 Elsevier B.V., All rights reserved.},
	correspondence_address = {N. Maucher; RAFI GmbH & Co. KG, Berg, Germany; email: Niko.Maucher@rafi-group.com},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {21984190; 21984182},
	isbn = {9783319432700},
	language = {English},
	abbrev_source_title = {Stud. Syst. Decis. Control},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Patil2023181,
	author = {Patil, Rachana Yogesh and Patil, Yogesh H. and Bannore, Aparna},
	title = {Security of Medical Internet of Things (MIoT)- A Bibliometric Analysis},
	year = {2023},
	journal = {Journal of Engineering Science and Technology Review},
	volume = {16},
	number = {3},
	pages = {181 - 190},
	doi = {10.25103/jestr.163.22},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165981806&doi=10.25103%2Fjestr.163.22&partnerID=40&md5=a5f6d15654c4ff8889a61d125bb827f8},
	affiliations = {Pimpri Chinchwad College of Engineering, Pune, India; D. Y. Patil College of Engineering, Pune, India; SIES Graduate School of Technology, Navi Mumbai, India},
	abstract = {The integration of the Internet and communication technologies has improved our lives in numerous ways. To date, the Internet of Things has evolved the healthcare industry from healthcare 1.0 to 4.0 which is known as the MIoT. In Healthcare 4.0, data is shared among multiple stakeholders through the use of cloud computing, fog computing, and telehealth. MIoT devices and technology's interconnected, heterogeneous nature raises new concerns about access to confidential patient data, which is often done without patients' or medical staff's knowledge. This is because security and privacy concerns for MIoT devices and technology are frequently ignored or undermined by relevant stakeholders. Medical IoT security and privacy are becoming increasingly important as a result of the increasing number of security breaches targeting the MIoT in healthcare.To impartially reveal the research scenario of Security of MIoT biblioshiny and VOS viewer software are used to conduct a quantitative assessment of research papers belonging to this field for the period 2012–2021 in the Web of Science (WoS) and Scopus databases. From the results, it is seen that for the past 10 years, the sum of articles on Security of MIoT has increased. This research domain covers 35 territories. MIoT, Security, Privacy, authentication, access control are the most often used keywords in this field of research in recent years. The research flashpoints in the field primarily emphasize research directions such as the, the security and privacy concerns related to MIoT sensor data and how to get rid of them. The top five nations considering research volume are the China, India, Saudi Arabia, USA, and Korea, but a lack of collaborative work amongst these countries is seen. Finally, the paper provides future research directions on security of MIoT, such as Privacy of patient information, Lightweight Protocols for MIoT Devices, Trust management, patient data sharing and insecure networks. © 2023 Elsevier B.V., All rights reserved.},
