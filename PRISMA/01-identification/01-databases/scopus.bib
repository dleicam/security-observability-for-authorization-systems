	author = {Bibal Benifa, J. V. and Mini, G. Venifa},
	title = {Modified Chebyshev polynomial-based access control mechanism for secured data access in cloud computing environment},
	year = {2021},
	journal = {Service Oriented Computing and Applications},
	volume = {15},
	number = {3},
	pages = {187 - 203},
	doi = {10.1007/s11761-020-00307-9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85094945812&doi=10.1007%2Fs11761-020-00307-9&partnerID=40&md5=bd13fb245878e061eef53c104b86ec9c},
	affiliations = {Indian Institute of Information Technology Kottayam, Kottayam, India; Noorul Islam University, Kanyakumari, India},
	abstract = {Cloud computing is a popular model for offering infinite storage resources for the users. In the present scenario, extremely sensitive data is stored in the third-party cloud service provider’s infrastructure. For instance, patients who have direct access to the healthcare system may access the cloud-based health care data at any time based on the needs. Such sensitive data is subjected to various security issues because of the entities from multiple hosts connecting to cloud storage. In the proposed work, an optimized secured data access control mechanism named as modified Chebyshev polynomial-based access control (MCPAC) is presented. In MCPAC scheme, multiple levels of verification and authentications are carried out to provide resilience against widely recognized attacks. The proposed access control scheme is evaluated in a real private cloud infrastructure using the metrics, such as precision, recall and detection rate. It is proved that the proposed MCPAC offers better privacy protection with the precision of 0.8947, recall of 0.8983, and detection rate of 85.63%, which is high as compared to the conventional state-of-the-art methods. Security analysis is also done for the MCPAC scheme, and it indicates that the system efficiently handles the well-known attacks. The performance analysis shows that MCPAC meets the essential security mandates and excels in computational efficiency by making it suitable for the realistic applications hosted in a cloud computing environment. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Access control mechanism; Chebyshev polynomial; Cloud infrastructure; Elliptic curve cryptography},
	keywords = {Access control; Cloud storage; Computational efficiency; Health care; Polynomials; Public key cryptography; Sensitive data; Access control mechanism; Access control schemes; Chebyshev polynomials; Cloud computing environments; Cloud infrastructures; Curve cryptography; Elliptic curve; Elliptic curve cryptography; Modified Chebyshev polynomials; Sensitive datas},
	correspondence_address = {J.V.B. Benifa; Indian Institute of Information Technology, Kottayam, India; email: benifa.john@gmail.com},
	publisher = {Springer Science and Business Media Deutschland GmbH},
