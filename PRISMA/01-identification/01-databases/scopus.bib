@CONFERENCE{Dong2018,
	author = {Dong, Qiuxiang and Huang, Dijiang and Luo, Jim and Kang, Myong H.},
	title = {Achieving fine-grained access control with discretionary user revocation over cloud data},
	year = {2018},
	pages = {},
	doi = {10.1109/CNS.2018.8433128},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85052593148&doi=10.1109%2FCNS.2018.8433128&partnerID=40&md5=c2a96cdf2e120f3346ed1a285037d6d0},
	affiliations = {Arizona State University, Tempe, United States; U.S. Naval Research Laboratory, Washington, D.C., United States},
	abstract = {Cloud storage solutions have gained momentum in recent years. However, cloud servers can not be fully trusted. Data access control have becomes one of the main impediments for further adoption. One appealing approach is to incorporate the access control into encrypted data, thus removing the need to trust the cloud servers. Among existing cryptographic solutions, Ciphertext Policy Attribute-Based Encryption (CP-ABE) is well suited for fine-grained data access control in cloud storage. As promising as it is, user revocation is a cumbersome problem that impedes its wide application. To address this issue, we design an access control system called DUR-CP-ABE, which implements identity-based User Revocation in a data owner Discretionary way. In short, the proposed solution provides the following salient features. First, user revocation enforcement is based on the discretion of the data owner, thus providing more flexibility. Second, no private key updates are needed when user revocation occurs. Third, the proposed scheme allows for group revocation of affiliated users in a batch operation. To the best of our knowledge, DUR-CP-ABE is the first CP-ABE solution to provide affiliation- based batch revocation functionality, which fits naturally into organizations' Identity and Access Management (IAM) structure. The analysis shows that the proposed access control system is provably secure and efficient in terms of computation, communi- cation and storage. © 2018 Elsevier B.V., All rights reserved.},
	author_keywords = {Access Control; Cloud Storage; CP-ABE; Directory; Discretionary Revocation; Encryption; IAM},
	keywords = {Cloud computing; Control systems; Cryptography; Digital storage; Network security; Trusted computing; Ciphertext-policy attribute-based encryptions; Cloud storages; CP-ABE; Data access control; Directory; Discretionary Revocation; Identity and access managements; Salient features; Access control},
	correspondence_address = {Q. Dong; Arizona State University, Tempe, 85281, United States; email: qiuxiang.dong@asu.edu},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9781538645864},
	language = {English},
	abbrev_source_title = {IEEE Conf. Commun. Netw. Secur., CNS},
	type = {Conference paper},
