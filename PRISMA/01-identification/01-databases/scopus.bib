@ARTICLE{Praveena2021151,
	author = {Praveena, D. and Thanga Ramya, S. and Gladis Pushparathi, V. P. and Bethi, Pratap and Poopandian, S.},
	title = {Hybrid Cloud Data Protection Using Machine Learning Approach},
	year = {2021},
	journal = {Studies in Big Data},
	volume = {89},
	pages = {151 - 166},
	doi = {10.1007/978-3-030-75657-4_7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85174314216&doi=10.1007%2F978-3-030-75657-4_7&partnerID=40&md5=f2f506b1524f1211a963d0991d5ccc20},
	affiliations = {R.M.D. Engineering College, Department of Information Technology, Kavaraipettai, India; Velammal Institute of Technology, Department of Computer Science and Engineering, Chennai, India; OPG Power Generation Pvt. Ltd, Chennai, India; Ltd., Chennai, India},
	abstract = {In today’s digital world, information created by Internet of Things (IoT) devices has expanded drastically. This expansion is due to an increase in the number of IoT devices associated with the internet. Hybrid cloud computing provides enormous support to these emerging IoT devices in processing vast data. However, security is a challenging issue because of the integration of IoT and hybrid cloud. To achieve a sufficient level of hybrid cloud IoT security, a combination of Enhanced C4.5 machine learning algorithm and Dynamic Spatio Role-Based Access Control Algorithm is introduced. In this approach, the data users are classified using the Enhanced C4.5 algorithm and the user’s level of cloud data access is restricted using the Dynamic Spatio Role-Based Access Control Algorithm. As a result, the major security issues pertaining to IoT cloud are addressed. The security framework also uses a deduplication algorithm for eliminating redundant data and significantly improving IoT data storage requirements. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Access control; Deduplication; Hybrid cloud networks; Internet of Things (IoT); Machine learning; Secured storage; Security},
	keywords = {Access control; Cloud storage; Digital devices; Learning algorithms; Machine learning; Network security; Cloud data; Cloud networks; Deduplication; Hybrid cloud network; Hybrid clouds; Internet of thing; Machine-learning; Role-based Access Control; Secured storages; Security; Internet of things},
	correspondence_address = {D. Praveena; Department of Information Technology, R.M.D Engineering College, Kavaraipettai, 601206, India; email: praveena.it@rmd.ac.in},
	publisher = {Springer Science and Business Media Deutschland GmbH},
