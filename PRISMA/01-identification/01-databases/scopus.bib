@CONFERENCE{Jambulingam2025,
	author = {Jambulingam, Umamageswaran and Shivakumar, Anish and Varshith, Achanta Srinivas and Prabu, M.},
	title = {Developing a More Adaptive and Dynamic Trust Evaluation System Using a Task Role Based Access Control Module (T-RBAC)},
	year = {2025},
	pages = {},
	doi = {10.1109/ICDSBS63635.2025.11031714},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105011053141&doi=10.1109%2FICDSBS63635.2025.11031714&partnerID=40&md5=a287d6c279749d21c21b86c0958db9e0},
	affiliations = {Amrita Vishwa Vidyapeetham Chennai Campus, Vengal, India},
	abstract = {Due to the increasing adoption of cloud computing, which is adopted for its flexibility and cost-effectiveness, huge amounts of sensitive information are entrusted to cloud storage systems. However, a crucial point of contention in this growth is ensuring data security and confidentiality. Traditional cryptographic access control techniques provide a level of protection but are insufficient for guaranteeing complete trust. This paper deals with the persistent trust issues with access control methods, therefore, decreasing the security risks and increasing data owners' confidence regarding the data stored. We propose a new Task-Role based access model(T-RBAC), tailored to the cloud environment, with a holistic framework for trust evaluation, so that trust is dynamically evaluated with broad criteria for adaptation to different contexts and scenarios. Unlike most of the existing trust-based modules, the T-RBAC system combines real-time contextual factors with machine learning algorithms that predict trends of trustworthiness to aid in decision-making. The high security offered by our framework is also balanced with flexibility and scalability to allow seamless integration into existing cloud storage systems. The model will maintain long-term reliability through continuous monitoring and trust recalibration. Through extensive simulations and real-world case studies in healthcare, finance, and critical infrastructure, the computational efficiency and robustness of the T-RBAC system are measured. The T-RBAC framework, enhanced to counter the shortcomings of static RBAC models and existing modules of trust, represents an important leap forward in the security of clouds. The proposed model provides a balanced means of securing sensitive data, while enabling data owners to make better-informed decisions, thereby making way for innovative trust management in cloud computing. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Context-Aware Access Control; Dynamic Trust Evaluation; Predictive Trust Modeling; Secure Cloud Computing; Task-Role Based Access Control (T-RBAC)},
	keywords = {Access control models; Cloud security; Cloud storage; Cost effectiveness; Cryptography; Decision making; Information management; Learning algorithms; Learning systems; Machine learning; Public works; Sensitive data; Trusted computing; Cloud-computing; Context-aware access control; Dynamic trust evaluation; Dynamic trusts; Predictive trust modeling; Role-based Access Control; Secure cloud computing; Task-role based access control; Trust evaluation; Trust models; Computational efficiency},
