	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85041433986&doi=10.1016%2Fj.comnet.2018.01.036&partnerID=40&md5=78b67089d4397a1e967f6ccc1ca05b53},
	affiliations = {University of Carthage, Ecole Polytechnique de Tunisie, SERCOM, La Marsa, Tunisia; Telnet Innovation Labs, Ariana, Tunisia; Université Paris-Saclay, Gif-sur-Yvette, France; Université de Tunis El Manar, Faculté des Sciences de Tunis, LIP2 Laboratory, Tunis, Tunisia},
	abstract = {Attribute based encryption (ABE) is an encrypted access control mechanism that ensures efficient data sharing among dynamic group of users. Nevertheless, this encryption technique presents two main drawbacks, namely high decryption cost and publicly shared access policies, thus leading to possible users’ privacy leakage. In this paper, we introduce PHOABE, a Policy-Hidden Outsourced ABE scheme. Our construction presents several advantages. First, it is a multi-attribute authority ABE scheme. Second, the expensive computations for the ABE decryption process is partially delegated to a Semi Trusted Cloud Server. Third, users’ privacy is protected thanks to a hidden access policy. Fourth, PHOABE is proven to be selectively secure, verifiable and policy privacy preserving under the random oracle model. Five, estimation of the processing overhead proves its feasibility in IoT constrained environments. © 2020 Elsevier B.V., All rights reserved.},
