	doi = {10.1109/IAEAC65194.2025.11166187},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105018470719&doi=10.1109%2FIAEAC65194.2025.11166187&partnerID=40&md5=5b2f125bae88f727265d42dd7cc9f44d},
	affiliations = {Peoples Liberation Army Engineering University, Command and Control Engineering College, Nanjing, China},
	abstract = {The zero trust paradigm experiences widespread adoption in leading domains such as cloud computing, Internet of Things, and blockchain. Nonetheless, actual deployment faces substantial technical and managerial challenges. A comparative analysis of the traditional perimeter-defense security model and the zero trust model explores their distinctions in identity management, fine-grained authorization, and dynamic access control. The analysis emphasizes the technical solutions and empirical outcomes of implementing zero trust security mechanisms in multi-cloud environments, smart device networks, and decentralized systems. The study demonstrates that zero trust, through continuous authentication, the principle of least privilege, and multilayered dynamic security policies, effectively mitigates internal threats and lateral movements, yet it still encounters significant challenges related to performance overhead, deployment complexity, and standardization. Finally, the paper outlines future optimization directions and research hotspots, thereby providing theoretical reference and practical guidance for further exploration in related fields. © 2025 Elsevier B.V., All rights reserved.},
