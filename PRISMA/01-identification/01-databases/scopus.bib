@ARTICLE{Deng20221130,
	author = {Deng, Hua and Qin, Zheng and Wu, Qianhong and Guan, Zhengyu and Yin, Hui},
	title = {Revocable Attribute-Based Data Storage in Mobile Clouds},
	year = {2022},
	journal = {IEEE Transactions on Services Computing},
	volume = {15},
	number = {2},
	pages = {1130 - 1142},
	doi = {10.1109/TSC.2020.2984757},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85083734588&doi=10.1109%2FTSC.2020.2984757&partnerID=40&md5=c567c470fa36cf5109667efdad8f86a4},
	affiliations = {Hunan University, Changsha, China; Beihang University, School of Cyber Science and Technology, Beijing, China; Changsha University, College of Computer Engineering and Applied Mathematics, Changsha, China},
	abstract = {It is becoming fashionable for people to access data outsourced to clouds with mobile devices. To protect data security and privacy, attribute-based encryption (ABE) has been widely used in cloud storage systems. However, one of the main efficiency drawbacks of ABE is the high computation overheads at mobile devices during user revocation and file access. To address this issue, we propose a revocable attribute-based data storage (RADS) scheme equipped with several attracting features. First, our RADS scheme achieves a fine-grained access control mechanism, by which file owners do not need to explicitly specify authorized visitors to their outsourced files. Second, our RADS scheme allows mobile users to authorize the cloud service provider (CSP) to share costly computations in file access, without exposing the file content. Third, our RADS scheme offloads the operations of access-credential update and file re-encryption during revocation process to CSP, leaving all non-revoked users undisturbed. The revocation of RADS achieves a strong data protection, i.e., revoked users can access neither newly uploaded files nor old ones. The security and efficiency of the RADS scheme are validated via both analysis and experimental results. © 2022 Elsevier B.V., All rights reserved.},
	author_keywords = {attribute-based encryption; Cloud computing; data security; mobile clouds; revocation},
	keywords = {Access control; Cryptography; Data privacy; Efficiency; Mobile security; Mobile telecommunication systems; Access control mechanism; Attribute-based; Attribute-based encryptions; Cloud service providers; Cloud storage systems; Computation overheads; Data security and privacy; User revocation; Digital storage},
