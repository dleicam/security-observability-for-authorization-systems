@CONFERENCE{Matetic20181387,
	author = {Matetic, Sinisa and Schneider, Moritz and Miller, Andrew and Juels, Ari and Čapkun, Srdjan},
	title = {DELEGATEE: Brokered delegation using trusted execution environments},
	year = {2018},
	pages = {1387 - 1403},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85075587151&partnerID=40&md5=51a88be783671b641bfd265e260e9bb2},
	affiliations = {ETH Zürich, Zurich, Switzerland; UIUC; Cornell Tech, New York, United States},
	abstract = {We introduce a new concept called brokered delegation. Brokered delegation allows users to flexibly delegate credentials and rights for a range of service providers to other users and third parties. We explore how brokered delegation can be implemented using novel trusted execution environments (TEEs). We introduce a system called DELEGATEE that enables users (Delegatees) to log into different online services using the credentials of other users (Owners). Credentials in DELEGATEE are never revealed to Delegatees and Owners can restrict access to their accounts using a range of rich, contextually dependent delegation policies. DELEGATEE fundamentally shifts existing access control models for centralized online services. It does so by using TEEs to permit access delegation at the user's discretion. DELEGATEE thus effectively reduces mandatory access control (MAC) in this context to discretionary access control (DAC). The system demonstrates the significant potential for TEEs to create new forms of resource sharing around online services without the direct support from those services. We present a full implementation of DELEGATEE using Intel SGX and demonstrate its use in four real-world applications: email access (SMTP/IMAP), restricted website access using a HTTPS proxy, e-banking/credit card, and a third-party payment system (PayPal). © 2025 Elsevier B.V., All rights reserved.},
	keywords = {Access control models; Access delegations; Centralised; Discretionary access control; Mandatory access control; On-line service; Service provider; Third parties; Trusted execution environments; User discretions},
	publisher = {USENIX Association},
	isbn = {9781939133045},
	language = {English},
	abbrev_source_title = {Proc. USENIX Secur. Symp.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 25}
}

