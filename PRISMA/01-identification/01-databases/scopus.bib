	keywords = {Authentication; Cloud storage; Cryptography; Data privacy; Information management; Cloud-computing; Computing model; Data confidentiality; Data Sharing; Edge clouds; Edge computing; Privacy pre-serving authentication; Secure data; User data; User revocation},
