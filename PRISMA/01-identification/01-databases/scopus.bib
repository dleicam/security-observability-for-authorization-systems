	affiliations = {Al-Farahidi University, Baghdad, Iraq; Kut University College, Department of Business Administration, Al Kut, Iraq; The Islamic University, Najaf, Department of Computers Techniques Engineering, Najaf, Iraq; Al-Kunooze University College, Department of Computer Engineering, Basra, Iraq; University of Mashreq, Baghdad, Iraq; Uruk University, Baghdad, Iraq; Mazaya University College, An Nasiriyah, Iraq},
