	affiliations = {Alma Mater Studiorum Università di Bologna, Department of Computer Science and Engineering, Bologna, Italy; Centre Inria d'Université Côte d'Azur, Sophia Antipolis, France; Syddansk Universitet, Department of Mathematics and Computer Science, Odense, Denmark},
