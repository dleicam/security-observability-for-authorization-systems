@CONFERENCE{Fan2023275,
	author = {Fan, Zijun and Yuan, Chaoying and Si, Xuan and Yuan, Shumei},
	title = {Enhancing Security in Cloud Computing: A Comprehensive Analysis of a Zero-Trust Dynamic Access Control Architecture with Integrated Multifactor Authentication},
	year = {2023},
	pages = {275 - 285},
	doi = {10.1109/INSAI60116.2023.00057},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105007415579&doi=10.1109%2FINSAI60116.2023.00057&partnerID=40&md5=c95452dc9709495144838898722fa3b3},
	affiliations = {China Telecom Corporation Limited, Beijing, China},
	abstract = {Cloud computing technology offers the convenience of accessing cloud resources through mobile devices, yet the security and manageability for numerous users and devices pose significant challenges. Traditional one-time identity authentication methods fall short in preventing unauthorized access stemming from compromised credentials. To address this, we introduce a dynamic access control framework based on the zero-trust model, facilitating secure and regulated resource access without the constraints of network perimeters. This paper presents an adaptive dynamic trust evaluation approach that analyzes diverse metrics, including device security status, service feedback, and user activity, to derive mutual trust scores between users and cloud service providers. These scores serve as pivotal factors in access control decisions, employing a backpropagation neural network to forecast future trust values, enabling the dynamic adjustment of trust levels and access permissions. Our simulation results confirm the effectiveness of this architecture in dynamically modulating trust assessments and access rights in line with trust degrees. This model surpasses traditional trust models by incorporating a penalty system for past user misbehavior, taking into account various trust determinants like terminal security and service feedback, thus offering a balanced trust evaluation that reduces reliance on historical user interactions and proactively adjusts trust levels for early intervention. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Cloud security; Trust-based access control architecture; Zero-trust},
	keywords = {Access control models; Authorization; Access control architecture; Cloud securities; Cloud-computing; Dynamic access control; Trust evaluation; Trust level; Trust models; Trust-based access control; Trust-based access control architecture; Zero-trust; Authentication},
