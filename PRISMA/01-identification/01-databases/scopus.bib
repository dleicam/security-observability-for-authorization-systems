	title = {Reinforcing privacy in cloud computing via adaptively secure non-zero inner product encryption and anonymous identity-based revocation in unbounded setting},
	year = {2024},
	journal = {Theoretical Computer Science},
	volume = {995},
	pages = {},
	doi = {10.1016/j.tcs.2024.114502},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85188047153&doi=10.1016%2Fj.tcs.2024.114502&partnerID=40&md5=38ccc5608e174b1558edb4a6b3d53ca4},
	affiliations = {Indian Institute of Technology Kharagpur, Kharagpur, India; Karlsruher Institut für Technologie, Karlsruhe, Germany},
	abstract = {Cloud computing serves as an advanced computing technology to support Internet services and has numerous applications, including medical fields, online data storage, social network, big data analysis, and e-learning platforms. Inner product encryption (IPE) is a promising cryptographic primitive that facilitates access control over outsourced encrypted data by restricting decryption capability via an inner product relation. Most of the existing IPEs are built assuming a priori bound on the length of attribute vectors associated with the plane data. A situation may occur when adding new attributes is essential due to upgradation. Thus it is desirable to construct IPE with variable length attribute vectors instead of fixing the length at the setup phase. Such IPEs are more flexible while encrypting data and consequently have more real-life applications. In the following, we make our contributions: – We design the first efficient adaptively payload-hiding secure unbounded non-zero IPE (UNIPE) scheme from the standard symmetric external Diffie-Hellman (SXDH) assumption and prove security in the standard model. – We propose a generic construction of an adaptively weak attribute-hiding UNIPE from an unbounded inner product functional encryption (UIPFE) scheme. We also instantiate UNIPE from the SXDH assumption and prove security in the standard model. – Finally, we present the first unbounded anonymous identity-based revocation (UAnon-IBRV) scheme using our generic UNIPE as the building block. The anonymity feature ensures that the ciphertext reveals no information about the revoking sets of the system. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Attribute-hiding; Inner product encryption; Payload-hiding; Unbounded},
	keywords = {Access control; Cloud storage; Social sciences computing; Attribute vectors; Attribute-hiding; Cloud-computing; Encryption schemes; Identity-based; Inner product; Inner product encryption; Payload-hiding; Symmetrics; Unbounded; Cryptography},
	correspondence_address = {S. Dutta; Department of Mathematics, Indian Institute of Technology Kharagpur, Kharagpur, West Bengal, India; email: subhranildutta@iitkgp.ac.in},
	publisher = {Elsevier B.V.},
	issn = {03043975},
	coden = {TCSCD},
	language = {English},
	abbrev_source_title = {Theor Comput Sci},
	type = {Article},
	publication_stage = {Final},
