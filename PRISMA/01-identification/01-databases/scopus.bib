	pages = {3223 - 3239},
	doi = {10.1093/comjnl/bxab190},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85156156538&doi=10.1093%2Fcomjnl%2Fbxab190&partnerID=40&md5=cb7e6b293861fb1dcc587e58d12f182a},
	affiliations = {Hamad Bin Khalifa University, College of Science and Engineering, Doha, Qatar; KINDI Center For Computing Research, College of Engineering, Qatar University, Doha, Qatar; Fujian Normal University, College of Mathematics and Informatics, Fuzhou, China; Hangzhou Normal University, Department of Mathematics, Hangzhou, China; Westone Cryptologic Research Center, Beijing, China},
	abstract = {Provable Data Possession (PDP) is of crucial importance in public cloud storage since it allows users to check the integrity of their outsourced data without downloading it. However, the existing PDP schemes, which are based on classical number-theoretic assumptions, are insecure under quantum attacks. In this paper, we propose the first PDP scheme from standard lattices, using a specific leveled fully homomorphic signature (FHS) scheme. To remove the complex key management of PDP cryptosystem on the public key infrastructure (PKI) setting, we employ a specific leveled identity-based (ID-based) FHS scheme to construct the first ID-based PDP scheme from standard lattices. Our two PDP schemes are secure under the standard small integer solution (SIS) assumption, which is conjectured to withstand quantum attacks. Furthermore, we conduct experimental evaluations to validate the feasibility of the proposed PDP schemes in practice. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {cloud storage; leveled fully homomorphic signature; Provable data possession; quantum attacks; small integer solution},
	keywords = {Public key cryptography; Quantum cryptography; Cloud storages; Cloud-computing; Identity-based; Integer solutions; Leveled fully homomorphic signature; Provable data possessions; Public clouds; Quantum attack; Signature Scheme; Small integer solution; Cloud storage},
	correspondence_address = {F. Luo; College of Science and Engineering, Hamad Bin Khalifa University, Doha, Qatar; email: lfucai@126.com},
