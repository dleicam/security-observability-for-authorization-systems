@ARTICLE{Hu20211647,
	author = {Hu, Shengzhou and Li, Jiguo and Lu, Yang and Zhang, Yichen},
	title = {Constant ciphertext size multi-authority attribute-based scheme without key escrow},
	year = {2021},
	journal = {Journal of Internet Technology},
	volume = {21},
	number = {6},
	pages = {1647 - 1657},
	doi = {10.3966/160792642020112106007},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85099332786&doi=10.3966%2F160792642020112106007&partnerID=40&md5=c170f2ed93e8372b224c8e7d13e4b483},
	affiliations = {Hohai University, College of Computer and Information, Nanjing, China; Fujian Normal University, College of Mathematics and Informatics, Fuzhou, China; State Key Laboratory of Cryptology, Beijing, China; GanNan Normal University, Department of Mathematics and Computer Science, Ganzhou, China; Nanjing Normal University, School of Computer Science and Technology, Nanjing, China},
	abstract = {With the development of cloud computing application, attribute based encryption (ABE) with flexibly fine-grained data access control is adopted widely. However, the honest but curious authorities often peep at the user data. How to eliminate the key escrow is also an important and challenging problem in ABE schemes. In this paper, a constant ciphertext size multi-authority ciphertext-policy ABE scheme (RKE-MA-ABE) which resists key escrow is presented. In the proposed scheme, a user credential issuer (UCI) is introduced to generate a credential for each user credibly. UCI decentralizes the managing privilege of attribute authorities (AAs) and helps to embed the user’s secret value into the decryption key issued by the corresponding AAs . Additionally, AAs in this scheme work independently without interacting with each other to generate the master public key of the system during the system initialization phase. Our scheme avoids the collusion attacks by vicious users or authorities and has constant ciphertext length. It is proven CPA-secure under the decisional q-Bilinear Diffie-Hellman Exponent (q-BDHE) assumption in random oracle model. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {Attribute-based encryption; Constant ciphertext size; Key escrow; Multi-authority},
	keywords = {Access control; Attribute authority; Attribute-based encryptions; Ciphertext policies; Collusion attack; Constant ciphertext lengths; Data access control; Multi authorities; Random Oracle model; Cryptography},
	correspondence_address = {J. Li; College of Computer and Information, Hohai University, China; email: ljg1688@163.com},
	publisher = {Taiwan Academic Network Management Committee},
	issn = {16079264; 20794029},
	language = {English},
	abbrev_source_title = {J. Internet Technol.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

