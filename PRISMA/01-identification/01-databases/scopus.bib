	isbn = {9798350395914},
	language = {English},
	abbrev_source_title = {Int. Conf. Electr., Comput., Energy Technol., ICECET},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Shi20249866,
	author = {Shi, Caiqun and Huang, Qinlong and Jian, Rui and Chi, Genghui},
	title = {Cross-Domain Inner-Product Access Control Encryption for Secure EMR Flow in Cloud Edge},
	year = {2024},
	journal = {IEEE Transactions on Information Forensics and Security},
	volume = {19},
	pages = {9866 - 9880},
	doi = {10.1109/TIFS.2024.3482724},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85207375672&doi=10.1109%2FTIFS.2024.3482724&partnerID=40&md5=a1a24a7d9155c69a5f332c4c3ab2420d},
	affiliations = {Beijing University of Posts and Telecommunications, School of Cyberspace Security, Beijing, China},
	abstract = {The quality of medical services is improved by sharing electronic medical records (EMRs) across multiple medical institutions via cloud edge. However, EMRs contain private information about patients, and cloud servers are untrustworthy, thus they cannot be shared arbitrarily among senders and receivers. Access control encryption (ACE) is a preferred technique that produces encrypted EMRs and then restricts the capabilities of both senders and receivers to enforce the EMR flow via sanitizers. However, existing cross-domain ACE schemes employ a single sender authority to issue encryption keys for senders, which suffers from single point of failure and encryption key escrow that the sender authority can public EMRs arbitrarily. Moreover, they only support coarse-grained access structures such as AND gates, which is not suitable for flexible EMR sharing among medical institutions. To this end, we propose a cross-domain inner-product ACE (CD-IPACE) scheme that features decentralized encryption key generation and fine-grained access structures. Specifically, we construct CD-IPACE from inner-product encryption, threshold structure-preserving signature instantiated with a distributed key generation protocol, and non-interactive zero-knowledge proof, which prevents individual sender authorities from sending ciphertexts, and also protects both data and receiver privacy. Then, we design a secure EMR flow system in cloud edge named ESFlow based on CD-IPACE, which employs edge nodes as sanitizers to check encrypted EMRs and discard illegal ones. Finally, we demonstrate the security and practicality of ESFlow via formal security analysis and extensive experiments. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Access control encryption; cloud edge; decentralized; electronic medical records; privacy protection},
	keywords = {Access control; Cloud platforms; Quality of service; Access control encryption; Cloud edge; Cross-domain; Decentralised; Electronic medical record; Encryption key; Inner product; Medical institutions; Medical record; Privacy protection; Electronic health record},
	correspondence_address = {Q. Huang; Beijing University of Posts and Telecommunications, School of Cyberspace Security, National Engineering Research Center of Disaster Backup and Recovery, Beijing, 100876, China; email: longsec@bupt.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {15566013},
	language = {English},
	abbrev_source_title = {IEEE Trans. Inf. Forensics Secur.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

@ARTICLE{Teli2024,
	author = {Teli, Manvendra S. and Jhawat, Vikas Chander and Sharma, Anil Kumar},
