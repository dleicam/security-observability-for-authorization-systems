	year = {2023},
	pages = {923 - 928},
	doi = {10.1109/ICAICCIT60255.2023.10465919},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85189885903&doi=10.1109%2FICAICCIT60255.2023.10465919&partnerID=40&md5=88bd5baafd33c097c9c6c16635ad937b},
	affiliations = {Maharishi University of Information Technology, Maharishi School of Engineering & Technology, Lucknow, India; Presidency University Bangalore, Department of Electronics and Communication Engineering, Bengaluru, India; JAIN (Deemed-to-be University), Department of Computer Science and Engineering, Bengaluru, India},
	abstract = {The Cloud Compute Adoption Architecture (CCAF), a unique architecture designed to improve safety of the business cloud installations, is introduced in this research article. Using router, authentication and authorization, and encryption methods embedded in Industrial File Sync/Share systems, CCAF aims to provide a multi-layered privacy strategy. Our paper describes the creation of this security A system, examines relevant literature, and explains the reasoning behind CCAF. Through testing and thorough analysis of the key technologies, the study assesses the effectiveness of the CCAF security layered approach. The intricate security system in place at CCAF proved to be an outstanding tool during penetration testing, detecting and eliminating 99.95% of worms including trojans, and even deactivating over 85% of them after 100 hours of continuous attack. Of particular note was the operating system's lightning-fast reaction time of less than 0.012 seconds per trojan and virus, which allowed for the early detection and mitigation of threats. Moreover, each try at SQL injection was successfully thwarted by the CCAF's extensive security defenses, guaranteeing strong security of data. The article highlights the usefulness of CCAF by exploring how its multi-layered security is seamlessly integrated into current regulations, services, and corporate processes. The research highlights how important CCAF's complex security is for Big Data applications running in the cloud, especially when it comes to scalability, speed, and veracity. The study's conclusions highlight CCAF's legitimacy and significant contributions to the field, demonstrating its applicability and effectiveness in protecting the cloud. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Cloud Compute Adoption Framework (CCAF); encryption; Enterprise File Sync; firewall; identity management; multilayered security approach; penetration testing and SQL injection assessment; security technologies; Share solutions},
	keywords = {Authentication; Authorization; Cloud computing architecture; Computer system firewalls; Computer viruses; Embedded systems; Security systems; Viruses; Adoption framework; Cloud compute adoption framework; Enterprise file sync; Firewall; Identity management; Multi-layered; Multilayered security approach; Penetration testing; Penetration testing and SQL injection assessment; Security approach; Security technology; Share solution; SQL injection; Cryptography},
