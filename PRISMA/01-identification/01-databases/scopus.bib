@CONFERENCE{Sri Dhananjayan2024,
	author = {Sri Dhananjayan, K. and Maheswaran, M. and Kayalvizhi, P. and Lakshmanan, P. and Pushpalatha, N. and Senthooriya, O. S.},
	title = {Development of a Telematic Control Unit for Capturing Vital Vehicle Data without Using Company Fitted Telematic Ports},
	year = {2024},
	pages = {},
	doi = {10.1109/ICSTEM61137.2024.10561194},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85197914302&doi=10.1109%2FICSTEM61137.2024.10561194&partnerID=40&md5=edf29bc89f817038fa17133210250583},
	affiliations = {Sri Eshwar College of Engineering, Department of Electrical and Electronic Engineering, Coimbatore, India; Nehru Institute of Engineering and Technology, Department of Mechanical Engineering, Coimbatore, India; M.Kumarasamy College of Engineering, Department of Computer Science and Engineering, Karur, India; Narasaraopeta Engineering College, Department of Electrical and Electronic Engineering, Narasaraopet, India},
	abstract = {Many companies use vehicle telemetry data to learn more about driver behaviour, fleet performance, and maintenance requirements. But occasionally, a vehicle might not have a telemetry data port, or the port might not be available because of restrictions put in place by the vehicleowner. The task at hand involves creating a Telematic Control Unit (TCU) that is capable of gathering crucial vehicle information without depending on the telemetry data port installed by the corporation. For fleet management purposes, the TCU should offer a dependable and strong means of gathering data from the car's numerous sensors and systems, guaranteeing real-time tracking and analysis capabilities.The solution elements involves the, Data Capture: Creating a TCU that can communicate with the sensors and systems of the vehicle in order to gather essential data, speed, fuel consumption, engine performance, payload, and diagnostic data.It should be possible for the TCU to reliably and accurately retrieve data from any vehicle, regardless of the brand or model. Wireless Communication: Set up a wireless communication system to transfer the TCU's collected data to a cloud platform or central server. A strong and secure wireless protocol that guarantees data integrity and secrecy should be supported by the solution. Real-time Monitoring and Analysis: Provide fleet managers with the ability to monitor and analyze vehicle data in real-time by creating an intuitive dashboard or interface.In order to help businesses make wise decisions and maximize their operations, the dashboard should offer information into vehicle performance, payload, fuel efficiency, driver behaviour, and maintenance requirements. Integration and Compatibility: Make sure the TCU solution is easily linked with third-party applications that are often used in the business or with the fleet management systems that are currently in place. APIs or other integration features should be included in the solution to facilitate smooth data interchange and interoperability. Privacy and Security: Put in place robust security measures to prevent unwanted access or manipulation of the collected data. Encryption, authentication, and access control techniques are just a few of the industry best practices for data security and privacy that the solution should follow. By taking care of these issues, the suggested TCU solution ought to let companies get hold of and utilize important vehicle data without depending on the telemetry data port that is installed by the organization. Fleet managers will be better equipped to maximize fleet performance, lower maintenance costs, improve fuel efficiency, and guarantee regulatory compliance as a result. It can also non-invasively retrieve data from a telemetry port fitted by the company without opening the port.And also we have implemented a health monitoring system to take care of the drivers health condition and to avoid the vehicle from mishap. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {fleet management; fleet performance; fuel efficiency; maintenance; noninvasive retrieval; real-time monitoring; regulatory compliance; Vehicle telemetry data; wireless communication},
	keywords = {Authentication; Cryptography; Efficiency; Fleet operations; Information management; Maintenance; Real time systems; Regulatory compliance; Telemetering equipment; Vehicle performance; Control unit; Fleet management; Fleet performance; Fuel efficiency; Noninvasive retrieval; Real time monitoring; Telematics; Telemetry data; Vehicle telemetry data; Wireless communications},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
