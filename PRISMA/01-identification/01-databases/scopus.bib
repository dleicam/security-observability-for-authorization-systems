	keywords = {Authentication; Cloud storage; Digital forensics; Digital image storage; Image retrieval; Military applications; Network security; Remote sensing; Satellite imagery; Security systems; Cloud-based; Deep hashing; Geological applications; Remote sensing images; Remote sensing imaging; Satellite imaging; Security frameworks; Storage and retrievals; Surveillance applications; Zero-knowledge proofs; Quantum cryptography},
