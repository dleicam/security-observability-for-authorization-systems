}

@CONFERENCE{Kumar2022,
	author = {Kumar, G. Sathish and Ramesh Babu, A.},
	title = {An improved attribute based encryption model with linked hashing technique for cloud data security},
	year = {2022},
	pages = {},
	doi = {10.1109/ICCCNT54827.2022.9984331},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85146325318&doi=10.1109%2FICCCNT54827.2022.9984331&partnerID=40&md5=4fa2d8b4194e9fe751c0e6313e063a78},
	affiliations = {Chaitanya Deemed to be University, Department of Computer Science, Himayatnagar, India},
	abstract = {Two of the characteristics of the Attribute-Based Encryption (ABE) system that is effective for delivering data security are one-to-many encryption and fine-grained access control. By utilising cloud technology, businesses may concentrate on their core competencies rather than dealing with labor-intensive data administration duties. Despite all of the advantages of cloud computing, security and privacy issues still exist. This study presents an introduction to ABE concepts, research challenges, and applications to resource discovery and data security in cloud computing systems. Flexible access control to encrypted data may be effectively controlled with attribute-based encryption (ABE). Modern apps increasingly employ ABE as a method of data security. However, privacy considerations are not taken into account by the current ABE systems when creating keys. This study examines how ABE may be used to protect sensitive user data, especially in cloud computing settings. The purpose of this study is to improve the suitability of Attribute Based Encryption with Linked Hashing Model (ABE-LHM) for cloud storage security. The research focuses on giving encryption complete control over access rights and making it feasible to manage keys even in the case of many independent authorities when it comes to user protection. This study suggests that the conventional method for maintaining data's privacy is to encrypt it before uploading. The proposed model is compared with the traditional model and the results show that the proposed model is better in providing security. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Attribute Based Encryption; Encryption; Key Distribution; Key Generation; Linked Hashing},
	keywords = {Cloud security; Cloud storage; Cryptography; Sensitive data; Attribute-based encryptions; Cloud technologies; Cloud-computing; Core competencies; Encryption system; Fine grained; Hashing techniques; Key distribution; Key generation; Linked hashing; Access control},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9781665452625},
	language = {English},
	abbrev_source_title = {Int. Conf. Comput. Commun. Netw. Technol., ICCCNT},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

