	note = {Cited by: 4}
}

@ARTICLE{Vu2024497,
	author = {Vu, Thi Huong Giang and Trinh, Tuan Dat and Tran, Trung Hieu},
	title = {Authorization Model for Microservice-Based ERP Software},
	year = {2024},
	journal = {Lecture Notes in Networks and Systems},
	volume = {1077 LNNS},
	pages = {497 - 506},
	doi = {10.1007/978-981-97-5504-2_59},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85203601347&doi=10.1007%2F978-981-97-5504-2_59&partnerID=40&md5=ce43df936198e674a7a02b8679a90841},
	affiliations = {Hanoi University of Science and Technology, Hanoi, Viet Nam; VNIST, Hanoi, Viet Nam},
	abstract = {Enterprise Resource Planning (ERP) and Enterprise Application Integration (EAI) play pivotal roles in enhancing organizational efficiency. ERP serves as a comprehensive software solution, integrating various business processes, while EAI focuses on connecting diverse applications. The adoption of microservices architecture in ERP and EAI introduces challenges in authorization mechanisms. (i) Existing ERP applications often lack granular authorization for microservices, posing security risks. (ii) End-user authorization requires mechanisms for group-based role authorization and individualized permissions. (iii) Microservices authorization must consider access environment requirements. (iv) The authorization model must be flexible, accommodating organizational changes seamlessly. This paper introduces an innovative authorization model that combines policy-based and role-based authorization. The model provides static role-based authorization for end-user interfaces and dynamic policy-based authorization for both end-user interfaces and microservices. The paper outlines the model, emphasizes its adaptability to organizational changes, and suggests implementing the authorization process in the enterprise following the Plan-Do-Check-Act (PDCA) cycle. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {ABAC; Authorization; Enterprise information systems; Microservices; PBAC; RBAC; Web application security},
	keywords = {Authorization; Common object request broker architecture (CORBA); Enterprise resource management; Enterprise resource planning; Information use; Resource allocation; Resource valuation; ABAC; Authorization model; Enterprise applications integration; Enterprise information system; Enterprise resources planning; Microservice; PBAC; Planning applications; RBAC; Web application security; Application programs},
	correspondence_address = {T.-D. Trinh; Hanoi University of Science and Technology, Hanoi, Viet Nam; email: dattt@soict.hust.edu.vn},
	editor = {Nguyen, T.D.L. and Dawson, M. and Ngoc, L.A. and Lam, K.Y.},
