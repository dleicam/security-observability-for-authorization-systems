	author = {Yang, Jinjiang and Xue, Kaiping and Liu, Feng and Zhu, Bin and Li, Ruidong and Sun, Qibin and Lu, Jun},
	title = {SSE-CTC: Search Over Encrypted Data With Owner-Enforced and Complete Time Constraints},
	year = {2025},
	journal = {IEEE Transactions on Dependable and Secure Computing},
	volume = {22},
	number = {3},
	pages = {1895 - 1907},
	doi = {10.1109/TDSC.2024.3472461},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85205821596&doi=10.1109%2FTDSC.2024.3472461&partnerID=40&md5=10c9335522605671af1ab4dbf2805fdd},
	affiliations = {University of Science and Technology of China, School of Cyber Science and Technology, Hefei, China; Jiaxing University, Jiaxing, China; Kanazawa University, College of Science and Engineering, Kanazawa, Japan},
	abstract = {Searchable symmetric encryption (SSE) is a technique that enables secure outsourcing of data to an untrusted cloud server without sacrificing search functionality. Recently, multi-user SSE schemes for data sharing, which support access control from various users, have gained attention. However, the access control mechanisms in existing schemes are not adequate for realistic data-sharing scenarios as they do not consider time constraints or only partially address them, making these mechanisms unsuitable for SSE schemes. To address this issue, we first highlight the importance of time constraints in multi-user SSE and propose a completely time-constrained SSE scheme under a two-server model. By taking advantage of the Lagrange interpolation and pre-computation, our proposed scheme enables searching over time-related encrypted data with owner-enforced time constraints. Additionally, we employ the blinding technique with the assistance of a semi-honest time server to ensure the completeness of time constraints, which is not guaranteed in existing works. Based on the leakage function, we prove the security of our proposed scheme in the simulation-based security model. Furthermore, extensive experiments demonstrate the practicality of our scheme in supporting time-constrained functions. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Cloud security; searchable symmetric encryption; time constraints; two-server model},
	keywords = {Information leakage; Cloud securities; Data Sharing; Encrypted data; Multiusers; Searchable symmetric encryption; Server modeling; Symmetric encryption; Symmetric encryption schemes; Time constraints; Two-server model; Cloud security},
	correspondence_address = {K. Xue; University of Science and Technology of China, School of Cyber Science and Technology, Hefei, Anhui, 230027, China; email: kpxue@ustc.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {15455971},
	language = {English},
	abbrev_source_title = {IEEE Trans. Dependable Secure Comput.},
