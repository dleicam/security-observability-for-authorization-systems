	doi = {10.1093/comjnl/bxy122},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85064177339&doi=10.1093%2Fcomjnl%2Fbxy122&partnerID=40&md5=b314cbaf90f92973342d749b51d0e7ad},
	affiliations = {Sejong University, Department of Computer and Information Security, Seoul, South Korea; Korea University, Center for Information Security Technologies (CIST), Seoul, South Korea; Sangmyung University, Department of Computer Science, Jongno-gu, South Korea; Columbia University, New York, United States},
	abstract = {Self-updatable encryption (SUE) is a new kind of public-key encryption, motivated by cloud computing, which enables anyone (i.e. cloud server with no access to private keys) to update a past ciphertext to a future ciphertext by using a public key. The main applications of SUE are revocable-storage attribute-based encryption (RS-ABE) that provides an efficient and secure access control to encrypted data stored in cloud storage. In this setting, there is a new threat such that a revoked user still can access past ciphertexts given to him by a storage server. RS-ABE solves this problem by combining user revocation and ciphertext updating functionalities. We propose the first SUE and RS-ABE schemes secure against a relevant form of chosen-ciphertext security (CCA). Due to the fact that some ciphertexts are easily derived from others, we employ a different notion of CCA that avoids easy challenge related messages. Specifically, we define "time extended challenge" CCA security for SUE which excludes ciphertexts that are easily derived from the challenge (over time periods) from being queried on. We then propose an efficient SUE scheme with such CCA security, and we also present an RS-ABE scheme with this CCA security. © 2019 Elsevier B.V., All rights reserved.},
	author_keywords = {Chosen-ciphertext security; Cloud storage; Public-key encryption; Self-updatable encryption},
	keywords = {Access control; Cloud computing; Digital storage; Attribute-based encryptions; CCA securities; Chosen ciphertext security; Cloud storages; Encrypted data; Public-key encryption; Storage servers; User revocation; Public key cryptography},
