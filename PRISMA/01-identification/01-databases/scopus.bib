	author = {Vijayasanthi, Maineni and Gugulothu, Narsimha},
	title = {Design and Integration of a Level-based Access Control and Selective Auditing Framework for Cloud Services},
	year = {2025},
	journal = {International Journal of Intelligent Engineering and Systems},
	volume = {18},
	number = {7},
	pages = {454 - 472},
	doi = {10.22266/ijies2025.0831.30},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013990307&doi=10.22266%2Fijies2025.0831.30&partnerID=40&md5=10cdb240be959a753812b857d71bc3a9},
	affiliations = {Jawaharlal Nehru Technological University Hyderabad, Hyderabad, India; Jawaharlal Nehru Technological University, Sultanpur, India},
	abstract = {The shift towards using cloud services has heightened the security necessities — in addition to many of the prior concerns such as better access control and audit capabilities. The current generation of access control is very static, and one dimension leads to over-privileged or too tight. To protect against this threat, we propose in this study a novel framework that uses Level Based Access Control (LBAC) mechanisms to improve audit selectivity among cloud environments such as secure data access and tighter resource monitoring. The framework is divided into three components: (1) the specification and instantiation of LBAC for cloud services, (2) a Localized Auditing Method targeted to fitting audit granularity at runtime based on user role assignments and service object sensitivity, and (3) Integration & verification mechanisms to thoroughly test interoperability across disparate classes of cloud services. The experimental evaluation results show that the proposed selective auditing framework with LBAC is able to reinforce security, generate an optimal assignment of audit resources, and allow secure enforcement of compliance mandates while minimally affecting routine cloud service operations. This study sheds light on access control with auditing-based strategy to secure, scalable and efficient cloud service management. Though future directions will include opportunities to extend this framework for cross-cloud auditing and also employ advanced analytics for real-time threat detection/response. The proposed LBAC and Selective Auditing framework outperforms existing works with an access control accuracy of 95.2% and anomaly detection accuracy of 92.9%, significantly higher than prior models (max ~88%). It reduces audit processing time to 250ms and lowers false positive rates to 4.2%, improving both security and resource efficiency. Additionally, it achieves the highest data sensitivity adaptability of 90.4%, ensuring focused auditing on critical data compared to traditional exhaustive auditing methods. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Cloud security; Data compliance; Framework integration; Level-based access control; Selective auditing},
