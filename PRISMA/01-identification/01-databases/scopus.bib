	keywords = {Application programs; Authentication; Benchmarking; Multivariable control systems; Network security; Software prototyping; Application logic; Authentication bypass; Authorization bypass; Logic attacks; Parameter tampering; Sequence violation; State violation; Web application security; Workflow violation; Computer circuits},
