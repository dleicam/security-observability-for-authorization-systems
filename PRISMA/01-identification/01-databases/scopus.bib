@ARTICLE{Mao20241435,
	author = {Mao, Chenyang and Shen, Zhonghua and Chen, Kefei and Liu, Yong and Meng, Qian and Wang, Fuqun},
	title = {DCIRM: Dynamic and Controllable Image Retrieval Scheme in Multi-Owner Multi-User Settings},
	year = {2024},
	journal = {IEEE Transactions on Services Computing},
	volume = {17},
	number = {4},
	pages = {1435 - 1448},
	doi = {10.1109/TSC.2024.3356650},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85183985827&doi=10.1109%2FTSC.2024.3356650&partnerID=40&md5=c8c50e3e90387dfd128050fe22a96725},
	affiliations = {Hangzhou Normal University, School of Information Science and Technology, Hangzhou, China; Hangzhou Normal University, School of Mathematics, Hangzhou, China},
	abstract = {The proliferation of cloud computing technology has led to a significant number of users opting to store image data on the cloud. To ensure the confidentiality of image data, it is recommended to apply encryption techniques prior to uploading them to cloud servers. However, the traditional encrypted image retrieval schemes prove inadequate for practical application scenarios due to limitations in supporting multi-owner and multi-user settings, inefficient access control, and a lack of dynamic verifiability. To address the challenges presented by practical application scenarios, in this paper, we propose a Dynamic and Controllable Image Retrieval scheme in the Multi-owner multi-user settings (DCIRM). First of all, we realize the usability in multi-owner and multi-user scenarios through re-encryption settings. Then, we realize the verifiability of dynamic data by applying the dynamic authentication constructed by the chameleon hash function. Finally, we realize lightweight access control through the polynomial-based access strategy. The DCIRM scheme has been demonstrated to be privacy-preserving, efficient, and feasible through rigorous security analysis and experimentation with authentic datasets. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Dynamic verifiable; encrypted image retrieval; multi-owner multi-user settings; polynomial-based access strategy},
	keywords = {Access control; Cloud computing; Feature extraction; Image processing; Image retrieval; Privacy-preserving techniques; Dynamic verifiable; Encrypted image retrieval; Encrypted images; Features extraction; Image data; Index; Multi-owner multi-user setting; Multiusers; Polynomial-based access strategy; User setting; Hash functions},
	correspondence_address = {Y. Liu; Hangzhou Normal University, School of Information Science and Technology, Hangzhou, 311121, China; email: yongliu@hznu.edu.cn; Q. Meng; Hangzhou Normal University, School of Mathematics, Hangzhou, 311121, China; email: mq@hznu.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {19391374},
	language = {English},
	abbrev_source_title = {IEEE Trans. Serv. Comput.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
