@CONFERENCE{Pei2022563,
	author = {Pei, Bei and Zhou, Xianbin and Jiang, Rui},
	title = {Lattice-Based Fine-grained Data Access Control and Sharing Scheme in Fog and Cloud Computing Environments for the 6G Systems},
	year = {2022},
	pages = {563 - 570},
	doi = {10.1109/MSN57253.2022.00094},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85152283074&doi=10.1109%2FMSN57253.2022.00094&partnerID=40&md5=ff722ed96224913aa2b22421e1200bd5},
	affiliations = {Ministry of Public Security of the People's Republic of China, Beijing, China; Southeast University, School of Cyber Science and Engineering, Nanjing, China},
	abstract = {The 6G (the sixth generation mobile communication) network is a heterogeneous network, which includes the cloud computing and the fog computing environment. And, the data securities in the 6G Systems may face great challenges. On the one hand, fine-grained data access control in fog and cloud computing environments is essential to the 6G network. On the other hand, quantum computing attacks may cause great security threats for the 6G network. In order to solve the above problems, we propose a lattice-based fine-grained data access control and sharing scheme in fog and cloud computing environments (LB-DACSS) for the 6G network. Firstly, our LB-DACSS scheme can achieve secure data sharing and fine-grained access control in fog and cloud computing environments. Secondly, we apply a lattice encryption algorithm to ensure our LB-DACSS scheme can withstand quantum computing attacks. Thirdly, our LB-DACSS scheme can achieve secure attribute revocation. Fourthly, we bind a unique secret value related to the user's attribute to construct the user's secret key. Finally, both formal security analysis and performance analysis show that our LB-DACSS scheme is efficient and secure. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Attribute Revocation; Fine-grained Access Control; Fog and Cloud Computing Environments; Lattice-Based Encryption; Quantum computing attacks; Ring-Learning with Errors},
	keywords = {5G mobile communication systems; Access control; Cryptography; Fog; Heterogeneous networks; Network security; Queueing networks; Security systems; Attribute revocation; Cloud computing environments; Fine grained; Fine-grained access control; Fog and cloud computing environment; Lattice-based; Lattice-based encryption; Learning with Errors; Quantum Computing; Quantum computing attack; Ring-learning with error; Fog computing},
