	title = {Key-Escrow Free Attribute-Based Multi-Keyword Search with Dynamic Policy Update in Cloud Computing},
	year = {2020},
	pages = {450 - 458},
	doi = {10.1109/CCGrid49817.2020.00-48},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85089072715&doi=10.1109%2FCCGrid49817.2020.00-48&partnerID=40&md5=3fb572e1337a16602dfa19081e6c3fe1},
	affiliations = {National Institute of Technology, Warangal, Warangal, India; Institute for Development and Research in Banking Technology India, Hyderabad, India},
	abstract = {Attribute-based searchable encryption (ABSE) schemes provide searchability and fine-grained access control over encrypted data in the cloud. Although prior ABSE schemes are designed to provide data protection and retrieval efficiency, they are suffering from the following issues. 1) A key-escrow problem, which may lead to the misuse of the user's secret key. 2) A single keyword search, which may produce irrelevant search results and also vulnerable in real-world applications. 3) A static policy update mechanism, which incurs high computation and communication overheads. In this paper, we propose a novel ABSE scheme called a key-escrow free attribute-based multi-keyword search with dynamic policy updates in cloud computing (KAMS-PU) to addresses all the above-stated issues. The security analysis proves that KAMS-PU is secure against malicious authority attacks and chosen keyword attack (CKA) in the random oracle model. Furthermore, performance analysis proves that KAMS-PU is efficient and practical in real-world applications. © 2021 Elsevier B.V., All rights reserved.},
