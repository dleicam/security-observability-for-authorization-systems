	keywords = {Antennas; Cloud computing; Cryptography; Digital storage; Trees (mathematics); Unmanned aerial vehicles (UAV); Vehicle to vehicle communications; Cloud service providers; Communication techniques; Computing performance; Performance analysis; Privacy and security; Privacy preserving; Privacy protection; Security requirements; Data privacy},
