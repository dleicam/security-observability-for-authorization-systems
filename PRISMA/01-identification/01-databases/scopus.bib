	doi = {10.18488/76.v11i4.4017},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216431282&doi=10.18488%2F76.v11i4.4017&partnerID=40&md5=e2b66d71cd33552192a21b907a377ed6},
