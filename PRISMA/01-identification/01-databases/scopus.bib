@ARTICLE{Sharma2024641,
	author = {Sharma, Arvind K. and Habib, Gousia and Wadhawan, Savita and Soni, Himani},
	title = {Interactive Learning for Patient Care: Blockchain Ingrained Electronic Health Record Management System with Patient Control, Data Quality and Security Assurance},
	year = {2024},
	journal = {Lecture Notes in Networks and Systems},
	volume = {896},
	pages = {641 - 657},
	doi = {10.1007/978-981-99-9811-1_51},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85188728716&doi=10.1007%2F978-981-99-9811-1_51&partnerID=40&md5=918d6113851db120ef1cea700013ddfe},
	affiliations = {Shoolini University, Computers and Data Science, Solan, India; Indian Institute of Technology Delhi, New Delhi, India; Maharishi Markandeshwar (Deemed to be University), Mullana, M.M. Institute of Computer Technology & Business Management, Ambala, India; Maharishi Markandeshwar (Deemed to be University), Mullana, Department of Neurosurgery, Ambala, India},
	abstract = {Objective: With the advent of healthcare specific multi-sensory applications and mobile-computing, a huge amount of data is being produced and accumulated periodically. This data not only requires accuracy but also the necessity to maintain its authenticity, security and access control. However the well-established cryptographic algorithms are capable enough to manage the security aspect, but somehow lacking to preserve the authenticity alone with digital-signatures and hash functions. The aforementioned problems concerning healthcare data have been gaining attention for years, and now the emerging blockchain technology is contributing to cope up with such situations by providing ingenious solutions. Another problem on healthcare data is related to access control which also requires astute solutions too, as this data belongs to patients and a patient should be the only entity who can decide, to what extent?, to whom?, this private information to be disclosed with privacy preservation. Now, in this paper a blockchain and cloud-based conceptual design for personal health record management system with patient control is proposed, in order to conquer existing problems in the healthcare industry on patient’s medical records. The computational intensiveness will be managed with machine learning strategies. Method: To articulate a patient centric design for secure preservation and efficient access of electronic health records, blockchain technology along with cloud platform incorporated in this design. In order to maintain the quality of records advent machine learning classification technique namely tranformers also used. Result: The design of electronic health records management system is proposed in this work, following with prototype building with Azure cloud platform. Conclusion: The work elucidated the prime limitations of electronic health records management schemes, and proposed a design which will help against hindrances for efficient, cost-effective, easy-to-use, secure and less intensive solution. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Authentication; Authorization; Blockchain; Cloud Computing; Confidentiality; Consensus; Electronic Health Records (EHR); Electronic Medical Records (EMR); Hash Function; Integrity; Interoperability; Machine Learning (ML); Miner; Privacy; Proof of Stake (PoS); Proof of Work (PoW); Public Key Pair (KPR,KPU); Secret Key (K); Security; Smart-Contracts},
	keywords = {Authentication; Authorization; Blockchain; Cloud computing; Cost effectiveness; Electronic document identification systems; Hash functions; Health care; Information management; Machine learning; Medical computing; Network security; Quality control; Radio frequency identification (RFID); Records management; Block-chain; Cloud-computing; Confidentiality; Consensus; Electronic health; Electronic health record; Electronic medical record; Health records; Integrity; Key pairs; Machine-learning; Medical record; Privacy; Proof of stake; Proof of work; Public key pair (KPR,KPU); Public keys; Secret key; Secret key (K); Security; Smart contract},
