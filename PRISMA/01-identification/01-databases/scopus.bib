	language = {English},
	abbrev_source_title = {Proc. - IEEE Int. Conf. Cryptogr., Informatics, Cybersecur.: Cryptogr. Cybersecur.: Roles, Prospect., Challenges, ICoCICs},
	type = {Conference paper},
	publication_stage = {Final},
