	author = {Sakapertana, Akbar Sahata and Faldi, Wan Muhafidz and Mahardika, Andi K. and Shiddiqi, Ary Mazharuddin},
	title = {Advancing Data Privacy in REST APIs: A Comparative Study of Machine Learning Techniques for PII Detection},
	year = {2025},
	pages = {},
	doi = {10.1109/SIML65326.2025.11081062},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105012769787&doi=10.1109%2FSIML65326.2025.11081062&partnerID=40&md5=b61983e789b6880c6b305d787196d120},
	affiliations = {Institut Teknologi Sepuluh Nopember, Department of Informatics, Surabaya, Indonesia},
	abstract = {The increasing use of REST APIs for data exchange has heightened the risk of exposing Personally Identifiable Information (PII), necessitating the development of automated detection systems to ensure software quality and compliance with regulatory standards. Global privacy regulations, including the GDPR and Indonesia's UU PDP, require organizations to effectively safeguard PII across various data formats, particularly unstructured data typically transmitted through APIs. Conventional approaches, such as rule-based detection, are inadequate for addressing the dynamic and semi-structured nature of API responses. This paper presents the application of machine learning techniques, specifically Support Vector Machines (SVM) and Naive Bayes classifiers, for detecting PII in REST API responses. The SVM model achieved an accuracy of 80.96%, a precision of 90.11%, a recall of 80.96%, and an F1-score of 84.37%, surpassing the performance of the Naive Bayes model. The results highlight the potential benefits of incorporating machine learning-based PII detection systems into the software development lifecycle to enhance API security, software quality, and compliance with privacy regulations. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {data privacy; machine learning; PII detection; REST API; software quality},
	keywords = {Application programming interfaces (API); Barium compounds; Classifiers; Data quality; Electronic data interchange; Learning algorithms; Learning systems; Regulatory compliance; Software design; Software quality; Support vector machines; Comparatives studies; Information detection; Machine learning techniques; Machine-learning; Personally identifiable information; Personally identifiable information detection; Privacy regulation; REST API; Software compliance; Software Quality; Data privacy},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
