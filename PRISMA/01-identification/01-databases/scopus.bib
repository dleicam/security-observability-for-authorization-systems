	affiliations = {University of the Cumberlands, Department of IT, Williamsburg, United States; Governors State University, Department of Computer Science, University Park, United States; K L Deemed to be University, Vaddeswaram, India},
	abstract = {The widespread use of cloud computing in healthcare systems has resulted in numerous advantages, such as increased scalability, cost efficiency, and access to medical data. The sensitive nature of healthcare data, on the other hand, poses significant challenges to its security and privacy in the cloud environment. In this study, an Advanced Integrated Data Security (AIDS) approach for cloud-based healthcare systems aims to address the vulnerabilities caused by data breaches and unauthorized access. The proposed AIDS is the data security framework that employs several security mechanisms to improve the overall security of healthcare data stored and processed in the cloud. It combines complementary techniques such as encryption, access control, anomaly detection, and intrusion prevention to create a comprehensive security infrastructure. Encryption algorithms transform healthcare data into an unreadable format that can only be accessed with appropriate decryption keys, ensuring the confidentiality and integrity of the data. An advanced role-based access control system is developed to manage user permissions and prevent unauthorized access to sensitive information. Anomaly detection techniques also detect abnormal patterns and behaviors in the cloud environment. Potential security breaches can be seen in real-time by continuously monitoring system logs and network traffic, allowing for prompt response and mitigation measures. Intrusion prevention systems actively prevent and block unauthorized access attempts, network attacks, and malicious activities to improve overall security. These systems analyze incoming and outgoing traffic using various detection algorithms to identify and thwart potential threats. The ensemble data security strategy capitalizes on the synergistic effects of combining multiple security mechanisms. The framework improves the resilience of cloud-based healthcare systems against data breaches and cyber threats by integrating encryption, access control, anomaly detection, and intrusion prevention. This work lays the groundwork for future research and development on data security in cloud-based healthcare systems. The proposed ensemble approach provides a robust and comprehensive solution for protecting sensitive healthcare data while enabling secure and trusted cloud-based healthcare services. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Access Control; Anomaly Detection; Cloud Computing; Data Security; Encryption; Ensemble Approach; Healthcare Systems; Intrusion Prevention},
	keywords = {Access control; Anomaly detection; Cloud security; Cybersecurity; Health care; Information management; Intrusion detection; Sensitive data; Cloud environments; Cloud-based; Cloud-computing; Ensemble approaches; Healthcare systems; Integrated data; Intrusion prevention; Security mechanism; Unauthorized access; Cryptography},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9798350300888},
	language = {English},
	abbrev_source_title = {Proc. Int. Conf. Smart Electron. Commun., ICOSEC},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 15}
}

@CONFERENCE{Nirmala2023607,
	author = {Nirmala, E. and Suresh, M. and Maragatharajan, M.},
	title = {Deployment of Robust Security Scheme in SDN Based 5G Network to Detect DDoS Attack},
	year = {2023},
	pages = {607 - 615},
	doi = {10.1109/ICOSEC58147.2023.10275898},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85175693116&doi=10.1109%2FICOSEC58147.2023.10275898&partnerID=40&md5=a2d076e2ba704aa550d98df6fa59c47c},
	affiliations = {VIT Bhopal University, School of Computing Science and Engineering, Sehore, India},
	abstract = {In the fifth generation of computing, the Cloud Architecture needs rigid security on to its virtualized network by representing the physical units in terms of logical Connections. Network Virtualization in 5G should also provide enhanced security to cloud data against the threat raise by the third party. In the existing schemes, the security mechanisms like detection and prevention of security have been implemented successfully to augment the security. But in 5G networking, when the mobile users are concerned, two features are additionally added to check for the security with the existing feature like Preliminary Authorization, that is validating, before entering into the network. As soon as the task is implemented, handover mechanism is used. In our proposed system the process of preliminary approval and handover is going reduce the latency in the virtualized network mode by Virtualized Handover with Authorization technique (VHAT). In this VHAT scheme the Tree Based Switch Analysis Algorithm (VN-TBSAA) is constructed to check for the packets sent by the sender to the receiver. Moreover, in our proposed TBSAA algorithm takes the flow table of content as input and detects the Distribution of Denial of Service (DDoS) attack is detected, by preventing through redirecting methodology. The overloading happens in case of multiple packets arrival to the same destination point to overcome with this problem in proposed system a methodology called VN-TBSAA is used to reduce attack raised on flow table, to devise it with overloaded entry. this could be avoided via identifying the attacker by assigning the packets to beneath load entry in the flow table. This is going to be implemented by Artificial Neural Network with personal fuzzy identification like biometric or iris. The added advantage of the proposed system is improving the security and reduced time by dropping the fault packets send by them. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Accuracy; Average time taken; Face Identification; Open CV; Scale Invariant Feature Transform},
	keywords = {5G mobile communication systems; Cloud computing architecture; Network security; Queueing networks; Trees (mathematics); Accuracy; Average time taken; Denialof- service attacks; Face identification; Flow tables; Hand over; Invariant feature transforms; Open CV; Scale invariant feature transform; Scale invariant features; Denial-of-service attack},
