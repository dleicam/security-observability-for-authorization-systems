@ARTICLE{Majumdar2023229,
	author = {Majumdar, Suryadipta},
	title = {Multi-level Security Investigation for Clouds},
	year = {2023},
	pages = {229 - 262},
	doi = {10.1142/9789811273209_0007},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85177537066&doi=10.1142%2F9789811273209_0007&partnerID=40&md5=076d4860f2556ad6d0f730921c001011},
	affiliations = {Concordia University, Montreal, Canada},
	abstract = {Cloud security has become one of the biggest challenges in cybersecurity. With the growing rate of cyber threats, it is now essential to enable security investigation capability for cloud technologies which can provide detailed analysis of security breaches. However, due to the unique nature of clouds, including multi-tenancy, dynamicity, elasticity, large scale, etc., offering such an investigation capability becomes non-trivial. Moreover, there are multiple abstraction levels in cloud design which render additional challenges in this process. The most existing solutions in cloud security mainly provide security solutions for a specific cloud level, none of them provide a comprehensive solution that can protect a cloud tenant against the threats rendered from those multiple levels; which is mainly due to the operational complexity and unique nature of each level of cloud (e.g., authentication and access control models in the user level versus virtual machine (VM) migration rules in the virtual level) in a cloud. Furthermore, a simple integration of those existing tools will not be sufficient as all of them suffer from different practical issues. For instance, most of the existing solutions suffer from slow response time and require significant manual efforts from the cloud tenants. In this chapter, we address all those challenges and present an efficient security investigation system for compliance breaches in clouds. We integrate this system with OpenStack, a popular cloud management platform and outline a concrete guideline to adapt our framework to other major cloud platforms, Google GCP, Amazon EC2, and Microsoft Azure. Our experiments using both synthetic and real data show the practicality and effectiveness of this solution. © 2023 Elsevier B.V., All rights reserved.},
	correspondence_address = {S. Majumdar; Concordia University, Montréal, H3G 1M81455 de Maisonneuve Blvd. West, S-EV 007.640, H3G 1M8, Canada; email: suryadipta.majumdar@concordia.ca},
	publisher = {World Scientific Publishing Co.},
	isbn = {9789811273209; 9789811273193},
	language = {English},
	abbrev_source_title = {Innovations in Digital Forensics},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

