	year = {2023},
	pages = {299 - 307},
	doi = {10.1109/IPDPSW59300.2023.00058},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85169297699&doi=10.1109%2FIPDPSW59300.2023.00058&partnerID=40&md5=322cd6076a706ce62472547887e4c6d0},
	affiliations = {Sirindhorn International Institute of Technology Thammasat University, School of ICT, Khlong Luang, Thailand},
	abstract = {Existing access control schemes that support fine-grained and secure data sharing for mobile cloud computing system typically focus on the design and development of secure and lightweight cryptographic protocols to enable data users efficiently decrypt the data by using mobile devices. However, some business requirements such as industrial cloud users may require the proof of authenticity of the data owner. Accordingly, both privacy-preserving and strong authenticity that data users can verify the authenticity of data owners to make trust the shared data are essential. To this end, we proposed a secure and efficient access control featured with efficient revocation in mobile cloud computing environment. Our proposed scheme is based on the outsourced dual proxy model where the expensive digital signing, encryption and decryption are partially offloaded to be executed by the delegated proxies in the cloud. We employed the symmetric encryption and the ciphertext policy attribute-based encryption (CP-ABE) as a core encryption scheme. In addition, we introduced a user revocation algorithm to enable the efficient user revocation in the mobile cloud computing. For the evaluation, we run the experiments to measure the performance of our core access control algorithms and the results demonstrated that our proposed scheme is efficient. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {access control; cloud; cp-abe; data sharing; digital signing; mobile cloud computing; symmetric encryption},
	keywords = {Authentication; Privacy-preserving techniques; Access control schemes; Computing system; Cp-abe; Data Sharing; Data users; Digital signing; Fine grained; Secure data; Symmetric encryption; User revocation; Mobile cloud computing},
