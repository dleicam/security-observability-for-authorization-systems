@ARTICLE{Deng202042805,
	author = {Deng, Ningzhi and Deng, Shaojiang and Hu, Chunqiang and Lei, Kaiwen},
	title = {An Efficient Revocable Attribute-Based Signcryption Scheme with Outsourced Unsigncryption in Cloud Computing},
	year = {2020},
	journal = {IEEE Access},
	volume = {8},
	pages = {42805 - 42815},
	doi = {10.1109/ACCESS.2019.2963233},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85082019625&doi=10.1109%2FACCESS.2019.2963233&partnerID=40&md5=90b3cb699f5b57ec78cd5d107cd09bf9},
	affiliations = {Chongqing University, School of Computer Science, Chongqing, China; Chongqing University, School of Big Data and Software Engineering, Chongqing, China},
	abstract = {In this paper, we present an efficient revocable signcryption (CP-ABSC) with outsourced unsigncryption scheme based on ciphertext-policy attribute based encryption (CP-ABE) to secure the data sharing in cloud computing that require access control, data encryption, and authentication to ensure message integrity and confidentiality. It can be used to signcrypt a message based on the access rights specified by the message itself. A user can decrypt a ciphertext if and only if it possesses the attributes required by the access structure of the data. Thus CP-ABSC felxible encrypts data based on the access rights of the data specified by the data itself, which differs significantly from the traditional encryption where the user can decrypt is predetermined and must be known by the data source. In addition, the proposed scheme handles attributes revocation with high efficiency and demands low computation overhead on users' device during unsigncryption phase. Our scheme provides collusion attack resistance, message authentication, forgery prevention, and confidentiality. Furthermore, we compare the performance of our scheme with others in terms of the ciphertext, key size, computation cost and functionality. © 2020 Elsevier B.V., All rights reserved.},
	author_keywords = {Attribute-based encryption; attributes revocation; ciphertext-policy; outsourced decryption},
