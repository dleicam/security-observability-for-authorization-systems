	note = {Cited by: 0}
}

@ARTICLE{Zhang2024,
	author = {Zhang, Yuncan and Liang, Weifa and Xu, Wenzheng and Xu, Zichuan and Jia, Xiaohua},
	title = {Cost Minimization of Digital Twin Placements in Mobile Edge Computing},
	year = {2024},
	journal = {ACM Transactions on Sensor Networks},
	volume = {20},
	number = {3},
	pages = {},
	doi = {10.1145/3658449},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85194055804&doi=10.1145%2F3658449&partnerID=40&md5=49e9a67d6c3a780b9574475103696aba},
	affiliations = {City University of Hong Kong, Hong Kong, Hong Kong; Sichuan University, Computer Science College, Chengdu, China; Dalian University of Technology, School of Software, Dalian, China},
	abstract = {In the past decades, explosive numbers of Internet of Things (IoT) devices (objects) have been connected to the Internet, which enable users to access, control, and monitor their surrounding phenomenons at anytime and anywhere. To provide seamless interactions between the cyber world and the real world, Digital twins (DTs) of objects (IoT devices) are key enablers for real time monitoring, behaviour simulations, and predictive decisions on objects. Compared to centralized cloud computing, mobile edge computing (MEC) has been envisioning as a promising paradigm for low latency IoT applications. Accelerating the usage of DTs in MEC networks will bring unprecedented benefits to diverse services, through the co-evolution between physical objects and their virtual DTs, and DT-assisted service provisioning has attracted increasing attention recently.In this article, we consider novel DT placement and migration problems in an MEC network with the mobility assumption of objects and users, by jointly considering the freshness of DT data and the service cost of users requesting for DT data. To this end, we first propose an algorithm for the DT placement problem with the aim to minimize the sum of the DT update cost of objects and the total service cost of users requesting for DT data, through efficient DT placements and resource allocation to process user requests. We then devise an approximation algorithm with a provable approximation ratio for a special case of the DT placement problem when each user requests the DT data of only one object. Meanwhile, considering the mobility of users and objects, we devise an online, two-layer scheduling algorithm for DT migrations to further reduce the total service cost of users within a given finite time horizon. We finally evaluate the performance of the proposed algorithms through experimental simulations. The simulation results show that the proposed algorithms are promising. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Cost modeling of digital twin placement; Digital twin placement and migration; Digital twin service cost minimization; Digital twin synchronization; Mobile Edge Computing},
	keywords = {Access control; Approximation algorithms; Digital devices; Internet of things; Scheduling algorithms; Control and monitor; Cost minimization; Cost modeling of digital twin placement; Cost models; Digital twin placement and migration; Digital twin service cost minimization; Digital twin synchronization; Placement problems; Real-world; Service costs; Mobile edge computing},
	publisher = {Association for Computing Machinery},
	issn = {15504859},
	language = {English},
	abbrev_source_title = {ACM Trans. Sens. Netw.},
