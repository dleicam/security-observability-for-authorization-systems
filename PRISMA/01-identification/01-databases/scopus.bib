@ARTICLE{Qiao202417975,
	author = {Qiao, Hongyi and Peng, Cong and Feng, Qi and Luo, Min and He, Debiao},
	title = {Ciphertext Range Query Scheme Against Agent Transfer and Permission Extension Attacks for Cloud Computing},
	year = {2024},
	journal = {IEEE Internet of Things Journal},
	volume = {11},
	number = {10},
	pages = {17975 - 17988},
	doi = {10.1109/JIOT.2024.3360141},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85184330530&doi=10.1109%2FJIOT.2024.3360141&partnerID=40&md5=339dd00df796c4a4c38b97420926bdad},
	affiliations = {Wuhan University, School of Cyber Science and Engineering, Wuhan, China; ShenZhen Institute of Information Technology, Shenzhen, China; Matrix Elements Technologies, Shanghai, China; Qilu University of Technology, Key Laboratory of Computing Power Network and Information Security, Jinan, China},
	abstract = {Range query is commonly used to support ciphertext retrieval on encrypted databases in a cloud-based environment, and order-revealing encryption (ORE) plays an increasingly important role in range query for ciphertext field processing. Specifically, one can utilize ORE to facilitate comparators to determine whether the order of ciphertext(s) corresponds to the associated plaintext(s). Newer ORE designs include those that are resistant to common attacks (e.g., spectral attacks) and those that are capable of supporting both multiclient and single-client settings. However, in the scenario of cross-database range queries, existing multiclient ORE approaches generally pass the data owner's query key to the searcher during the authorization process. Consequently, this results in agent transfer and permission extension, which can be exploited to facilitate unauthorized access to the database data. To solve these limitations, we propose om-ORE. The latter uses the oblivious pseudorandom function (OPRF) protocol to further enhance the security of token generation mechanism in ORE, and is designed to ensure that neither the data owner nor the authorized client reveals any secret key or expected query range to each other. Using the proposed om-ORE scheme as a building block, we design a secure multiclient ciphertext range query scheme that is resilient to both agent transfer and permission extension attacks. The performance evaluation shows that om-ORE inherits the advantages of state-of-the-art multiclient ORE approaches, in terms of ciphertext size and comparison efficiency, as well as having comparable performance in the token generation process. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Agent transfer; oblivious pseudorandom function (OPRF); order-revealing encryption (ORE); permission extension; range query},
	keywords = {Authorization; Internet of things; Network security; Ores; Petroleum reservoir evaluation; Query languages; Query processing; Agent transfer; Ciphertexts; Cloud-computing; Encrypted database; Oblivious pseudorandom functions; Order-revealing encryption; Permission extension; Query schemes; Range query; Security; Cryptography},
	correspondence_address = {C. Peng; Wuhan University, School of Cyber Science and Engineering, Wuhan, 430072, China; email: cpeng@whu.edu.cn; M. Luo; Wuhan University, School of Cyber Science and Engineering, Wuhan, 430072, China; email: mluo@whu.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
