@ARTICLE{Li2022,
	author = {Li, Su and Qin, Chengyi and Xu, Zihui and Zhang, Xinzhe and Liu, Zhien and Wu, Lei},
	title = {Verifiable and Multi-Keyword Searchable Encryption Scheme Based on LSSS},
	year = {2022},
	pages = {},
	doi = {10.1109/ISPCE-ASIA57917.2022.9970993},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85145436724&doi=10.1109%2FISPCE-ASIA57917.2022.9970993&partnerID=40&md5=362333dca9e8243aa1bea6364a98bfcb},
	affiliations = {Shandong Normal University, School of Information Science and Engineering, Jinan, China; Henan Key Laboratory of Network Cryptography Technology, Zhengzhou, China},
	abstract = {Attribute-based Searchable Encryption (ABSE) schemes allow keyword encryption to be outsourced to cloud servers, and users can securely search for keyword ciphertext documents of interest. However, most existing searchable encryption schemes do not encourage the fine-grained search of users, and attributes are exposed to third parties easily. Moreover, ABSE schemes have high computational costs for resource-constrained clients on the user’s client side. To solve the above problems, a verifiable and multi-keyword searchable encryption scheme based on linear secret sharing schemes (LSSS) is presented by us, which enables users to achieve a more efficient and secure fine-grained search of multi-keyword documents. In this scheme, access control is achieved using LSSS technology, and user attribute hiding is accomplished by hash. Furthermore, user authentication and pre-decryption are outsourced to cloud servers without leaking any information, which lessens the client’s computational burden. It is demonstrated that the scheme can resist selective plaintext and selective keyword attacks in security models. In addition, the performance evaluation shows that our scheme performs well in real application scenarios. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {ABSE; LSSS; pre-decryption; user authentication; verifiable and multi-keyword},
	keywords = {Authentication; Cloud computing; Petroleum reservoir evaluation; Attribute-based; Attribute-based searchable encryption; Cloud servers; Encryption schemes; Linear secret sharing schemes; Multi keywords; Pre-decryption; Searchable encryptions; User authentication; Verifiable and multi-keyword; Cryptography},
