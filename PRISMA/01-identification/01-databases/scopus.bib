	title = {Efficient Data Sharing Scheme With Fine-Grained Access Control and Integrity Auditing in Terminal-Edge-Cloud Network},
	year = {2024},
	journal = {IEEE Internet of Things Journal},
	volume = {11},
	number = {16},
	pages = {26944 - 26954},
	doi = {10.1109/JIOT.2024.3393639},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85191801887&doi=10.1109%2FJIOT.2024.3393639&partnerID=40&md5=b9ee09ff489a420c305038fb7a7db6f5},
	affiliations = {Xi'an University of Architecture and Technology, Institute for Interdisciplinary and Innovate Research, Xi'an, China; Xidian University, State Key Laboratory of Integrated Services Networks, Xi'an, China; Changzhi University, Department of Mathematics, Changzhi, China},
	abstract = {In recent years, terminal-edge-cloud framework is very popular since it combines the storage ability of cloud servers with the advantages of timely response of edge nodes. How to realize the secure and fast data transmission from the terminal device to the edge node under the premise of weak computational ability and limited storage space for terminal devices, how to ensure that the original data can be securely obtained by authorized users, and how to efficiently audit the integrity of data in the cloud storage are still challenging issues. Although Zhang et al. designed a data sharing scheme, which is based on blockchain and hybrid encryption model, and simultaneously considers these issues, the security and performance of this scheme can be greatly improved. The reason lies in that the storage of symmetric key on blockchain will result in its potential leakage once one entity among the Chain becomes dishonest. Therefore, this article proposes a new data sharing protocol. In our protocol, lightweight symmetric encryption is first used to securely transmit data between terminal devices and edge nodes. Second, the edge node uses ciphertext-policy attribute-based encryption technology to encrypt the original data collected by the terminal device. Only authorized users who meet the access policy can correctly recover the data, thus ensuring the fine-grained access control. In addition, in the integrity audit process of stored data, authentication based on homomorphic signatures is adopted to achieve efficient auditing based on third-party auditors. Finally, simulation of the entire data sharing system reveals that our proposed protocol is relatively efficient and competitive in future Internet of Things applications. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Attributed-based encryption; cloud storage; edge computing; integrity auditing; privacy preserving},
	keywords = {Blockchain; Edge computing; Internet of things; Network security; Privacy-preserving techniques; Attributed-based encryptions; Cloud storages; Cloud-computing; Data Sharing; Edge nodes; Integrity auditing; Privacy preserving; Smart devices; Terminal devices; Cloud storage},
	correspondence_address = {J. Chang; Xi'an University of Architecture and Technology, School of Information and Control Engineering, Institute for Interdisciplinary and Innovate Research, Xi'an, Shaanxi, 710064, China; email: changjinyong@xauat.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {23274662},
