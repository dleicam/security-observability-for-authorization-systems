	title = {A Hash-based Multidimensional Graph Neural Network Approach for Zero Trust Oriented Access Control Security},
	year = {2023},
	journal = {Proceedings of the International Conference on Parallel and Distributed Systems - ICPADS},
	pages = {2387 - 2394},
	doi = {10.1109/ICPADS60453.2023.00319},
