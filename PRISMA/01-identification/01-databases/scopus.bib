@CONFERENCE{Krishna2024145,
	author = {Krishna, Dondapati Manoj and Pranay, Medasani Veda and Mohiddin, Shaik Khaja},
	title = {Security Measures in Cloud-Driven Home Automation Systems},
	year = {2024},
	pages = {145 - 150},
	doi = {10.1109/ICISC62624.2024.00032},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85206100669&doi=10.1109%2FICISC62624.2024.00032&partnerID=40&md5=28cc4c74960c92dd915b2e035588e8ee},
	affiliations = {K L Deemed to be University, Department of Computer Science and Engineering, Vaddeswaram, India},
	abstract = {Cloud-driven home automation systems are widely used to enable high levels of convenience, efficiency, and connectivity as cloud technology becomes more and more integrated into everyday household operations. Despite these advantages, there is an increasing need to address security issues introduced by smart device interconnectivity and dependence on remote cloud services. Security features in cloud-based home automation systems are essential for guaranteeing the confidentiality, integrity, and dependability of data exchanges and smart device connectivity in residential environment. Strong security protocols and procedures are essential as homes become more networked and dependent on cloud services for automation and remote management. This study addresses the main issues, weak points, and recommended procedures for preventing cyberattacks and unwanted access as it focuses on the complex aspects of security in cloud-driven home automation systems. This study covers a wide range of security topics, including secure communication channels, data encryption, access controls, and authentication methods relevant to the home automation industry. By utilizing the knowledge from industry standards and cybersecurity research, this study looks at ways to mitigate common attack vectors, including malware infections, phishing scams, and unapproved device access. The study also explores the challenges of controlling user consent and privacy in cloud-driven home automation ecosystems, highlighting the significance of open data handling procedures and user-centric privacy controls. This study analyzes the methods employed to minimize data collection and storage, anonymize sensitive information, and provide users with fine-grained control over smart home environment. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Access controls; Cloud-driven home automation systems; Connectivity; Data encryption; Privacy Controls; Security; Security issues},
	keywords = {Access control; Anonymity; Phishing; Cloud services; Cloud-driven home automation system; Connectivity; Data encryption; Home automation; Home automation systems; Privacy control; Security; Security issues; Smart devices; Cloud security},
