	title = {Auditable σ-Time Outsourced Attribute-Based Encryption for Access Control in Cloud Computing},
	year = {2018},
	journal = {IEEE Transactions on Information Forensics and Security},
	volume = {13},
	number = {1},
	pages = {94 - 105},
	doi = {10.1109/TIFS.2017.2738601},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85028971342&doi=10.1109%2FTIFS.2017.2738601&partnerID=40&md5=11a6e6ae1c1a41f015e53b7657f95145},
	affiliations = {National University of Singapore, Department of Computer Science, Singapore City, Singapore; East China Normal University, Shanghai Key Laboratory of Trustworthy Computing, Shanghai, China; Manchester Metropolitan University, Mathematics and Digital Technology, Manchester, United Kingdom; Institute of Information Engineering, Beijing, China; Shanghai Ocean University, College of Information Technology, Shanghai, China},
	abstract = {As a sophisticated mechanism for secure fine-grained access control over encrypted data, ciphertext-policy attribute-based encryption (CP-ABE) is one of the highly promising candidates for cloud computing applications. However, there exist two main long-lasting open problems of CP-ABE that may limit its wide deployment in commercial applications. One is that decryption yields expensive pairing cost which often grows with the increase of access policy size. The other is that one is granted access privilege for unlimited times as long as his attribute set satisfies the access policy of a given ciphertext. Such powerful access rights, which are provided by CP-ABE, may be undesirable in real-world applications (e.g., pay-as-you-use). To address the above drawbacks, in this paper, we propose a new notion called auditable σ-time outsourced CP-ABE, which is believed to be applicable to cloud computing. In our notion, expensive pairing operation incurred by decryption is offloaded to cloud and meanwhile, the correctness of the operation can be audited efficiently. Moreover, the notion provides σ-time fine-grained access control. The cloud service provider may limit a particular set of users to enjoy access privilege for at most σ times within a specified period. As of independent interest, the notion also captures key-leakage resistance. The leakage of a user's decryption key does not help a malicious third party in decrypting the ciphertexts belonging to the user. We design a concrete construction (satisfying our notion) in the key encapsulation mechanism setting based on Rouselakis and Waters (prime order) CP-ABE, and further present security and extensive experimental analysis to highlight the scalability and efficiency of our construction. © 2018 Elsevier B.V., All rights reserved.},
	author_keywords = {access control; auditability; cloud computing; key-leakage resistance; Outsourced attribute-based encryption},
	keywords = {Access control; Cloud computing; Electric resistance; Electric resistance measurement; Network function virtualization; Outsourcing; Public key cryptography; Security of data; Servers; Attribute-based encryptions; auditability; Ciphertext-policy attribute-based encryptions; Cloud service providers; Commercial applications; Key encapsulation mechanisms; Leakage resistance; Sophisticated mechanism; Cryptography},
	correspondence_address = {J. Ning; Department of Computer Science, National University of Singapore, Singapore, 117417, Singapore; email: jtning88@gmail.com},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {15566013},
