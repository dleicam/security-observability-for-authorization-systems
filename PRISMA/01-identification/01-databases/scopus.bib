@ARTICLE{Jastaniah202437012,
	author = {Jastaniah, Khlood and Zhang, Ning and Mustafa, A. Mustafa},
	title = {Efficient Privacy-Friendly and Flexible Wearable Data Processing with User-Centric Access Control},
	year = {2024},
	journal = {IEEE Access},
	volume = {12},
	pages = {37012 - 37029},
	doi = {10.1109/ACCESS.2024.3367000},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85186082904&doi=10.1109%2FACCESS.2024.3367000&partnerID=40&md5=eea3173a470ab4d6525e4d82c7c5b69f},
	affiliations = {The University of Manchester, Department of Computer Science, Manchester, United Kingdom; University of Jeddah, College of Computer Science and Engineering, Jeddah, Saudi Arabia; KU Leuven, Leuven, Belgium},
	abstract = {With the advent of cloud computing and the vast amount of data produced by IoT wearable devices, outsourcing computation has become a widespread practice in providing health services to individuals and society. Conventional approaches typically focus on either secure data processing or fine-grain access control. Nevertheless, only a few existing solutions consider secure fine-grain access control over the encrypted computational results. Notably, these solutions overlook different data access request needs (e.g., needs of data owners and requesters to access data of a single or multiple data owners) and data owners' access control. In addition, they almost exclusively focus on data aggregation operations, neglecting multiplication and division operations on encrypted data, which are fundamental operations with significant importance in various application scenarios. In this paper, we present efficient and privacy-preserving schemes for multiplication and division operations with fine-grain data-sharing and user-centric access control capabilities, called SAMM and SAMD, respectively. We utilise a multi-key Paillier homomorphic cryptosystem to allow privacy-preserving computation of data from both single and multiple data owners. Additionally, we integrate ciphertext-policy attribute-based encryption to enable fine-grain sharing with multiple data requesters based on user-centric access control. Through formal security analysis, we demonstrate that these schemes ensure data confidentiality and authorisation. Moreover, the computational cost and communication overhead of our proposed schemes are thoroughly analysed, and our experimental results indicate that these schemes outperform existing state-of-the-art solutions in terms of efficiency, making them well-suited for use in modern IoT wearable healthcare systems. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {access control; attribute-based encryption; IoT; multi-key homomorphic encryption; Privacy preservation; secure division computation; secure multiplication computation},
	keywords = {Internet of things; Outsourcing; Privacy-preserving techniques; Wearable technology; Attribute-based encryptions; Ho-momorphic encryptions; Homomorphic-encryptions; IoT; Multi-key homomorphic encryption; Privacy preservation; Secure division computation; Secure multiplication computation; Security management; Wearable devices; Access control},
	correspondence_address = {K. Jastaniah; The University of Manchester, Department of Computer Science, Manchester, M13 9PL, United Kingdom; email: khlood.jastaniah@manchester.ac.uk},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {21693536},
	language = {English},
	abbrev_source_title = {IEEE Access},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access}
}

@ARTICLE{T2024803,
