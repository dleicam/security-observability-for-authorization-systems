	author = {Yan, Liang and Ge, Li'na and Wang, Zhe and Zhang, Guifen and Xu, Jingya and Hu, Zheng},
	title = {Access control scheme based on blockchain and attribute-based searchable encryption in cloud environment},
	year = {2023},
