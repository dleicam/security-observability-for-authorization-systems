	title = {Typical Load Identification-Based Calculation for Air-Conditioning Load},
	year = {2023},
	pages = {5056 - 5060},
	doi = {10.1109/EI259745.2023.10512979},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85194189825&doi=10.1109%2FEI259745.2023.10512979&partnerID=40&md5=5c09c6035d13d2079b9836df4e5725d8},
	affiliations = {College of Electrical Engineering, Zhejiang University, Hangzhou, China; Ltd., Hangzhou, China; Zhejiang Hua Yun Information Technology Co., Hangzhou, China; Ltd., Hangzhou, China},
	abstract = {As a primary issue in air conditioning load (ACL) management, the calculation of the power of air conditioning loads aids in quantifying the power consumption characteristics and regulation potential of the ACL, providing a guidance for ACLs to participate in demand response. In this work, a typical load identification-based ACL calculation method is proposed. First, a ridge regression-based temperature sensitivity analysis method of the power load is proposed to extract the load curves that are insensitive to the environmental temperature. Then, a Gaussian mixture model (GMM) is established on these extracted load curves to estimate the probability density distribution at each sampling time. Next, a cloud model-based benchmark load determination method is presented to identify the benchmark load for ACL calculation from the probability density distribution. Finally, the ACL is calculated as the difference between the total load and the benchmark load. The effectiveness of the proposed method is verified using air conditioning load data from a city in Zhejiang province, China, and the results show that the proposed method earns higher accuracy. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {air-conditioning load calculation; benchmark load; cloud model; Gaussian mixture model; ridge regression},
	keywords = {Air conditioning; Air navigation; Cloud computing; Electric power distribution; Gaussian distribution; Regression analysis; Air conditioning load; Air-conditioning load calculation; Benchmark load; Cloud modeling; Gaussian Mixture Model; Load calculation; Load curves; Load identification; Probability density distribution; Ridge regression; Sensitivity analysis},
