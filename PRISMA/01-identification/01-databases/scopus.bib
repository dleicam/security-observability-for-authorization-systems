@ARTICLE{Stubbs2024268,
	author = {Stubbs, Joe F. and Padhy, Smruti and Cardone, Richard and Black, Steve},
	title = {CloudSec: An Extensible Automated Reasoning Framework for Cloud Security Policies},
	year = {2024},
	journal = {Lecture Notes in Networks and Systems},
	volume = {956 LNNS},
	pages = {268 - 279},
	doi = {10.1007/978-3-031-56950-0_23},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85190690673&doi=10.1007%2F978-3-031-56950-0_23&partnerID=40&md5=906f25887e05b3dee838b5fa2c73033b},
	affiliations = {The University of Texas at Austin, Austin, United States},
	abstract = {Users increasingly create, manage and share digital resources, including sensitive data, via cloud platforms and APIs. Platforms encode the rules governing access to these resources, referred to as security policies, using different systems and semantics. As the number of resources and rules grows, the challenge of reasoning about them collectively increases. Formal methods tools, such as Satisfiability Modulo Theories (SMT) libraries, can be used to automate the analysis of security policies, but several challenges, including the highly specialized, technical nature of the libraries as well as their variable performance, prevent their broad adoption in cloud systems. In this paper, we present CloudSec, an extensible framework for reasoning about cloud security policies using SMT. CloudSec provides a high-level API which can be used to encode different types of cloud security policies without knowledge of SMT. Further, it is trivial for applications written with CloudSec to utilize and switch between different SMT libraries. We use CloudSec to analyze security policies in Tapis, a cloud-based API for distributed computational research used by tens of thousands of researchers, and we present a performance case study of using CloudSec with Z3 and cvc5, two popular SMT solvers. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Cloud Security Policy; Extensible Framework; Role Based Access Control; SMT; Tapis},
	keywords = {Access control; Computation theory; Encoding (symbols); Formal methods; Information management; Libraries; Security systems; Sensitive data; Automated reasoning; Cloud securities; Cloud security policy; Digital resources; Extensible framework; Reasoning framework; Role-based Access Control; Satisfiability modulo Theories; Security policy; Tapis; Semantics},
	correspondence_address = {J. Stubbs; Texas Advanced Computing Center, University of Texas at Austin, Texas, United States; email: jstubbs@tacc.utexas.edu},
	editor = {Daimi, K. and Al Sadoon, A.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
