@ARTICLE{Elkana Ebinazer20241,
	author = {Elkana Ebinazer, Silambarasan and Santosh, Shinde Soham},
	title = {Robust Ownership Management for Secure Deduplication in Cloud},
	year = {2024},
	journal = {Lecture Notes in Networks and Systems},
	volume = {817},
	pages = {1 - 11},
	doi = {10.1007/978-981-99-7886-1_1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85192199956&doi=10.1007%2F978-981-99-7886-1_1&partnerID=40&md5=edcf6bd30932166c497e8e8c4a3036ec},
	affiliations = {Indian Institute of Information Technology Kottayam, Kottayam, India},
	abstract = {Cloud storage is the primary service offered by cloud service providers (CSPs) for businesses, hospitals, and other institutions that need to store big volumes of data on a budget. However, CSPs are struggling with the big issue of data security and duplicate data being gathered in cloud storage by data owners. Data deduplication is a technique for getting rid of duplicate copies of data by keeping only one copy of the data with appropriate access controls rather than storing multiple copies of the same data. It decreases connection bandwidth and cloud storage capacity. In a multi-user cloud system, secure deduplication is difficult. This problem is solved by convergent encryption, which features using the hash value of the file as the only key to encrypt its contents. Currently, the difficulty is in controlling the ownership of data owners who join and leave the organization periodically. Due to the Convergent Encryption Key’s static nature, one further issue could arise: unauthorized data owners could attempt to access the data (CEK). Applying CSP-Identity-based Re-Encryption with Access Control Policy (CSP-IBRE-ACP) addresses the aforementioned issues and supports mobile cloud devices with limited resources. In comparison to the current system, the suggested provides strong ownership management on the storage server side. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Cloud computing; Convergent encryption; Identity-based encryption; Ownership management; Secure deduplication},
	keywords = {Access control; Budget control; Cryptography; Bandwidth storage; Cloud service providers; Cloud storages; Cloud-computing; Convergent encryption; Data de duplications; Deduplication; Identity Based Encryption; Ownership managements; Secure deduplication; Cloud storage},
