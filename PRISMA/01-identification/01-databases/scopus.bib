@ARTICLE{Cotter2022195,
	author = {Cotter, Kelley},
	title = {Selling Political Data: How Political Ad Tech Firms’ Discourses Legitimate Microtargeting},
	year = {2022},
	journal = {Lecture Notes in Computer Science},
	volume = {13192 LNCS},
	pages = {195 - 208},
	doi = {10.1007/978-3-030-96957-8_18},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85126221917&doi=10.1007%2F978-3-030-96957-8_18&partnerID=40&md5=72e16a8e25e67fc015819f7a5d09ba5e},
	affiliations = {Pennsylvania State University, University Park, United States},
	abstract = {In spite of mounting concerns about the use of microtargeting in politics and attendant regulatory pressure, spending on digital advertising and ad tech has significantly increased over the past decade. In this article, I explore how political ad tech firms pursue continuity for the high stakes business of political microtargeting. Specifically, I present findings from a discourse analysis of the websites of 34 political ad tech firms who have developed microtargeting tools. Applying van Leeuwen’s framework for legitimation in discourse to this analysis, I find that the firms legitimate microtargeting through four key discourses: Rationalization (“Microtargeting is the Right Approach”), mythopoesis (“Microtargeting is How you Win”), moral evaluation (“Microtargeting is the Democratic Thing to Do”), and Authorization (“Everybody’s Doing It”). I argue that these discourses offer insight for understanding and contextualizing ongoing discussions about the future of microtargeting in politics. © 2022 Elsevier B.V., All rights reserved.},
	author_keywords = {Microtargeting; Political ad tech; Political campaigning; Political communication},
	keywords = {Digital advertizing; Discourse analysis; Microtargeting; Political ad tech; Political campaigning; Political communication; Rationalisation; Regulatory pressure},
	correspondence_address = {K. Cotter; The Pennsylvania State University, University Park, 16802, United States; email: kcotter@psu.edu},
	editor = {Smits, M.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
