}

@ARTICLE{Berraadi2025463,
	author = {Berraadi, Oumayma and Gibet Tani, Hicham and Mohamed, Ben Ahmed},
	title = {Optimizing Efficiency and Security in IoT Data Streaming: A Novel Three-Layer Architecture},
	year = {2025},
	journal = {Lecture Notes in Networks and Systems},
	volume = {1310 LNNS},
	pages = {463 - 474},
	doi = {10.1007/978-3-031-88653-9_46},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105005394284&doi=10.1007%2F978-3-031-88653-9_46&partnerID=40&md5=2d4a7820a9354df7cd4d6368f114adfa},
	affiliations = {Université Abdelmalek Essaadi, Tetouan, Morocco; Université Abdelmalek Essaadi, Tetouan, Morocco},
	abstract = {The Internet of Things (IoT) is a primary source of big data nowadays. However, transferring and processing IoT data directly in the cloud creates issues like increased access time, especially for time-sensitive applications like smart cities, and challenges in secure data transfer. Additionally, the large data volume strains cloud resources, reducing processing efficiency. In this paper, we reviewed the latest scientific papers that proposed a three-layer architecture at the computing level, for improving the efficiency the computing of data in real-time. Then we proposed a new three-layer architecture focusing on the most important levels in terms of reducing access time, and scalability, and improving efficiency with data security during its transfer between layers by dividing it depending on the level of complexity of data. © 2025 Elsevier B.V., All rights reserved.},
