	title = {Attribute-based fine-grained access control for outscored private set intersection computation},
	year = {2020},
	journal = {Information Sciences},
	volume = {536},
	pages = {222 - 243},
	doi = {10.1016/j.ins.2020.05.041},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85085733774&doi=10.1016%2Fj.ins.2020.05.041&partnerID=40&md5=12c0e143f977fe265176483597252aeb},
	affiliations = {Amirkabir University of Technology, Department of Mathematics and Computer Science, Tehran, Iran; Sharif University of Technology, Electronics Research Institute, Tehran, Iran; Fuzhou University, Fuzhou, China; Singapore Management University, School of Information Systems, Singapore City, Singapore},
	abstract = {Private set intersection (PSI) is a fundamental cryptographic protocol which has a wide range of applications. It enables two clients to compute the intersection of their private datasets without revealing non-matching elements. The advent of cloud computing drives the ambition to reduce computation and data management overhead by outsourcing such computations. However, since the cloud is not trustworthy, some cryptographic methods should be applied to maintain the confidentiality of datasets. But, in doing so, data owners may be excluded from access control on their outsourced datasets. Therefore, to control access rights and to interact with authorized users, they have to be online during the protocol. On the other hand, none of the existing cloud-based PSI schemes support fine-grained access control over outsourced datasets. This paper, for the first time, proposes an attribute-based private set intersection (AB-PSI) scheme providing fine-grained access control. AB-PSI allows a data owner to control intersection computations on its outsourced dataset by defining an access control policy. We also provide security definitions for an AB-PSI scheme and prove the security of our scheme in the standard model. We implement our scheme and report performance evaluation results. © 2020 Elsevier B.V., All rights reserved.},
	author_keywords = {Attribute-based encryption; Cloud computing; Fine-grained access control; Private set intersection},
	keywords = {Cryptography; Digital storage; Information management; Outsourcing; Access control policies; Authorized users; Cryptographic methods; Cryptographic protocols; Evaluation results; Matching elements; Security definitions; The standard model; Access control},
	correspondence_address = {M.-R. Sadeghi; Department of Mathematics and Computer Science, Amirkabir University of Technology, Tehran, Iran; email: msadeghi@aut.ac.ir},
	publisher = {Elsevier Inc. usjcs@elsevier.com},
	issn = {00200255},
	coden = {ISIJB},
	language = {English},
	abbrev_source_title = {Inf Sci},
	type = {Article},
