	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85044745720&doi=10.1109%2FTCC.2018.2820714&partnerID=40&md5=c2369d3eeed2dd8bb510829e6099a65f},
	affiliations = {Fuzhou University, Fuzhou, China; Guangxi Key Laboratory of Cryptography and Information Security, Guilin, China; Fuzhou University, Fuzhou, China; Ministry of Education of the People's Republic of China, Beijing, China; Fuzhou University, Fuzhou, China; Minjiang University, Fujian Provincial Key Laboratory of Information Processing and Intelligent Control, Fuzhou, China; Universitetet i Stavanger, Department of Electronic Engineering and Computer Science, Stavanger, Norway},
	abstract = {Secure search over encrypted remote data is crucial in cloud computing to guarantee the data privacy and usability. To prevent unauthorized data usage, fine-grained access control is necessary in multi-user system. However, authorized user may intentionally leak the secret key for financial benefit. Thus, tracing and revoking the malicious user who abuses secret key needs to be solved imminently. In this paper, we propose an escrow free traceable attribute based multiple keywords subset search system with verifiable outsourced decryption (EF-TAMKS-VOD). The key escrow free mechanism could effectively prevent the key generation centre (KGC) from unscrupulously searching and decrypting all encrypted files of users. Also, the decryption process only requires ultra lightweight computation, which is a desirable feature for energy-limited devices. In addition, efficient user revocation is enabled after the malicious user is figured out. Moreover, the proposed system is able to support flexible number of attributes rather than polynomial bounded. Flexible multiple keyword subset search pattern is realized, and the change of the query keywords order does not affect the search result. Security analysis indicates that EF-TAMKS-VOD is provably secure. Efficiency analysis and experimental results show that EF-TAMKS-VOD improves the efficiency and greatly reduces the computation overhead of users' terminals. © 2020 Elsevier B.V., All rights reserved.},
	author_keywords = {Authorized searchable encryption; key escrow free; multiple keywords subset search; traceability; verifiable outsourced decryption},
