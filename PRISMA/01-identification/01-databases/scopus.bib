	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85188104813&doi=10.1109%2FPEEIC59336.2023.10450807&partnerID=40&md5=360e87fb0213bef5d6e83650842e044a},
	affiliations = {JAIN (Deemed-to-be University), Department of Data Analytics and Mathematical Sciences, Bengaluru, India; Maharishi University of Information Technology, Maharishi School of Engineering & Technology, Lucknow, India; Presidency University Bangalore, Department of Electronics and Communication Engineering, Bengaluru, India},
	abstract = {Recently, the development of vehicle computer technology has changed the conventional idea of a car from a simple means of transportation to an intelligent, safe smart vehicle. Additionally, cloud computing has been effortlessly incorporated into the Intelligent Transportation System, also known as ITS, features, which include traffic accident avoidance and live traffic information providing. ITS services have grown to include effective traffic management, accident avoidance, and convenience services in the context of Vehicular Cloud Computing (VCC). Be that as it may, the ongoing arrangement of vehicle benefits for the most part centers on utilizing information from in-vehicle sensors and misses the mark with regards to collaborating with outside foundation. Moreover, the utilization of Bluetooth networks in VCC settings makes security gambles with that could uncover private data held in vehicle sensors, including the personality of the driver and installment data during exchanges. We present the Virtual Computing Center Service-oriented Privacy Framework (VCC-SSF) to settle these limitations and security issues present in VCC-based administrations. As well as ensuring the smooth conveyance of viable and easy to use VCC administrations, this total engineering puts security first. New elements are incorporated, for example, precautionary mishap the executives benefits and further developed installment organization. The VCC-SSF additionally has solid security components that incorporate confirmation, validation, access control, encryption, honesty, secrecy affirmation, and protection assurances for both client private data and in-vehicle information. © 2024 Elsevier B.V., All rights reserved.},
