@ARTICLE{Badirova202361660,
	author = {Badirova, Aytaj and Dabbaghi, Shirin and Fatemi Moghaddam, Faraz Fatemi and Wieder, Philipp and Yahyapour, Ramin},
	title = {A Survey on Identity and Access Management for Cross-Domain Dynamic Users: Issues, Solutions, and Challenges},
	year = {2023},
	journal = {IEEE Access},
