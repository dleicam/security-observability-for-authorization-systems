	author = {de Nies, Tom and Versteden, Aad and Pauwels, Erika and Delaure, Johan},
	title = {Combining Public and Private Linked Data through Graph-based Authorization Profiles in the semantic.works Framework},
	year = {2023},
	journal = {CEUR Workshop Proceedings},
