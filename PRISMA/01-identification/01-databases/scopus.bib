@ARTICLE{Bouchaala2021,
	author = {Bouchaala, Mariem and Ghazel, Cherif and Saïdane, Leila Azouz},
	title = {TRAK-CPABE: A novel Traceable, Revocable and Accountable Ciphertext-Policy Attribute-Based Encryption scheme in cloud computing},
	year = {2021},
	journal = {Journal of Information Security and Applications},
	volume = {61},
	pages = {},
	doi = {10.1016/j.jisa.2021.102914},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85108961218&doi=10.1016%2Fj.jisa.2021.102914&partnerID=40&md5=2f9f3444317578c5922b925826099ac9},
	affiliations = {Ecole Nationale des Sciences de l'Informatique, CRISTAL Laboratory, Manouba, Tunisia},
	abstract = {Ciphertext Policy Attribute Based Encryption (CPABE) offers fine-grained access control in Cloud Computing environment. It is considered as the most promising one-to-many encryption mechanism. However, a Cloud user can delegate decryption privileges to unauthorized users for profits. The key abuse issue is not the only limit with this model for the reason that when the malicious user has been caught, it cannot be revoked. To address these problems, we propose a Traceable, Revocable, Accountable and Key-escrow free CPABE scheme (TRAK-CPABE). This solution supports white-box traceability and direct revocation. The main idea of this work is to divide the original data after publishing in cloud server. In the case of user revocation, one single slice is affected. Data owner needs to retrieve, re-encrypt and re-publish it. In addition, shared keys will be traced and conflict scenario will be resolved. More, the traceability of TRAK-CPABE depends on the l-Strong Diffie–Hellman (l-SDH) and Indistinguishability under chosen-plaintext attack (IND-CPA. The security of the proposed scheme is proved formally by using the Scyther tool. Furthermore, the experimental results show the efficiency of the proposed solution. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {Access control; Accountable; Ciphertext Policy Attribute Based Encryption; Cloud computing; Revocable; Traceable},
	keywords = {Access control; Cloud computing; Chosen-plaintext attack; Ciphertext-policy attribute-based encryptions; Cloud computing environments; Indistinguishability; Key escrow free; Scyther tools; Unauthorized users; User revocation; Cryptography},
	correspondence_address = {M. Bouchaala; CRISTAL Laboratory, ENSI, University of Manouba, Tunisia; email: bouchaala.mariem@gmail.com},
	publisher = {Elsevier Ltd},
	issn = {22142134; 22142126},
	language = {English},
	abbrev_source_title = {J. Inf. Secur. Appl.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 23}
}

