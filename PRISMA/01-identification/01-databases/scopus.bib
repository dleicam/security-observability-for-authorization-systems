@CONFERENCE{Shao2018642,
	author = {Shao, Jiaye and Zhu, Yanqin and Ji, Qijin},
	title = {Secure online/offline multi-authority attribute-based encryption for resource-constrained devices in cloud computing},
	year = {2018},
	pages = {642 - 649},
	doi = {10.1109/SmartWorld.2018.00129},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85060278630&doi=10.1109%2FSmartWorld.2018.00129&partnerID=40&md5=6a2db40fb282150df9694f6ad52f0259},
	affiliations = {Soochow University, School of Computer Science and Technology, Suzhou, China},
	abstract = {Multi-authority attribute-based encryption (MA-ABE) is regarded as a promising cryptographic technique to handle the problem of access control for data sharing, because it provides the fine-grained access control over encrypted data. However, most of the existing MA-ABE schemes suffer from the disadvantages of expensive computational cost and weak security. In this paper, we present a novel secure online/offline multi-authority attribute-based encryption scheme for resource-constrained devices in cloud computing. The proposed scheme reduces the online computation burden for data owners by completing the preprocessing computation as much as possible during the offline phase. The proposed scheme eliminates a major of computation overhead on the user side by migrating the partial decryption computation to the cloud servers. In order to guarantee data security, a Chameleon hash function is utilized to generate an immediate ciphertext embedded in the offline ciphertext. The proposed scheme is proven secure against adaptively chosen-ciphertext attacks. The extensive analytical comparisons and experimental results indicate that the proposed scheme is efficient and very suitable for resource-constrained devices. © 2019 Elsevier B.V., All rights reserved.},
	author_keywords = {Access Control; Chosen-Ciphertext Security; Cloud Computing; Multi-Authority Attribute-Based Encryption; Resource-Constrained Devices},
	keywords = {Access control; Big data; Cloud computing; Hash functions; Smart city; Trusted computing; Attribute-based encryption schemes; Attribute-based encryptions; Chosen ciphertext attack; Chosen ciphertext security; Computation overheads; Cryptographic techniques; Online computation burden; Resourceconstrained devices; Ubiquitous computing},
