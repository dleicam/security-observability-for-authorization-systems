@CONFERENCE{Prasad2023,
	author = {Prasad, Mahaveer and Gupta, Sanchit and Kaur, Sarvjeet},
	title = {Characterizing and Classifying Android Malware: A High-Level Feature Approach},
	year = {2023},
	pages = {},
	doi = {10.1109/iQ-CCHESS56596.2023.10391357},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85184803727&doi=10.1109%2FiQ-CCHESS56596.2023.10391357&partnerID=40&md5=32ff849d619cb54211c72225c93edd3b},
	affiliations = {DRDO Scientific Analysis Group, New Delhi, India},
	abstract = {We present a novel framework for characterizing and classifying Android malware based on high-level abstract features. Our research highlights the limitations of traditional approaches that directly rely on low-level implementation units such as Android API calls, permissions, system properties, and intents to classify malware into different categories. To address these constraints, we introduce a method for malware classification that leverages high-level attributes rooted in the MITRE ATT&CK (Adversarial Tactics, Techniques, and Common Knowledge) framework. This strategy offers a more generalized portrayal of malware behavior, reducing reliance on particular implementation technologies, while also establishing a uniform terminology for articulating malware conduct. In our study, we developed a classification scheme for Android malware based on the techniques defined in the mobile ATT&CK framework. We accomplished this in two steps: first, we mapped various mobile ATT&CK techniques to low-level implementation units, such as Android API calls, permissions, system properties, and intents. Second, we characterized seven families of Android malware using ATT&CK techniques and used them to classify these malware families. Our focus was on 33 ATT&CK techniques out of the 70 currently present in the mobile ATT&CK framework, and we created a mapping for each of these techniques in terms of implementation units. By using only ATT&CK techniques as features for classification, we significantly reduced the number of features used by our classifier compared to current classifiers that use hundreds of low-level features. Our model not only improve overall classification results, but also allows for modification of the low-level mapping without the need to retrain the classifier. Through the correlation of ATT&CK techniques with low-level implementation components, we managed to notably decrease the count of features employed by the classifier, all the while attaining an accuracy exceeding 97%. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {API calls; dynamic analysis; intents; MITRE ATT&CK; permissions; static analysis; system properties},
	keywords = {Android (operating system); Android malware; Classification (of information); Mapping; Mobile security; API calls; Common knowledge; Dynamics analysis; Intent; Knowledge frameworks; Malwares; MITRE adversarial tactic, technique, and common knowledge; Permission; System property; Static analysis},
	correspondence_address = {M. Prasad; Scientific Analysis Group, Drdo, Delhi, India; email: mahaveer1984@gmail.com},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9798350314946},
	language = {English},
	abbrev_source_title = {iQ-CCHESS - IEEE Int. Conf. Quantum Technol., Commun., Comput., Hardw. Embed. Syst. Secur.},
