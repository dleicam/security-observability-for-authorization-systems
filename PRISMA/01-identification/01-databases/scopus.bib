@CONFERENCE{Gunawan2025,
	author = {Gunawan, Dedi and Awwal, Salsabil Nuuril and Afif, Faishal Nur Haidar},
	title = {Sentiment Analysis of Personal Data Protection and Privacy Law in Indonesia Using Multinomial Naive Bayes Algorithm},
	year = {2025},
	pages = {},
	doi = {10.1109/SIML65326.2025.11080902},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105012750696&doi=10.1109%2FSIML65326.2025.11080902&partnerID=40&md5=c6182eb399478ebd73f73a05184207c8},
	affiliations = {Universitas Muhammadiyah Surakarta, Informatics Engineering Department, Surakarta, Indonesia},
	abstract = {The protection of personal data and individual privacy is critical in today's digital world. Recently, the number of digital privacy violations and personal data breaches in Indonesia has increased significantly. Therefore, through the Personal Data Protection Law (PDP Law) No. 27 of 2022, the Indonesian government encourages all parties, individuals, and industries to actively protect privacy and personal data. However, the understanding and perception of the public regarding this matter are very diverse. Some layers of society believe that personal data and privacy protection are less important, while others think that enforcing personal data protection is crucial to minimize cybercrime. This research aims to analyze public sentiment regarding PDP Law No.27 of 2022 based on comments generated from the X social media. Multinomial Naive Bayes is adopted as the method to analyze public sentiment. The method is prominent in analyzing textual classification and is widely adopted for the classification of categorical text data. The evaluation results of automatic labeling show that the model achieves 74% accuracy with precision, recall, and f1-score values of 86%, 78%, and 82% for negative sentiment, and 44%, 59%, and 50% for positive sentiment, respectively. Meanwhile, the evaluation results from manual labeling show that the model achieves 72% accuracy with precision, recall, and f1-score values of 50%, 2%, and 3% for negative sentiment, respectively, and 72%, 99%, and 84% for positive sentiment. The model is also implemented in a web application that can accept user input and check its sentiment. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {multinomial naive bayes; personal data protection law; privacy protection; sentiment analysis; textual classification},
	keywords = {Barium compounds; Bayesian networks; Classification (of information); Classifiers; Data privacy; Data protection laws; Evaluation results; Indonesia; Multinomial naive bayes; Personal data protection law; Personal data protections; Privacy protection; Public sentiments; Sentiment analysis; Textual classification},
