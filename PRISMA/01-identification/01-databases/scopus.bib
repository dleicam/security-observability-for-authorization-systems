	affiliations = {University of Chinese Academy of Sciences, School of Computer Science and Technology, Beijing, China; University of Sialkot, Department of Information Technology, Sialkot, Pakistan; Maynooth University, Innovation Value Institute, Maynooth, Ireland},
	abstract = {Vehicles are taking a significant step towards connected transportation with advanced applications and robust security frameworks. Despite growth in networking potential in the automotive industry, security and privacy vulnerabilities continue to plague the industry. Internet of Vehicles, one of the subsets of cyber-physical systems, can utilize smart sensors to collect and synthesize data from connected vehicles. This technological development facilitates seamless information exchange between drivers, manufacturers, insurers, and service providers. For effective IoV systems, optimizing spectrum usage, allocating quality channels judiciously, and using infrastructure efficiently to maintain connectivity under changing traffic conditions are essential. However, security and privacy remain the main concerns of these communication networks. With the advent of blockchain technology, the world of cryptocurrency transactions can benefit from a secure communication framework that can alleviate these concerns. We propose integrating blockchain technology into IoV infrastructure to facilitate safe, reliable, and trust-enhancing communication between vehicles. We utilize a distributed access control system to ensure scalable and strategic decision-making processes. Our results and evaluation show that using distributed storage across cloud platforms helps enhance data security, enabling vehicles to exchange information safely. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Blockchain; Internet of vehicles; Privacy Preserving; Security},
	keywords = {Access control; Automotive industry; Decision making; Digital storage; Embedded systems; Information dissemination; Internet of things; Network security; Privacy-preserving techniques; Vehicle to vehicle communications; Vehicles; Advanced applications; Application security; Block-chain; Chain links; Internet of vehicle; Privacy preserving; Robust security; Security; Security and privacy; Security scheme; Blockchain},
