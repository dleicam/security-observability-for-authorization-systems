	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85063189771&doi=10.1109%2FACCESS.2018.2890565&partnerID=40&md5=668335a1967152d2cda918abcb6b38fc},
	affiliations = {Beijing University of Posts and Telecommunications, State Key Laboratory of Networking and Switching Technology, Beijing, China},
	abstract = {Attribute-based encryption (ABE) is a promising cryptographic tool for data owner (DO) to realize fine-grained date sharing in the cloud computing. In the encryption of most existing ABE schemes, a substantial number of modular exponentiations are often required; the computational cost of it is growing linearly with the complexity of the access policy. Besides, in the most existing ABE with outsourced decryption, the computation cost of generating transformation key is growing linearly with the number of attributes associated with user private key; these computations are prohibitively high for mobile device users, which becomes a bottleneck limiting its application. To address the above issues, we propose a secure outsourcing algorithm for modular exponentiation in one single untrusted server model and a new method to generate the transformation key. Based on these techniques and Brent Waters's ciphertext-policy ABE scheme, we propose an ABE scheme with verifiable outsourced both encryption and decryption, which can securely outsource encryption and decryption to untrusted encryption service provider (ESP) and decryption service provider (DSP), respectively, leaving only a constant number of simple operations for the DO and eligible users to perform locally. In addition, both DO and the eligible users can check the correctness of results returned from the ESP and the DSP with a probability, respectively. Finally, we provide the experimental evaluation and security analysis of our scheme, which indicates that our construction is suitable for the mobile environment. © 2019 Elsevier B.V., All rights reserved.},
	author_keywords = {ABE; access control; modular exponentiation; outsourced decryption; outsourced encryption; secure outsourcing algorithm; verifiability},
