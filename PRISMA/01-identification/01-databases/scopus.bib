}

@CONFERENCE{Yang202277,
	author = {Yang, Yang and Wei, Zengtao and Huang, Minming},
	title = {Accountable Policy-Based Sanitizable Signature for Medical Data Sharing},
	year = {2022},
	pages = {77 - 84},
	doi = {10.1145/3586102.3586114},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85168768353&doi=10.1145%2F3586102.3586114&partnerID=40&md5=c2866dfb187d61a64348b9de96a60f17},
	affiliations = {Fuzhou University, College of Computer and Data Science, Fuzhou, China; Singapore Management University, School of Computing and Information Systems, Singapore City, Singapore},
	abstract = {With the Internet and cloud computing development, signed electronic medical data can be stored on the cloud server for flexible data sharing. However, the signed medical data contains much private information, and directly sharing the entire medical data may lead to privacy leakage. The sanitizable signatures can solve this problem well. However, in the existing sanitizable signature schemes, few schemes achieve access control to sanitizer while achieving invisibility and unlinkability. In addition, the existing schemes only consider a signer and a single sanitizer situation. If the sanitizer is not online or unwilling to perform the sanitization operation, the data cannot be sanitized in time. The existing methods to achieve the accountability of sanitizer cannot be directly expanded to the situation of multiple sanitizers because the existing methods are less flexible, and the signer is required to regenerate the signature to assign sanitization rights to a new sanitizer. We propose an accountable policy-based invisible and unlinkable sanitizable signature scheme to solve the above problems. This scheme contains a signer and multiple sanitizers and can achieve signer and multiple sanitizer accountability. Specifically, the medical data provider can specify the access policy when signing the data. Only those who meet the access policy can sanitize the signed data and generate valid signatures. When there is a dispute, not only can the medical data provider generate a proof tag, but all medical data sanitizers can also generate proof tags to identify the actual generator of the data-signature pair. In addition, this paper proposes an electronic medical data-sharing scheme based on the above-mentioned sanitizable signature. Finally, the security analysis and performance analysis show that the scheme of this paper is feasible. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Accountability; Medical data sharing; Multiple sanitizers; Sanitizable signatures},
	keywords = {Cloud computing; Information dissemination; Network security; Access policies; Accountability; Data Sharing; Medical data; Medical data sharing; Multiple sanitizer; Policy-based; Sanitizable signature; Sanitization; Signature Scheme; Authentication},
