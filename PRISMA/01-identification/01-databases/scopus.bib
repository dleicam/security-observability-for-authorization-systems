	affiliations = {PSNA College of Engineering and Technology, Department of Computer Science and Business Systems, Dindigul, India; PSNA College of Engineering and Technology, Department of CSE (Cyber Security), Dindigul, India; PSNA College of Engineering and Technology, Department of Artificial Intelligence and Data Science, Dindigul, India},
	abstract = {Vehicular Cloud Computing (VCC) offers a promising platform for supporting various automotive applications and services. However, its distributed and dynamic nature makes it susceptible to Denial-of-Service (DoS) attacks, particularly during channel establishment. This research proposes a comprehensive approach to mitigate these risks by integrating a suite of security mechanisms. These include rate-limiting, resource management, traffic analysis, access control, authentication, encryption, intrusion detection, behavioral analysis, and blacklisting/whitelisting techniques. By incorporating these measures, the proposed approach enhances the security and reliability of VCC, ensuring the availability of critical automotive services and protecting vehicles from the impact of DoS attacks. © 2025 Elsevier B.V., All rights reserved.},
