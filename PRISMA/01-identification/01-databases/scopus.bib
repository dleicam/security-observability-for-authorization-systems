	title = {Decentralized Identity Management in Cloud Computing: A Blockchain-Based Solution With Automatic Provisioning Techniques},
	year = {2025},
	journal = {International Journal of Intelligent Systems},
	volume = {2025},
	number = {1},
	pages = {},
