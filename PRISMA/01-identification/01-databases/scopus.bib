	author = {Zhou, Yanwei and Xu, Yuan and Qiao, Zirui and Yang, Bo and Zhang, Mingwu},
	title = {Continuous leakage-resilient certificate-based signcryption scheme and application in cloud computing},
	year = {2021},
	journal = {Theoretical Computer Science},
	volume = {860},
	pages = {1 - 22},
	doi = {10.1016/j.tcs.2021.01.024},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85099987389&doi=10.1016%2Fj.tcs.2021.01.024&partnerID=40&md5=b48d03916954a52e1b6aaafe396707ce},
	affiliations = {Shaanxi Normal University, School of Computer Science, Xi'an, China; State Key Laboratory of Cryptology, Beijing, China; Guilin University of Electronic Technology, Guangxi Key Laboratory of Trusted Software, Guilin, China},
	abstract = {Leakage of private information, e.g. the secret keys, has become a serious threat to the security of computing systems. It has become a common requirement that real-world security applications should withstand various leakage attacks, such as side-channel attacks, cold-boot attacks, etc. For example, the above leakage attacks are very common in cloud computing nowadays. Hence, we need a novel method to protect the security of data storage and authorization even if a certain amount of leakage information with respect to the secret state can be obtained by any adversary. In order to achieve the above goal, in this paper, we introduce a continuous leakage-resilient certificate-based signcryption (CBS) scheme, and we prove that our proposed scheme achieves the chosen-ciphertext attacks (CCA) security based on the discrete logarithm assumption and the decisional Diffie-Hellman assumption. Our proposed scheme not only has the ability to resist the continuous leakage attacks, but also enjoys very low computational overheads. Moreover, two concrete continuous leakage-resilient data storage and authorization protocols are generated from the above continuous leakage-resilient CBS scheme: one has a single key generation center and the other generates the keys in a distributed form. Therefore, our protocols with continuous leakage resilience are particularly suitable for data storage and authorization in cloud computing system. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {CCA security; Certificate-based signcryption; Cloud computing; Continuous leakage resilience},
	keywords = {Cloud computing; Data privacy; Digital storage; Electric circuit breakers; Mobile telecommunication systems; Network security; Chosen ciphertext attack; Computational overheads; Decisional Diffie Hellman assumption; Discrete logarithms; Key generation centers; Leakage information; Security application; Signcryption schemes; Side channel attack},
	correspondence_address = {Z. Qiao; School of Computer Science, Shaanxi Normal University, Xi'an, China; email: qzr_snnu@163.com},
