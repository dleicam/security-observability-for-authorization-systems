	title = {Improving the Security and Reliability of SDN Controller REST APIs Using JSON Web Token (JWT) with OpenID and auth2.0},
	year = {2024},
	pages = {398 - 402},
	doi = {10.1109/MI-STA61267.2024.10599643},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85201163177&doi=10.1109%2FMI-STA61267.2024.10599643&partnerID=40&md5=77edd3691a30d02befdfea7324724b42},
	affiliations = {Libyan International University, Department of Computer Networks, Benghazi, Libya},
	abstract = {As Software-Defined Networking (SDN) continues to gain popularity, the need for secure and efficient methods of authenticating users and controlling access to network resources becomes increasingly important. RESTful APIs are commonly used in SDN to enable communication between applications and network devices through the controllers. However, without proper authentication mechanisms, these APIs can be vulnerable to attacks such as injection and unauthorized access. This paper proposes lighter and reliable REST API authentication solution with less open configuration for Software-Defined Networking (SDN) controllers based on JSON Web Token (JWT), OpenID and auth2.0. The proposed solution offers a secure and efficient way to authenticate and authorize users, control access to network resources, and protect against injection attacks. It consists of generating a secret key, defining the JWT payload, generating the JWT, including the JWT in the HTTP Authorization header, verifying the JWT, extracting the payload from the JWT, and implementing token refresh. The solution is implemented using a combination of libraries in Python [requests-json-http.client] and tested on an SDN controller using a cisco DNA sandbox network environment. The results show that the proposed authentication solution is highly efficient and effective, making it suitable for use in high-performance SDN environments. It provides a much-needed solution for securing RESTful APIs in SDN controllers, and we hope that it will encourage further research in this area. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {JSON Web Token (JWT); OpenFlow; OpenID and auth2.0; RESTful API; Software Defined Networks},
	keywords = {Authentication; Authorization; HTTP; Network security; Software defined networking; Software reliability; Authentication solutions; JSON web token; Network devices; Network resource; Openflow; Openid and auth2.0; RESTful API; Security and reliabilities; Software-defined networkings; Software-defined networks; Controllers},
