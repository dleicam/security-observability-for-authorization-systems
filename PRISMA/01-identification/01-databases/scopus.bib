	pages = {3986 - 3998},
	doi = {10.1109/TSC.2023.3303185},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85167809639&doi=10.1109%2FTSC.2023.3303185&partnerID=40&md5=aabda6a4d8e7895ddcd77b5cd1612972},
	affiliations = {Guizhou Normal University, Guizhou Provincial Specialized Key Laboratory of Information Security Technology in Higher Education Institutions, Guiyang, China; Guizhou Normal University, School of Mathematical Sciences, Guiyang, China; Guizhou Normal University, Graduate School, Guiyang, China},
	abstract = {Provable data possession (PDP) solves the problem of determining whether the data stored in the cloud is maintained in its entirety. Certificateless cryptography simultaneously tackles two challenges: certificate management and key escrow. There are still three deficiencies in the current known certificateless provable data possession (CL-PDP) schemes. First, security proofs are typically conducted in the random oracle model (ROM). Second, some schemes are incapable of preventing third-party auditor (TPA) from recovering user data blocks. Third, most schemes require hash-to-point operations, which result in lower computational efficiency. In this article, we demonstrated two kinds of attacks targeting the scheme Ji et al. 2020. Subsequently, we put forward a new CL-PDP scheme and showed security proofs in the standard model (SM). Finally, we conducted performance analysis on ten CL-PDP schemes. Our scheme outperforms others in terms of efficiency, as it minimizes computational overhead by requiring only three pairing operations and eliminating the need for hash-to-point operations. © 2023 Elsevier B.V., All rights reserved.},
