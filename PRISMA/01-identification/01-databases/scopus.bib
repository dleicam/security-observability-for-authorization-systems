@CONFERENCE{Gajera2021237,
	author = {Gajera, Hardik and Das, Manik Lal},
	title = {Fine-grained Data Deduplication and proof of storage Scheme in Public Cloud Storage},
	year = {2021},
	pages = {237 - 241},
	doi = {10.1109/COMSNETS51098.2021.9352742},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85102066192&doi=10.1109%2FCOMSNETS51098.2021.9352742&partnerID=40&md5=4b3644b9ff2d439ca0b51139e13d43ec},
	affiliations = {Dhirubhai Ambani Institute of Information and Communication Technology, Gandhinagar, India},
	abstract = {Verification of the integrity of the data stored on a public cloud server is a challenging research problem. While providing on-demand service to the service consumer, the cloud service provider also requires to ensure minimizing error in data stored in a cloud storage server. To address this issue, many schemes like proof of storage (POS), proof of data possession (PDP), proof of retrievability (POR) exist in the literature. However, for practical purpose, a scheme which verifies the data stored in the server should be compatible with the standard practice of data deduplication for an efficient storage system. There are a few proof of storage with data deduplication (POSD) schemes. We observe that these schemes do not consider stronger tag consistency properties and are vulnerable to duplicate data faking attacks. Moreover, existing POSD schemes are inefficient for real-world applications. In this paper, we present an efficient proof of storage scheme with data deduplication at the block-level which allows private as well as public verification of the data stored. DPoS is secure against duplicate faking attacks and unforgeable under the standard assumption. The theoretical analysis of the DPoS scheme shows that it is efficient in comparison to related schemes. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {Cloud Security; Data Deduplication; Proof of Storage; Verification},
	keywords = {Storage as a service (STaaS); Cloud service providers; Consistency property; Data de duplications; On-demand services; Proof of retrievability; Public verifications; Standard assumptions; Standard practices; Digital storage},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
