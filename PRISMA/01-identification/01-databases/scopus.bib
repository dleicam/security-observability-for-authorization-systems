	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85094324316&doi=10.1109%2FTPDS.2020.3028685&partnerID=40&md5=123f622fb5e0983c88234f3f6dde158a},
	affiliations = {Xidian University, State Key Laboratory on Integrated Services Networks, Xi'an, China; Singapore Management University, School of Information Systems, Singapore City, Singapore; Xi'an Jiaotong University, School of Computer Science and Technology, Xi'an, China; Aalto University, Department of Communications and Networking, Espoo, Finland},
	abstract = {Encrypted data deduplication, along with different preferences in data access control, brings the birth of hybrid encrypted cloud data deduplication (H-DEDU for short). However, whether H-DEDU can be successfully deployed in practice has not been seriously investigated. Obviously, the adoption of H-DEDU depends on whether it can bring economic benefits to all stakeholders. But existing economic models of cloud storage fail to support H-DEDU due to complicated interactions among stakeholders. In this article, we establish a formal economic model of H-DEDU by formulating the utilities of all involved stakeholders, i.e., data holders, data owners, and Cloud Storage Providers (CSPs). Then, we construct a multi-stage Stackelberg game, which consists of Holder Participation Game, Owner Online Game, and CSP Pricing Game, to capture the interactions among all system stakeholders. We further analyze the conditions of the existence of a sub-game perfect Nash Equilibrium and propose a gradient-based algorithm to help the stakeholders choose near-optimal strategies. Extensive experiments show the feasibility of the proposed algorithm in achieving the Nash Equilibrium of the Stackelberg game. Additionally, we investigate the effects of parameters related to CSP, data owners and data holders on H-DEDU adoption. Our study advises all stakeholders the best strategies to adopt H-DEDU. © 2020 Elsevier B.V., All rights reserved.},
	author_keywords = {Cloud computing; deduplication; gradient-based algorithm; multi-stage stackelberg game},
