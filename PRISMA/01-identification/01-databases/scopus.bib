	doi = {10.1109/QRS54544.2021.00021},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85146199452&doi=10.1109%2FQRS54544.2021.00021&partnerID=40&md5=cca1eb064045abf2e44e8cfe36eb5505},
