	doi = {10.1109/ICICACS57338.2023.10100155},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85158152246&doi=10.1109%2FICICACS57338.2023.10100155&partnerID=40&md5=40ad73aa5f481af26cda1963068c0483},
	affiliations = {CMR Institute of Technology, Department of CSE, Bengaluru, India},
	abstract = {The prevalence of cloud security has significant privacy-preserving problems due to humanity's need to protect sensitive and non-sensitive data for decision-making and resolve data leakage problems in the IoT environment. One of the most challenging aspects is the reuse and sharing of accurate and detailed clinical data about PHR collected via Personal Health Records (PHRs). Cloud transition is difficult. PHRs are often privacy-preserving patient-centric models for exchanging medical information outsourced to third parties, such as Cloud Service Providers (CSP). A unique PHR patient information to ensure security with encryption before storage in the cloud. But still, issues such as security issues, flexible access and proper user privacy risk management, and efficiency remain critical challenges to achieving better data access sensitive and non-sensitive imposition of control in cloud storage. To achieve high efficiency of PHR and modular data access control, Rail Fence Data Encryption (RFDE) algorithm is provided to encrypt the PHR file to make high privacy standards. RFDE is also a form of transposition cypher called zigzag encryption, and the unauthorized user can't access the information. The proposed algorithm encrypts the PHR information it generates the secret key. The receiver decrypts the PHR information using the private key. The proposed algorithm provides efficient performance compared with the previous algorithm. © 2023 Elsevier B.V., All rights reserved.},
