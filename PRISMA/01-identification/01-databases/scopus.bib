@CONFERENCE{Snyman20251372,
	author = {Snyman, Jean and Culnane, Chris and Boureanu, Ioana and David, Gerault},
	title = {Protocols and Formal Models for Delegated Authorisation with Server-Side Secrecy},
	year = {2025},
	journal = {Proceedings of the ACM Conference on Computer and Communications Security},
	pages = {1372 - 1393},
	doi = {10.1145/3708821.3736217},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016009996&doi=10.1145%2F3708821.3736217&partnerID=40&md5=e0473391cb92de23e1efb72dbb76a0f3},
	affiliations = {University of Surrey, Guildford, United Kingdom; Castell Safety International Ltd., London, United Kingdom; University of Melbourne, Melbourne, Australia; Technology Innovation Institute, Abu Dhabi, United Arab Emirates; Hewlett Packard Enterprise, Palo Alto, United States},
	abstract = {OAuth 2.0 is a well-known protocol suite whereby customers of a web service can grant third-party applications access to their information (or resources) on said web service, all without handing over their long-term credentials. But what if the resources are encrypted? Should third parties get rights to decrypt them?We propose APEX: an OAuth-grounded suite of protocols which systematically augment delegated authorisation to allow refined third-party access to encrypted resources, while maintaining OAuth's behaviour for any unencrypted resources. We also provide an implementation of APEX, showing its seamless integration with OAuth. On the formal side, we propose a generalisation of APEX (and OAuth) into a paradigm which we call restricted authorisation delegation (RAD). RAD is a model that lifts formal treatment from protocol to suites; and, it also stipulates the desirable requirements that delegated authorisation schemes should attain (including to enable access over encrypted resources). We also give a formal, cryptographic model that augments existing models in multi-party authorisation, authenticated key-exchange and access control. Finally, we use this model to prove that APEX formally attains all the properties of a restricted authorisation delegation (RAD) scheme, and discuss that OAuth 2.0 does not. © 2025 Elsevier B.V., All rights reserved.},
	keywords = {Cryptography; Formal methods; Internet protocols; Web services; CryptoGraphics; Formal modeling; Generalisation; Protocol modeling; Seamless integration; Server sides; Third parties; Third party access; Third party application (Apps); Webs services; Websites},
	correspondence_address = {I. Boureanu; University of Surrey, Guildford, United Kingdom; email: ib0020@surrey.ac.uk},
