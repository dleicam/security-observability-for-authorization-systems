	affiliations = {Fujian Normal University, College of Mathematics and Informatics, Fuzhou, China; Singapore Management University, School of Information Systems, Singapore City, Singapore; University of Wollongong, Institute of Cybersecurity and Cryptology, Wollongong, Australia; Faculteit Elektrotechniek, Wiskunde en Informatica, TU Delft, Delft, Netherlands; Fuzhou University, Fuzhou, China; Xi'an Institute of Posts and Telecommunications, School of Cyberspace Security, Xi'an, China},
