	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105004655947&doi=10.1109%2FETIS64005.2025.10960867&partnerID=40&md5=d37fffc702be16b2ee2bbeca2ed3fd01},
	affiliations = {Providence College of Engineering, Department of Cse, Chengannur, India; College of Engineering, Kottarakara, India},
	abstract = {The Cloaked Cryptography is a novel Attribute-Based Encryption (ABE) system designed to enhance security and privacy in IoT data interactions on cloud platforms. This system emphasizes data confidentiality and privacy through encryption prior to cloud storage and features a multi-authority ABE scheme to enable secure data sharing and stringent access control, suitable for the dynamic and resource-constrained scenarios often encountered in IoT environments. The architecture incorporates several key entities: the data owner, data user, attribute authority, cloud server, and auditor. The attribute authority generates system parameters and distributes credentials, while the data owner encrypts and sends data to the cloud. Data users with matching attributes can decrypt the data according to specific access structures. In cases of potential credential leaks, an auditor investigates and reports findings, ensuring accountability. Cloaked Cryptography aims to deliver a robust, efficient, and accountable access control framework for CloudIoT platforms, tackling significant challenges insecuring IoT data and authenticating users. © 2025 Elsevier B.V., All rights reserved.},
