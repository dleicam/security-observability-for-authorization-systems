	keywords = {Access control; Cloud computing; Computational efficiency; Costs; Information management; Internet of things; Attribute-based encryptions; Ciphertexts; Cloud servers; Data Sharing; Fine grained; Industrial internet of thing; Industrial manufacturing; Manufacturing equipment; Proxy re encryptions; Cryptography},
