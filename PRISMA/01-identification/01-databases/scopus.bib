	pages = {1556 - 1564},
	doi = {10.1109/ICISCE50968.2020.00309},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85116349933&doi=10.1109%2FICISCE50968.2020.00309&partnerID=40&md5=08f27796a1e94dda4f50baa2f7521d71},
	affiliations = {He’nan Province Key Laboratory of Information Security, Zhengzhou, China},
	abstract = {In the micro-service composition, the policy conflict resolution mechanism has such problems as single resolution policy, coarse-granularity and inflexible resolution. To solve these problems, we propose a policy conflict resolution mechanism based Multiple Resolution Policy (MRP). It uses the policy generated tree model to express access control policy set of micro-service composition. The mechanism supports four resolution policies that include negative priority, timing priority, positive priority and recent priority. It can balance the security and availability of system better. In addition, coarse-grained resolution of policy level and fine-grained resolution of attribute level are implemented by calculating attribute relevance. The security intention of original policy set is changed minimally in the process of conflict resolution that can meet the flexible, dynamic conflict resolution needs of composite service better. Finally, we carry out some simulation experiments to verify and evaluate the effectiveness and efficiency of the mechanism. © 2021 Elsevier B.V., All rights reserved.},
