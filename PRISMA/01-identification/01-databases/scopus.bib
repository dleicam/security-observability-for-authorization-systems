@CONFERENCE{Jiang201855,
	author = {Jiang, Qingye and Lee, Youngchoon and Zomaya, Albert Y.H.},
	title = {Janus: A Generic QoS Framework for Software-as-a-Service Applications},
	year = {2018},
	journal = {Proceedings - IEEE International Conference on Cluster Computing, ICCC},
	volume = {2018-September},
	pages = {55 - 65},
	doi = {10.1109/CLUSTER.2018.00018},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85057222888&doi=10.1109%2FCLUSTER.2018.00018&partnerID=40&md5=09edcecf0c200ec82ba47b755e02b114},
	affiliations = {School of Computer Science, Sydney, Australia; Macquarie University, Department of Computing, Sydney, Australia},
	abstract = {The move from the traditional Software-as-a-Product (SaaP) model to the Software-as-a-Service (SaaS) model is apparent with the wide adoption of cloud computing. Unlike the SaaP model, the SaaS model delivers a diverse set of software features directly from public clouds to a large number of arbitrary users with varying quality of service (QoS) requirements. QoS is typically assured by admission control. However, there are two outstanding issues with traditional QoS systems: (1) they are usually designed and developed with a special purpose, making them difficult to be reused for other use cases; and (2) they have limited scalability (i.e., vertical scalability) due to the write-intensive nature of admission control workload. In this paper, we present Janus - a QoS framework that is generic and scalable for SaaS applications taking full advantage of cloud's inherent horizontal scalability (scaling-out). Janus uses a multi-layer architecture to eliminate the communication between nodes (being scaled out) in the same layer achieving horizontal scalability without sacrificing vertical scalability. Janus ensures accurate admission control (QoS decisions) using a distributed set of leaky buckets with a refill mechanism. Janus also adopts a key-value request-response mechanism for easy integration with the actual application. We extensively evaluate Janus on AWS cloud with both Apache HTTP server benchmarking tool and a photo sharing web application. Our experimental results demonstrate that (a) Janus achieves linear scalability both vertically and horizontally, and (b) Janus can be integrated with existing applications with a minimum amount of code change. In particular, Janus achieves more than 100,000 requests per second with only 10 nodes (4 vCPU cores on each node) in the QoS server layer and 90% of the admission control decisions were made in 3 milliseconds. © 2019 Elsevier B.V., All rights reserved.},
	author_keywords = {Admission control; Distributed system; Scalability; Write intensive workload},
	keywords = {Access control; Application programs; Benchmarking; Cluster computing; Computer architecture; HTTP; Quality of service; Scalability; Web services; Admission control decision; Apache http servers; Distributed systems; Multi-layer architectures; Qualityof-service requirement (QoS); Response mechanisms; Vertical scalabilities; Write-intensive workloads; Software as a service (SaaS)},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {15525244},
	isbn = {0769517455; 9781424403288; 9781728147345; 9798350370621; 9781665498562; 9781424450121; 9781509036530; 9780780394858; 1424413885; 9781424426409},
	language = {English},
	abbrev_source_title = {Proc. IEEE Int. Conf. Cluster Comput. ICCC},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Zolotas20181007,
	author = {Zolotas, Christoforos and Chatzidimitriou, Kyriakos C. and Symeonidis, Andreas L.},
	title = {RESTsec: a low-code platform for generating secure by design enterprise services},
	year = {2018},
	journal = {Enterprise Information Systems},
