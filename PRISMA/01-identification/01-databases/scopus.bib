@ARTICLE{Cui20243662,
	author = {Cui, Hui and Yi, Xun},
	title = {Secure Internet of Things in Cloud Computing via Puncturable Attribute-Based Encryption with User Revocation},
	year = {2024},
	journal = {IEEE Internet of Things Journal},
	volume = {11},
	number = {2},
	pages = {3662 - 3670},
	doi = {10.1109/JIOT.2023.3297997},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165926931&doi=10.1109%2FJIOT.2023.3297997&partnerID=40&md5=d7e9786886c493392813dca65fda21bd},
	affiliations = {Monash University, Faculty of IT, Melbourne, Australia; RMIT University, School of Sciences, Melbourne, Australia},
	abstract = {With significant achievements of Internet of Things (IoT) in cloud services, IoT devices are becoming primary targets of cyber attackers. To protect security of previous messages generated by IoT devices in cloud computing, puncturable attribute-based encryption (PABE) was introduced which achieves fine-grained access control and supports self-update to private keys to disable the decryption capability to existing ciphertexts. Users in PABE are identified by their attributes and authenticated via the attribute authority (AA) which issues them attribute keys. But PABE does not consider any attribute revocation which should be managed by the AA. To address such a concern, this article presents a primitive called PABE with user revocation (PAER) which is the first light-weight PABE scheme with the user revocation achieved by the AA broadcasting the information for the key update. In addition to the light calculation of users in the decrypting process, another prominent advantage in PAER is that the AA does not need to communicate with users to revoke their attributes but broadcasts regular updates in the network. We present a concrete construction of PAER, and then implement the given scheme to evaluate its practicability in the real world. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Access control; light-weight computation; scalability; self key update; user revocation},
	keywords = {Access control; Binary trees; Cloud security; Cybersecurity; Internet of things; Network security; Attribute-based encryptions; Cloud-computing; Key updates; Light weight; Light-weight computation; Public keys; Scalibility; Security; Self key update; User revocation; Cryptography},
	correspondence_address = {H. Cui; Monash University (Clayton Campus), Faculty of IT, Clayton, 3800, Australia; email: hui.cui@monash.edu},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
