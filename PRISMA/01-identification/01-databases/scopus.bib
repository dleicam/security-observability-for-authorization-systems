	source = {Scopus},
	note = {Cited by: 1; All Open Access; Green Accepted Open Access; Green Open Access}
}

@CONFERENCE{Atmakuri2024424,
	author = {Atmakuri, Aparnarajesh and Sahoo, Amiya Kumar and Pallavi, M. and Behera, Dayal Kumar and Gourisaria, Mahendra Kumar and Padhi, Sunita},
	title = {Dynamic Resource Optimization for Cloud Encryption: Integrating ACO and Key-Policy Attribute-Based Encryption},
	year = {2024},
	pages = {424 - 428},
	doi = {10.1109/ICSCSA64454.2024.00074},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001485509&doi=10.1109%2FICSCSA64454.2024.00074&partnerID=40&md5=30e03ad1d470c781afb421642ca268a9},
	affiliations = {Centurion University of Technology and Management, Paralakhemundi, India; Aryan Institute of Engineering and Technology, Department of CSE, Bhubaneswar, India; Presidency University Bangalore, Department of CSE, Bengaluru, India; Kalinga Institute of Industrial Technology, Bhubaneswar, School of Computer Engineering, Bhubaneswar, India; Aryan Institute of Engineering and Technology, Department of CSE, Bhubaneswar, India},
	abstract = {Encryption and decryption are essential in cloud-based systems, and it's vital to ensure they run efficiently. This paper introduces a new method called CloudSecurePath (cSp) to optimize the execution paths of these tasks using Ant Colony Optimization (ACO) and Key-Policy Attribute-Based Encryption (KP-ABE). The ACO algorithm identifies the most efficient resource sequences (such as virtual machines, containers, serverless functions) for encryption and decryption. In the ACO algorithm, ants represent different resource paths, evaluating each path based on execution time and resource use. Pheromone trails are updated to guide future ants to the best paths, and the algorithm runs continuously to adapt to changes in the cloud environment. To further improve security, the approach integrates KP-ABE, which provides fine-grained access control, ensuring only authorized entities can access encrypted data. Combining ACO-based path optimization with KP-ABE results in a robust, adaptive solution for secure and efficient encryption/decryption in cloud systems. The paper details the ACO-based path optimization algorithm, covering its initialization, ant exploration, pheromone updating, and convergence checking. It also discusses about implementing the optimal path and the continuous optimization process. This approach is designed to be scalable and adaptable, making it suitable for various cloud applications needing secure and efficient encryption and decryption. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Ant Colony Optimization (ACO); Cloud Encryption; Cloud Secure Path; Fine-Grained Access Control; Key-Policy Attribute-Based Encryption (KP-ABE); Resource Path Optimization; Secure Data Processing},
	keywords = {Access control; Cloud platforms; Cloud security; Ant colonies; Ant colony optimization; Attribute-based encryptions; Cloud encryption; Cloud secure path; Colony optimization; Fine grained; Fine-grained access control; Key policies; Key-policy attribute-based encryption; Path optimizations; Resource path optimization; Secure data; Secure data processing},
	correspondence_address = {A. Atmakuri; Centurion University of Technology and Management, SoET-Dept.of CSE, Bhubaneswar, Odisha, India; email: aparna.subhadra@gmail.com},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9798331515720},
	language = {English},
	abbrev_source_title = {Proc. - Int. Conf. Soft Comput. Secur. Appl., ICSCSA},
	type = {Conference paper},
