	doi = {10.1109/ICPADS47876.2019.00126},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85078923965&doi=10.1109%2FICPADS47876.2019.00126&partnerID=40&md5=9fc719225e86620a2148516f70074601},
