	keywords = {Blockchain; Cloud security; Cloud storage; Attribute-based encryptions; Block-chain; Blockchain technology; Cloud-computing; Health monitoring; Internet of medical thing security; Key generation; Medical services; Optimal key generation; Secure storage; Security; Electronic health record},
