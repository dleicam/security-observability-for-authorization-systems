	doi = {10.1109/ICACCS60874.2024.10716966},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208611669&doi=10.1109%2FICACCS60874.2024.10716966&partnerID=40&md5=7ab0a3453fa4476188fbfcc134b8e4bb},
