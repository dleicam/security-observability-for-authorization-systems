	title = {Efficient Outsourced Data Access Control with User Revocation for Cloud-Based IoT},
	year = {2018},
	journal = {Proceedings - IEEE Global Communications Conference, GLOBECOM},
	pages = {},
	doi = {10.1109/GLOCOM.2018.8647659},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85063445166&doi=10.1109%2FGLOCOM.2018.8647659&partnerID=40&md5=847c4768e834d47ae8aaa75286a6acd3},
	affiliations = {National University of Defense Technology China, College of Electronic Science, Changsha, China; University of Waterloo, Waterloo, Canada},
	abstract = {Data owners have benefited significantly from cloud computing for managing the numerous data produced by massive devices in various Internet of Things (IoT) applications, such as smart home and electronic healthcare. On the other hand, fine- grained access control on outsourced data is a big concern for data owners, after they lose physical control over their data. Key-policy attribute- based encryption (KP-ABE), which provides data confidentiality and fine-grained data access control simultaneously, can be naturally introduced in this cloud-based IoT paradigm. However, the primitive KP-ABE cannot achieve efficient data access control with flexible user revocation. In this paper, we propose an efficient and fine-grained data access control scheme based on the proxy re-encryption and key blinding techniques for cloud-based IoT. With the scheme, the decryption capability of misbehaving users can be efficiently revoked to prevent data disclosure. In addition, most of the costly update operations over ciphertexts and keys due to user revocation, are delegated to the cloud. Extensive experiment results demonstrate that our scheme is more efficient than existing solutions in terms of computation and communication overheads. © 2024 Elsevier B.V., All rights reserved.},
	keywords = {Access control; Automation; Cryptography; Attribute-based encryptions; Cloud-based; Cloud-computing; Data access control; Fine grained; Key policies; Outsourced datum; Smart electronics; Smart homes; User revocation; Internet of things},
	issn = {23340983; 25766813},
	isbn = {9781479913534; 9798350351255; 9781467309219; 9781728109626; 9781728182988; 9798350310900; 9781479935116; 9781538647271; 9781509050192},
	language = {English},
	abbrev_source_title = {Proc. - IEEE Glob. Commun. Conf., GLOBECOM},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6}
}

