@CONFERENCE{Guo2023,
	author = {Guo, Sheng and Wang, Zhi and Yang, Lei},
	title = {Design of Computer Network Security Storage System Based on Digital Cloud Computing Technology},
	year = {2023},
	pages = {},
	doi = {10.1109/EASCT59475.2023.10393585},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85187280932&doi=10.1109%2FEASCT59475.2023.10393585&partnerID=40&md5=68c51f4f1478af4b5fcd7aeedd2342ca},
	affiliations = {Wenhua College, Wuhan, China},
	abstract = {The design of a computer network security (CNS) storage system based on digital cloud computing technology (CCT) is a solution proposed to address the increasing network security threats. With the widespread application of computer networks in various industries, data security has become an important concern. Traditional storage systems often cannot meet the requirements for data security and reliability, so a new design is needed to protect network data. This storage system based on digital CCT has multiple functions. Firstly, it can encrypt, backup, and restore data to ensure that it is not accessed, tampered with, or lost without authorization. Secondly, the system ensures that only authorized users can access and modify data through authentication and access rights management, thereby preventing unauthorized access. In addition, the system can also record the access and operation of data, making it easy to trace and detect whether there are security vulnerabilities or violations in the later stage. Storage systems based on CCT also have the characteristics of elasticity and scalability. It can flexibly expand storage space according to user needs and provide high availability services. Through experiments, it can be seen that the CNS storage system using digital CCT has only one successful intrusion, data loss, and running error within one minute, which is a significant improvement compared to traditional network security storage systems. Finally, the design of a CNS storage system based on digital CCT can also optimize the use of network and storage resources, improve the efficiency of data transmission and processing, and provide a better user experience. In short, this system can effectively protect the security and confidentiality of data, provide reliable storage and access services, and provide better data protection and security defense capabilities for network users. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {cloud computing technology; computer networks; data transmission; network security; savings systems},
	keywords = {Authentication; Authorization; Cloud security; Cloud storage; Computer networks; Data communication systems; Data transfer; Information management; Cloud computing technologies; Computer network security; Data-transmission; Industry datum; Networks security; Saving system; Security and reliabilities; Security storages; Security threats; Storage systems; Network security},
