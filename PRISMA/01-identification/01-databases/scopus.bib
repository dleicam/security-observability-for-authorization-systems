@CONFERENCE{Chen20181063,
	author = {Chen, Yihua and Huang, Pochung},
	title = {Collaborative access control of cloud storage systems},
	year = {2018},
	pages = {1063 - 1064},
	doi = {10.1109/ICASI.2018.8394460},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85050268313&doi=10.1109%2FICASI.2018.8394460&partnerID=40&md5=377451f9eb468e45d50c9fae4ed695de},
	affiliations = {Yuan Ze University, Department of Electronics Engineering, Taoyuan, Taiwan},
	abstract = {Recently, cloud storage systems have become a popular means of data storage and sharing in a wide spectrum of application scenarios, especially in cloud computing systems. Although the present implementations of cloud storage systems such as Google Drive or HackMD offer the functionality to let multiple users edit the same documents at the same time, some issues on access controls might emerge. First, the existing access control policies allow the reads or writes of a file or directory if the corresponding access privileges are granted, in an all-or-nothing basis, and finer-grained controls are not realized. Then, the privileges to read or write a file are not completely orthogonal, thus the access controls for reads and writes should be asymmetric. In particular, a user that are granted to write a file cannot be always guaranteed to be able to read the same file, and vice versa. Last but not least, to avoid any intended or careless sabotage of any single user on critical files, multiple users must be able to collaboratively control the accesses to a file. Unfortunately, while the collaborative access control of files on cloud storage systems has been extensively studied, more sophisticated access control policies based on sets of users - referred to as manager groups in this work - still remain an unanswered problem, which motivates this work. In this work, we propose a collaborative access control strategy based on manager groups, which allow multiple groups to be connected in series or in parallel to further enhance the flexibility of access control of files on the cloud. In addition, we also considered several key implementation issues such as the performance of management, as well as the overheads for file encryption. © 2018 Elsevier B.V., All rights reserved.},
	author_keywords = {cloud storage systems; collaborative access control; collaborative management; file auditing; non-repudiation},
	keywords = {Cryptography; Digital storage; Distributed computer systems; Managers; Storage management; Access control policies; Application scenario; Cloud storage systems; Collaborative management; Control strategies; file auditing; File encryption; Non repudiation; Access control},
	editor = {Lam, A.D.K.-T. and Prior, S.D. and Meen, T.-H.},
