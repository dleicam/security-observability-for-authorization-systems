	keywords = {Cloud storage; Content based retrieval; Convolution; Data mining; Extraction; Feature extraction; Image enhancement; Learning systems; Neural networks; Privacy-preserving techniques; Query processing; Vector spaces; Attribute based access control; Content-Based Image Retrieval; Contents-based image retrievals; Convolutional neural network; Features extraction; Index; Multiusers; Privacy preserving; Secure transfer learning; Transfer learning; Access control},
