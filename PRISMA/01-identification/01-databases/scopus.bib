@CONFERENCE{Huang2018,
	author = {Huang, Qinlong and Li, Nan and Yang, Yixian},
	title = {DACSC: Dynamic and Fine-Grained Access Control for Secure Data Collaboration in Cloud Computing},
	year = {2018},
	journal = {Proceedings - IEEE Global Communications Conference, GLOBECOM},
	pages = {},
	doi = {10.1109/GLOCOM.2018.8648113},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85063480799&doi=10.1109%2FGLOCOM.2018.8648113&partnerID=40&md5=6dd784777f2acd97df807c265fef00e4},
	affiliations = {Beijing University of Posts and Telecommunications, School of Cyberspace Security, Beijing, China},
	abstract = {Data collaboration is more and more popular in cloud computing. In a typical collaboration scenario, data owner outsources the data to cloud platforms, and users can access and re-upload the data. In consideration of the semi-trusted cloud platform, attribute-based encryption (ABE) has been utilized to guarantee data confidentiality and fine-grained access control. However, how to allow the collaborative data to be accessed only by authorized users in a flexible and dynamic manner is a challenging problem. In this paper, we propose DACSC, a dynamic and fine-grained access control scheme for secure data collaboration in cloud computing. First of all, we adopt ciphertext-policy ABE technique to define the original access policy of outsourced data. Second, we introduce a tree-based policy extending framework which allows users who satisfy the original access policy to customize a new access policy and add it to current access policies in a non-restrictive or restrictive way. Furthermore, we achieve integrity checking during the policy extending procedure based on ABE with equality test algorithm, which ensures that the added access policy comes from authorized user. The security analysis and experimental results indicate that DACSC is secure and efficient, and is suitable for the data collaboration scenario in cloud computing. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Access control; Attribute-based encryption; Cloud computing; Data collaboration; Integrity checking},
	keywords = {Cloud computing; Cryptography; Access policies; Attribute-based encryptions; Authorized users; Cloud platforms; Cloud-computing; Data collaborations; Fine grained; Integrity checking; Secure data; Trusted clouds; Access control},
	issn = {23340983; 25766813},
	isbn = {9781479913534; 9798350351255; 9781467309219; 9781728109626; 9781728182988; 9798350310900; 9781479935116; 9781538647271; 9781509050192},
	language = {English},
	abbrev_source_title = {Proc. - IEEE Glob. Commun. Conf., GLOBECOM},
	type = {Conference paper},
	publication_stage = {Final},
