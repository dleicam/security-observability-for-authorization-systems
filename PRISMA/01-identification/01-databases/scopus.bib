@ARTICLE{Sethi20211525,
	author = {Sethi, Kamalakanta and Pradhan, Ankit and Bera, Padmalochan},
	title = {PMTER-ABE: a practical multi-authority CP-ABE with traceability, revocation and outsourcing decryption for secure access control in cloud systems},
	year = {2021},
	journal = {Cluster Computing},
	volume = {24},
	number = {2},
	pages = {1525 - 1550},
	doi = {10.1007/s10586-020-03202-2},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85098512391&doi=10.1007%2Fs10586-020-03202-2&partnerID=40&md5=aaea76f7ca931c792d44059d48058c9f},
	affiliations = {Indian Institute of Technology Bhubaneswar, Bhubaneswar, India},
	abstract = {Attribute-based encryption (ABE) has evolved as an efficient and secure method for storage of data with fine-grained access control in cloud platforms. In recent years, increasing diversification in the design of ABE schemes has led to significant research in the assimilation of properties like traceability, revocation, and outsourcing decryption. However, most of the recent ABE schemes incorporate few of these properties and hence lack in robustness to adapt with varying demands of cloud systems. In modern ABE designs, the notions of forward and backward secrecy have been introduced to accommodate the delegation of a large number of heterogeneous users in the system. In general, these features are realized under the concept of user revocation. On the other hand, to control malicious users in the system, it is necessary to implement traceability in integration with user revocation. Finally, for resource-constrained users, outsourcing decryption to proxy servers is a viable option. Thus, we propose PMTER-ABE, a practical decentralized multi-authority traceable and efficiently revocable attribute-based cryptosystem with outsourcing decryption advantage. The key features of our cryptosystem are (i) incorporating large attribute universe with highly expressive policies, (ii) integrating forward and backward secrecy under user revocation, (iii) implementing white-box traceability to detect malicious users, and (iv) outsourcing decryption to reduce the computational overhead of decryption on users. We present the formal proofs for correctness, security, and traceability of PMTER-ABE along with performance analysis. The efficiency and usability of PMTER-ABE is shown with practical implementation and experimental results. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {Attribute-based encryption; Backward secrecy; Fine-grained access control; Forward secrecy; Large attribute universe; Outsourcing decryption; User revocation; White-box traceability},
	keywords = {Access control; Digital storage; Outsourcing; Attribute-based; Attribute-based encryptions; Computational overheads; Forward and backward secrecy; Heterogeneous users; Multi authorities; Performance analysis; User revocation; Cryptography},
	correspondence_address = {K. Sethi; Indian Institute of Technology Bhubaneswar, Bhubaneswar, India; email: ks23@iitbbs.ac.in},
