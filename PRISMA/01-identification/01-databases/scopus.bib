	pages = {1817 - 1833},
	doi = {10.1007/s12083-022-01318-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85128789560&doi=10.1007%2Fs12083-022-01318-3&partnerID=40&md5=80d24c395c05cdbf7e335677c096c846},
	affiliations = {Hebei University, School of Cyber Security and Computer, Baoding, China; Hebei University, Baoding, China},
	abstract = {With the rapid development of cloud storage technology, cloud data assured deletion has undergone significant research and progress. In this paper, we propose an assured deletion scheme based on a dynamic sliding window. In the proposed scheme, multilevel security ideas and dynamic sliding window technology are used to achieve more fine-grained access control. The attribute encryption method based on the ciphertext policy is employed to realize data encryption and decryption. Data deletion is achieved by re-encrypting the access control policy in the ciphertext, and data deletion proof is achieved by using the Merkle hash tree structure. Theoretical analysis and experimental results show that this scheme can meet the requirements of assured data deletion in the cloud, improve the granularity of data access control and increase the security of the system. © 2022 Elsevier B.V., All rights reserved.},
