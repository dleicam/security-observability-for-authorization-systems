@ARTICLE{Shrimali2022327,
	author = {Shrimali, Bela and Surati, Shivangi},
	title = {The importance of 5G healthcare using blockchain technologies},
	year = {2022},
	pages = {327 - 350},
	doi = {10.1016/B978-0-323-90615-9.00007-4},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85137570883&doi=10.1016%2FB978-0-323-90615-9.00007-4&partnerID=40&md5=fb5c6f4fe669e7b2e11a179b97dfd879},
	affiliations = {LDRP Institute of Technology & Research, Gandhinagar, India},
	abstract = {With the revolution in network technology and the Internet of things (IoT), pervasive computing becomes tangible by its usage in abundant applications at the global level, including the healthcare industry. It enables billions of objects to communicate purposefully with high-speed data processing (data transfer, collection, management, and processing) particularly in the 5G-enabled healthcare industry/environment. The evolution in the healthcare industry has grown exponentially from Healthcare 1.0 to 4.0. The evolution originated with Healthcare 1.0, which was doctor centric, and was subsequently followed by Healthcare 2.0 where manual records were made digital, and Healthcare 3.0 in which the technology became patient centric. Next, Healthcare 4.0 was equipped with advanced digital technologies such as IoT, cloud computing, and fog computing for sharing or communicating the data between various stakeholders such as doctors, patients, laboratories, nurses, relatives/caretakers, etc. As communication became easy and in real time in Healthcare 4.0, it utilizes a centralized architecture suffering from major issues such as access control mechanisms, security, and privacy. Majorally, the challenges include a longer time in retrieval and storage of data from heterogeneous devices as well as threats of tampering of sensitive medical records of patients/hospitals. The issue related to the access control mechanism can be resolved by 5G healthcare, which introduces a high data speed, low latency, increased reliability, availability, and massive network capacity in the current healthcare framework. In addition, the concerns of privacy and security can be resolved by adopting Blockchain technology in 5G healthcare. This emerging technology supports both the privacy and security of sensitive data by offering a safe and trustworthy secure system to record and share these data. The data, once encrypted using this technology, cannot be modified later. Thus, Blockchain is an appropriate alternative to resolve tampering issues and achieving privacy, security, and trust in applications related to healthcare. Therefore, in this chapter, the basic architecture and main features of Blockchain and 5G are introduced with the major issues faced by the healthcare industry. In addition, the adoption and importance of Blockchain with 5G healthcare is discussed in detail along with its architecture and opportunities. Further, the opportunities, scope, issues, limitations, and research directions of 5G healthcare using Blockchain with a variety of use case scenarios and case studies/applications are explored that help researchers and developers understand its importance and applicability in the healthcare domain. © 2022 Elsevier B.V., All rights reserved.},
	author_keywords = {Blockchain technology; Decentralization; Healthcare; Immutability; Reliability; Security; Transparency},
	publisher = {Elsevier},
	isbn = {9780323908290; 9780323906159},
	language = {English},
	abbrev_source_title = {Blockchain Applications for Healthc. Informatics: beyond 5G},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

