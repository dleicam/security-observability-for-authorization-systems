@ARTICLE{Ainapure20182390,
	author = {Ainapure, Bharati and Shah, Deven and Ananda Rao, Akepogu},
	title = {AMAP: Adaptive multilevel authentication protocol on cloud environment},
	year = {2018},
	journal = {Journal of Theoretical and Applied Information Technology},
	volume = {96},
	number = {9},
	pages = {2390 - 2401},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85047473372&partnerID=40&md5=ff1b667285e7d8085a12fce6638ebe0b},
	affiliations = {Jawaharlal Nehru Technological University Anantapur, Anantapur, India; TCET, Department of Information Technology, Mumbai, India; Jawaharlal Nehru Technological University Anantapur, Anantapur, India},
	abstract = {Cloud computing is an emerging technology that allows users to access the computational data through virtual machines on a cloud. Since the technology is based on the sharing of resources, lack of security is a major issue. This paper proposes a new authentication protocol, with an intention to provide secure access to computational data through virtual machines. The proposed protocol works on mutual and multi-level authentication between the user and the server in a cloud environment. This multi-level authentication protocol provides security, considering multiple parameters like OTP, session password, and so on. The protocol includes two phases: Registration and Authentication. At first, the cloud user and the server are registered under Authorization Centre (AC), which authenticates the user and the server using four different messages. The verification of the user is on the basis of hashing function and EC, following a six level authentication process to allocate the virtual machines to access the computational data in the cloud. This protocol provides resistance against Server spoofing attack, stolen verifier attack, Password guessing attack, Impersonation attack and replay attack. Thus, the protocol allows the cloud user to gain a secured access offering robustness with the utilization of Elliptic Curve Cryptography (ECC) and hashing function. The experimental results show that the proposed protocol could provide 75.58% genuine user details, 78.49% attacker details, and 77.03% accuracy, in the comparative analysis made with the approach of Vanga Odelu et al. This comparison shows that it had better performance in providing authentication than the considered existing technique. © 2018 Elsevier B.V., All rights reserved.},
