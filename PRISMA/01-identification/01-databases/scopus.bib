	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85024488808&doi=10.1016%2Fj.future.2017.06.014&partnerID=40&md5=edc5286c41744cbc9506bfd1c52a5609},
	affiliations = {The University of Tokyo, Department of Electrical Engineering and Information Systems, Tokyo, Japan},
	abstract = {Ciphertext Policy Attribute-based Encryption (CP-ABE) is proven to be one of the most effective approaches to data access control in data outsourcing environment such as cloud computing since it provides efficient key management based on user attributes of multiple users in accessing shared data. However, dealing with policy update limits the efficiency of the CP-ABE. In CP-ABE scheme, the access policy is used as a core element for data encryption. Hence, if the policy is updated, the data owner needs to re-encrypt files and send them back to the cloud. This incurs overheads including computation, communication, and maintenance cost at the data owner side. The computation and communication cost are very expensive if the outsourcing environment is devoted to “big data”. In this paper, we extend the capability of our access control scheme: C-CP-ARBE to be capable of supporting secure and flexible policy updates in the big data outsourcing environment. We develop a secure policy updating algorithm and propose a very lightweight proxy re-encryption (VL-PRE) technique to enable the policy updating to be done in the cloud in an efficient and computationally cost effective manner. Finally, we demonstrate the efficiency and performance of our proposed scheme through the implementation. © 2017 Elsevier B.V., All rights reserved.},
	author_keywords = {Cloud computing; CP-ABE; Data access control; Policy update; Proxy re-encryption},
	keywords = {Access control; Cloud computing; Costs; Cryptography; Efficiency; Outsourcing; Access control policies; Access control schemes; Ciphertext-policy attribute-based encryptions; CP-ABE; Data access control; Effective approaches; Efficiency and performance; Proxy re encryptions; Big data},
	correspondence_address = {S. Fugkeaw; Department of Information Systems and Electrical Engineering, Graduate School of Engineering, University of Tokyo, Japan; email: somchartf@yahoo.com},
	publisher = {Elsevier B.V.},
