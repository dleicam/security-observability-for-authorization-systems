	doi = {10.1002/9781394287970.ch10},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215209704&doi=10.1002%2F9781394287970.ch10&partnerID=40&md5=8b51f5dc772992cc3f4f3b342cd45264},
	affiliations = {KPR Institute of Engineering and Technology, Department of Information Technology, Coimbatore, India; Sri Krishna College of Engineering and Technology Coimbatore, Department of Information Technology, Coimbatore, India},
	abstract = {Blockchain, the Internet of Things (IoT), and healthcare have the potential to completely transform the sector by improving patient care, data security, and interoperability. Healthcare organizations may safely capture and send patient data in real time by connecting IoT devices with blockchain technology. IoT devices can produce a significant amount of useful health data, including wearable sensors, remote monitoring tools, and implantable medical devices. Blockchain ensures the secure and tamper-proof storage of these data, protecting patient privacy and allowing for granular access control. In emergency situations, when doctors and nurses fail to verify the expiry date of medicines, patients may unknowingly consume expired medications through injections or pills. This issue is not limited to hospitals, as expired medicines are sometimes sold in medical shops as well. Such incidents can have detrimental effects on the patients’ health, leading to side effects, and in severe cases, even death. In 2021, a tragic incident occurred in Haryana state where a mother and son lost their lives after consuming expired medicine. A research study has introduced a smart vending machine concept that utilizes IoT, cloud computing, and blockchain technology. This machine is equipped with a scanner sensor that reads the barcode of medicines and securely stores detailed information in a distributed ledger using blockchain. This approach ensures data accuracy and enhances security. This proposed method introduces a blockchain-based platform to improve the interoperability of medicines. It enables the secure and efficient sharing of medical data among users. The vending machine can organize medicines based on their expiry dates, allowing for proper management. When a medicine reaches its expiration date, it is automatically removed from the vending machine and disposed of appropriately. Additionally, the vending machine transmits comprehensive information about the medicine, including its composition and expiry date, to the consumer via a message through the mobile device. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Blockchain technology; Cloud computing; Data security; Data sharing; Expired medicines; Healthcare; Internet of Things; Vending machines},
