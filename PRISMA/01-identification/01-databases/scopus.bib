@CONFERENCE{Delea2020,
	author = {Delea, Cosmin and Coccolo, Emanuele and Covarrubias, Salvador Fernandez and Campagnaro, Filippo and Favaro, Federico and Francescon, Roberto and Schneider, Vincent E. and Oeffner, Johannes and Zorzi, Michele},
	title = {Communication Infrastructure and Cloud Computing in Robotic Vessel as-a-Service Application},
	year = {2020},
	pages = {},
	doi = {10.1109/IEEECONF38699.2020.9389285},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85104571535&doi=10.1109%2FIEEECONF38699.2020.9389285&partnerID=40&md5=804045442e207bb46d8ad41a7d6a992e},
	affiliations = {Università degli Studi di Padova, Department of Information Engineering, Padua, Italy; Fraunhofer Centre for Maritime Logistics and Services CML, Hamburg, Germany; Wireless and More, Padua, Italy},
	abstract = {The current trend in robotics is to enhance robustness against uncertainties through complex modern control methods, applied to either single- or multi-agent systems. While indeed these approaches provide noticeable performance improvements, their implementation requires, among others, enclosed environments, where the operator has full access to the control systems of the robot during execution. With constant improvement of the Internet of Things, real-time systems needed different software architectures and communication systems to enable their remote operation, with the same degree of flexibility when operating the systems in-situ. The paradigm shifted towards cloud computing, which moved the computational effort needed for various real-time processing algorithms on the server-sided application and focused on having lightweight interfaces between components, with the exception of the lower-level control loops, which remained within the processing units of the robotic systems. This paper describes the software architecture and communication system for a state-of-the-art service to enable, support and monitor different robotics applications. The case study presents all features of a small-sized but scalable robotics application, having multiple challenges when building a service oriented platform: autonomous robots, over- and underwater long-distance communication, sensor fusion and command and control of multiple users. The goal is to create a centralised cloud computing environment, with decentralised microservices and redundant resources, supporting a plethora of port-specific operations conducted with the help of waterborne robotics with different equipment configurations, that can be remotely operated and monitored in real time over cross-platform, lightweight applications. © 2021 Elsevier B.V., All rights reserved.},
	keywords = {Access control; Application programs; Command and control systems; Infrastructure as a service (IaaS); Interactive computer systems; Marine communication; Multi agent systems; Robotics; Robots; Cloud computing environments; Communication infrastructure; Computational effort; Constant improvement; Degree of flexibility; Lightweight application; Long distance communication; Robotics applications; Real time systems},
