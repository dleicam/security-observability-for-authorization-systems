	year = {2021},
	journal = {IEEE Access},
	volume = {9},
	pages = {15156 - 15169},
	doi = {10.1109/ACCESS.2021.3051061},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85099536354&doi=10.1109%2FACCESS.2021.3051061&partnerID=40&md5=6256b1f665be1712981c5aacc6b50f59},
	affiliations = {Information Engineering University China, Zhengzhou, China; Beijing Union University, School of Information, Beijing, China; Lab. of Intelligent Technol., Beijing, China},
	abstract = {When users upload their private data to the cloud, they lose control of the data stored in the cloud server. If the cloud system cannot provide an effective security mechanism to protect the data, the consequent data leakage issue will hinder the development of cloud computing. Conventional access control and encryption technologies cannot effectively control the propagation of tenant private data in the system. The mandatory one-way information flow control model is limited by the complexity of the cloud environment, and it is difficult to effectively protect private data stored in the cloud. To solve the above problems, this article proposes a tenant-led ciphertext information flow control method for cloud virtual machines. Through the design of a decentralized information flow control security policy, a secret-domain key management scheme, and a multi-ID-based threshold encryption scheme, the information flow control strategies of taint infection, secret-level reduction, and ability propagation are realized in a ciphertext form, which can effectively prevent malicious users inside and outside the system from illegally reading private data. The feasibility of this method is verified by a security proof and an experiment. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {Cloud computing; data protection; information flow control; information flow encryption},
	keywords = {Access control; Cloud computing; Flow control; Information management; Network security; Virtual machine; Cloud environments; Decentralized information flow control; Encryption technologies; Information flow control; Key management schemes; Security mechanism; Security proofs; Threshold encryption; Cryptography},
