	title = {Experimental Evaluation of Secure and Verifiable Data Control Access Over Cloud Storage Environment Using Dynamic Cryptographic Strategy},
	year = {2024},
	pages = {},
	doi = {10.1109/ICSES63760.2024.10910755},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001305833&doi=10.1109%2FICSES63760.2024.10910755&partnerID=40&md5=d4b43d6c553ffc172ba9db231f2adffc},
	affiliations = {VEL TECH MULTITECH, Department of Information Technology, Chennai, India; QIS College of Engineering & Technology, Department of Mca, Ongole, India; Tilak Education Society, Department of CS/IT, Navi Mumbai, India; QIS College of Engineering & Technology, Department of S&h, Ongole, India; Yeshwantrao Chavan College of Engineering, Department of Mechanical Engineering, Nagpur, India; Zarqa University, Department of Cyber Secuity, Zarqa, Jordan; University of Business and Technology, Jeddah, Saudi Arabia},
	abstract = {Cloud storage offers numerous advantages in terms of accessibility, scalability, and reliability, but it also poses significant security challenges. This study evaluates a secure and verifiable data control access mechanism over a cloud storage environment using a dynamic cryptographic strategy. Several cryptographic techniques were employed, including capability-based access control, multi-authority role-based access control (RBAC), Ciphertext Policy Attribute-Based Encryption (CP-ABE), deniable encryption, and the NTRU cryptosystem. The system's performance, security, scalability, and resilience were analyzed under various conditions. The results show that the NTRU cryptosystem outperformed other cryptographic methods with an average latency of 35ms and a success rate of 99%, compared to CP-ABE's 95% and deniable encryption's 92%. The system also demonstrated high resilience to brute force attacks with a 100% detection rate and minimal false positives at 1 %. In terms of scalability, the system maintained a high success rate of 90% even when scaled to 2000 users. Overall, the proposed cryptographic strategy effectively balanced security, performance, and scalability, making it highly suitable for dynamic cloud environments with varying user demands and data security requirements. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Cloud Storage; CP-ABE; Cryptographic Strategy; Data Access Control; NTRU Cryptosystem; RBAC},
	keywords = {Cloud storage; Ciphertext-policy attribute-based encryptions; Cloud storages; Control access; Cryptographic strategy; CryptoGraphics; Data access control; Data control; Deniable encryptions; NTRU cryptosystem; Role-based Access Control; Cloud security},
