	pages = {},
	doi = {10.3390/electronics13142812},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85199654310&doi=10.3390%2Felectronics13142812&partnerID=40&md5=9dbcb8dfb3b6c6598d00ba6fe527ead2},
	affiliations = {Texas A and M International University, School of Engineering, Laredo, United States; Columbus State University, TSYS School of Computer Science, Columbus, United States; University of Nebraska Omaha, Omaha, United States},
	abstract = {Location-based services (LBS) offer various functionalities, but ensuring secure access to sensitive user data remains a challenge. Traditional access control methods often need more detail to enforce location-specific restrictions. This paper proposes a new approach that utilizes the Generalized Spatio-Temporal Role-Based Access Control Model (GSTRBAC) within the context of LBS. GSTRBAC grants access based on user credentials, authorized locations, and access times, providing a detailed approach to securing LBS data. We introduce an optimized cloud-based GSTRBAC implementation suitable for deployment in modern LBS architectures. The system uses two secure communication protocols tailored to different security requirements. This allows for efficient communication for less-sensitive data while offering robust protection for highly sensitive information. Additionally, a proof-of-concept mobile application demonstrates the system’s functionality and efficiency within an LBS environment. Our evaluation confirms the effectiveness of the cloud-based GSTRBAC implementation in enforcing location-specific access control while maintaining resource and time efficiency. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {access control; authorization; cloud computing; location-based services},
	correspondence_address = {M. Al Lail; School of Engineering, Texas A&M International University, Laredo, 78041, United States; email: mustafa.allail@tamiu.edu; A.J. Perez; Department of Computer Science, University of Nebraska at Omaha, Omaha, 68182, United States; email: alfredoperez@unomaha.edu},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
	issn = {20799292},
	language = {English},
	abbrev_source_title = {Electronics (Switzerland)},
	type = {Article},
