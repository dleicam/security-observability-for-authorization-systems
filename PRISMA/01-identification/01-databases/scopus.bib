}

@ARTICLE{Godly202267,
	author = {Godly, Cinthia Joy and Balasubramanian, Venki and Srinivasan, Ram and Jinila, Bevish Y.},
	title = {Adaptation of Blockchain in Internet of Medical Things for Remote Patient Monitoring},
	year = {2022},
