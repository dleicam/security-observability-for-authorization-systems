@ARTICLE{Santos Filho2020176,
	author = {Santos Filho, Reiner H. and Ferreira, Tadeu N. and Mattos, Diogo M.F. and Medeiros, Dianne S.V.},
	title = {A Rapid Fuzzy Controller for Decentralized Bandwidth Provisioning on a Multitenant Data Center},
	year = {2020},
	pages = {176 - 183},
	doi = {10.1109/NoF50125.2020.9249136},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85097607360&doi=10.1109%2FNoF50125.2020.9249136&partnerID=40&md5=a164ae325bca4eeaed08ee9d9f66db64},
	affiliations = {Universidade Federal Fluminense, Niteroi, Brazil},
	abstract = {The efficient management of cloud traffic leads to resource sharing among tenants. Meeting tenants' performance restrictions leads cloud providers to adopt strict resource allocation, which implies idle resources as tenants' bandwidth thresholds are over-provisioned. Commonly, cloud provides adopt the migration of virtual machines as a means to meet Service Level Agreements (SLA). Clustering, prediction and migration methods are usually studied in order to meet response time goals. We focus on complying with SLAs, distributing the available bandwidth to tenants according to their contracts, and allowing them to surpass the hired bandwidth, as in a pay-As-you-go bussiness model. In this paper, we propose a dynamic mechanism to provide on-demand network resources in a multitenant data center. Our mechanism relies on the deployment of a fuzzy controller to manage access of tenants to the cloud resources. The proposed mechanism measures the throughput of each tenant continuously. We assess our mechanism in an emulated environment, in which the fuzzy network controller provisions bandwidth according to the available measurements of the cloud load and bandwidth usage on a per-Tenant basis. Results show that the proposed mechanism reduces cloud idleness, allowing low-priority tenants to use bandwidth while there is idle capacity. © 2020 Elsevier B.V., All rights reserved.},
	author_keywords = {bandwidth provisioning; data center; Fuzzy logic},
