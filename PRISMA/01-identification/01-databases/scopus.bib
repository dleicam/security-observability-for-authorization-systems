	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85218209965&doi=10.1109%2FINNOVA63080.2024.10847054&partnerID=40&md5=fe7b6f5ee1a175ada9751f0ce23b82ff},
	affiliations = {BLDEA’s V. P. Dr. P. G. Halakatti College of Engineering and Technology, Dept. of ISE, Bijapur, India},
	abstract = {The utilization of cloud computing based services by healthcare providers has led to the easiest and inexpensive sharing of Personal Health Records(PHRs) to the various E-health system participants. However, storing private medical records of people on cloud servers increases the risk of theft or discovery. This necessitates the importance of creating procedures that secure PHR privacy. The mechanism known as Fortified Sharing of Confidential Health Records (FSCHR) is proposed for the protected sharing of PHRs in the cloud. In this approach the privacy of PHRs are maintained while guaranteeing patient-centric control. Usually, patients store their encrypted health records on untrusted cloud servers and provide varying user types access to different parts of the records. This approach successfully handles privacy concerns related to cloud-based health data storage by giving patient’s authority and utilizing encryption and access control measures. Its dependability is shown by formal analysis, which makes it a viable option for boosting PHR security and confidentiality in e-health systems. © 2025 Elsevier B.V., All rights reserved.},
