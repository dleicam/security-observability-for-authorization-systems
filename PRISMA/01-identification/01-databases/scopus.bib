}

@ARTICLE{Amezcua-Valdovinos202415594,
	author = {Amezcua-Valdovinos, Ismael and Millán, Patricia Elizabeth Figueroa and Guerrero-Ibáñez, Juan Antonio and Valdez, Ramona Evelia Chavez},
	title = {Design, Implementation, and Evaluation of an Embedded CoAP Proxy Server for 6LoWPAN},
	year = {2024},
	journal = {IEEE Access},
	volume = {12},
	pages = {15594 - 15608},
	doi = {10.1109/ACCESS.2024.3358678},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85183943765&doi=10.1109%2FACCESS.2024.3358678&partnerID=40&md5=486f0923b1b4560e35f0e62219227708},
	affiliations = {Universidad de Colima, Colima, Mexico; Tecnológico Nacional de México, Mexico City, Mexico},
	abstract = {Proxy servers are widely used in many contexts since they can enhance performance, security, and access control for production networks. The Constrained Application Protocol (CoAP), the de facto standard of Internet of Things (IoT) communications, specifies mechanisms and semantics to applications based on RESTful approach similar to HTTP. The CoAP standard defines an additional operation mode for proxying request, which is supported by several programming languages and platforms. However, there is no current implementation of a CoAP proxy for embedded systems, namely for devices supporting the Contiki-NG operating system. This paper discusses the design, implementation, and evaluation of a forward CoAP Proxy server for 6LoWPAN embedded systems with cache capabilities. We perform simulation and experimental evaluations with topologies involving up to three hops from the proxy to study performance in terms of response times and the number of exchanged packets. In simulation environments results show a 48.03%, 85.39%, and 134.21% in response time reduction at one, two, and three hops away. In experimental environments, results show that the use of our embedded CoAP Proxy server reduces response times in 7.46%, 30.67%, and 37.43% when requests are targeted to servers at one, two, and three hops away from the proxy respectively. In both scenarios, a reduction in the number of exchanged packets of 71.42%, 125%, and 166.66% for requests at each hop is achieved. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {6LoWPAN; Cache management; CoAP; embedded proxy; forward proxy},
	keywords = {Access control; Cache memory; Embedded systems; HTTP; IEEE Standards; Internet of things; Internet protocols; Response time (computer systems); Semantics; 6LoWPAN; Application protocols; Cache management; Cache storage; Constrained application protocol; Embedded proxy; Embedded-system; Forward proxy; IEEE 802.15 Standards; Performances evaluation; Time factors; Wireless sensor networks},
	correspondence_address = {P.E.F. Millan; Tecnológico Nacional de México/I.T Colima, Colima, 28976, Mexico; email: patricia.figueroa@colima.tecnm.mx},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {21693536},
	language = {English},
	abbrev_source_title = {IEEE Access},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Gold Open Access}
}

