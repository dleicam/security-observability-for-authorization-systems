	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85131463483&doi=10.1016%2Fj.cie.2022.108278&partnerID=40&md5=feb321888647ad131ae86a7abf24eae8},
	affiliations = {Jaypee University of Information Technology, Solan, Department of CSE & IT, Solan, India},
	abstract = {This paper addresses the problem of increasing chances of insider threats in cloud computing. In Database as a Service (DBaaS), where multiple dependencies exist among data. Insiders tries to infer knowledge on the bases of dependencies. There is a requirement of Insider threat prevention mechanism for DBaaS due to its dynamic nature. Various researchers have proposed a Single PDP and Multiple PEPs to solve this problem with the limitations on authentication, scalability, tracking of insiders. This research aims to fill the gap by providing an effective framework on access control mechanism designed to prevent insider threats using a Blockchain-based authentication mechanism, a distributed architecture-based, and insider activity tracking mechanism. The framework enables us to handle authentication mechanism, distributed DBaaS insider activity tracking. Experimental results show that this framework is effective, dynamic and scalable. The validation of this framework has been done with the help of synthetic data due to lack of standardized dataset and its applicability has been demonstrated with the help of a case study involving the use of real cloud data. © 2022 Elsevier B.V., All rights reserved.},
