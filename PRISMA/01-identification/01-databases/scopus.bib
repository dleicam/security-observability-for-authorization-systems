	keywords = {Access control; Biological organs; Cloud security; Cloud storage; Computerized tomography; Convolution; Denial-of-service attack; Diagnosis; Forecasting; Internet of things; Network security; Cloud-computing; Convolution neural network; Convolutional neural network; Disease prediction; fuzzy-TOPSIS; Golden search optimization; Internet of thing; Kernel convolution; Search optimization; Secure storage; Decision support systems},
