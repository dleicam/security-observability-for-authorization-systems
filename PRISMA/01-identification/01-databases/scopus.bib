@ARTICLE{Jayasree202395,
	author = {Jayasree, P. and Gupta, A. V.S.S.S. and Gudhanti, Shiva Naga Koteswara Rao and Fatima, Hajeera and Babu, Rekha Naresh and Budha, Roja Rani},
	title = {Patient monitoring using blockchain},
	year = {2023},
	pages = {95 - 106},
