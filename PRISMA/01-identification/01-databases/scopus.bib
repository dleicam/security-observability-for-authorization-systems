@ARTICLE{Shaik2018195,
	author = {Shaik, Amjan and Madhurima, B. and Neelakantappa, M.},
	title = {An approach to zero knowledge proof for secure data sharing in cloud storage: New direction},
	year = {2018},
	journal = {International Journal of Innovative Technology and Exploring Engineering},
	volume = {8},
	number = {2S},
	pages = {195 - 201},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85061811841&partnerID=40&md5=9504a46f0f11f0e357f6a64ac57967a9},
	affiliations = {},
	abstract = {Now a days, Cloud computing (CC) is seriously growing because of it’s strengths like elastic, flexible, on-demand storage and fast computing services for users. In cloud based storage concept, data owner does not have full control over own data because data controlled by the third party called cloud service providers (CSP). The most challenging issue in data security arises when the owner of the data shares to other through cloud. This issue is very common as data is shared in the cloud computing environment. This issue is addressed by few researchers through encryption techniques of cryptography to provide secure data-sharing on the cloud. In this paper, we propose a model to provide security of shared data on cloud in terms of access control and data confidentiality. This system eliminates the need of key management and file encryptions and descriptions by the users. It also supports dynamic changes of user permissions (Read,Write), there by removes the need of owner to be always online during user accessing of data from cloud. In this system, we extended the notion of zero-knowledge proofs of the membership (that reveals 1 bit of information) to zero-knowledge proofs of the knowledge(that reveals no information at all). The common weakness of conventional communication protocols is they are vulnerable to the impersonation attacks. Each time this type of protocol is executed, the system degrades due to the threat of an eavas-dropper listening the communication. The main objective of this designed system is that it makes possible for a prover for convincing a verifier of his knowledge of a certain secret without revealing any information apart from validity of his claim. © 2019 Elsevier B.V., All rights reserved.},
