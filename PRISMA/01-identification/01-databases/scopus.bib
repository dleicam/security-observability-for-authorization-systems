	keywords = {Access control; Application programs; Commerce; Computer control systems; Data privacy; HTTP; Information management; Information systems; Information use; Infrastructure as a service (IaaS); Real time systems; Risk assessment; Security systems; Service industry; Application security; Critical reflections; Cross-site scripting; Development method; Security analysis; Security vulnerabilities; Session management; Traditional commerce; Safety engineering},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9781728153650},
	language = {English},
	abbrev_source_title = {SYSCON - Annu. IEEE Int. Syst. Conf., Proc.},
