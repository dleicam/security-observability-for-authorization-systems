	title = {Multi-authority fine-grained access control with accountability and its application in cloud},
	year = {2018},
	journal = {Journal of Network and Computer Applications},
	volume = {112},
	pages = {89 - 96},
	doi = {10.1016/j.jnca.2018.03.006},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85044942018&doi=10.1016%2Fj.jnca.2018.03.006&partnerID=40&md5=43e68e176d88e5b0d32b6d5c8d9b554e},
	affiliations = {Guangzhou University, Department of Computer Science, Guangzhou, China; Xidian University, Key Laboratory of Computer Networks and Information Security, Xi'an, China; Chinese University of Hong Kong, Department of Information Engineering, Hong Kong, Hong Kong; South China Agricultural University, College of Informatics, Guangzhou, China; ASTRI, Security and Data Sciences Technology Division, Hong Kong, Hong Kong; Nankai University, College of Computer and Control Engineering, Tianjin, China},
	abstract = {Attribute-based encryption (ABE) is one of critical primitives for the application of fine-grained access control. To reduce the trust assumption on the attribute authority and in the meanwhile enhancing the privacy of users and the security of the encryption scheme, the notion of multi-authority ABE with an anonymous key issuing protocol has been proposed. In an ABE scheme, it allows to encrypt data for a set of users satisfying some specified attribute policy and any leakage of a decryption key cannot be associated to a user. As a result, a misbehaving user could abuse the property of access anonymity by sharing its key other unauthorized users. On the other hand, the previous work mainly focus on the key-policy ABE, which cannot support ciphertext-policy access control. In this paper, we propose a privacy-aware multi-authority ciphertext-policy ABE scheme with accountability, which hides the attribute information in the ciphertext and allows to trace the dishonest user identity who shares the decryption key. The efficiency analysis demonstrates that the new scheme is efficient, and the computational overhead in the tracing algorithm is only proportional to the length of the identity. Finally, we also show how to apply it in cloud computing to achieve accountable fine-grained access control system. © 2018 Elsevier B.V., All rights reserved.},
	author_keywords = {Access control; Accountability; Anonymity; Attribute-based encryption; Ciphertext-policy; Multi-authority; Recipient-privacy},
	keywords = {Access control; Computational efficiency; Data privacy; Distributed computer systems; Accountability; Anonymity; Attribute-based encryptions; Ciphertext policies; Multi authorities; Recipient privacies; Cryptography},
	correspondence_address = {J. Li; Department of Computer Science, Guangzhou University, China; email: lijin@gzhu.edu.cn},
