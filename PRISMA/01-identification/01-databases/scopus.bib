	keywords = {Application programming interfaces (API); Health care; Interface states; Interoperability; Query languages; Applications programming interfaces; Broken function level authorization; Broken object level authorization; Control solutions; Fast healthcare interoperability resource; Functions level; Graphql; Healthcare Interoperability; Representational state transfer; Role-based Access Control; Authorization},
	correspondence_address = {M.S. Baihan; King Saud University, Community College, Department of Computer Science, Riyadh, Saudi Arabia; email: malbaihan@ksu.edu.sa},
