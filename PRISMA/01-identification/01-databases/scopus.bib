@ARTICLE{Sakya20241837,
	author = {Sakya, Gayatri and Yadav, Vrattica and Shukla, Saumya and Gupta, Aditi and Shakya, Rajeev Kumar},
	title = {An Intelligent IoT Based Landfill Fire Prediction and Prevention System},
	year = {2024},
	journal = {Wireless Personal Communications},
	volume = {139},
