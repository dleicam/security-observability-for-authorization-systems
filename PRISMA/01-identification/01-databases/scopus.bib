}

@ARTICLE{Abdul2022,
	author = {Abdul, Arif Mohammad and Mohammad, Arshad Ahmad Khan and Reddy, Patlolla Venkat and Nuthakki, Praveena and Kancharla, Rakesh and Joshi, Rahul Raghvendra and Kannaiya Raja, N.},
	title = {Enhancing Security of Mobile Cloud Computing by Trust- and Role-Based Access Control},
	year = {2022},
	journal = {Scientific Programming},
	volume = {2022},
