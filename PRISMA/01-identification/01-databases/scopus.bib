	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85041206227&doi=10.1109%2FTSC.2018.2791538&partnerID=40&md5=950def8069b184bfea804eab49c395a4},
	affiliations = {National University of Singapore, Department of Computer Science, Singapore City, Singapore; East China Normal University, Shanghai, China; University of Surrey, Department of Computer Science, Guildford, United Kingdom; Shanghai Ocean University, School of Information Technology, Shanghai, China; The University of Texas at San Antonio, Department of Information Systems and Cyber Security, San Antonio, United States},
	abstract = {Secure cloud storage, which is an emerging cloud service, is designed to protect the confidentiality of outsourced data but also to provide flexible data access for cloud users whose data is out of physical control. Ciphertext-Policy Attribute-Based Encryption (CP-ABE) is regarded as one of the most promising techniques that may be leveraged to secure the guarantee of the service. However, the use of CP-ABE may yield an inevitable security breach which is known as the misuse of access credential (i.e., decryption rights), due to the intrinsic 'all-or-nothing' decryption feature of CP-ABE. In this paper, we investigate the two main cases of access credential misuse: one is on the semi-trusted authority side, and the other is on the side of cloud user. To mitigate the misuse, we propose the first accountable authority and revocable CP-ABE based cloud storage system with white-box traceability and auditing, referred to as CryptCloud++. We also present the security analysis and further demonstrate the utility of our system via experiments. © 2021 Elsevier B.V., All rights reserved.},
