@ARTICLE{Kumar202577,
	author = {Kumar, Shashwat Ananda and Chuli, Anannya and Raj, Shivam and Jain, Aditi and Aju, D.},
	title = {SecureCloudX: An Innovative Approach to Enhance Data Security Through Advanced File Encryption},
	year = {2025},
	journal = {Communications in Computer and Information Science},
	volume = {2205},
	pages = {77 - 97},
	doi = {10.1007/978-3-031-81458-7_6},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85219204006&doi=10.1007%2F978-3-031-81458-7_6&partnerID=40&md5=d125443f40d872875f3b66766dab491f},
	affiliations = {Vellore Institute of Technology, School of Computer Science and Engineering, Vellore, India},
	abstract = {Cloud storage’s popularity is undeniable, yet data security remains a critical concern. Existing encryption methods often struggle with granular access control or suffer from single points of failure. SecureCloudX presents a novel and robust approach for securing cloud data. It leverages a synergistic combination of Threshold Cryptography and the Digital Signature Algorithm (DSA) to achieve the core principles of the CIA triad: confidentiality, integrity, and authenticity. SecureCloudX generates a cryptographically secure key, fragments it using Threshold Cryptography, and distributes the shares among authorized parties. This ensures that no single entity can decrypt the data independently, promoting strong access control. Additionally, DSA verifies data integrity and prevents unauthorized tampering by utilizing digital signatures. A comprehensive evaluation with 20 diverse test cases demonstrates SecureCloudX’s effectiveness. It achieved a 92% decryption success rate, surpassing existing solutions in security. The evaluation covered various scenarios, including basic functionality tests, advanced security checks, and performance assessments. While issues like inadequate available keys or duplicate inputs arose in some cases, SecureCloudX successfully verified digital signatures, shared secret codes securely, and ensured secure cloud file uploads. In conclusion, SecureCloudX offers a significant contribution to secure data management in the cloud by mitigating unauthorized access and data tampering. Its seamless integration of Threshold Cryptography and DSA fosters robust data security, making it a valuable solution for cloud storage environments. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Cloud Computing; Data Privacy; Digital Signature Algorithm; SecureCloudX; Threshold Cryptography},
	keywords = {Cloud security; Cloud storages; Cloud-computing; Digital signature algorithms; Encryption methods; File encryption; Innovative approaches; Robust approaches; Securecloudx; Single point; Threshold cryptography; Data integrity},
