}

@CONFERENCE{Fotiou2024,
	author = {Fotiou, Nikos and Kyriakidou, Chalima Dimitra Nassar and Papathanasiou, Athanasia Maria and Pittaras, Iakovos and Thomas, Yannis and Xylomenos, George},
	title = {Certificate Management for Cloud-Hosted Digital Twins},
	year = {2024},
