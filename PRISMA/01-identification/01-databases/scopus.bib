@ARTICLE{Somda20253,
	author = {Somda, Metouole Mwinbe Yves Ghislain and Outtoumane, Tahar and Ouya, Samuel and Mendy, Gervais},
	title = {Data-Driven Open Finance: A Novel Architecture for Financial Inclusion in Developing Countries},
	year = {2025},
	journal = {Communications in Computer and Information Science},
	volume = {2357 CCIS},
	pages = {3 - 14},
	doi = {10.1007/978-981-96-7178-6_1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013267774&doi=10.1007%2F978-981-96-7178-6_1&partnerID=40&md5=ee2944a9ea57a6114451e7042eb4ae85},
	affiliations = {Université Cheikh Anta Diop de Dakar, de Télécommunication et Applications), Dakar, Senegal},
	abstract = {Innovation in finance is crucial for developing countries to reduce poverty and achieve financial inclusion. By enabling interoperability of financial big data among all actors, Open Finance can promote innovation and competition. However, existing Open Finance models do not address the specific challenges of the African financial ecosystem, characterized by outdated IT infrastructure and high mobile channel usage. This study proposes a simple, secure, and cost-effective Open Finance solution that processes large volumes of financial data using open-source technologies like Keycloak as an identity provider. The architecture enables rapid deployment of Open Finance infrastructure in West African countries and is applicable to any developing nation. We implemented and tested the system by simulating an account aggregator accessing financial data from banks and mobile money operators. The results demonstrate secure sharing of user financial information and initiation of account-to-account transactions with user consent. The proposed architecture simplifies financial data sharing while ensuring data security and confidentiality, marking the first contribution to propose an Open Finance deployment infrastructure for developing countries. © 2025 Elsevier B.V., All rights reserved.},
