@ARTICLE{Xu2024,
	author = {Xu, Mudi and Chen, Benfeng and Tan, Zhizhong and Chen, Shan and Wang, Lei and Liu, Yan and San, Tai Io and Fong, Souwang and Wang, Wenyong and Feng, Jing},
	title = {AHAC: Advanced Network-Hiding Access Control Framework},
	year = {2024},
	journal = {Applied Sciences (Switzerland)},
	volume = {14},
	number = {13},
	pages = {},
	doi = {10.3390/app14135593},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85198480081&doi=10.3390%2Fapp14135593&partnerID=40&md5=8f85052f2d76f9bcf28f8a80da4a00f1},
	affiliations = {Macau University of Science and Technology, School of Computer Science and Engineering, Taipa, Macao; The Hong Kong University of Science and Technology (Guangzhou), Guangzhou, China; Ltd., Hangzhou, China; Ltd., Macau, Macao; China Telecom Corporation Limited, Beijing, China},
	abstract = {In the current context of rapid Internet of Things (IoT) and cloud computing technology development, the Single Packet Authorization (SPA) protocol faces increasing challenges, such as security threats from Distributed Denial of Service (DDoS) attacks. To address these issues, we propose the Advanced Network-Hiding Access Control (AHAC) framework, designed to enhance security by reducing network environment exposure and providing secure access methods. AHAC introduces an independent control surface as the access proxy service and combines it with a noise generation mechanism for encrypted access schemes, replacing the traditional RSA signature method used in SPA protocols. This framework significantly improves system security, reduces computational costs, and enhances key verification efficiency. The AHAC framework addresses several limitations inherent in SPA: users need to know the IP address of resources in advance, exposing the resource address to potential attacks; SPA’s one-way authentication mechanism is insufficient for multi-level authentication in dynamic environments; deploying the knocking module and protected resources on the same host can lead to resource exhaustion and service unavailability under heavy loads; and SPA often uses high-overhead encryption algorithms like RSA2048. To counter these limitations, AHAC separates the Port Knocking module from the access control module, supports mutual authentication, and implements an extensible two-way communication mechanism. It also employs ECC and ECDH algorithms, enhancing security while reducing computational costs. We conducted extensive experiments to validate AHAC’s performance, high availability, extensibility, and compatibility. The experiments compared AHAC with traditional SPA in terms of time cost and performance. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {access control; DDoS attacks; network security; port knocking; single packet authorization (SPA); zero trust},
	keywords = {Authentication; Authorization; Cost reduction; Cryptography; Denial-of-service attack; Internet of things; Internet protocols; Packet networks; Advanced networks; Computational costs; Control framework; Denialof- service attacks; Distributed denial of service; Distributed denial of service attack; Networks security; Port knocking; Single packet authorization; Zero trust; Network security},
	correspondence_address = {W. Wang; School of Computer Science and Engineering, Macau University of Science and Technology, 999078, Macao; email: wywang@must.edu.mo; J. Feng; China Telecom Co., Ltd. Sichuan Branch, Chengdu, 610000, China; email: 15328080777@189.cn},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
	issn = {20763417},
	language = {English},
	abbrev_source_title = {Appl. Sci.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Gold Open Access}
}

@ARTICLE{Al-Milli20245033,
	author = {Al-Milli, Nabeel Refat and Jobair, Zeyad and Al-Mousa, Mohammad Rasmi and Al-Shaikh, Ala'a and Asassfeh, Mahmoud Rajallah and Alazaidah, Raed and Al-Daoud, Essam F.},
	title = {DATA INTEGRITY CONCERNS, REQUIREMENTS, AND PROOFING IN CLOUD COMPUTING},
