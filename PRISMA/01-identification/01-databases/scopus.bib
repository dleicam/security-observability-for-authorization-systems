	doi = {10.1016/j.iot.2024.101430},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85210309529&doi=10.1016%2Fj.iot.2024.101430&partnerID=40&md5=d7022de0269c7f6fcdaba4b5f3f80312},
	affiliations = {Universidad Carlos III de Madrid, Department of Telematic Engineering, Getafe, Spain},
	abstract = {Authorization models are pivotal in the Internet of Things (IoT) ecosystem, ensuring secure management of data access and communication. These models function after authentication, determining the specific actions that a device is allowed to perform. This paper aims to provide a comprehensive and comparative analysis of authorization solutions within IoT contexts, based on the requirements identified from the existing literature. We critically assess the functionalities and capabilities of various authorization solutions, particularly those designed for IoT cloud platforms and distributed architectures. Our findings highlight the urgent need for further development of authorization models optimized for the unique demands of IoT environments. Consequently, we address both the persistent challenges and the gaps within this domain. As IoT continues to reshape the technological landscape, the refinement and adaptation of authorization models remain imperative ongoing pursuits. © 2024 Elsevier B.V., All rights reserved.},
