	keywords = {Application programming interfaces (API); Application programs; Codes (symbols); Data Sharing; Memory architecture; Memory management; Pipeline processing systems; Program compilers; Programmed control systems; Storage allocation (computer); Virtual reality; Virtualization; Data planes; Data-plane; Line rate; Memory-sharing; On chips; Packet processing; Programmable data plane; Register memory sharing; Static approach; Virtualizations; Pipelines},
