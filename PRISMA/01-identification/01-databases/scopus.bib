	author = {Wang, Ti and Ma, Hui and Zhou, Yongbin and Zhang, Rui and Song, Zishuai},
	title = {Fully Accountable Data Sharing for Pay-as-You-Go Cloud Scenes},
	year = {2021},
	journal = {IEEE Transactions on Dependable and Secure Computing},
	volume = {18},
