}

@ARTICLE{Ali2020105,
	author = {Ali, Ahmad and Ahmed, Mansoor and Imran, Muhammad Kashif and Khattak, Hasan Ali},
	title = {Security and privacy issues in fog computing},
	year = {2020},
	pages = {105 - 137},
	doi = {10.1002/9781119551713.ch5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85096548329&doi=10.1002%2F9781119551713.ch5&partnerID=40&md5=d37bce2886ffec10dbaebc65b18ee6eb},
	affiliations = {COMSATS University Islamabad, Department of Computer Science, Islamabad, Pakistan},
	abstract = {Fog computing is now becoming prominent among users due to its on-demand services and dynamic resource allocations. Resource allocation and scheduling is a critical task in cloud computing. Cloud resource management is based upon two main parts, which are: (1) state information collection and (2) scheduling decision making. In state information collection, a machine is responsible to collect information related to the current utilization of cloud resources. Based on the state information, the cloud resources are allocated according to scheduling decision making. The key purpose of scheduling is to attain good computing performance and to reduce the system cost. Security and privacy are becoming the key requirements with the huge influx of these millions of devices. The presence of security, privacy, and accountability measures establish trust among its stakeholders. It is dependent on the measures taken for the availability, accountability of security, and privacy of users’ data and services in the fog, as well as sharing these statistics with the stakeholders. Any type of lapses in measures for security and privacy shatters user trust. This chapter provides a comprehensive review for trust management in machine to machine communications that lays the ground for trust establishment in fog computing. Comparative studies of authentication, authorization, and privacy measures are carried out while the role of service layer agreements (SLA) is discussed as well, followed by implementation issues and discussion based on a healthcare scenario. A taxonomy is presented that outlines the strategies used for trust management in fog. We have provided a detailed reference table of research work performed in this context. We also described the merits and demerits of each technique. This work will be equally helpful for researchers to have a global overview of existing fog trust management techniques. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {Fog computing; Fog-enabled infrastructures; Privacy issues; Security issues; Web semantics},
	publisher = {wiley},
	isbn = {9781119551713; 9781119551690},
	language = {English},
	abbrev_source_title = {Fog Computing: Theory and Practice},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 27}
}

