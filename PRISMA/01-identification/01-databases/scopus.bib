	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85161163816&doi=10.1007%2Fs42979-023-01807-z&partnerID=40&md5=db5e8484899d75a1ec9a57233ce3de54},
	affiliations = {Amity University Madhya Pradesh, Gwalior, India},
	abstract = {Cloud computing refers to a network-enabled service that allows users to access large data centres and web services through the internet. A hybrid cloud comprises of both private and public clouds that allows users to integrate resources and increase performance. The biggest challenge in hybrid cloud computing is information security protection, especially user authentication. Kerberos is an authentication protocol used in cloud computing to secure network transactions. A new service model is proposed to enhance the cloud security services by filtering unauthorized access and reducing memory usage on the service provider. The proposed model combines Kerberos Authentication Protocol and Resource Allocation Manager Unit (RAMU) to secure a multi-tenant hybrid cloud. This provides expandable access to resources and improves consumer confidentiality and security. The model verifies the user's request before granting access, preventing the password from being exposed to hackers during transmission. The request is validated by the Key Distribution Centre (KDC) and granted access by RAMU after checking the control database and resource allocation map. Performance evaluation of the proposed model demonstrated that it has a lower response time, lower message response time, and lower AP creation time than Access Control as a Service (ACaaS), proving its computational efficiency and speed. This study combines Kerberos authentication with a ticket-granting approach for improved security solutions for hybrid cloud. A novel methodology is presented to address issues with illegal access to the cloud. This article is concluded with comparative analysis between proposed model and existing methods and how proposed model achived enhanced security solutions. In future work, the model can be enhanced with blockchain-based solution which may include combined approach in real-world settings for measuring computation time. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Access control as a service (ACaaS); Cloud computing; Cloud security; Kerberos; Kerberos authentication protocol (KAP); Key distribution centre (KDC); Resource allocation manager unit (RAMU); Virtual machine (VM)},
	correspondence_address = {S.K. Tiwari; Amity School of Engineering and Technology, Amity University Madhya Pradesh, Gwalior, Madhya Pradesh, India; email: sshiv.tiwari22@gmail.com},
