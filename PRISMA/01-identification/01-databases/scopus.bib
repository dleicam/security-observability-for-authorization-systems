}

@ARTICLE{Schmitz202243,
	author = {Schmitz, Guido},
	title = {Privacy-preserving Web single sign-on: Formal security analysis and design},
	year = {2022},
	journal = {IT - Information Technology},
	volume = {64},
	number = {1-2},
	pages = {43 - 48},
	doi = {10.1515/itit-2022-0003},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85125994470&doi=10.1515%2Fitit-2022-0003&partnerID=40&md5=e54bb2a9e05e0d1d45ac3c8cfbf48697},
	affiliations = {Royal Holloway, University of London, Information Security Group, Egham, United Kingdom},
	abstract = {Single sign-on (SSO) systems, such as OpenID and OAuth, allow Web sites to delegate user authentication to third parties, such as Facebook or Google. These systems provide a convenient mechanism for users to log in and ease the burden of user authentication for Web sites. Conversely, by integrating such SSO systems, they become a crucial part of the security of the modern Web. So far, it has been hard to prove if Web standards and protocols actually meet their security goals. SSO systems, in particular, need to satisfy strong security and privacy properties. In this thesis, we develop a new systematic approach to rigorously and formally analyze and verify such strong properties with the Web Infrastructure Model (WIM), the most comprehensive model of the Web infrastructure to date. Our analyses reveal severe vulnerabilities in SSO systems that lead to critical attacks against their security and privacy. We propose fixes and formally verify that our proposals are sufficient to establish security. Our analyses, however, also show that even Mozilla's proposal for a privacy-preserving SSO system does not meet its unique privacy goal. To fill this gap, we use our novel approach to develop a new SSO system, SPRESSO, and formally prove that our system indeed enjoys strong security and privacy properties. © 2022 Elsevier B.V., All rights reserved.},
	author_keywords = {authentication; formal analysis; privacy; single sign-on; web security},
	keywords = {Network security; Privacy-preserving techniques; Websites; Formal analysis; Privacy; Privacy preserving; Property; Security and privacy; Single sign on; Single signs-on; User authentication; WEB security; Web-sites; Authentication},
	correspondence_address = {G. Schmitz; Royal Holloway University of London, Information Security Group, Egham, Surrey, United Kingdom; email: Guido.Schmitz@rhul.ac.uk},
