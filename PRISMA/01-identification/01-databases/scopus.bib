	year = {2022},
	journal = {International Journal of Information and Computer Security},
	volume = {17},
	number = {1-2},
	pages = {1 - 20},
	doi = {10.1504/IJICS.2022.121288},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85127069016&doi=10.1504%2FIJICS.2022.121288&partnerID=40&md5=85f527b76b906961a6738495a2b68c78},
	affiliations = {Kalasalingam Academy of Research and Education, Department of Information Technology, Krishnankoil, India},
	abstract = {The isolation of sensitive attributes in the customer profile and the uploading of encrypted data to the multi-server-based cloud are the major issues in the existing applications. This paper proposes the novel rule-based statistical disclosure method (RSDM) and access control policy-based access restriction (ACPAR) to integrate the activities of sensitive attribute prediction and the data uploading stages in cloud computing. Initially, the normalisation based on the hide and visibility metric assignment to the fields in the dataset used to isolate the sensitive and normal attributes in the customer profile. Then, the data encryption is performed through proliferate ElGamal algorithm sequentially and stored into the cloud. The RSDM serves as the base for sensitive data isolation. Then, the access control policy is designed to control the profile-viewing ability to assure the security. The proposed work decrypts the data associated with the denormalised profile for integrity. © 2022 Elsevier B.V., All rights reserved.},
