}

@ARTICLE{Khan2023140914,
	author = {Khan, Muzammil Ahmad and Khan, Shariq Mahmood and Subramaniam, Siva Kumar},
	title = {Secured Dynamic Request Scheduling and Optimal CSP Selection for Analyzing Cloud Service Performance Using Intelligent Approaches},
	year = {2023},
	journal = {IEEE Access},
	volume = {11},
	pages = {140914 - 140933},
	doi = {10.1109/ACCESS.2023.3339378},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85179807481&doi=10.1109%2FACCESS.2023.3339378&partnerID=40&md5=430aa3283c9c65f65c0dbea43531157b},
	affiliations = {Sir Syed University of Engineering and Technology, Department of Computer Engineering, Karachi, Pakistan; NED University of Engineering & Technology, Department of Computer Science and Information Technology, Karachi, Pakistan; Universiti Teknikal Malaysia Melaka, Faculty of Electronic and Computer Engineering, Malacca, Malaysia},
	abstract = {Due to its heterogeneity, cloud services providers' (CSPs) rapid expansion presents several challenges, such as optimal service selection and privacy preservation. Multiple users using the cloud service at once increases the delay for service selection and request. Service interruptions result from centralized provisioning and insecurity. Existing work constraints include access control loss, service disruptions, security issues, trust management issues, and delays. Blockchain-based request scheduling and optimal CSP selection in edge-assisted clouds were presented in this research. Five phases - Data User (DS) authentication, sensitivity-aware request scheduling, policy verification, trust management, and optimal CSP selection - are proposed. In the first phase, DU authentication detects and eliminates authorized users. We suggested a chaotic map-based camellia encryption algorithm (CMCE) to boost security. The gateway schedules service requests using Johnson's rule-based Stochastic Gradient Descent method, considering delay, throughput, and priority, in the second phase. This schedules the request into sensitive and non-sensitive services. Policy verification is done in the third phase utilizing Dynamic Policy-based Access control, which allows only sensitive requests. In phase four, we calculate the CSP trust value to boost security. Based on CSP behavior, we introduced the Multi Behavior Analysis-based Nomadic People Optimizer method. Every CSP's trust value is modified based on user feedback over time. Finally, the best CSP is chosen for data user service, and suggested Dynamic and non-cooperative Game Theory is to choose the best CSP from a list. CloudSim is used to simulate and assess. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Blockchain; cloud computing; edge; scheduling},
	keywords = {Blockchain; Chaotic systems; Computation theory; Cryptography; Data privacy; Edge computing; Game theory; Optimization; Quality of service; Trusted computing; Block-chain; Cloud-computing; Delay; Edge; Privacy; Processor scheduling; Quality-of-service; Scheduling; Security; Authentication},
	correspondence_address = {M.A. Khan; Sir Syed University of Engineering and Technology, Department of Computer Engineering, Karachi, 75300, Pakistan; email: muzammilahmad.khan@gmail.com},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {21693536},
	language = {English},
	abbrev_source_title = {IEEE Access},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6; All Open Access; Gold Open Access}
}

@ARTICLE{Sanchol2023145915,
	author = {Sanchol, Pattavee and Fugkeaw, Somchart},
	title = {A Fully Outsourced Attribute-Based Signcryption Scheme Supporting Privacy-Preserving Policy Update in Mobile Cloud Computing},
	year = {2023},
	journal = {IEEE Access},
	volume = {11},
	pages = {145915 - 145930},
	doi = {10.1109/ACCESS.2023.3341095},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85179782262&doi=10.1109%2FACCESS.2023.3341095&partnerID=40&md5=74c2cca14393a9b2d3b6852eae917024},
	affiliations = {Sirindhorn International Institute of Technology Thammasat University, Computer, Khlong Luang, Thailand},
	abstract = {Existing fine-grained and secure access control systems deployed in mobile cloud computing (MCC) typically focus on offloading encryption and/or decryption workloads to the delegated proxy in the cloud server. However, the privacy and authenticity management of outsourced data with flexible and efficient access policy update in MCC is generally overlooked by existing works. In fact, the signcryption feature is generally required in data access control system where the trust between data owner and multiple mobile users is crucial while the policy update management deals with the dynamic handling of user privilege control lifecycle. In this paper, we propose a privacy-preserving access control scheme supporting signcryption and efficient policy update with policy hiding in MCC setting. Essentially, a fully outsourced attribute-based signcryption (ABSC) and policy update method are devised to allows the data owner to offload ABS operation and policy update cost to be executed by the delegated proxy. Finally, we present our experiments to demonstrate that our proposed scheme is computationally more efficient compared to related works. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {ABSC; Access control; CP-ABE; key transformation; mobile cloud; policy update},
	keywords = {Access control; Information management; Mobile cloud computing; Privacy-preserving techniques; Access control systems; Attribute-based; Attribute-based signcryption; CP-ABE; Key transformation; Mobile clouds; Policy update; Privacy preserving; Signcryption; Signcryption schemes; Control systems},
	correspondence_address = {S. Fugkeaw; Sirindhorn International Institute of Technology, Thammasat University, School of Information, Computer, and Communication Technology (ICT), Pathum Thani, 12121, Thailand; email: somchart@siit.tu.ac.th},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {21693536},
	language = {English},
	abbrev_source_title = {IEEE Access},
