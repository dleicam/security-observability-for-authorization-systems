	year = {2023},
	pages = {1529 - 1532},
	doi = {10.1109/PEEIC59336.2023.10450314},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85188113257&doi=10.1109%2FPEEIC59336.2023.10450314&partnerID=40&md5=bcc05aad225f8e8b18d62792679e14b1},
	affiliations = {Maharishi University of Information Technology, Maharishi School of Engineering & Technology, Lucknow, India; JAIN (Deemed-to-be University), Department of Computer Science, Bengaluru, India; Vivekananda Global University, Department of Electrical Engineering, Jaipur, India},
	abstract = {The objective of this research is to present an innovative security architecture designed to safeguard user data within a cloud context. This state-of-the-art security framework incorporates digital signature methods, access control mechanisms, and encryption and decryption processes. Introducing a novel key generation procedure utilizing elliptic curve cryptography ensures the generation of highly secure keys. Furthermore, we introduce a unique Identity-based Elliptic Curve Access Control technique (Id-EAC) to regulate data access provided by users across various data types. In addition, to enhance user data security in the cloud environment, we propose a two-phase encryption and decryption technique based on binary values. Lastly, to ensure data integrity within this security framework, we propose a Lightweight Virtual Signature Algorithm built around a modulo function. The security architecture guarantees users high levels of data safety, convenience, and integrity. Experimental findings demonstrate that the techniques proposed in this framework outperform current methods in terms of both performance and security. © 2024 Elsevier B.V., All rights reserved.},
