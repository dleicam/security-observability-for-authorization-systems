	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105015858203&doi=10.1109%2FJIOT.2025.3606577&partnerID=40&md5=6846e164a60afb772d442a06240fec6c},
	affiliations = {Xi'an Jiaotong University, College of Computer Science and Technology, Xi'an, China},
	abstract = {Cloud computing has transformed data sharing by enabling flexible and scalable services, making it easier for organizations to store and process large amounts of data. However, security remains a critical concern, especially for sensitive data outsourced to third-party servers. Protecting data confidentiality and ensuring that only authorized users can access it are key challenges. Attribute-Based Encryption with Keyword Search (ABKS) has emerged as a promising solution for finegrained access control, but it requires a trusted authority to issue decryption keys. If an attacker compromises the central authority and leaks its keys, the privacy and security of users will face significant challenges, resulting in significant security risks. To address these issues, we propose the first practical implementation of Registered-based Revocable Attribute-based Encryption with Keyword Search for Secure Cloud Data Sharing. Our scheme introduces a novel revocation mechanism based on registered-based ABKS scheme, enabling the secure and efficient revocation of user privileges without compromising scheme security. Additionally, we incorporate conjunctive keyword search functionality, allowing users to perform secure and reliable data retrieval while maintaining data confidentiality. Through comprehensive security analysis and extensive experiments, we demonstrate the effectiveness and robustness of our solution, ensuring both security and practical usability for data sharing, making it a viable and scalable option for real-world applications. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {conjunctive keyword search; Registered-based attribute-based encryption with keyword search; revocation mechanism; Secure Cloud Data Sharing},
