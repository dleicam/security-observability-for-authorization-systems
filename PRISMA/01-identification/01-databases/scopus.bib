@ARTICLE{Kalyana Kumar20197079,
	author = {Kalyana Kumar, A. S. and Abdul Razak, T.},
	title = {Secure and smart monitoring of sensitive data in cloud computing using effective cryptographic scheme},
	year = {2019},
	journal = {International Journal of Engineering and Advanced Technology},
	volume = {9},
	number = {1},
	pages = {7079 - 7086},
