	year = {2021},
	journal = {International Journal of Advanced Computer Science and Applications},
	volume = {12},
	number = {5},
	pages = {245 - 257},
	doi = {10.14569/IJACSA.2021.0120531},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85107770248&doi=10.14569%2FIJACSA.2021.0120531&partnerID=40&md5=5837710b82a5e681ddd37ed2bc4ba782},
	affiliations = {Vels Institute of Science, Technology & Advanced Studies, Chennai, India; Vels Institute of Science, Technology & Advanced Studies, School of Computer Science, Chennai, India},
	abstract = {Cloud computing offers several services, such as storage, software, networking, and other computing services. Cloud storage is a boon for big data and big data owners. Although big data owners can easily avail cloud storage without spending much on infrastructure and software to manage their data, security is a big issue, and protecting the outsourced big data is challenging and ongoing research. Cloud service providers use the attribute-based access control model to detect malicious intruders and address the security requirements of today’s new computing technologies. Anomalies in security policies are removed to improve the efficiency of the access control model. This paper implements a novel clustering approach to cluster security policies. Our proposed approach uses a rule-specific cluster merging technique that compares the rule with the clusters where the probability of similarity is high. Hence this technique reduces the cost, time, and complexity of clustering. Rather than verifying all rules, detecting and removing anomalies in every cluster of rules improve the performance of the intrusion detection system. Our novel clustering approach is useful for the researchers and practitioners in the ABAC policy validation. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {Anomalies; attribute-based access control model; big data; cloud storage; clustering; intrusion detection system; security policy},
