	title = {Enforcing Multilevel Security Policies in Unstable Networks},
	year = {2022},
	journal = {IEEE Transactions on Network and Service Management},
	volume = {19},
	number = {3},
	pages = {2349 - 2365},
	doi = {10.1109/TNSM.2022.3176820},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85131749571&doi=10.1109%2FTNSM.2022.3176820&partnerID=40&md5=0d1a2ebadf18eab5fe5b8dc5f167be05},
	affiliations = {Pennsylvania State University, University Park, United States; Technische Universität München, Institute of Communication Networks, Munich, Germany},
	abstract = {Multilevel security (MLS) systems control access to data by formalizing permissible and impermissible information flows between data sources and destinations (e.g., database servers and clients) fixed with distinct security labels. In computer networks, MLS systems have been used to prevent unauthorized data disclosure in shared-infrastructure settings where network hosts and devices may fall within different trust domains (e.g., in multi-tenant cloud networks or wireless mesh networks). However, current MLS systems assume static network behavior-thus preventing the network from being practically usable in the presence of dynamic network events that frequent unstable network environments, including sudden changes in traffic patterns, link failures, and topology changes as a result of device movement or intermittent device connectivity. In this paper, we introduce MLS-Enforcer, a software-defined networking (SDN) controller application that can efficiently deploy network-level MLS policies while retaining the ability to securely relabel network nodes under changing topology state and network traffic demands. We model network adaptivity as an integer linear programming problem that reflects a given security policy. We then introduce heuristic relabeling algorithms that achieve near-optimal performance and are more tractable and efficient for larger networks. We validate MLS-Enforcer on several network topologies and traffic loads, demonstrating that it can relabel the network to route 90%+ of flows under normal conditions and quickly converge (on the order of seconds for the heuristic algorithms) under changing needs-from small network structure changes to catastrophic failures. This shows that formally secured networks can feasibly be deployed in diverse, changing, and unpredictable environments. © 2022 Elsevier B.V., All rights reserved.},
	author_keywords = {multilevel security; optimization; SDN; security management; security services; Software-defined networking; wireless network security},
	keywords = {Access control; Application programs; Heuristic algorithms; Integer programming; Mesh generation; MESH networking; Network security; Security systems; Topology; Wireless mesh networks (WMN); Heuristics algorithm; Multilevel security; Network topology; Optimisations; Optimization.; Security; Security management; Security services; Software-defined networkings; Wireless network security; Software defined networking},
