	year = {2024},
	pages = {34 - 40},
	doi = {10.1109/ICPIDS65698.2024.00015},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105004894495&doi=10.1109%2FICPIDS65698.2024.00015&partnerID=40&md5=d826d7892a1aeda235607fcad62a0ca4},
	affiliations = {Vishwakarma Institute of Technology, Department of Computer Science, Pune, India},
	abstract = {The proposed Zero Trust Architecture (ZTA) system merges Artificial Intelligence, Cloud Computing, and Cybersecurity on the Amazon Web Services (AWS) platform to offer a multi-layered, secure infrastructure. SHA-256 hashing, Amazon Cognito for safe user verification, and Amazon SageMaker for AI-driven insights to improve authentication procedures are all used by the system's authentication systems. While AWS Lambda allows automated actions depending on specific security triggers, AWS Identity and Access Management (IAM) enforces user rights for access control. Additionally, the solution incorporates AI-powered threat detection through the use of CloudWatch for ongoing infrastructure activity monitoring, Macie for sensitive data and anomaly identification, and AWS GuardDuty for threat monitoring and detection. The system utilizes network segmentation using Amazon Virtual Private Cloud (VPC) and micro segmentation using network ACLs to isolate critical resources in order to secure data and communications. Network security is further improved by AWS Transit Gateway, which guarantees safe, controlled connectivity across VPCs. Strong encryption techniques are enabled by AWS Key Management Service (KMS) for data security and masking, and encrypted data management is offered by AWS Relational Database Service (RDS). These elements work together to produce a scalable, AI-driven Zero Trust Architecture that satisfies the expanding security requirements of cloud-based infrastructure. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Artificial Intelligence; Authentication; Cloud Computing-AWS; Cyber Security; Encryption},
	keywords = {Authorization; Cloud computing architecture; Cyber attacks; Information management; Infrastructure as a service (IaaS); Network security; Sensitive data; Trusted computing; Amazon web services; Authentication systems; Cloud computing-amazon web service; Cloud-computing; Cyber security; Identity and access managements; Lambda's; Multi-layered; User verification; Web services platform; Authentication},
