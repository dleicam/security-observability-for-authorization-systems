	keywords = {Authorization; Controllers; Cryptography; Distributed computer systems; Network security; Transfer functions; Wireless networks; Accounting; Authentication and authorization; Authentication authorization and accountings; Authorization authentication and accountings; Modern technologies; Network functions; Opendaylight; Openid connect; Proof of concept; Software-defined networkings; Authentication},
