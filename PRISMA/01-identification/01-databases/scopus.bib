	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208557115&doi=10.1109%2FI-SMAC61858.2024.10714840&partnerID=40&md5=4567d46c772d6e856a7c77ac63074239},
	affiliations = {Vel Tech Rangarajan Dr.Sagunthala R&D Institute of Science and Technology, Chennai, India; M.Kumarasamy College of Engineering, Department of Computer Science and Engineering, Karur, India; Bannari Amman Institute of Technology, Department of Computer Science and Engineering, Sathyamangalam, India; St. Martin’s Engineering College, Department of Ai & Ml, Secunderabad, India; Excel Engineering College, Department of Computer Science and Engineering, Komarapalayam, India; Kongunadu College of Engineering and Technology, Department of Information Technology, Tiruchirappalli, India},
	abstract = {The high usage of storage in cloud, ensuring the privacy and security of information stored in the cloud has come up with a difficult concern. One approach to address this issue is the use of techniques which are encrypted, where data is already encrypted being uploaded to the storage of cloud. However, traditional encryption methods hinder the ability to find and retrieve particular information from the secured information, as the information needs to be decrypted first. This limitation hampers the usability and efficiency of storage of cloud systems. To overcome the challenge, this research says a novel approach for keyword search on secured information in storage of cloud using an AES approach. The algorithm of AES is a maximum adopted symmetric encryption method familiar for efficiency and robustness. By leveraging the AES encryption approach, the solution assures the confidentiality of information stored while enabling efficient keyword-based search operations without the need for decryption. The proposed approach utilizes a combination of cryptographic techniques such as AES encryption and index structures to access efficient information findings on the secured information. A secure index is created during encryption process that enables for potent retrieval of encrypted data related to specific keywords. The encrypted data remains confidential, as only authorized users possess the necessary decryption keys to retrieve the plaintext information. During data outsourcing, data owner can set the access permission based on their user identity. Users should have specific identity with decryption key for accessing data from cloud. Here data manager can also provide particular period for accessing information from cloud. The results demonstrate that the keyword findings on secured information in storage of using the AES approach achieve a balance between data privacy and search functionality. The solution offers an effective means to securely store and retrieve data from the cloud ensures that confidential data remains safeguarded against unauthorized access. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {and Auditable Data Access; Cloud storage services; Symmetric encryption method; Time Control; Time-Based Access Control},
	keywords = {Cloud security; AES encryption; And auditable data access; Cloud storage services; Data access; Encryption methods; Symmetric encryption; Symmetric encryption method; Time based; Time control; Time-based access control; Cloud storage},
	correspondence_address = {P. Pandiaraja; Vel Tech Rangarajan Dr.Sagunthala R&d Institute of Science and Technology, School of Computing, Department of Computer Science and Engineering, Chennai, 600 062, India; email: sppandiaraja@gmail.com},
