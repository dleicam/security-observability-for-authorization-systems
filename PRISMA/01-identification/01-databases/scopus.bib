	affiliations = {China Unicom Research Institute, Beijing, China; Unicom Digital Tech., Data Intelligence Department, Beijing, China; China Unicom (Hong Kong) Limited, Hong Kong, Hong Kong},
	abstract = {This paper proposes a trustworthy matchmaking mechanism for intelligent computing services. By decoupling the supply and demand of intelligent computing services, it achieves dynamic tracking of service status, efficient, secure, and resilient data delivery, as well as fair and trustworthy transaction matching for intelligent computing services. The trustworthy matchmaking for intelligent computing services integrates the trusted traceability and decentralization characteristics of blockchain, the intelligent analysis and automation capabilities of artificial intelligence, the elasticity and resource management advantages of edge and cloud computing, as well as the access control and data encryption functions provided by secure infrastructure. This mechanism ensures the efficiency and quality of matching transactions for intelligent computing services, facilitating sustainable development for both supply and demand sides. © 2025 Elsevier B.V., All rights reserved.},
