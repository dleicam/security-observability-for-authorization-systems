	year = {2024},
	journal = {International Journal of System Assurance Engineering and Management},
	pages = {},
	doi = {10.1007/s13198-024-02551-0},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85207011196&doi=10.1007%2Fs13198-024-02551-0&partnerID=40&md5=fec25af70d21c9d4c079a2bb91539015},
	affiliations = {Chitkara University, Punjab, Rajpura, India; Noida Institute of Engineering & Technology, Greater Noida, India; ATLAS SkillTech University, Department of ISME, Mumbai, India; JAIN (Deemed-to-be University), Department of Computer Science and Technology, Bengaluru, India; Vivekananda Global University, Department of Computer Science and Engineering, Jaipur, India; Chitkara University, Himachal Pradesh, Baddi, India},
	abstract = {Safety measures are used in multi-cloud security to protect infrastructure, apps, and data that are spread across several cloud environments. It necessitates lowering the risks connected to dispersed data access and storage by maintaining honesty and secrecy across several cloud platforms. The purpose of this research is to develop a novel inter-server communication for securing a multi-cloud environment. We discuss several challenges associated with utilizing many clouds and offering solutions such as the Supersingular isogeny Diffie–Hellman (SIDH) algorithm to prevent sensitive messages from being intercepted during internal server communications, Attribute-based encryption with outsourced decryption (ABE-OD) for fine-grained access control, rekeying at user withdrawal, Blowfish for message encryption, Rivest, Shamir, and Adleman (RSA) for key encryption. Our suggested paradigm includes anexchange of keys methodology to strengthen server-to-server prerequisites for communications in addition to security for fine-grained data security and access control on systems for storing. The RSA technique is used in the suggested concept to encrypt secret keys, allowing the encrypted keys to be stored in the database proxy server. The computation times for the construction of the BLAKE2 hash, data encryption, data decryption, and SIDH key exchange were determined. We made use of many parameters, including hash generation time, encryption time, and decryption time. The outcomes of the parameters are hash generation time of 2 mb (45), 4 mb (167), 8 mb (301), 16 mb (421), 22 mb (563), 28 mb (685), 32 mb (705), 36 mb (911), 42 mb (1027), encryption times of 2 mb (24), 4 mb (90), 8 mb (170), 16 mb (265), 22 mb (342), 28 mb (420), 32 mb (508), 36 mb (595), 42 mb (712), and decryption time of 2 mb (42), 4 mb (164), 8 mb (298), 16 mb (417), 22 mb (560), 28 mb (682), 32 mb (705), 36 mb (907), 42 mb (1024). Based on the inter-server communication system, the experiment results demonstrate the effectiveness of the recommended methodology in securing a multi-cloud environment. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Data security; Inter-server communication; Multi-cloud security; Supersingular isogeny Diffie–Hellman (SIDH)},
	keywords = {Access control models; Authentication; Cloud platforms; Data integrity; Empowerment of personnel; Fault tolerance; Fault tree analysis; Information management; Negative bias temperature instability; Network security; Outages; Steganography; Total quality management; Cloud environments; Cloud securities; Decryption time; Diffie Hellman; Fine grained; Generation time; Inter-server communications; Multi-cloud security; Multi-clouds; Supersingular isogeny diffie–hellman; Cloud security},
	correspondence_address = {S. Kaur; Centre of Research Impact and Outcome, Chitkara University, Rajpura, Punjab, 140417, India; email: sumeetkaur012345@outlook.com},
	publisher = {Springer},
	issn = {09756809; 09764348},
	language = {English},
	abbrev_source_title = {Intl. J. Syst. Assur. Eng. Manage.},
	type = {Article},
