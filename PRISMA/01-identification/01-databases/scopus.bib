	title = {Reach on Access Control Technology of Geomagnetic Observation Network System Based on Fog Computing},
	year = {2024},
	pages = {215 - 220},
	doi = {10.1109/MICCIS63508.2024.00042},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85202622567&doi=10.1109%2FMICCIS63508.2024.00042&partnerID=40&md5=330343545729d3a1daaa8b0b4386e1dc},
	affiliations = {Tianjin Earthquake Agency, Tianjin, China; Tianjin Electronic Information College, Department of Electronic and Communication, Tianjin, China; Tianjin Earthquake Agency, Earthquake Emergency Information Center, Tianjin, China},
	abstract = {In recent years, with the development of cloud computing and Internet of Things technology, earthquake observation technology has made tremendous progress. Tianjin earthquake agency developed a low-cost local magnetic field observation system based on cloud architecture to carry high-density deployed sensors. With the increasing deployment of sensors and the richness of application scenarios, existing access control models couldn't meet the needs of actual business development. The original access control technology was based on physical network security protocols and IoT device security chips. Although it could eliminate some security risks during the access process, there were still shortcomings that couldn't be well adapted to the needs of large-scale IoT device deployment environments. However, using complex access control models may result in neglecting the low local computing power of IoT geomagnetic field observation equipment. In order to solve the above problems, the project team conducted research and analysis on access control between geomagnetic observation devices based on fog computing and combined with blockchain technology. The IoT access control model suitable for geomagnetic observation network systems was designed based on research results. This model uses fog node agents to place the main work on the blockchain for completion and solve the problem of low computing power in some IoT devices. Through smart contracts, the model has achieved control over device access permissions, it provided an effective and secure method for IoT access control. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {access control; blockchain; fog calculation; internet of things},
