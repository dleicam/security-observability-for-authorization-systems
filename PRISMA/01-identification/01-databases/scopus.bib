@ARTICLE{Huang2024,
	author = {Huang, Bin and Du, Yanhui},
	title = {Break-Pad: effective padding machines for tor with break burst padding},
	year = {2024},
	journal = {Cybersecurity},
	volume = {7},
	number = {1},
	pages = {},
	doi = {10.1186/s42400-024-00222-y},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85205678562&doi=10.1186%2Fs42400-024-00222-y&partnerID=40&md5=8859ee2e606ce333fe8ec4be214f5dd8},
	affiliations = {People's Public Security University of China, Beijing, China},
	abstract = {Website Fingerprinting (WF) attacks enable a local eavesdropper to use metadata of packet flow, such as size, timing, and direction, to infer the websites a user is visiting. This can damage the user privacy provided by anonymity systems such as Tor. Tor has implemented the WF defense called Circuit Padding Framework, which provides an interface for developers to implement their own defenses. However, these defenses in the framework were overcome by the Deep Fingerprinting (DF) attack. In this paper, we propose a novel defense approach called break burst padding (Break-Pad), which injects a random number of padding packets into an incoming burst once the number of consecutive incoming packets exceeds a set number. We integrated Break-Pad into the existing Circuit Padding Framework. In addition, we have implemented two padding machines named August and October in the new framework and conducted experiments to evaluate these machines. In the open-world setting, our results show that August, with 29% bandwidth overhead, reduces Tik-Tok’s TPR by 14.48% and DF’s TPR by 22%. October outperforms the best padding machine, RBB. With 36% bandwidth overhead, it drops Tik-Tok’s TPR to 74.24% and DF’s TPR to 65.36%. In the one-page setting, October further reduces the bandwidth overhead by 11% while achieving similar performance to RBB. In the information leak analysis, for the burst sequence feature of the traffic, October leaks at 2.453 bits, while the best comparable padding machine Interspace leaks at 2.629 bits. © 2024 Elsevier B.V., All rights reserved.},
	keywords = {Anonymity; Data privacy; Human computer interaction; Information leakage; Medium access control; Network security; Bandwidth overheads; Incoming packets; Open world; Packet flows; Padding machines; Performance; Random Numbers; Sequence features; User privacy; Websites},
	correspondence_address = {B. Huang; People’s Public Security University of China, Beijing, No. 1, Muxidi Nanli, Xicheng District, China; email: beenhuang@126.com},
