@ARTICLE{Bao20251065,
	author = {Bao, Haiyong and Xing, Lu and Wu, Honglin and Guan, Menghong and Ruan, Na and Huang, Cheng and Dai, Hongning},
	title = {MKAC: Efficient and Privacy-Preserving Multi- Keyword Ranked Query With Ciphertext Access Control in Cloud Environments},
	year = {2025},
	journal = {IEEE Transactions on Cloud Computing},
	volume = {13},
	number = {3},
	pages = {1065 - 1077},
	doi = {10.1109/TCC.2025.3594575},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105012404843&doi=10.1109%2FTCC.2025.3594575&partnerID=40&md5=e521604afcabf438e8b0174849298011},
	affiliations = {East China Normal University, Software Engineering Institute, Shanghai, China; Shanghai Jiao Tong University, Department of Computer Science and Engineering, Shanghai, China; Fudan University, School of Computer Science, Shanghai, China; Hong Kong Baptist University, Department of Computer Science, Hong Kong, Hong Kong},
	abstract = {With the explosion of Big Data in cloud environments, data owners tend to delegate the storage and computation to cloud servers. Since cloud servers are generally untrustworthy, data owners often encrypt data before outsourcing it to the cloud. Numerous privacy-preserving schemes for the multi-keyword ranked query have been proposed, but most of these schemes do not support ciphertext access control, which can easily lead to malicious access by unauthorized users, causing serious damage to personal privacy and commercial secrets. To address the above challenges, we propose an efficient and privacy-preserving multi-keyword ranked query scheme (MKAC) that supports ciphertext access control. Specifically, in order to enhance the efficiency of the multi-keyword ranked query, we employ a vantage point (VP) tree to organize the keyword index. Additionally, we develop a VP tree-based multi-keyword ranked query algorithm, which utilizes the pruning strategy to minimize the number of nodes to search. Next, we propose a privacy-preserving multi-keyword ranked query scheme that combines asymmetric scalar-product-preserving encryption with the VP tree. Furthermore, attribute-based encryption mechanism is used to generate the decryption key based on the query user’s attributes, which is then employed to decrypt the query results and trace any malicious query user who may leak the secret key. Finally, a rigorous analysis of the security of MKAC is conducted. The extensive experimental evaluation shows that the proposed scheme is efficient and practical. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {cloud computing; multi-keyword ranked query; Privacy preservation},
	keywords = {Big data; Ciphertext; Cloud security; Cloud storage; Encryption algorithms; Forestry; Privacy-preserving techniques; Query languages; Query processing; Search engines; Cipher-text access controls; Cloud environments; Cloud servers; Cloud-computing; Multi keywords; Multi-keyword ranked query; Privacy preservation; Privacy preserving; Query schemes; Vantage-point trees; Trees (mathematics)},
	correspondence_address = {L. Xing; East China Normal University, Software Engineering Institute, Shanghai, 200062, China; email: 52275902018@stu.ecnu.edu.cn; H. Wu; East China Normal University, Software Engineering Institute, Shanghai, 200062, China; email: 71215902112@stu.ecnu.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {21687161},
	language = {English},
	abbrev_source_title = {IEEE Trans. Cloud Comput.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Tamilselvan2025605,
	author = {Tamilselvan, V. and Kalaiselvi, K. and Deepak, K. and Sree Krishnnaa, A. and Akilan, K.},
	title = {Cloud Integrated System for Audio Processing and Automated Lecture Transcription},
	year = {2025},
	pages = {605 - 611},
	doi = {10.1109/ICISS63372.2025.11076573},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105012167962&doi=10.1109%2FICISS63372.2025.11076573&partnerID=40&md5=26eb9360e8d59a320a47f3a54cf0a36a},
	affiliations = {Karpagam College of Engineering, Department of EEE, Coimbatore, India},
	abstract = {Accurate speech transcription fulfills essential functions like accessibility and documentation and automated communication while background noises cause major obstacles to the accuracy rate. The research presents a speech-to-text system which combines edge computing with deep learning and cloud services to deliver better transcription results. An edge device based on a Raspberry Pi 3 Model B handles the process of audio capture and pre-processing. The noise reduction capabilities of the RNN model use LSTM units for dynamic disturbance filtering to enhance speech clarity. The service Amazon Transcribe receives refined audio data which it uses to generate text with high accuracy through its cloud-based speech recognition capabilities. AWS S3 provides secure high-scale storage that depends on encryption features alongside versioning and access authorization tools. A MERN stack-based dashboard that combines MongoDB, Express.js, React.js, Node.js lets users conduct interactive searches and filtration operations and transcription administration through an interface. Traditional noise suppression techniques break down when sound environments change but the adaptive RNN model both learns new information and enhances itself thus leading to better speech recognition accuracy in multiple real-life situations. This system functions best for lecture recording as well as corporate meeting recordings and accessibility tool applications and automatic documentation system processing. This study achieves a versatile high-sensitivity and cost-optimized transcription system through its real-time edge computing tech and AI noise filtration systems and scalable cloud platform design. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Automatic Speech Recognition; Cloud Computing; Edge Computing; LSTM; MERN Stack; Noise Reduction; RNN; Speech-to-Text},
