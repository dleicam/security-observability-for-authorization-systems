@ARTICLE{Polimeno2025,
	author = {Polimeno, Antongiacomo and Braghin, Chiara and Anisetti, Marco and Ardagna, Claudio Agostino},
	title = {Maximizing data quality while ensuring data protection in service-based data pipelines},
	year = {2025},
	journal = {Journal of Big Data},
	volume = {12},
	number = {1},
	pages = {},
	doi = {10.1186/s40537-025-01118-5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-86000731761&doi=10.1186%2Fs40537-025-01118-5&partnerID=40&md5=509c92cd2c4105e7500a94d64537b313},
	affiliations = {Università degli Studi di Milano, Department of Computer Science, Milan, Italy},
	abstract = {The growing capacity to handle vast amounts of data, combined with a shift in service delivery models, has improved scalability and efficiency in data analytics, particularly in multi-tenant environments. Data are treated as digital products and processed through orchestrated service-based data pipelines. However, advancements in data analytics do not find a counterpart in data governance techniques, leaving a gap in the effective management of data throughout the pipeline lifecycle. This gap highlights the need for innovative service-based data pipeline management solutions that prioritize balancing data quality and data protection. The framework proposed in this paper optimizes service selection and composition within service-based data pipelines to maximize data quality while ensuring compliance with data protection requirements, expressed as access control policies. Given the NP-hard nature of the problem, a sliding-window heuristic is defined and evaluated against the exhaustive approach and a baseline modeling the state of the art. Our results demonstrate a significant reduction in computational overhead, while maintaining high data quality. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Access control; Big data; Data protection; Data quality; Privacy; Service-based data pipelines},
	keywords = {Data analytics; Data pipelines; Data quality; Delivery models; Digital products; Multi tenants; Privacy; Service delivery; Service-based; Service-based data pipeline},
