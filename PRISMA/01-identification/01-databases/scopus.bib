	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85130954603&doi=10.1109%2FSPICES52834.2022.9774238&partnerID=40&md5=489196b4cfc315421585fa2e1f769572},
	affiliations = {Noorul Islam University, Department of Information Technology, Kanyakumari, India},
	abstract = {The Personal Health Record (PHR) is one of the most significant models in the information exchange of the health reports, which is frequently extracted from some other third party storing the data, like as the cloud holder. Thus, for the privacy concern purpose of the patients and the users there emerged the promising technique to provide security for the data and its attributes shared among the PHR owners and the users, which is the Attribute Based Encryption (ABE). Yet, there existed issues in this technology for the security provision with adaptable access for the user and owner, scalability in key management, privacy exposure, and user revocation efficacy have been persisted towards the succession of the fine-grained and the cryptographical imposed access control over the data. In such case the paper is proposed upon a framework for a patient-centric control of PHR over the semi-trusted servers of the cloud data, where the encryption of the data can be accessed by multiple authority in a proper ciphertext policy applied over the attribute-based encryption termed as the MA-CP-ABE. Attaining the scalability and fine-grained, the ABE uses the encryption technique to each PHR documents and the data is secured from multiple domains of users and owners which is significantly divided by different terms of PHR in multiple security schemes for affording the key management difficulty in a reduced state. Additionally, a revocable and scalable mechanism is added in the ABE for the patient privacy and security of data sharing which is highly assured. The experimental results and the analytical reports are established which achieves the security, scalability and efficacy of the proposed work. © 2022 Elsevier B.V., All rights reserved.},
	author_keywords = {Attribute Authority; Attribute Based Encryption; Central Authority; Multi Authority Ciphertext Policy ABE; Personal Health Record},
	keywords = {Access control; Cloud security; Data privacy; Health; Scalability; Attribute authority; Attribute-based encryptions; Central authority; Ciphertext-policy attribute-based encryptions; Cloud computing environments; Fine grained; Key-management; Multi authorities; Multi authority ciphertext policy attribute based encryption; Personal health record; Cryptography},
