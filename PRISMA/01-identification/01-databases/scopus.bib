	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85192764483&doi=10.1007%2Fs41870-024-01911-0&partnerID=40&md5=93c3333ad484cd53d0faf7bca10fd063},
	affiliations = {ACS College of Engineering, Department of CSE, Bengaluru, India; RajaRajeswari College of Engineering, Bengaluru, Department of ISE, Bengaluru, India},
	abstract = {Healthcare cloud computing environments are expanding quickly, and security and confidentiality of patient records are top priorities. Academics and researchers are becoming more interested in cloud-based medical data interchange. Medical data may be compromised or altered by using unreliable networks, even if it is not used improperly. In order to overcome the drawbacks of current cryptosystems, a hybrid cryptosystem is presented in this paper to protect medical data. Elliptical curve cryptography (ECC) and cipher policy attribute-based encryption (CP-ABE) are combined to form the proposed hybrid cryptosystem known as HABE. Confidentiality and integrity of the sensor data are guaranteed by this technology, which also provides total security. Additionally, the suggested system offers users with effective confidentiality and access control in accordance with trust-based data level access control (TDLA). User access to the cloud environment is restricted in accordance with the TDLA. Based on the encryption and decryption times, security level, throughput, and temporal complexity, the effectiveness of the proposed technique is assessed. © 2024 Elsevier B.V., All rights reserved.},
