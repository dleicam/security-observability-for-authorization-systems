	author = {Shekhar, R. and Paul, P. Mano and Jingle I, Diana Jeba},
	title = {AI applications at the scheduling and resource allocation schemes in web medium},
	year = {2024},
	pages = {107 - 126},
	doi = {10.1201/9781003369028-6},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85191436836&doi=10.1201%2F9781003369028-6&partnerID=40&md5=bc5c2f526c713b7227509e447da7cf90},
