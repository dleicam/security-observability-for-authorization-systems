@ARTICLE{Mishra2025707,
	author = {Mishra, Ritu and Kumar Goyal, Sandip Kumar and Rana, Sanjeev Kumar},
	title = {Secure and Collaborative Data Management in Clouds Using Blockchain: A Systematic Review},
	year = {2025},
	journal = {Lecture Notes in Networks and Systems},
	volume = {1270 LNNS},
	pages = {707 - 721},
	doi = {10.1007/978-981-96-2015-9_49},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105017239147&doi=10.1007%2F978-981-96-2015-9_49&partnerID=40&md5=fbaab846f4d9c2183ed0e55433941300},
