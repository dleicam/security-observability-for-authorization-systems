@ARTICLE{Zhang2023122,
	author = {Zhang, Xiaojun and Huang, Chao and Gu, Dawu and Zhang, Jingwei and Wang, Huaxiong},
	title = {BIB-MKS: Post-Quantum Secure Biometric Identity-Based Multi-Keyword Search Over Encrypted Data in Cloud Storage Systems},
	year = {2023},
	journal = {IEEE Transactions on Services Computing},
	volume = {16},
	number = {1},
	pages = {122 - 133},
	doi = {10.1109/TSC.2021.3112779},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85115197844&doi=10.1109%2FTSC.2021.3112779&partnerID=40&md5=b89b71ee5030f66294eba61c59ff46be},
	affiliations = {Shanghai Jiao Tong University, School of Cyber Science and Engineering, Shanghai, China; Southwest Petroleum University China, Research Center for Cyber Security, Chengdu, China; Beihang University, School of Cyber Science and Technology, Beijing, China; School of Physical and Mathematical Sciences, Singapore City, Singapore},
	abstract = {Cloud computing technologies rely on powerful storage services and computing capabilities to maintain massive data for users. Since many cloud storage data probably contain sensitive privacy information, they are typically encrypted before outsourcing, which simultaneously limits the availability due to the difficulty of encrypted data retrieval. Public-key encryption with keyword search (PEKS) contributes to searching target encrypted data with keywords. However, majority of existing PEKS mechanisms require to manage certificates in the public key infrastructure (PKI), they are also vulnerable to adversaries equipped with quantum-computing devices in the near future. In this article, we devise a biometric identity-based multi-keyword search (BIB-MKS) mechanism from lattices over encrypted outsourced data, which inherently resists quantum-computing attacks. Each user in BIB-MKS is identified with her/his biometric information, which could be envisioned as the public key, thereby avoiding complex certificate managements. Particularly, BIB-MKS enables a data owner to produce an index associated with a biometric identity BID', such that a user with a biometric identity BID issues multiple keywords in a single search query and retrieves corresponding encrypted data, if and only if BID and BID' are within a certain distance of each other as judged by some metric. BIB-MKS narrows down the search scope, and improves users search experience significantly. We define the formal security model of BIB-MKS, and prove the security of BIB-MKS under this model. The performance evaluation demonstrates that BIB-MKS is practical for post-quantum secure cloud storage systems. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {biometric identity; cloud storage systems; lattices; multi-keyword search; Post-quantum security},
	keywords = {Access control; Cloud storage; Public key cryptography; Quantum computers; Quantum cryptography; Search engines; Sensitive data; Biometric (access control); Biometric identity; Cloud storage systems; Cloud-computing; Keyword search; Lattice; Multi keywords; Multi-keyword search; Post-quantum securities; Public keys; Security; Biometrics},
	correspondence_address = {X. Zhang; Shanghai Jiao Tong University, School of Cyber Science and Engineering, Shanghai, 200240, China; email: zhangxjdzkd2012@163.com; D. Gu; Shanghai Jiao Tong University, School of Cyber Science and Engineering, Shanghai, 200240, China; email: dwgu@sjtu.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
