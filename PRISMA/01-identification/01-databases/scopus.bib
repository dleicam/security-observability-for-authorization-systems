@CONFERENCE{Asteriou2021,
	author = {Asteriou, Vassilios and Papadimitriou, Georgios I. and Nicopolitidis, Petros},
	title = {Adaptive MAC Protocols for IoT Edge Computing Architectures with Event-Triggered Traffic},
	year = {2021},
	pages = {},
	doi = {10.1109/BlackSeaCom52164.2021.9527755},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85115667783&doi=10.1109%2FBlackSeaCom52164.2021.9527755&partnerID=40&md5=467697fa7423ed7f11779a1c5a3b715e},
	affiliations = {Aristotle University of Thessaloniki, Thessaloniki, Greece},
	abstract = {Edge computing, which extends cloud computing to the edge of a network, make possible low-latency IoT applications, such as fire-detection-capable forest management. In such applications, event-triggered traffic, generated by IoT devices, is often characterized by strong spatial autocorrelation. Under these traffic conditions, the standard ALOHA-based LoRaWAN protocol suffers from a large number of collisions near the epicenter of the event, which lead to a dramatic performance decrease. Therefore, critical information from the area near the epicenter is unable to be received. This may have dramatic consequences in case of a time-critical catastrophic event, like a forest fire. In this paper, a new family of adaptive protocols is introduced, that are capable of switching from ALOHA to TDMA mode in the area of the epicenter, when an event is suspected. In this way, the network is capable of transmitting critical information from the area of the epicenter. The performance of the proposed family of protocols is studied via extensive simulation results. The implementation alternatives of the new family of protocols are also discussed. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {event-triggered traffic; Internet of Things (IoT); LoRaWAN; MAC protocol; wake-up radio (WuR)},
	keywords = {Computer architecture; Deforestation; Edge computing; Medium access control; Network architecture; Time division multiple access; Adaptive protocol; Catastrophic event; Computing architecture; Event-triggered; Extensive simulations; IOT applications; Spatial autocorrelations; Traffic conditions; Internet of things},
