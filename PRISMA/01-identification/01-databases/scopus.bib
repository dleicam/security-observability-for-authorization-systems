	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85182510003&doi=10.1007%2F978-981-99-7633-1_29&partnerID=40&md5=cf1848a7a4bad299cd5e6641b9e5f7dd},
	affiliations = {Liverpool John Moors University, MSC- Computer Science, Chennai, India; Nitte Meenakshi Institute of Technology, Department of Information Science and Engineering, Bengaluru, India},
	abstract = {Securing cloud computing is a significant challenge for the cloud services sector. If someone is using the cloud to store data, choosing an encryption method that would not slow things down too much while providing a high-security level is essential. The world is going through a massive transformation from the electrical to the digital era. Though the mobile industry is quickly increasing, it has not yet fully advanced in terms of capability, storage, and capacity to meet customer demands. This paper focusses on cloud data security using hybrid encryption (RSA + proxy-re-encryption) with Blockchain Technology (BCT). BCT provides high data security, decentralization, an open and transparent network design, and minimal operational costs. The proposed method is also focused on BC-based decentralized consortium traceable anonymous cloud data storage and sharing system. It alleviates the blockchain’s massive data storage load using an “on-chain & off-chain” paradigm. The proposed solution enables fine-grained access control of outsourced data by presenting an upgraded proxy re-encryption with the RSA algorithm. © 2024 Elsevier B.V., All rights reserved.},
