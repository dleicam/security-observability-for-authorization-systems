	doi = {10.3844/jcssp.2022.955.967},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85140028530&doi=10.3844%2Fjcssp.2022.955.967&partnerID=40&md5=95cd7a4c8d1ad0a75199a8282f9e8d2a},
