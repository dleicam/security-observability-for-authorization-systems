}

@CONFERENCE{Li20213971,
	author = {Li, Xing and Chen, Yan and Lin, Zhiqiang and Wang, Xiao Shaun and Chen, James Hao},
	title = {Automatic policy generation for inter-service access control of microservices},
	year = {2021},
	pages = {3971 - 3988},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85114505734&partnerID=40&md5=53d03ee3abc596465b501e325309baaf},
	affiliations = {Zhejiang University, Hangzhou, China; Northwestern University, Evanston, United States; The Ohio State University, Columbus, United States},
	abstract = {Cloud applications today are often composed of many microservices. To prevent a microservice from being abused by other (compromised) microservices, inter-service access control is applied. However, the complexity of fine-grained access control policies, along with the large-scale and dynamic nature of microservices, makes the current manual configuration-based access control unsuitable. This paper presents AUTOARMOR, the first attempt to automate inter-service access control policy generation for microservices, with two fundamental techniques: (1) a static analysis-based request extraction mechanism that automatically obtains the invocation logic among microservices, and (2) a graph-based policy management mechanism that generates corresponding access control policies with on-demand policy update. Our evaluation on popular microservice applications shows that AUTOARMOR is able to generate fine-grained inter-service access control policies and update them timely based on changes in the application, with only a minor runtime overhead. By seamlessly integrating with the lifecycle of microservices, it does not require any changes to existing code and infrastructures. © 2021 Elsevier B.V., All rights reserved.},
	keywords = {Graphic methods; Life cycle; Static analysis; Access control policies; Cloud applications; Dynamic nature; Extraction mechanisms; Policy generation; Policy management; Runtime overheads; Service access; Access control},
	publisher = {USENIX Association},
