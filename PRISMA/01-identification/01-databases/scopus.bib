	doi = {10.1109/ICDCC62744.2024.10960995},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105004789373&doi=10.1109%2FICDCC62744.2024.10960995&partnerID=40&md5=6d72467e64c5acb3a2da07d7cab82029},
	affiliations = {National Institute of Public Administration, Information Communication Technology, Lusaka, Zambia; COER University, College of Smart Computing, Roorkee, India; Kalinga Institute of Industrial Technology, Bhubaneswar, School of Computer Applications, Bhubaneswar, India; Xamta Infotech, Ahmedabad, India; The University of Adelaide, Adelaide, Australia},
	abstract = {Cloud computing has transformed the IT industry by providing on-demand and pay-as-you-go computing resources. However, security and privacy concerns are hindering its widespread adoption. To address these issues, we present new architectural design principles by which we can leverage blockchain technology to secure cloud computing systems. We enhance the tamper-proof nature of blockchains by deploying decentralised applications which run consensus-governed microservices directly on a blockchain or at least their cryptographic hashes along with corresponding service access control mechanisms. Here, we leverage the fact that (i) microservices offer encapsulation, eliminating the need for tamper-proof maintenance of their internal state while ensuring full availability through replicated tamper-proof hash values; (ii) microservice compositions accommodate necessary functionalities and suggest deployability options; and (iii) existing cloud infrastructures already facilitate microservice deployments due to the architectures major cloud vendors use underneath. © 2025 Elsevier B.V., All rights reserved.},
