	pages = {},
	doi = {10.1016/j.iot.2020.100278},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85105509260&doi=10.1016%2Fj.iot.2020.100278&partnerID=40&md5=0a47208d9e5f69afa3e6fc15391bfc77},
