	affiliations = {JAIN (Deemed-to-be University), Department of Computer Science and Technology, Bengaluru, India; ATLAS SkillTech University, Department of ISME, Mumbai, India; Chitkara University, Punjab, Rajpura, India; Chitkara University, Himachal Pradesh, Baddi, India; Noida Institute of Engineering & Technology, Greater Noida, India; Vivekananda Global University, Department of Computer Science and Engineering, Jaipur, India},
