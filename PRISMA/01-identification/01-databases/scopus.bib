	year = {2024},
	journal = {IEEE Access},
	volume = {12},
	pages = {191860 - 191882},
	doi = {10.1109/ACCESS.2024.3514781},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85212125117&doi=10.1109%2FACCESS.2024.3514781&partnerID=40&md5=7d550d8ee3889ad1e3751d7d8812dbce},
	affiliations = {Marmara Üniversitesi, Department of Electrical and Electronic Engineering, Istanbul, Turkey; Republic of Iraq Ministry of Electricity, Baghdad, Iraq},
	abstract = {The identification and classification of broken conductor faults in power distribution systems (PDSs) is challenging because of the nonlinear and complex nature of the unbalanced three-phase currents. Previous approaches to identifying faults fail to resolve the issue of precise fault identification because of limited data availability and inefficient data modeling approaches. In this study, to identify the broken conductor faults and classify them into several scenarios in three-phase open-circuit distribution networks, a new hybrid method of deep learning based on Complex Value Neural Networks (CVNNs) and Long Short Term Memory (LSTM) is introduced. Our method refines input using the Proportional Topology Optimization (PPTO) algorithm that enhances the signal quality of unbalanced three-phased current signals for fault identification. Moreover, we use an appropriate DenseNet pre-trained model to extract features and estimate the topology state with reliable data representation. The developed CVNN framework was built with TensorFlow's Sequential API, which provided efficient computing of complex-valued inputs and weights and, thus, the proper handling of the intricate signals often encountered in power systems. The proposed approach was validated on three publically accessible datasets using a five-fold cross-validation technique. Results were realized in the form of Classification Accuracy (98.22% / 99.83% / 98.22%), F-measure (0.8881 / 0.9983 / 0.88), Precision (0.9207 / 0.9983 /0.92), Recall (0.8578 / 0.9983 / 0.85), and Area Under the Curve (AUC) (0.9433 / 0.9917/ 0.9958). It is shown that the proposed method has higher fault detection and classification accuracy compared to three traditional classification approaches, namely, Support Vector Machine (SVM), Decision Tree (DT), Random Forest (RF), and three state-of-the-art methods: 1) Stockwell transform +SVM, 2) Fast Fourier Transform + SVM, and 3) Hilbert-Huang transform of vibration data and power spectral density + Artificial Neural Network. Overall, the performance of the proposed methodology was satisfactory and can be used in real-time fault identification from PDSs installed in complex load environments and industries. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {complex value neural networks; decision tree; long short-term memory; Power distribution system; random forest; support vector machine},
	keywords = {Access control; Blind source separation; Conformal mapping; Decision trees; Deep neural networks; Directed graphs; Formal concept analysis; Fourier series; Hilbert-Huang transform; Image analysis; Image reconstruction; Image texture; Image thinning; Image understanding; Linear transformations; Long short-term memory; Network security; Overhead lines; Photomapping; Power distribution faults; Power distribution networks; Static Var compensators; Support vector machines; Broken conductors; Classification accuracy; Complex value neural network; Complex values; Fault identifications; Neural-networks; Power-distribution system; Random forests; Short term memory; Support vectors machine; Fast Fourier transforms},
	correspondence_address = {F.S.M. Al-Jumaili; Marmara University, Engineering Faculty, Electrical and Electronic Department, Istanbul, 34722, Turkey; email: firasaljumaili@marun.edu.tr},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {21693536},
	language = {English},
	abbrev_source_title = {IEEE Access},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Gold Open Access}
}

