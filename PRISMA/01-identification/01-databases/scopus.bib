}

@ARTICLE{Kumar2024,
	author = {Kumar, D. Suresh and Srinivasu, Nulaka},
	title = {Provisioning an efficient data deduplication model for cloud storage and integrity},
	year = {2024},
	journal = {International Journal of System Assurance Engineering and Management},
	pages = {},
	doi = {10.1007/s13198-024-02584-5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208790784&doi=10.1007%2Fs13198-024-02584-5&partnerID=40&md5=6853d0ef7980ed26c94a2013f374f2b6},
	affiliations = {K L Deemed to be University, Vaddeswaram, India},
	abstract = {Cloud computing, which centralizes various resources, offers a massive resource pool in response to the exponential development of digital data. Data storage is the most palatable cloud computing service. Data deduplication, one of the fundamental technologies used in cloud storage, allows cloud servers to free up storage space by deleting duplicate data. Owners encrypt their data to protect privacy before moving it to a cloud server. Traditional deduplication technology cannot deduplicate encrypted data, creating a new hurdle for cloud data deduplication. Many security problems exist in current solutions. They demand users stay online and cannot enable flexible data access management. In this study, we provide a data deduplication method that combines virtual auditing, identity-based proof of ownership (dd-IPoW), and data deletion. The dd-IPoW proposal combines access control with cloud data deduplication. We prove the proposed scheme's security, efficacy, and efficiency by conducting a thorough security study and performance review. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Cloud computing; Data access; Data deduplication; Data replication; Resource pooling},
	keywords = {Cloud platforms; Cloud security; Cloud storage; Cloud data; Cloud servers; Cloud storages; Cloud-computing; Data access; Data de duplications; Data replication; Exponentials; Resource offer; Resource pooling; Data integrity},
	correspondence_address = {N. Srinivasu; Computer Science and Engineering, Koneru Lakshmaiah Education Foundation, Guntur, Andhra Pradesh, 522301, India; email: srinivasu28@kluniversity.in},
	publisher = {Springer},
	issn = {09756809; 09764348},
	language = {English},
	abbrev_source_title = {Intl. J. Syst. Assur. Eng. Manage.},
	type = {Article},
	publication_stage = {aip},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Qian2024,
	author = {Qian, Jianguo and Que, Lingyan and Lu, Min and Fu, Quan and Feng, Yuan},
	title = {Research on abnormal access control of database management system under cloud computing platform},
	year = {2024},
	journal = {Applied Mathematics and Nonlinear Sciences},
	volume = {9},
	number = {1},
	pages = {},
	doi = {10.2478/amns-2024-3084},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208696877&doi=10.2478%2Famns-2024-3084&partnerID=40&md5=997871319a64bfb0e1f075dc665624a9},
	affiliations = {Ltd., Hangzhou, China; Ltd., Wuhan, China},
	abstract = {Access control is a security technique that can restrict access to protected resources, and data to only authorized users. In this paper, we design a blockchain-based access control scheme for cloud storage that is enabled by revocation. First, initialize blockchain to generate global parameters, generate complete user encryption keys and decryption keys, and perform data encryption. When the blockchain receives a user's access request, the authorization contract determines if it is on the revocation list. If not, the key is checked. Then, it determines abnormal access and adds its identity to the revocation list, preventing further access to the database. The access control model is created by combining attribute-based encryption. After the security analysis and operational efficiency test, it can be considered that the model meets the security features, such as IND-CPA security. Regarding the time overhead of generating encryption keys, the computational overhead of this paper is the lowest, and the time required to generate encryption keys for 10 attributes is only 0.09 seconds, and for 100 attributes is only 1.62 seconds, which is better than the performance of the two attribute-based access control schemes, FIFC and AACE. The user access time overhead for 10 to 100 attributes at user encryption time is 1.38, 1.56, 1.98, 2.1, 2.53, 2.76, 3.03, 3.27, 3.66, and 3.94 seconds, respectively. The lowest decryption time consumed ensures data security and a good access experience. This study achieves fine-grained access control while protecting data privacy. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Access control; Attribute-based encryption; Blockchain; Security analysis},
	keywords = {Access control models; Access control schemes; Attribute-based encryptions; Authorized users; Block-chain; Cloud computing platforms; Database management; Encryption key; Management systems; Security analysis; Users access; Cloud platforms},
	correspondence_address = {J. Qian; State Grid Zhejiang Electric Power Co., Ltd., Hangzhou, Zhejiang, 310007, China; email: qian_jianguo@zj.sgcc.com.cn},
	publisher = {Sciendo},
	issn = {24448656},
	language = {English},
	abbrev_source_title = {Appl. Math. Nonlinear Sci.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Xu2024173758,
	author = {Xu, Zhigang and Pan, Tiantian and Han, Hongmu and Dong, Xinhua and Wang, Zhongpeng and He, Miaomiao},
	title = {Blockchain-Based Traceable Multi-Level Revocation Attribute-Based Encryption},
	year = {2024},
	journal = {IEEE Access},
	volume = {12},
	pages = {173758 - 173774},
	doi = {10.1109/ACCESS.2024.3493464},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208695399&doi=10.1109%2FACCESS.2024.3493464&partnerID=40&md5=ddf768def7de4e0b9fbae400cd13a3cd},
	affiliations = {Hubei University of Technology, School of Computer Science, Wuhan, China},
	abstract = {With the development of cloud computing and big data, data security and privacy protection in multi-user environments have become particularly important. Existing encryption schemes exhibit significant deficiencies in addressing the flexible revocation of user attributes and dynamic changes in access permissions, leading to unauthorized users illicitly accessing and tampering with data. Therefore, we propose a Blockchain-based Traceable Multi-Level Revocable Attribute-Based Encryption Scheme (BTMAR-ABE). This scheme combines the advantages of Attribute-Based Encryption (ABE) technology and blockchain, achieving real-time attribute updates and verification through smart contracts, thereby avoiding reliance on a single centralized management server and introducing uniquely associated random numbers to prevent collusion attacks. To achieve flexible and secure data access control, we designed a multi-level revocation mechanism for both temporary and permanent revocation to address short-term and long-term permission change requirements. Performance evaluation and security analysis indicate that the BTMAR-ABE scheme can effectively resist chosen plaintext attacks, attribute revocation attacks, and collusion attacks, while demonstrating significant efficiency advantages in computational cost. Simulation results further demonstrate that this scheme has high practical value in data security and access control. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {attribute revocation; Attribute-based encryption (ABE); blockchain; data security},
	keywords = {Attribute revocation; Attribute-based encryption; Attribute-based encryption schemes; Attribute-based encryptions; Block-chain; Cloud-computing; Collusion attack; Data security and privacy; Multilevels; Security and privacy protection},
	correspondence_address = {Z. Xu; School of Computer Science, Hubei University of Technology, Wuhan, 430068, China; email: 20181100@hbut.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {21693536},
	language = {English},
	abbrev_source_title = {IEEE Access},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access}
}

