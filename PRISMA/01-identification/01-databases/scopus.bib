	title = {Impacts of High Denisty Cloud Computing on Data Protection and Security Management for 6G Networking},
	year = {2024},
	pages = {617 - 622},
	doi = {10.1109/ICDT61202.2024.10489780},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85191258047&doi=10.1109%2FICDT61202.2024.10489780&partnerID=40&md5=039621d95029bc764a136473397c1343},
	affiliations = {Thomson Reuters, Legal Tech Platform, New York, United States; University of Central Missouri, Department of Computer Science, Austin, United States; Department of Computer Science, Department of Computer Science, Houston, United States; Sri Eshwar College of Engineering, Department of Electrical & Computer Engineering, Coimbatore, India; G.L.Bajaj Institute of Technology & Management, Department of Computer Science and Engineering, Greater Noida, India},
	abstract = {Data protection and security management in the 6G era is a key challenge due to the emergence of high density cloud computing. The availability of high density cloud computing technologies creates a platform for massive data storage, processing, and analytics capabilities at a scale that has never been seen before. High density cloud computing facilitates the deployment of complex distributed systems consisting of hundreds or thousands of nodes in a single deployment. This can have a significant impact on data protection and security management as it increases the potential threat to the system from malicious actors. To protect data in this environment, organizations must adopt more advanced security practices such as access control, encryption, and defensive layers to protect against malicious actors. The use of encryption can provide a layer of security by making it difficult for outsiders to access information without authorization. Access control can also prevent unauthorized users from accessing certain parts of the system, while defensive layers can help detect and block malicious attacks. The results of this study showed that high density cloud computing can potentially improve the efficiency and performance of data protection and security management in 6G networks. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {6G Networking; Cloud Data Storage; Data Protection; Network Reliability; Network Security; Security Management},
