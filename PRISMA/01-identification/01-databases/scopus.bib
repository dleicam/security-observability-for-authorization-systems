	affiliations = {State Grid Zibo Power Supply Company, Zibo, China; Shandong Electric Power Research Institute, Jinan, China; Shandong Electric Power Research Institute, Jinan, China; Harbin Institute of Technology, School of Computer Science and Technology, Harbin, China},
