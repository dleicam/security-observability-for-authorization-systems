	doi = {10.1109/AICCSA.2018.8612787},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85061909482&doi=10.1109%2FAICCSA.2018.8612787&partnerID=40&md5=ea25618ee41ee640116c859a580eb089},
