@ARTICLE{Sravya20244540,
	author = {Sravya, Gudipati and Kumar, Pasupuleti Syam and Padmavathi, R. Anusha},
	title = {Survey of Post-Quantum Lattice-Based Ciphertext-Policy Attribute-Based Encryption Schemes for Cloud Storage: Taxonomy, Open Issues, and Future Directions},
	year = {2024},
