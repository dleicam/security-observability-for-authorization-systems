@CONFERENCE{Nagothu2018,
	author = {Nagothu, Deeraj and Xu, Ronghua and Nikouei, Seyed Yahya and Chen, Yu},
	title = {A Microservice-enabled Architecture for Smart Surveillance using Blockchain Technology},
	year = {2018},
	pages = {},
	doi = {10.1109/ISC2.2018.8656968},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85063476743&doi=10.1109%2FISC2.2018.8656968&partnerID=40&md5=773b8cda0b95270ecaff22c3e37ecd82},
	affiliations = {State University of New York System, Department of Electrical & Computer Engineering, Albany, United States},
	abstract = {While the smart surveillance system enhanced by the Internet of Things (IoT) technology becomes an essential part of Smart Cities, it also brings new concerns in security of the data. Compared to the traditional surveillance systems that is built following a monolithic architecture to carry out lower level operations, such as monitoring and recording, the modern surveillance systems are expected to support more scalable and decentralized solutions for advanced video stream analysis at the large volumes of distributed edge devices. In addition, the centralized architecture of the conventional surveillance systems is vulnerable to single point of failure and privacy breach owning to the lack of protection to the surveillance feed. This position paper introduces a novel secure smart surveillance system based on microservices architecture and blockchain technology. Encapsulating the video analysis algorithms as various independent microservices not only isolates the video feed from different sectors, but also improve the system availability and robustness by decentralizing the operations. The blockchain technology securely synchronizes the video analysis databases among microservices across surveillance domains, and provides tamper proof of data in the trustless network environment. Smart contract enabled access authorization strategy prevents any unauthorized user from accessing the microservices and offers a scalable, decentralized and fine-grained access control solution for smart surveillance systems. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Blockchain; Decentralization; Microservices Architecture; Smart Contracts; Smart Surveillance},
	keywords = {Authorization; Blockchain; Internet of things; Monitoring; Network architecture; Network security; Security systems; Block-chain; Decentralisation; Decentralised; Internet of things technologies; Microservice architecture; Monolithic architecture; Smart surveillance; Smart surveillance systems; Surveillance systems; Video analysis; Smart contract},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
