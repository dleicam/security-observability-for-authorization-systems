	year = {2025},
	journal = {IEEE Transactions on Dependable and Secure Computing},
	pages = {},
	doi = {10.1109/TDSC.2025.3593598},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105012540858&doi=10.1109%2FTDSC.2025.3593598&partnerID=40&md5=8f5a4d28b1a808e33596ba2bfd0accdb},
	affiliations = {Shanghai Jiao Tong University, School of Electronic Information and Electrical Engineering, Shanghai, China},
	abstract = {One Time Password (OTP) plays a crucial role in verifying user identities for tasks like registration, login, and forgotten password on cloud platforms. However poorly implemented OTP can lead to vulnerabilities like Bomb attacks (a Denial of Service attack) on SMS or Email, OTP Brute-Force attacks, and OTP bypass, compromising access control. While fuzzing at the application layer (e.g., http) is effective for web products, it faces limitations in mobile applications due to cryptographic complexities and certificate verification. To address this, we propose a fuzzing framework, OTP-Hunter, combining static and dynamic analysis to uncover OTP vulnerabilities in applications with minimal manual intervention. We use OTP-Hunter to analyze 59 IoT-related apps (not limited), identify 68 vulnerabilities and reported them to the vendor and China National Vulnerability Database for 11 CNVDs. These vulnerabilities could let attackers remotely take control of devices by knowing the victim's cloud account, typically a phone number. Our results also show that compared with mutating the network requests, our approach can cover more circumstances like custom protocol because we do not need to know the encryption process. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Applications; Fuzzing; One Time Password; Vulnerability Detection},
	keywords = {Authentication; Cloud platforms; Cryptography; Denial-of-service attack; Dynamic analysis; Mobile applications; Mobile security; National security; Network security; Application layers; Bomb attacks; Brute-force attack; Denialof- service attacks; Fuzzing; One time password; One-time; User identity; Vulnerability detection; HTTP},
	correspondence_address = {F. Zou; Shanghai Jiao Tong University, School of Electronic Information and Electrical Engineering, Shanghai, 200240, China; email: zoufutai@sjtu.edu.cn},
