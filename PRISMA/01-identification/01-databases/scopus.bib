@CONFERENCE{Zhong202426,
	author = {Zhong, Yuan and Chen, Pengfei and Zhang, Huxing},
	title = {eGBox: A Secure Shell Runtime based on eBPF},
	year = {2024},
	pages = {26 - 34},
	doi = {10.1145/3686540.3686544},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85205444768&doi=10.1145%2F3686540.3686544&partnerID=40&md5=8158f20095691be5d00cc0045d6ac2e3},
	affiliations = {Sun Yat-Sen University, School of Computer Science and Engineering, Guangzhou, China; Alibaba Group Holding Limited, Hangzhou, China},
	abstract = {Cloud systems that offer remote data and computational access through networks face significant security challenges. Secure SHell session (SSH) is a popular access method, but its login information leakage presents a substantial security threat, allowing attackers to exploit identities of users and disrupt systems. As a result, security remains paramount in cloud-system operations. Access control, a vital security mechanism in operating systems, is increasingly challenging due to the complexity of control mechanisms and the difficulty in developing precise Access Control Lists (ACLs). Traditional ACLs require extensive resources for each user or role, falter in complex scenarios, and risk system vulnerability by granting excessive privileges. To address these issues, this paper introduces eBPF-based Guarded Box (eGBox), a novel solution that combines a lightweight system call restriction system with machine learning. eGBox utilizes rule learning through itemset mining to analyze user behavior and generate system call control lists, thereby significantly reducing system vulnerability. By employing extended Berkeley Packet Filter (eBPF) program hooks, eGBox effectively audits and restricts remote user behavior at the system call level. The results demonstrate that eGBox's rule-mining algorithm achieves over 99% accuracy in generating access control policies, using only 40% of the log entries for mining. Additionally, eGBox presents a lower overhead compared to established tools, such as AppArmor, thereby enhancing the overall security of the operating system. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Access control; eBPF; Itemset mining; Security; System call},
	keywords = {Cloud security; Hooks; Access control lists; Berkeley packet filters; Cloud systems; Extended berkeley packet filter; Itemset mining; Secure shell; Security; System calls; System vulnerability; User behaviors; Computer operating systems},
	correspondence_address = {P. Chen; School of Computer Science and Engineering, Sun Yat-Sen University, Guangzhou, China; email: chenpf7@mail.sysu.edu.cn},
	publisher = {Association for Computing Machinery},
