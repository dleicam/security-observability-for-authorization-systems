@ARTICLE{Kumar2025353,
	author = {Kumar, Voruganti Naresh and Veerender, A. and Madhukar, G. and Soujanya, K. L.S. and Naryana, V. A. and Aelgani, Vivekanand},
	title = {A Novel IoT-Based Block Chain Approach for Evaluating Confidential Data Sharing by Providing Data Privacy, Integrity, and Reliability},
	year = {2025},
	journal = {Lecture Notes in Electrical Engineering},
	volume = {1400 LNEE},
	pages = {353 - 370},
	doi = {10.1007/978-981-96-4391-2_35},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105014114954&doi=10.1007%2F978-981-96-4391-2_35&partnerID=40&md5=300fe6c5f0e6c624d948eecf5b680bc1},
	affiliations = {CMR Technical Campus, Hyderabad, Department of CSE, Hyderabad, India; CMR Technical Campus, Hyderabad, Department of CSE (Data Science), Hyderabad, India; CMR College of Engineering & Technology, Department of CSE, Hyderabad, India},
	abstract = {Since the Internet of Things has grown in recent years, data sharing has become one of the most beneficial cloud computing technologies. While the technology in question has a pleasing aesthetic, privacy continues to be one of its difficulties because inappropriate data utilization might have a number of unfavorable impacts. We offer a proxy re-encryption technique for cloud settings in this article in order to secure data transfer. Data owners can outsource their encrypted data to the cloud using identity-based encryption, and proxy re-encryption architecture makes sure that only authorized users can access the data. Because Internet of Things devices have limited capabilities, an edge device serves as a proxy server to do complex calculations. Moreover, we effectively allocate cached material in the proxy by utilizing information-centric networking capability, therefore attracting the degree of service through the effective utilization of the network capacity. Additionally, the foundation of our network model is the revolutionary technology known as block chain, which enables decentralized data sharing. It attains fine-grained control over access to data and diminishes bottlenecks in centrally managed systems. The safety research and assessment of our plan demonstrate the potential of our strategy for protecting data security, privacy, and integrity. © 2025 Elsevier B.V., All rights reserved.},
