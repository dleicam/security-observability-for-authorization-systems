	note = {Cited by: 91; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access}
}

@ARTICLE{Gowda20233343,
	author = {Gowda, Naveen Chandra and Bharathi Malak Reddy, A.},
	title = {BPCPR-FC: blockchain-based privacy preservation with confidentiality using proxy reencryption and ring signature in fog computing environments},
	year = {2023},
	journal = {International Journal of Information Technology (Singapore)},
	volume = {15},
	number = {6},
	pages = {3343 - 3357},
	doi = {10.1007/s41870-023-01373-w},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85167334172&doi=10.1007%2Fs41870-023-01373-w&partnerID=40&md5=ee457995d9f75afa35392405ab6c033f},
	affiliations = {REVA University, School of Computer Science and Engineering, Bengaluru, India; BMS Institute of Technology and Management, Department of AI and ML, Bengaluru, India},
	abstract = {The usage of edge devices in distributed fog and cloud computing applications is increasing day by day in the current digital communication world. The edge devices can be mobile devices, smart devices, IoT devices, and vehicular devices. The edge devices produce a variety of data in various applications such as healthcare, educational, vehicular networks, smart systems and industrial IoT. The private data of a user or any generated data at the edge devices will be stored in the centralized cloud server and then can be accessed by any user when required upon permission by the data owner. An increase in the rate of data sharing in current digital communications directly increases vulnerable activities which require security services like access control, privacy, data confidentiality, anonymity, unforgeability, and nonframeability. In this article, a blockchain-based privacy preservation with confidentiality using proxy reencryption and ring signature in fog computing environments (BPCPR-FC) mechanism is proposed to achieve the requirements. The proposed BPCPR-FC is verified using mathematical analysis for a set of security issues and an informal security analysis is carried out for a set of common attacks. Cryptanalysis of the proposed BPCPR-FC scheme is discussed and shows the improvement of encryption and decryption time by 8–22% and 10–23% compared to existing schemes. The blockchain implementation of the proposed BPCPR-FC is carried out in the Truffle suite and discussed the improvement of block preparation time by 7–17% compared to suitable existing works. © 2023 Elsevier B.V., All rights reserved.},
