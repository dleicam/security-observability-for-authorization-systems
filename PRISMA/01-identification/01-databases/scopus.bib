	author = {Zhang, Qian and Wang, Shangping and Zhang, Duo and Wang, Jifang and Zhang, Yaling},
	title = {Time and Attribute Based Dual Access Control and Data Integrity Verifiable Scheme in Cloud Computing Applications},
