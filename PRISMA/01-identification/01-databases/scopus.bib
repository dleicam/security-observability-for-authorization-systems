@ARTICLE{Xue201836,
	author = {Xue, Yuan and Tan, Yu'an and Chen, Liang and Li, Yuanzhang and Zheng, Jun and Zhang, Quanxing Xin},
	title = {RootAgency: A digital signature-based root privilege management agency for cloud terminal devices},
	year = {2018},
	journal = {Information Sciences},
	volume = {444},
	pages = {36 - 50},
	doi = {10.1016/j.ins.2018.02.069},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85042664782&doi=10.1016%2Fj.ins.2018.02.069&partnerID=40&md5=61ce982aecc5561b514ad59f6c665e83},
	affiliations = {Beijing Institute of Technology, School of Computer Science and Technology, Beijing, China; School of Computer Science and Technology, Beijing Institute of Technology, Beijing, China},
	abstract = {Rooting an Android device can be a voluntary behavior from end users with various motivations, such as removing OEM pre-installed apps. This leads to an increase in opportunity of privilege escalation for malwares. The existing root privilege management schemes rely on the end users to make privilege granting decisions for all legal and illegal apps installed on the device. However, unskilled end users are incapable, or are careless in determining which privileges are appropriate for what type of app. To address this issue, a root privilege management agency named RootAgency is proposed, which adopts a digital signature scheme to guarantee the exclusive root-privilege-granting opportunities of authenticated apps. RootAgency authenticates an app by checking whether it holds the signature generated by the secret key, and grants the root privilege when a signed app submits the request. Moreover, it verifies the app's integrity to prevent it from repackaging. Thus, the users are not involved in decision making while confronting root requests. The proposed scheme ensures the security of rooted Android devices, and enhances the security of mobile terminal devices. This diminishes the threat to cloud infrastructure from root-misused Android devices. In addition, a prototype is implemented to evaluate its effectiveness, efficiency, and overhead. The experimental results show that RootAgency is widely compatible and its performance overhead is reasonable. © 2018 Elsevier B.V., All rights reserved.},
	author_keywords = {Android security; Digital signature; Integrity verification; Mobile cloud computing; Root management scheme},
	keywords = {Access control; Android (operating system); Authentication; Decision making; Digital devices; Electronic document identification systems; Malware; Mobile cloud computing; Android securities; Cloud infrastructures; Digital signature schemes; Integrity verifications; Management scheme; Privilege escalations; Privilege management; Terminal devices; Mobile security},
	correspondence_address = {Q. Zhang; School of Computer Science and Technology, Beijing Institute of Technology, Beijing, 100081, China; email: zhangqx@bit.edu.cn},
	publisher = {Elsevier Inc. usjcs@elsevier.com},
