	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85211820880&doi=10.3390%2Fs24237842&partnerID=40&md5=72ecbc6c042b035616d011531069acc3},
	affiliations = {University of Shanghai for Science and Technology, Engineering Research Center of Optical Instrument and System, Shanghai, China; University of Shanghai for Science and Technology, Department of Biomedical Engineering, Shanghai, China; The Islamia University of Bahawalpur, Department of Engineering, Bahawalpur, Pakistan; Shaheed Zulfikar Ali Bhutto Institute of Science and Technology, Karachi, Department of Computer Science, Karachi, Pakistan; The Islamia University of Bahawalpur, Faculty of Engineering, Bahawalpur, Pakistan},
	abstract = {Smart fish farming faces critical challenges in achieving comprehensive automation, real-time decision-making, and adaptability to diverse environmental conditions and multi-species aquaculture. This study presents a novel Internet of Things (IoT)-driven intelligent decision-making system that dynamically monitors and optimizes water quality parameters to enhance fish survival rates across various regions and species setups. The system integrates advanced sensors connected to an ESP32 microcontroller, continuously monitoring key water parameters such as pH, temperature, and turbidity which are increasingly affected by climate-induced variability. A custom-built dataset comprising 43,459 records, covering ten distinct fish species across diverse pond environments, was meticulously curated. The data were stored as a comma-separated values (CSV) file on the IoT cloud platform ThingSpeak and synchronized with Firebase, enabling seamless remote access, control, and real-time updates. Advanced machine learning techniques, with feature transformation and balancing, were applied to preprocess the dataset, which includes water quality metrics and species-specific parameters. Multiple algorithms were trained and evaluated, with the Decision Tree classifier emerging as the optimal model, achieving remarkable performance metrics: 99.8% accuracy, precision, recall, and F1-score, a 99.6% Matthews Correlation Coefficient (MCC), and the highest Area Under the Curve (AUC) score for multi-class classification. Our framework’s capability to manage complex, multi-species fishpond environments was validated across diverse setups, showcasing its potential to transform fish farming practices by ensuring sustainable climate-adaptive management through real-time water quality optimization. This study marks a significant step forward in climate-smart aquaculture, contributing to enhanced fish health, survival, and yield while mitigating the risks posed by climate change on aquatic ecosystems. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {climate-induced variability; fishpond; IoT cloud platform; machine learning; sensors; water quality parameters},
	keywords = {Aquatic ecosystems; Decision making; Failure analysis; Climate-induced variability; Cloud platforms; Decision-making systems; Fish farming; Fishpond; Intelligent decision-making; Internet of thing cloud platform; Machine-learning; Real- time; Water quality parameters; Fish; algorithm; animal; aquaculture; decision making; environmental monitoring; fish; internet of things; machine learning; physiology; procedures; water quality; Algorithms; Animals; Aquaculture; Decision Making; Environmental Monitoring; Fishes; Internet of Things; Machine Learning; Water Quality},
	correspondence_address = {D. Kumar; Faculty of Engineering, The Islamia University of Bahawalpur, Bahawalpur, 63100, Pakistan; email: dileep.kumar@iub.edu.pk},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
