@CONFERENCE{Shashi20231812,
	author = {Shashi, Manish and Saxena, Amit and Vaya, Dipesh and Pillai, Neetu and Chavan, Sunil S. and Balarama Krishna, C.},
	title = {Enhancing Trust and Privacy in Edge and Cloud Computing Through Blockchain Technology},
	year = {2023},
	pages = {1812 - 1816},
	doi = {10.1109/IC3I59117.2023.10397883},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85185228152&doi=10.1109%2FIC3I59117.2023.10397883&partnerID=40&md5=2444b6af1544fd38470b90d5322c1ef6},
	affiliations = {Walden University, Supply Chain Leader and Researcher, Minneapolis, United States; University of Technology, Jaipur, India; Sir Padampat Singhania University, Udaipur, India; University of West London, London, United Kingdom; Smt. Indira Gandhi College of Engineering, Mumbai, India; SR University, Warangal, India},
	abstract = {Edge and cloud computing environment is currently employed in a variety of fields, yet despite their growing prominence and advantages, it faces certain difficulties, including data privacy and trust. Intruder assaults ought to be avoided, and data storage ought to be restricted to authorized individuals only. The majority of methods of authentication use a trusted group to go through the procedure. Consumers and computer systems must both be enrolled with the trusted group to be granted authorization to authenticate other individuals. Because the whole framework is dependent on just one trusted group, in this case, one point of collapse may trigger the whole structure to malfunction, and problems with scalability exist. Blockchain innovation can be used to ensure data privacy and trust in storage and trading procedures. To tackle the problems that continue to arise in current platforms, this work discusses a decentralized method that involves removing the idea of a single trusted group through the implementation of a blockchain framework in edge and cloud computing where any moment an individual or server desires to access the framework, it is not required to enter itself by hand, yet the authorization procedure is executed out autonomously during the framework. The findings from experiments and performance examination show that the suggested design is advantageous and surpasses those that exist in the relevant field. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Blockchain; Cloud Computing; Decentralized method; Edge; Privacy; Trust},
