	year = {2025},
	journal = {Applied Sciences (Switzerland)},
	volume = {15},
	number = {13},
	pages = {},
	doi = {10.3390/app15137485},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010341041&doi=10.3390%2Fapp15137485&partnerID=40&md5=c73247524e0a651d2358052081c6518e},
	affiliations = {Birla Institute of Technology, Mesra, Department of Computer Science and Engineering, Ranchi, India; Birla Institute of Technology, Mesra, Department of Electronics and Communication Engineering, Ranchi, India; Centre for Development of Advanced Computing, India, Pune, India; Norges Teknisk-Naturvitenskapelige Universitet, Faculty of Engineering, Trondheim, Norway; Høgskolen i Molde, Informatics and Digitalization Group, Molde, Norway},
	abstract = {Data privacy is a crucial concern for individuals using cloud storage services, and cloud service providers are increasingly focused on meeting this demand. However, privacy breaches in the ever-evolving cyber landscape remain a significant threat to cloud storage infrastructures. Previous studies have aimed to address this issue but have often lacked comprehensive coverage of privacy attributes. In response to the identified gap in privacy-preserving techniques for cloud computing, this research paper presents a novel and adaptable framework. This approach introduces a multi-layer encoding storage arrangement combined with the implementation of a one-time password authorization approach. By integrating these elements, the proposed approach aims to enhance both the flexibility and efficiency of data protection in cloud environments. The findings of this study are anticipated to have significant implications, contributing to the advancement of existing techniques and inspiring the development of innovative research-driven solutions. Continuous research efforts are required to validate the effectiveness of the proposed framework across diverse contexts and assess its performance against evolving privacy vulnerabilities in cloud computing. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {cloud-based storage; data privacy; encryption characteristics; privacy safeguarding; theoretical framework},
	keywords = {Cloud storage; Distributed database systems; Privacy-preserving techniques; Cloud storage services; Cloud storages; Cloud-based; Cloud-based storage; Cloud-computing; Encryption characteristic; Layer encoding; Multi-layers; Privacy safeguarding; Theoretical framework; Encoding (symbols)},
	correspondence_address = {A. Mishra; Faculty of Engineering, Norwegian University of Science and Technology (NTNU), Trondheim, 7034, Norway; email: alok.mishra@ntnu.no},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
	issn = {20763417},
	language = {English},
	abbrev_source_title = {Appl. Sci.},
	type = {Article},
