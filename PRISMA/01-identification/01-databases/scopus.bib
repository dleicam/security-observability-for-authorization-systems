@CONFERENCE{Yang20223791,
	author = {Yang, Jinjiang and Liu, Feng and Luo, Xinyi and Hong, Jia'nan and Li, Jian and Xue, Kaiping},
	title = {Forward Private Multi-Client Searchable Encryption with Efficient Access Control in Cloud Storage},
	year = {2022},
	journal = {Proceedings - IEEE Global Communications Conference, GLOBECOM},
	pages = {3791 - 3796},
	doi = {10.1109/GLOBECOM48099.2022.10001146},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85146962700&doi=10.1109%2FGLOBECOM48099.2022.10001146&partnerID=40&md5=cd2598583baf52b17528c6fe4aff44e4},
	affiliations = {University of Science and Technology of China, School of Cyber Science and Technology, Hefei, China; Shanghai Jiao Tong University, School of Electronic Information and Electrical Engineering, Shanghai, China},
	abstract = {Through Searchable Symmetric Encryption (SSE), a user can make search over encrypted documents that are stored on an untrusted cloud server. Multi-client SSE schemes require that one client can search documents contributed by other clients and upload documents. Nevertheless, existing multi- client SSE schemes implement the fine-grained access control with high complexity. Although fine-grained access control adapts to complex scenarios, it is not necessary anytime and may cause heavy costs over computation in SSE schemes. Moreover, it is crucial to support documents updating and forward privacy. To combat that, we design a multi-client SSE scheme with efficient access control over dynamic encrypted documents. Specifically, we first modify Symmetric Hidden Vector Encryption (SHVE) and utilize Bloom filter to implement the access control, which reduces much of computation overhead. We then employ Oblivious Dynamic Cross-Tag (ODXT) protocol to preserve the forward privacy of our scheme. Finally, the corresponding security and experimental evaluation demonstrate both security and practicality of our scheme, respectively. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Access Control; Cloud Computing; Forward Privacy; Multiple Clients; Searchable Encryption},
	keywords = {Cloud storage; Cryptography; Cloud servers; Cloud storages; Cloud-computing; Fine grained; Forward privacy; High complexity; Multiple clients; Searchable encryptions; Symmetric encryption; Symmetric encryption schemes; Access control},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {23340983; 25766813},
	isbn = {9781479913534; 9798350351255; 9781467309219; 9781728109626; 9781728182988; 9798350310900; 9781479935116; 9781538647271; 9781509050192},
	language = {English},
	abbrev_source_title = {Proc. - IEEE Glob. Commun. Conf., GLOBECOM},
	type = {Conference paper},
