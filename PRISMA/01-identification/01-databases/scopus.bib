	author = {Wang, Zihui and Zhang, Jun and Li, Jinwei and Wu, Zhongcheng},
	title = {PHP-CABE: Partially Hidden Policy Comparable Attribute-Based Encryption with Computation Outsourcing},
	year = {2025},
