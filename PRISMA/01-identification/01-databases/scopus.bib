	year = {2020},
	journal = {IEEE Transactions on Cloud Computing},
	volume = {8},
	number = {1},
	pages = {32 - 44},
	doi = {10.1109/TCC.2017.2751471},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85029902986&doi=10.1109%2FTCC.2017.2751471&partnerID=40&md5=70bb2e78b274aba97d42ef7865c76aa3},
	affiliations = {Pandit Dwarka Prasad Mishra Indian Institute of Information Technology, Design & Manufacturing Jabalpur, Department of CSE, Jabalpur, India},
	abstract = {Nowadays cloud servers have become the primary choice to store and share data with multiple users across the globe. The major challenge in sharing data using cloud servers is to protect data against untrusted cloud service provider and illegitimate users. Attribute-Based Encryption (ABE) has emerged as a useful cryptographic technique to securely share data with legitimate recipients in fine-grained manner. Several solutions employing ABE have been proposed to securely share data using cloud servers. However, most of the solutions are data owner-centric and focus on providing data owner complete control on his outsourced data. The existing solutions in cloud computing fail to provide shared access privileges among users and to enable cloud users to delegate their access privileges in a flexible manner. In order to simultaneously achieve the notion of fine-grained access control, scalability and to provide cloud users shared access privileges and flexibility on delegation of their access privileges, we propose a scalable attribute-based access control scheme for cloud storage. The scheme extends the ciphertext policy attribute-based encryption to achieve flexible delegation of access privileges and shared access privileges along with scalability and fine-grained access control. The scheme achieves scalability by employing hierarchical structure of users. Furthermore, we formally prove the security of our proposed scheme based on security of the ciphertext-policy attribute-based encryption. We also implement the algorithm to show its scalability and efficiency. © 2020 Elsevier B.V., All rights reserved.},
	author_keywords = {access privileges; attribute-based encryption; Cloud computing; data security; delegation},
	keywords = {Cloud computing; Cryptography; Digital storage; Scalability; Security of data; Servers; access privileges; Attribute based access control; Attribute-based encryptions; Ciphertext-policy attribute-based encryptions; Cloud service providers; Cryptographic techniques; delegation; Hierarchical structures; Access control},
	correspondence_address = {R. Ahuja; Department of CSE, Indian Institute of Information Technology Design and Manufacturing, Jabalpur, India; email: r.ahuja@iiitdmj.ac.in},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {21687161},
	language = {English},
	abbrev_source_title = {IEEE Trans. Cloud Comput.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 41}
}

@ARTICLE{Yang202078,
