	title = {Privacy-preserving IoT system based on blockchain and proxy re-encryption},
	year = {2024},
	journal = {Proceedings of SPIE - The International Society for Optical Engineering},
	volume = {13105},
	pages = {},
	doi = {10.1117/12.3026400},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85191496361&doi=10.1117%2F12.3026400&partnerID=40&md5=533dd79264d0a2d165b80753f7efac47},
	affiliations = {Yunnan University, School of Information Science and Engineering, Kunming, China; University Key Laboratory of Internet of Things Technology and Application, Kunming, China},
	abstract = {Internet of Things (IoT) technology is widely used across various domains, generating a substantial volume of data from IoT devices. These data often contains sensitive information pertaining to individuals and organizations. As a result, ensuring the privacy and security of IoT data has become a top priority. Many users prefer to connect their IoT devices to semi-trusted IoT cloud platforms. However, existing IoT cloud platforms often fail to adequately safeguard data privacy. Furthermore, most IoT data privacy protection schemes tend to overlook privacy and security concerns within this context. To address these challenges, this paper introduces a solution for IoT data privacy protection. This solution builds upon the existing architecture of IoT cloud platforms and incorporates blockchain and proxy re-encryption technology to enhance the privacy and security of IoT data. This approach achieves decentralized access control through blockchain technology and employs proxy re-encryption for end-to-end encrypted data transmission. We have developed a prototype system for this solution, including IoT client and server applications, Distributed Applications (DApps), and blockchain smart contracts. Experimental results demonstrate that this solution delivers excellent encryption and decryption performance, thereby ensuring data privacy and security. In comparison to existing solutions employing Attribute-Based Encryption (ABE), our approach offers enhanced feasibility and effectiveness. It presents an improved path for existing IoT cloud platforms to securely and reliably handle sensitive data, with promising applications across various domains. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Blockchain; Internet of Things; privacy protection; proxy re-encryption; smart contract},
	keywords = {Access control; Blockchain; Internet of things; Privacy-preserving techniques; Sensitive data; Block-chain; Cloud platforms; Data privacy protections; Internet of things technologies; Privacy and security; Privacy preserving; Privacy protection; Protection schemes; Proxy re encryptions; Sensitive informations; Smart contract},
	correspondence_address = {Y. Yang; School of Information Science and Engineering, Yunnan University, Yunnan Province, 650500, China; email: yanhuaya@163.com},
	editor = {Li, H. and Wu, H.},
