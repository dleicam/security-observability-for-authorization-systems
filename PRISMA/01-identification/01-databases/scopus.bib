	keywords = {Authorization; Cloud computing; Computer system firewalls; Computer viruses; Cryptography; Intrusion detection; Learning algorithms; Machine learning; Attack behavior; Behaviour patterns; Cloud services; Cloud-computing; Honey net; Low-cost services; Machine-learning; R2NET; Record-and-replay; Zero day attack; Zero-day attack},
