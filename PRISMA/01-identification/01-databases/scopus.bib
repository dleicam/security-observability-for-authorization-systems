@CONFERENCE{Heutelbeck202195,
	author = {Heutelbeck, Dominic},
	title = {Demo: Attribute-stream-based access control (ASBAC) with the streaming attribute policy language (SAPL)},
	year = {2021},
	pages = {95 - 97},
	doi = {10.1145/3450569.3464397},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85108177255&doi=10.1145%2F3450569.3464397&partnerID=40&md5=da84d4f03005699e4a38ae137530799f},
	affiliations = {FTK-FORSCHUNGSINSTITUT FUR TELEKOMMUNIKATION UND KOOPERATION EV, Dortmund, Germany},
	abstract = {Traditional Attribute-Based Access Control (ABAC) implementations are based on a request-response protocol resulting in one decision for one authorization request. In stateful, session-based applications this may lead to polling the policy decision point (PDP) and policy information points (PIPs) referenced by policies. This leads to the well-known trade-offs between polling frequency and latency of updates becoming known to the client. Attribute-Stream-based Access Control (ASBAC) is an authorization model employing a publish-subscribe pattern protocol where a single subscription results in a stream of decisions dynamically updating based on the streams of changing attribute values, streams of changing policies, and PDP configuration. This demonstration will show the basic architecture of ASBAC based systems, show how the model is implemented by the Streaming Attribute Policy Language (SAPL) and its engine. The SAPL engine is available as Open Source for security researchers and practitioners. First, the overall architecture of the engine will be introduced, followed by a short demo of the publish-subscribe protocol. Afterwards, several key features of SAPL are demonstrated in an authoring and administration environment. Next, a full-stack web application employing SAPL is demonstrated, showing how Policy Enforcement Points (PEPs) are established. The demonstration concludes with a demo of the SAPL tools for testing policies and calculating test metrics on policies. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {Access control; Attribute-based access control; Data streams; Data structures; Policy languages},
	keywords = {Computer hardware description languages; Decision making; Economic and social effects; Engines; Network architecture; Attribute based access control; Attribute values; Authorization model; Policy decision points; Policy enforcement points; Policy language; Publish-subscribe; Tools for testing; Access control},
	correspondence_address = {D. Heutelbeck; FTK - Forschungsinstitut für Telekommunikation und Kooperation E.V., Dortmund, Germany; email: dheutelbeck@ftk.de},
	publisher = {Association for Computing Machinery},
