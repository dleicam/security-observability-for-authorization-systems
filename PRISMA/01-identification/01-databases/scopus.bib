@CONFERENCE{Choudhary2024,
	author = {Choudhary, Sachin and Kumar, Abhimanyu and Berwal, Krishan Kiran and Pundir, Manmohan},
	title = {Securing Smart Grid: A Cloud-Assisted Approach with Multi-Authority Attribute-Based Encryption},
	year = {2024},
	pages = {},
	doi = {10.1109/ICCCNT61001.2024.10724170},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85212979930&doi=10.1109%2FICCCNT61001.2024.10724170&partnerID=40&md5=6dba03025352bc4026f6f5426176b7cf},
	affiliations = {National Institute of Technology, Uttarakhand, Sumari, India; MHOW, Faculty of Communication Engineering, Indore, India},
	abstract = {With the evolution of smart grid technologies, the integration of cloud computing introduces new security challenges. Attribute-based encryption (ABE) has emerged as a promising solution, leveraging its attribute matching mechanism. Recognizing the heightened demands posed by smart meters, we present a novel approach called Multi-Authority CP-ABE (MA-CP-ABE). Our scheme employs Linear Secret-Sharing Schemes (LSSS) access structures for robust access control. Additionally, it leverages private cloud infrastructure for managing user authorization lists and authentication. Smart meters encrypt data using the MA-CP-ABE scheme before transmitting it to the cloud for storage and processing. When authorized users, such as utility providers or grid operators, request access to smart grid data, the cloud evaluates their roles and attributes against the access policies defined by the MA-CP-ABE. Access is granted only if the user's role or attributes match the access requirements, ensuring data confidentiality and integrity. Furthermore, extensive security analysis and performance evaluations are conducted to validate the effectiveness and efficiency of the MA-CP-ABE within smart grid environments. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Fine-grained control; Key Agreement; Multi-authority-CP-ABE; Smart Grid},
	keywords = {Cloud platforms; Attribute matching; Attribute-based encryptions; Cloud-computing; Fine-grained control; Key agreement; Multi authorities; Multi-authority-CP-attribute-based encryption; Security challenges; Smart grid; Smart Grid technologies; Smart power grids},
