	doi = {10.1109/ICSGRC53186.2021.9515199},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85114638579&doi=10.1109%2FICSGRC53186.2021.9515199&partnerID=40&md5=6a0f51d9bd549da11f53187d311a5a12},
