@CONFERENCE{Gupta2022854,
	author = {Gupta, Rajat and Dresel, Lukas Patrick and Spahn, Noah and Vigna, Giovanni and Kruegel, Christopher and Kim, Taesoo},
	title = {POPKORN: Popping Windows Kernel Drivers At Scale},
	year = {2022},
	journal = {ACM International Conference Proceeding Series},
	pages = {854 - 868},
	doi = {10.1145/3564625.3564631},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85144074041&doi=10.1145%2F3564625.3564631&partnerID=40&md5=27aa8f35cb9dcb1ff11d169b7e590993},
	affiliations = {Georgia Institute of Technology, Systems Software & Security Lab, Atlanta, United States; UC Santa Barbara College of Engineering, Santa Barbara, United States},
	abstract = {External vendors develop a significant percentage of Windows kernel drivers, and Microsoft relies on these vendors to handle all aspects of driver security. Unfortunately, device vendors are not immune to software bugs, which in some cases can be exploited to gain elevated privileges. Testing the security of kernel drivers remains challenging: the lack of source code, the requirement of the presence of a physical device, and the need for a functional kernel execution environment are all factors that can prevent thorough security analysis. As a result, there are no binary analysis tools that can scale and accurately find bugs at the Windows kernel level. To address these challenges, we introduce POPKORN, a lightweight framework that harnesses the power of taint analysis and targeted symbolic execution to automatically find security bugs in Windows kernel drivers at scale. Our system focuses on a class of bugs that affect security-critical Windows API functions used in privilege-escalation exploits. POPKORN analyzes drivers independently of both the kernel and the device, avoiding the complexity of performing a full-system analysis. We evaluate our system on a diverse dataset of 212 unique signed Windows kernel drivers. When run against these drivers, POPKORN reported 38 high impact bugs in 27 unique drivers, with manual verification revealing no false positives. Among the bugs we found, 31 were previously unknown vulnerabilities that potentially allow for Elevation of Privilege (EoP). During this research, we have received two CVEs and six acknowledgments from different driver vendors, and we continue to work with vendors to fix the issues that we identified. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Kernel Driver; Microsoft Windows; Missing Access Controls; Symbolic Execution; Taint Analysis},
	keywords = {Application programming interfaces (API); Model checking; Execution environments; Kernel drivers; MicroSoft; Microsoft windows; Missing access control; Physical devices; Software bug; Source codes; Symbolic execution; Taint analyse; Program debugging},
	correspondence_address = {R. Gupta; Systems Software & Security Lab, Georgia Institute of Technology, United States; email: rgupta415@gatech.edu},
	publisher = {Association for Computing Machinery},
	isbn = {9781450385855; 9781450314398; 9781450396387; 9781450390019; 9781450390217; 9781450348270; 9781450381963; 9781450322485; 9781450348201; 9781450364454},
