	doi = {10.1109/ICESIC61777.2024.10846251},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217868206&doi=10.1109%2FICESIC61777.2024.10846251&partnerID=40&md5=af10ef39a3f97f44fc3f3623c7e504fa},
