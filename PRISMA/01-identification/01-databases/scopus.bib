	pages = {},
	doi = {10.1016/j.jjimei.2023.100211},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85182353316&doi=10.1016%2Fj.jjimei.2023.100211&partnerID=40&md5=d52c68d6dfc8b34b3d05628c015c939b},
