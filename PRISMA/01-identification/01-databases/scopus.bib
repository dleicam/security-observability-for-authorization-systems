	keywords = {Information leakage; Attribute-based encryptions; Ciphertext-policy attribute-based encryptions; Cloud data; Cloud-computing; Data leakage; Data Sharing; Exponentials; Fine grained; Key escrow free; Self-sovereign identity; Ciphertext},
