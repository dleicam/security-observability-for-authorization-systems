	doi = {10.1016/j.comcom.2021.02.006},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85101417234&doi=10.1016%2Fj.comcom.2021.02.006&partnerID=40&md5=f452f7f00e432dddc2b371c4b46e7b53},
	affiliations = {Ocean University of China, Department of Computer Science and Technology, Qingdao, China; Qingdao University, College of Liberal Arts, Qingdao, China},
	abstract = {Public key encryption with equality test (PKEET) is an important cryptographic primitive for protecting users’ outsourced data in the cloud-based email systems. Due to the fact that it is required to deploy different authorization policies for the demand of dynamic privacy protection in the cloud-based email systems, Ma et al. recently presented a new related primitive, called public key encryption with equality test supporting flexible authorization (PKEET-FA). In their proposal, four types of authorization were considered to support different authorization policies. Their proposal is based on the bilinear pairings. However, as the basic operation of equality test, bilinear pairings are expensive operations compared with modular multiplications and modular inverses. Hence, it is desired to propose a new method for constructing efficient equality test with modular multiplications and modular inverses. In this paper, we present such a PKEET-FA scheme. Compared with Ma et al.’s, our proposal is (surprisingly) more efficient, especially in terms of equality test. Moreover, our proposal supports an additional type of authorization, called user-specific ciphertext-to-user (or user-specific user-to-ciphertext) level authorization. Hence, ours is more flexible than Ma et al.’s. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {Cloud computing; Flexible authorization; Public key encryption with equality test},
	keywords = {Data privacy; Electronic mail; Testing; Authorization policy; Bilinear pairing; Cryptographic primitives; Modular Multiplication; Outsourced datum; Privacy protection; Public-key encryption; Without bilinear pairings; Public key cryptography},
