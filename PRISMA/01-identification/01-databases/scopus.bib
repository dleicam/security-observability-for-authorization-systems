@ARTICLE{Ezhil Arasi202210772,
	author = {Ezhil Arasi, V. and Indra Gandhi, K. and Kulothungan, Kanagasabai},
	title = {Auditable attribute-based data access control using blockchain in cloud storage},
	year = {2022},
	journal = {Journal of Supercomputing},
	volume = {78},
