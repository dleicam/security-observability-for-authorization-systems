	year = {2024},
	journal = {IEEE Access},
	volume = {12},
	pages = {70568 - 70580},
	doi = {10.1109/ACCESS.2024.3401844},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85193478824&doi=10.1109%2FACCESS.2024.3401844&partnerID=40&md5=8a413cebfa85c0fed3cfe96704eb10ea},
	affiliations = {İstanbul Teknik Üniversitesi, Cyber Security Engineering and Cryptography Department, Istanbul, Turkey; Işik Üniversitesi, Department of Computer Engineering, Istanbul, Turkey},
	abstract = {This study introduces a hierarchical key assignment scheme (HKAS) based on the closest vector problem in an inner product space (CVP-IPS). The proposed scheme offers a comprehensive solution with scalability, flexibility, cost-effectiveness, and high performance. The key features of the scheme include CVP-IPS based construction, the utilization of two public keys by the scheme, a distinct basis set designated for each class, a direct access scheme to enhance user convenience, and a rigorous mathematical and algorithmic presentation of all processes. This scheme eliminates the need for top-down structures and offers a significant benefit in that the lengths of the basis sets defined for classes are the same and the costs associated with key derivation are the same for all classes, unlike top-down approaches, where the higher class in the hierarchy generally incurs much higher costs. The scheme excels in both vertical and horizontal scalability due to its utilization of the access graph and is formally proven to achieve strong key indistinguishability security (S-KI-security). This research represents a significant advancement in HKAS systems, providing tangible benefits and improved security for a wide range of use cases. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {access control; access graph; closest vector problem; Hierarchical key assignment; inner product space; strong key indistinguishability},
	keywords = {Cloud computing; Cost effectiveness; Cryptography; Scalability; Vector spaces; Access graph; Closest vector problem; Cloud-computing; Complexity theory; Hierarchical key assignment; Ho-momorphic encryptions; Homomorphic-encryptions; Indistinguishability; Inner product space; Public keys; Strong key indistinguishability; Strong keys; Access control},
	correspondence_address = {I. Celikbilek; Informatics Institute, Istanbul Technical University, Cybersecurity Engineering and Cryptography Department, Istanbul, 34469, Turkey; email: celikbilek20@itu.edu.tr},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
