@CONFERENCE{He2021379,
	author = {He, Yachen and Dong, Guishan and Liu, Dong and Peng, Haiyang and Chen, Yuxiang},
	title = {Access Control Scheme Supporting Attribute Revocation in Cloud Computing},
	year = {2021},
	pages = {379 - 384},
	doi = {10.1109/NaNA53684.2021.00072},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85124025707&doi=10.1109%2FNaNA53684.2021.00072&partnerID=40&md5=c67e0543c287df36c7488539dc3c204d},
	affiliations = {China Electronic Technology Group Corporation, Shanghai, China; Ltd., Chengdu, China},
	abstract = {To break the data barrier of the information island and explore the value of data in the past few years, it has become a trend of uploading data to the cloud by data owners for data sharing. At the same time, they also hope that the uploaded data can still be controlled, which makes access control of cloud data become an intractable problem. As a famous cryptographic technology, ciphertext policy-based attribute encryption (CP-ABE) not only assures data confidentiality but implements fine-grained access control. However, the actual application of CP-ABE has its inherent challenge in attribute revocation. To address this challenge, we proposed an access control solution supporting attribute revocation in cloud computing. Unlike previous attribute revocation schemes, to solve the problem of excessive attribute revocation overhead, we use symmetric encryption technology to encrypt the plaintext data firstly, and then, encrypting the symmetric key by utilizing public-key encryption technology according to the access structure, so that only the key ciphertext is necessary to update when the attributes are revoked, which reduces the spending of ciphertext update to a great degree. The comparative analysis demonstrates that our solution is reasonably efficient and more secure to support attribute revocation and access control after data sharing. © 2022 Elsevier B.V., All rights reserved.},
	author_keywords = {access control; attribute revocation; Attribute-based encryption; cloud computing},
	keywords = {Cloud computing; Public key cryptography; Access control schemes; Attribute revocation; Attribute-based encryptions; Ciphertext policies; Ciphertexts; Cloud-computing; Data Sharing; Encryption technologies; Information island; Policy-based; Access control},
