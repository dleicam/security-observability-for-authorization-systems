	year = {2024},
	journal = {IEEE Internet of Things Journal},
	volume = {11},
	number = {2},
	pages = {3510 - 3523},
	doi = {10.1109/JIOT.2023.3296906},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165257523&doi=10.1109%2FJIOT.2023.3296906&partnerID=40&md5=176a0150282dbf463e153b8c17363b3d},
	affiliations = {Shanghai University, School of Communication and Information Engineering, Shanghai, China},
	abstract = {The vehicular social networks (VSNs) provide passengers, drivers and vehicles with multiple services, such as safe driving, data sharing, and traffic management. However, transmitting data in VSNs can expose information, such as the user's identity and location. Malicious users who tamper with shared data can even cause serious traffic accidents. Considering the privacy protection and secure transmission of shared data in VSNs, we propose a blockchain-based and fog computing-assisted data access control (BFDAC) scheme. We combine the multi-authority ciphertext-policy attribute-based encryption algorithm with the consortium blockchain to avoid the security and trust issues in the form of centralized key management, and outsource part of the decryption calculations to roadside units (RSUs) as fog nodes to realize lightweight calculation for users. Our BFDAC scheme also supports user tracking and revocation, while users can also revoke shared data saved in the cloud. Security analysis shows that the BFDAC scheme can effectively protect the shared data. Experiments show that our BFDAC scheme reduces 32.8% in storage cost, 9.5% in encryption cost, and 57.1% in outsourced decryption cost compared to previous ones. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Blockchain; data access control; outsourcing decryption; revocation; vehicular social networks (VSNs)},
	keywords = {Access control; Cryptography; Digital storage; Fog; Fog computing; Internet of things; Social networking (online); Social sciences computing; Access control schemes; Block-chain; Cloud-computing; Data access control; Gold; Outsourcing decryption; Revocation; Shared data; Vehicular social network; Blockchain},
	correspondence_address = {Y. Ren; Shanghai University, School of Communication and Information Engineering, Shanghai, 200444, China; email: renyanli@shu.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
