@article{ WOS:000765555700003,
Author = {Obiri, Isaac Amankona and Xia, Qi and Xia, Hu and Affum, Eric and Abla,
   Smahi and Gao, Jianbin},
Title = {Personal health records sharing scheme based on attribute based
   signcryption with data integrity verifiable},
Journal = {JOURNAL OF COMPUTER SECURITY},
Year = {2022},
Volume = {30},
Number = {2},
Pages = {291-324},
Abstract = {The distribution of personal health records (PHRs) via a cloud server is
   a promising platform as it reduces the cost of data maintenance.
   Nevertheless, the cloud server is semi-trusted and can expose the
   patients' PHRs to unauthorized third parties for financial gains or
   compromise the query result. Therefore, ensuring the integrity of the
   query results and privacy of PHRs as well as realizing fine-grained
   access control are critical key issues when PHRs are shared via cloud
   computing. Hence, we propose new personal health records sharing scheme
   with verifiable data integrity based on B+ tree data structure and
   attribute-based signcryption scheme to achieve data privacy, query
   result integrity, unforgeability, blind keyword search, and fine-grained
   access control.},
Type = {Article},
Affiliation = {Gao, JB (Corresponding Author), Univ Elect Sci \& Technol China, Sch Comp Sci \& Engn, Chengdu, Peoples R China.
