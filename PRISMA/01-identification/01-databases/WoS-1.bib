@inproceedings{ WOS:001283898700092,
Author = {More, Mandar and Wagholikar, Raj and Chopade, Swati},
Book-Group-Author = {IEEE},
Title = {CloudCraft: Transforming Resume Management System with Dynamic Cloud
   Deployment},
Booktitle = {2024 IEEE 14TH SYMPOSIUM ON COMPUTER APPLICATIONS \& INDUSTRIAL
   ELECTRONICS, ISCAIE 2024},
Series = {International Conference on Computer Applications and Industrial
   Electronics},
Year = {2024},
Pages = {99-103},
Note = {14th Symposium on Computer Applications \& Industrial Electronics
   (ISCAIE), Penang Island, MALAYSIA, MAY 24-25, 2024},
Abstract = {CloudCraft represents a novel approach to web-based resume management
   systems, leveraging the power of cloud computing for dynamic deployment
   and customizable user experiences. Earlier the Resume Builder websites
   were not capable of providing drag and drop features of customizing the
   content like User Bio, Education Details, Work Experience etc. This is
   where our CloudCraft Solution come into picture where we overcome this
   problem by providing drag and drop features using JavaScript's Functions
   and Event Listeners. This paper also explores the integration of
   CloudCraft with AWS, providing users with a seamless and flexible
   platform to create, customize, and personalize resumes. The research
   delves into the architecture of the CloudCraft project, emphasizing its
   innovative use of Docker for containerization and AWS for scalable
   deployment. The user-centric design allows individuals to tailor their
   resumes effortlessly, enhancing their job application process. Security
   measures, including password encryption and JSON Web Tokens (JWT),
   ensure a secure client-server communication.},
