@inproceedings{ WOS:000455682100053,
Author = {Maseedu, Jeswanth and Pasupuleti, Syam Kumar},
Book-Group-Author = {IEEE},
Title = {Attribute based Range Search over Encrypted Data for Privacy Preserving
   in Cloud Computing},
Booktitle = {2018 INTERNATIONAL CONFERENCE ON ADVANCES IN COMPUTING, COMMUNICATIONS
   AND INFORMATICS (ICACCI)},
Year = {2018},
Pages = {323-329},
Note = {7th International Conference on Computing, Communications and
   Informatics (ICACCI), Bangalore, INDIA, SEP 19-22, 2018},
Abstract = {Cloud Computing is a model for providing ondemand services like storing
   and retrieve the data from the cloud instead of our local computer's
   drive. With the advantages of cloud computing, most of the data owners
   are outsourcing their database to the cloud for great flexibility and
   economic savings. However, problem of outsourcing database to the cloud
   is the privacy of data i. e., disclosing the data present in the cloud
   to unauthorized user due to the untrusted environment. To protect data
   privacy, the user can encrypt the data, but it is difficult task for an
   user to search over the encrypted data. Range search over encrypted data
   is a preferable solution. Many researchers worked on scheme range search
   over encrypted data, but those are lacking in efficiency and fine-grain
   access control. To address these issues, in this paper, we propose
   attribute based range search over encrypted data. In our scheme, we use
   Ciphertext Policy-Attribute Based Encryption (CP-ABE) for privacy and
   access control. We also use the B+ tree data structure to provide search
   efficiency and dynamic operations. Through security analysis and
   performance analysis we prove that our scheme is secure and efficient},
Type = {Proceedings Paper},
