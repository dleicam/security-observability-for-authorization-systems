@inproceedings{ WOS:001324578100009,
Author = {Lei, Gang and Luo, Fu and Chen, Jianchen},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Research on Data Security Technology in Cloud Computing Environment},
Booktitle = {2023 11TH INTERNATIONAL CONFERENCE ON INFORMATION TECHNOLOGY: IOT AND
   SMART CITY, ITIOTSC 2023},
Year = {2023},
Pages = {42-45},
Note = {11th International Conference on Information Technology - IoT and Smart
   City (ITIoTSC), Shanghai, PEOPLES R CHINA, AUG 11-13, 2023},
Abstract = {With the widespread use of cloud computing, big data, blockchain and
   artificial intelligence, data security and privacy protection has become
   an important research topic in the cloud computing environment. In this
   paper, we propose a proof-of-data-possession (PDP) model based on
   blockchain and trusted third-party auditing, which aims to address the
   confidentiality, integrity and availability of data in the cloud
   environment. By combining blockchain and trusted third-party auditing
   technologies, the model achieves effective protection of data integrity
   and confidentiality, while leveraging the decentralized nature of
   blockchain to enable open and transparent verification of data holdings.
   In addition, experimental results show that the model has significant
   advantages over the traditional PDP model in terms of data security,
   data availability, and data integrity. Overall, this study provides a
   new solution for data security in cloud environments, which has
   theoretical and practical implications for both cloud service providers
   and users.},
