@article{ WOS:000437555800123,
Author = {Yang, Yang and Zheng, Xianghan and Guo, Wenzhong and Liu, Ximeng and
   Chang, Victor},
Title = {Privacy-preserving fusion of IoT and big data for e-health},
Journal = {FUTURE GENERATION COMPUTER SYSTEMS-THE INTERNATIONAL JOURNAL OF ESCIENCE},
