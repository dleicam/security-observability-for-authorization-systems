   Viswanathan, K. K., Kuwait Coll Sci \& Technol, Dept Math, Doha 35004,Block 4,POB 27235, Kuwait, Kuwait.},
DOI = {10.1109/CSE/EUC.2019.00039},
ISSN = {1949-0828},
