@inproceedings{ WOS:000886226800005,
Author = {Suryadipta, Majumdar and Madi, Taous and Jarraya, Yosr and Pourzandi,
   Makan and Wang, Lingyu and Debbabi, Mourad},
Editor = {Zincir-Heywood, N and Bonfante, G and Debbabi, M and Garcia-Alfaro, J},
Title = {Cloud Security Auditing: Major Approaches and Existing Challenges},
Booktitle = {FOUNDATIONS AND PRACTICE OF SECURITY, FPS 2018},
Series = {Lecture Notes in Computer Science},
Year = {2019},
Volume = {11358},
