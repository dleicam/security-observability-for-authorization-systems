@inproceedings{ WOS:000932853900036,
Author = {Madni, Ahmad Fayyaz and Shah, Munam Ali},
Book-Group-Author = {IEEE},
Title = {Security Model for Securing Data on Cloud},
Booktitle = {2022 17TH INTERNATIONAL CONFERENCE ON EMERGING TECHNOLOGIES (ICET'22)},
Series = {International Conference on Emerging Technologies ICET},
Year = {2022},
Pages = {206-211},
Note = {17th International Conference on Emerging Technologies (ICET), Ghulam
   Ishaq Khan Inst Engn Sci \& Technol, Topi, PAKISTAN, NOV 29-30, 2022},
Abstract = {Data storage is transitioning from physical servers to ``cloud{''}
   storage because cloud service providers deliver the resources through
   the Internet when required. Cloud computing is a successful and rapidly
   evolving technology. With new features and capabilities released
   regularly, companies can move to the cloud on a ``pay as you go{''}
   model. The most prominent feature of pay as you go model on the cloud is
   that it is cost-effective, however, this makes the cloud platform
   vulnerable to cyber attacks. This is the reason, the safety of such
   information has become a concern. This paper provides a security
   framework that secures cloud storage from unauthorized individuals by
   using user identification and authorization. We have used dual
   encryption by using Advance encryption standard (AES) \& Ecliptic Curve
