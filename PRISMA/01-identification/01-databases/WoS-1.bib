@article{ WOS:000473285900025,
Author = {Fatima, Shahin and Ahmad, Shish},
Title = {An Exhaustive Review on Security Issues in Cloud Computing},
Journal = {KSII TRANSACTIONS ON INTERNET AND INFORMATION SYSTEMS},
Year = {2019},
Volume = {13},
