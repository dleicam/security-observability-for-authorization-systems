@inproceedings{ WOS:000456340700010,
Author = {Ulybyshev, Denis and Bhargava, Bharat and Oqab-Alsalem, Aala},
Editor = {Deka, GC and Kaiwartya, O and Vashisth, P and Rathee, P},
Title = {Secure Data Exchange and Data Leakage Detection in an Untrusted Cloud},
Booktitle = {APPLICATIONS OF COMPUTING AND COMMUNICATION TECHNOLOGIES, ICACCT 2018},
Series = {Communications in Computer and Information Science},
Year = {2018},
Volume = {899},
Pages = {99-113},
Note = {1st International Conference on Applications of Computing and
   Communication Technologies (ICACCT), Univ Delhi, Shyama Prasad Mukherji
   Coll, Delhi, INDIA, MAR09, 2018},
Abstract = {In service-oriented architecture, services can communicate and share
   data amongst themselves. It is necessary to provide role-based access
   control for data. In addition, data leakages made by authorized insiders
   to unauthorized services should be detected and reported back to the
   data owner. In this paper, we propose a solution that uses role-and
   attribute-based access control for data exchange among services,
   including services hosted by untrusted environments. Our approach
   provides data leakage prevention and detection for multiple leakage
   scenarios. We also propose a damage assessment model for data leakages.
   The implemented prototype supports a privacy-preserving exchange of
   Electronic Health Records that can be hosted by untrusted cloud
   providers, as well as detecting leakages made by insiders.},
