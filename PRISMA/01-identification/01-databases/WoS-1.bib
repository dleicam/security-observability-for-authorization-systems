@article{ WOS:001515297500001,
Author = {Garigipati, Nagababu and Srithar, S. and Krishna Reddy, V.},
Title = {An efficient integrity-based heterogeneous EHR data encryption and
   decryption framework for cloud computing environment},
Journal = {INTERNATIONAL JOURNAL OF MODELING SIMULATION AND SCIENTIFIC COMPUTING},
Year = {2025},
Month = {2025 JUN 25},
Abstract = {Cloud data security is critical in healthcare to protect patient
   information across diverse databases. 2D and 3D medical datasets pose
   challenges for traditional cloud security frameworks due to differences
   in format, size, and computational demands. This study introduces a
   hybrid encryption-decryption framework that uses token key generation
   for efficient distributed key management. The framework generates token
   keys from user-provided information, improving encryption and decryption
   processes. It also creates dynamic token keys to verify both homogeneous
   and heterogeneous data. Evaluations using 2D and 3D EHRs show that the
   framework outperforms traditional models in computation time and data
   security. These findings validate its effectiveness in securing complex
   datasets.},
