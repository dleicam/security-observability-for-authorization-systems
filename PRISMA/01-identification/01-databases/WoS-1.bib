@article{ WOS:001231010400001,
Author = {Cai, Rongsheng and Chen, Lanxiang and Zhu, Yizhao},
Title = {Using private set intersection to achieve privacy-preserving
   authorization for IoT systems},
Journal = {JOURNAL OF INFORMATION SECURITY AND APPLICATIONS},
Year = {2024},
Volume = {83},
Month = {JUN},
Abstract = {We propose a novel approach to utilize private set intersection (PSI) to
   achieve privacy -preserving authorization for IoT systems for the first
   time in this work. Our contribution includes an optimized PSI protocol
   that reduces communication costs and enhances privacy protection. The
   proposed protocol utilizes an aggregated algorithm to gain minimized
   communication overhead. Additionally, it achieves the size -hiding of
   the cloud platform's roles set with an optimized protocol. Specifically,
   we: (1) introduce a role -based access control framework that leverages
   PSI technology for IoT-focused system authorization; (2) optimize PSI
   communication complexity, resulting in ideal and constant costs
   regardless of the size of the role set of the two parties involved from
   the cloud platform to the IoT client, while maintaining linearity with
   the client's set size in the opposite direction, this significantly
   improves communication overhead for IoT systems; and (3) strengthen
   privacy protection concerning the cloud platform's set size. Overall,
   our proposed scheme enhances the practicality of IoT-focused system
   authorization while preserving privacy.},
