Year = {2019},
Pages = {350-353},
Note = {3rd International Conference on Computing Methodologies and
   Communication (ICCMC), Erode, INDIA, MAR 27-29, 2019},
Abstract = {Cloud computing paradigm encounters many practical issues especially
   data security and access control over the outsourced secret data is a
   major one. Cloud providing computation as a service must prevent misuse
   of data by third party cloud service providers. This paper addresses a
   novel Symmetric Fully Homomorphic Encryption scheme (UGFHE) with access
   control policies written in XACML to provide controlled access over the
   ciphers and the homomorphic property is ensured by Smith Normal Form
   (SNF). The access control policies and ciphers are centrally managed by
   data owners. The security of the system is analyzed and the performance
   is also measured.},
