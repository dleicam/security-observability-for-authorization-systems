@article{ WOS:001549198300001,
Author = {Zhao, Kejie and Bao, Zijian and Zhang, Yongxin and Lei, Hong},
Title = {BECAAC: A Blockchain and Edge Computing-Assisted Access Control Scheme
   for Medical Data Sharing},
Journal = {IEEE INTERNET OF THINGS JOURNAL},
