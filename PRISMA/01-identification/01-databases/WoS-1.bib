@inproceedings{ WOS:001536434400032,
Author = {Papachappa, Hemanth Manchabale},
Editor = {Stojanovic, R and Jozwiak, L and Lutovac, B},
Title = {Dynamic and Secure Resource Management in Cloud Computing: A
   Control-Theoretic Approach},
Booktitle = {2025 14TH MEDITERRANEAN CONFERENCE ON EMBEDDED COMPUTING, MECO},
Series = {Mediterranean Conference on Embedded Computing},
Year = {2025},
Pages = {142-147},
Note = {14th Mediterranean Conference on Embedded Computing-MECO-Annual, Budva,
   MONTENEGRO, JUN 10-14, 2025},
Abstract = {As cloud computing continues to evolve, ensuring secure and efficient
   resource management remains a critical challenge. This paper presents a
   dynamic resource control system designed to improve security and
   performance in cloud environments. By integrating control theory with
   access control mechanisms, we propose a framework that provides cloud
   resources based on predefined security attributes and service-level
   agreements (SLAs). Our system utilizes role-based access control (RBAC)
   and fine-grained usage management to regulate data access, ensuring
   compliance with confidentiality, integrity, and availability
   requirements. Additionally, we implement a multiinput multi-output
   (MIMO) control model to optimize resource allocation dynamically.
   Experimental results demonstrate that our approach effectively balances
   performance and security while maintaining scalability across hybrid
   cloud infrastructures. This work contributes to the ongoing development
   of secure cloud computing architectures by providing a robust mechanism
   for automated resource provisioning and policy enforcement.},
