@inproceedings{ WOS:000578467600073,
Author = {Saito, Takamichi and Kikuta, Tsubasa and Koshiba, Rikita},
Editor = {Barolli, L and Hellinckx, P and Enokido, T},
Title = {How Securely Are OAuth/OpenID Connect Implemented in Japan?},
Booktitle = {ADVANCES ON BROAD-BAND WIRELESS COMPUTING, COMMUNICATION AND
   APPLICATIONS},
Series = {Lecture Notes in Networks and Systems},
Year = {2020},
Volume = {97},
Pages = {800-811},
Note = {14th IEEE International Conference on Broadband Wireless Computing,
   Communication and Applications (BWCCA), Univ Antwerp, Antwerp, BELGIUM,
   NOV 07-09, 2019},
Abstract = {When a website authenticates users, it does so for a so-called social
   login in electronic commerce (EC) site. A social login is used for a
   social media account, such as Facebook, Google, and Twitter. In such a
   case, the website uses OAuth and OpenID Connect. However, the
   implementation of a website might involve privacy concerns or be
   vulnerable to the attacks. In this paper, by crawling the login pages of
   500 Japanese EC sites and tracing the authentication flows, we
   investigate the implementation status of social logins and their
   security against cross-site request forgery. We observed 28 websites
   that acquired more user permissions from SNS than necessary, or were
   vulnerable as a result of improper implementation.},
