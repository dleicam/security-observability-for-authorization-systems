@inproceedings{ WOS:000767941100024,
Author = {Li, Taoshen and Liu, Qing and Huang, Ruwei},
Editor = {Xing, C and Fu, X and Zhang, Y and Zhang, G and Borjigin, C},
Title = {Multi-user Fully Homomorphic Encryption Scheme Based on Policy for Cloud
   Computing},
Booktitle = {WEB INFORMATION SYSTEMS AND APPLICATIONS (WISA 2021)},
