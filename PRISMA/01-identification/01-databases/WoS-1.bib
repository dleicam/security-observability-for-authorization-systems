Pages = {787-792},
Note = {SoutheastCon Conference, Mobile, AL, MAR 26-APR 03, 2022},
Abstract = {As the number of cyber attacks on cloud infrastructures increases, cloud
   monitoring systems are needed to detect possible breaches, identify
   security gaps, and secure the cloud assets well before a possible cyber
   attack happens. In this paper, we present a monitoring system for cloud
   infrastructures that can collect statistics, detect several types of
   issues in the cloud and send notifications in a protected form to the
   owner. Our solution supports data confidentiality and integrity for
   cloud instance notifications and alerts, so that they can be sent via
   email or in popular messengers, such as Microsoft Teams or Slack.
   Furthermore, our solution provides fine-grained role-based and
   attribute-based access control for cloud instance notifications and
   alerts. We will also show how we integrated our cloud monitoring
   solution with the Amazon EC2 cloud. However, our approach is generic and
   can be used on other cloud platforms.},
