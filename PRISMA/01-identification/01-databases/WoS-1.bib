@inproceedings{ WOS:001534325100013,
Author = {Yu, Chuntang and Feng, Xia and Zhan, Yongzhao},
Editor = {Zhu, T and Li, J and Castiglione, A},
Title = {Blockchain-Assisted Anonymous Data Sharing Scheme with Full
   Accountability for CloudIoT},
Booktitle = {ALGORITHMS AND ARCHITECTURES FOR PARALLEL PROCESSING, ICA3PP 2024, PT
   III},
Series = {Lecture Notes in Computer Science},
Year = {2025},
Volume = {15253},
Pages = {242-262},
Note = {24th International Conference on Algorithms and Architectures for
   Parallel Processing-ICA3PP, Macau, PEOPLES R CHINA, OCT 29-31, 2024},
Abstract = {The combination of cloud computing and the Internet of Things has
   created numerous possibilities for data sharing applications that
   prioritize privacy, accountability, and efficiency. Currently, many data
   sharing schemes based on Attribute-Based Encryption (ABE) show promise
   due to their fine-grained access control and one-to-many data
   encryption. However, existing schemes often struggle to find a balance
   between protecting user identity privacy and ensuring accountability. To
   address this limitation, this paper proposes a Blockchain-Assisted
   Anonymous Data Sharing scheme (BAADS) that provides full accountability.
   BAADS incorporates ElGamal encryption, signature of knowledge, and
   blockchain technology to design an anonymous identity management
   mechanism. Additionally, it integrates a reconstructed attribute
   encryption scheme that supports data auditing, identity tracking, and
   verifiable outsourced decryption. Compared to existing schemes, the key
   advantage of BAADS is that it enables both anonymous data sharing and
   full accountability for malicious or negligent behavior of all
   participants (data owners, data users, and cloud service providers). We
   have formalized the security aspects of BAADS and demonstrated its
   security in the random oracle model. Moreover, we have implemented the
   scheme using Hyperledger Fabric and OpenABE, and the experimental
   results have shown the effectiveness and availability of the scheme.},
