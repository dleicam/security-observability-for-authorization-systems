@inproceedings{ WOS:000459621000044,
Author = {Ponomarev, K. Y. and Nissenbaum, O. V.},
Editor = {Kosykh, A},
Title = {Attribute-Based Encryption with Authentication Provider in FIWARE
   Platform},
Booktitle = {2018 12TH INTERNATIONAL IEEE SCIENTIFIC AND TECHNICAL CONFERENCE ON
   DYNAMICS OF SYSTEMS, MECHANISMS AND MACHINES (DYNAMICS)},
Series = {Dynamics of Systems Mechanisms and Machines},
Year = {2018},
Note = {12th International IEEE Scientific and Technical Conference on Dynamics
   of Systems, Mechanisms and Machines (Dynamics), Omsk, RUSSIA, NOV 13-15,
   2018},
Abstract = {This paper aims at presenting the approach for the process of attributes
   verification in the Attribute-Based Encryption schemes. We considered
   ABE methods in the Internet of Things environment. The main idea is to
   allow users or device owners to verify attributes using standardized and
   well-known authorization protocols like Oauth2. More accurately,
   Attribute Authority will use Authentication as a Service approach for
   users and device controllers authentication. We described software
   service for Attribute-Based Encryption methods in the context of FIWARE
   platform. Components of this platform use Oauth2 for authentication and
   authorization mechanisms. More specifically, we developed a web
