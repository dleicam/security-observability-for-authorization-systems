Journal = {INTERNATIONAL JOURNAL OF ADVANCED COMPUTER SCIENCE AND APPLICATIONS},
Year = {2021},
Volume = {12},
Number = {8},
Pages = {599-604},
Month = {AUG},
Abstract = {Homelab is a discussion platform on course materials and assignments for
   students and is packed in an Android application product and website.
   The Homelab website is built using Laravel. For Android-based Homelab
   application development, a special Application Programming Interface
   (API) with JWT security is made in this research. In Homelab, besides
   the question and answer feature, a virtual conversation agent (chatbot)
   based on deep learning with a retrieval model that uses multilayer
   perceptron and a special text dataset for conversations about Homelab
   products is also created. The virtual conversation agent at Homelab is
   made by utilizing the Sastrawi library and natural language processing
   to facilitate the processing of user messages in Indonesian. The output
   of this research is the response from the chatbot and the probability
   value from the classification results of the available response classes.
   The system made has an accuracy rate of 96.43 percent with an average
   processing time of 0.3 seconds to get a response.},
