Title = {New secure access control model for cloud computing based on Chaotic
   systems},
Booktitle = {2023 INTERNATIONAL WIRELESS COMMUNICATIONS AND MOBILE COMPUTING, IWCMC},
Series = {International Wireless Communications and Mobile Computing Conference},
Year = {2023},
Pages = {1485-1490},
Note = {19th IEEE International Wireless Communications and Mobile Computing
   (IEEE IWCMC), Marrakesh, MOROCCO, JUN 19-23, 2023},
Abstract = {Cloud computing is a cutting-edge technology that integrates a variety
   of networked devices to provide required services. Individuals as well
   as organizations can use cloud computing to gain on-demand access to
   handled and scalable IT resources such as servers, storage, and apps via
   a shared network.. However, in such systems, a large user base from many
   fields, each with their own set of policies, can lead to a variety of
   issues, such as the loss of access control information, theft, or
   unauthorized use of information. To overcome these issues, researchers
   and specialists have developed a number of approaches for ensuring
   secure access to cloud services. This essay compares and summarizes
   access control models.To overcome the drawbacks of existing models, we
   propose a more effective and sophisticated extended access control model
   based on chaotic systems.},
