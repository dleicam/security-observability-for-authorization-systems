@article{ WOS:000938088300001,
Author = {Petcu, Adrian and Pahontu, Bogdan and Frunzete, Madalin and Stoichescu,
   Dan Alexandru},
Title = {A Secure and Decentralized Authentication Mechanism Based on Web 3.0 and
   Ethereum Blockchain Technology},
