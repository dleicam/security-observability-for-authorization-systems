@inproceedings{ WOS:000672735800003,
Author = {Li, Wanpeng and Mitchell, Chris J. and Chen, Thomas},
Editor = {Matyas, V and Svenda, P and Stajano, F and Christianson, B and Anderson, J},
Title = {Your Code Is My Code: Exploiting a Common Weakness in OAuth 2.0
   Implementations},
Booktitle = {SECURITY PROTOCOLS XXVI},
Series = {Lecture Notes in Computer Science},
Year = {2018},
Volume = {11286},
Pages = {24-41},
Note = {26th International Security Protocols Workshop, Trinity Coll, Cambridge,
   ENGLAND, MAR 19-21, 2018},
Abstract = {Many millions of users routinely use their Google, Facebook and
   Microsoft accounts to log in to websites supporting OAuth 2.0-based
   single sign on. The security of OAuth 2.0 is therefore of critical
   importance, and it has been widely examined both in theory and in
   practice. In this paper we disclose a new class of practical attacks on
   OAuth 2.0 implementations, which we call Partial Redirection URI
   Manipulation Attacks. An attack of this type can be used by an attacker
   to gain a victim user's OAuth 2.0 code (a token representing a right to
   access user data) without the user's knowledge; this code can then be
   used to impersonate the user to the relevant relying party website. We
   examined 27 leading OAuth 2.0 identity providers, and found that 19 of
   them are vulnerable to these attacks.},
Type = {Proceedings Paper},
Affiliation = {Li, WP (Corresponding Author), City Univ London, Dept Elect \& Elect Engn, London, England.
