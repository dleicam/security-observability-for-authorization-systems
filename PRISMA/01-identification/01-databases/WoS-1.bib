@article{ WOS:000527105300020,
Author = {Liu, Zhengtao and Ying, Yi and Peng, Yaqin and Xia, Jinyue},
Title = {A Temporal Multi-Tenant BRAC Model for Collaborative Cloud Services},
Journal = {CMC-COMPUTERS MATERIALS \& CONTINUA},
Year = {2020},
Volume = {63},
Number = {2},
Pages = {861-871},
Abstract = {Multi-tenant collaboration brings the challenge to access control in
   cloud computing environment. Based on the multi-tenant role-based access
   control (MT-RBAC) model, a Temporal MT-RBAC (TMT-RBAC) model for
   collaborative cloud services is proposed. It adds the time constraint
   between trusted tenants, including usable role time constraint based on
   both calendar and interval time. Analysis shows that the new model
   strengthens the presentation ability of MT-RBAC model, achieves the
   finer-grained access control, reduces the management costs and enhances
   the security of multitenant collaboration in cloud computing
   environment.},
