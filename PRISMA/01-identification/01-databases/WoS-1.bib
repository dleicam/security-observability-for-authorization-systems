@inproceedings{ WOS:001146292400001,
Author = {Ilapakurthy, Sriram Vamsi},
Editor = {Jararweh, Y and Quwaider, M},
Title = {Bolstering the Mobile Cloud: Addressing Emerging Threats and
   Strengthening Multi-Layered Defenses for Robust Mobile Security},
Booktitle = {2023 10TH INTERNATIONAL CONFERENCE ON INTERNET OF THINGS: SYSTEMS,
   MANAGEMENT AND SECURITY, IOTSMS},
Series = {International Conference on Internet of Things},
Year = {2023},
Pages = {7+},
Note = {10th International Conference on Internet of Things - Systems,
   Management and Security (IOTSMS), San Antonio, TX, OCT 23-25, 2023},
Abstract = {The proliferation of mobile devices as the primary computing platform
   for billions of users worldwide introduces escalating security threats,
   especially as mobile interactions with sensitive data and cloud services
   increase. This paper provides an analysis of emerging mobile security
   issues including malware stealing credentials and data from mobile cloud
   services, lower-level operating system and hardware vulnerabilities
   enabling exploits on mobile cloud confidentiality and integrity,
   weaknesses in mobile apps enabling attacks, and rising user privacy
   risks from excessive tracking. Current security limitations are also
   reviewed, including signature-based malware detection, coarse-grained
   access control, and fragmented visibility across the mobile ecosystem.
   An integrated cross-layer security strategy is proposed combining formal
   verification of critical mobile components, pervasive hardware-anchored
   security, intelligence-driven malware adaptation, robust devsecops
   processes, and coordinated defense visibility. As mobile continues
   dominating personal and enterprise computing, constructing resilient
   security foundations through research and awareness of mobile security
   issues and countermeasures is imperative for realizing the potential of
   mobile cloud computing.},
Type = {Proceedings Paper},
Affiliation = {Ilapakurthy, SV (Corresponding Author), Univ Calif Irvine, Samueli Sch Engn, Irvine, CA 92717 USA.
   Ilapakurthy, Sriram Vamsi, Univ Calif Irvine, Samueli Sch Engn, Irvine, CA 92717 USA.},
