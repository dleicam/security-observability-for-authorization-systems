   Waheed, Abdul, Seoul Natl Univ, Sch Elect \& Comp Engn, Seoul 08826, South Korea.},
DOI = {10.1109/ACCESS.2021.3104899},
ISSN = {2169-3536},
Keywords = {Encryption; Cryptography; Cloud computing; Indexes; Security; Access
