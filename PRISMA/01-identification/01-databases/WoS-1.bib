Title = {A Bibliometric Analysis of Cloud Computing Technology Research},
Booktitle = {PROCEEDINGS OF 2018 IEEE 3RD ADVANCED INFORMATION TECHNOLOGY, ELECTRONIC
   AND AUTOMATION CONTROL CONFERENCE (IAEAC 2018)},
Year = {2018},
Pages = {2353-2358},
Note = {3rd IEEE Advanced Information Technology, Electronic and Automation
   Control Conference (IAEAC), Chongqing, PEOPLES R CHINA, OCT 12-14, 2018},
Abstract = {Cloud computing involves multidisciplinary development and integration,
   and is the result of information technology and related applications. In
   this study, Web of Science Core Collection database is used as data
   source. Using Excel, Bibexcel, VOSviewer and CiteSpace software for data
   mining and quantitative analysis of the 2005-2018 year research papers
   on cloud computing, we explore the trend of change, the distribution of
   research forces, key areas, research hot spots and international
   cooperation. The results show that the number of documents in cloud
   computing has been growing, and there are many subjects involved in the
   research of cloud computing technology, mainly Computer Science,
   Engineering and Telecommunications. There are many research papers on
   cloud computing in China and the United States; China is most prominent
   in international cooperation and has strong cooperative relations with
   the major countries; Chinese Academy of Sciences is very active in the
   research of cloud computing, and its papers are far ahead of other
   institutions. The main focuses of the study are virtualization, mobile
   cloud computing, big data, security, etc. The main hot spots of research
   are mobile cloud computing, big data, fog computing, secure, storage,
   access control, sever consolidation, etc.},
