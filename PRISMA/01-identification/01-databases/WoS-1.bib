DOI = {10.1109/ACCESS.2019.2890976},
ISSN = {2169-3536},
Keywords = {Fog computing; attribute-based encryption; distributed access control;
   multi-authority; large-universe},
Keywords-Plus = {ATTRIBUTE-BASED ENCRYPTION; MULTI-AUTHORITY},
