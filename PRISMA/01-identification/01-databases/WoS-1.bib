@inproceedings{ WOS:001264790400025,
Author = {Jessup, Andrew and Cochak, Henrique Z. and Koslovski, Guilherme P. and
   Pillon, Mauricio A. and Miers, Charles C. and Correia, Pedro H. B. and
   Marques, Marco A. and Simplicio, Jr., Marcos A.},
