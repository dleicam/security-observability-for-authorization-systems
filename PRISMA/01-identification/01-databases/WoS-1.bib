@article{ WOS:001335354100003,
Author = {Kaur, Sumeet and Khare, Mayank Deep and Bhatt, Mukul and Haripriya, V.
   and Kumar, Ajay and Singla, Abhishek},
Title = {Multi-cloud security model: establishment of inter-server communication
   for authentication integrity},
Journal = {INTERNATIONAL JOURNAL OF SYSTEM ASSURANCE ENGINEERING AND MANAGEMENT},
Year = {2024},
Month = {2024 OCT 18},
Abstract = {Safety measures are used in multi-cloud security to protect
   infrastructure, apps, and data that are spread across several cloud
   environments. It necessitates lowering the risks connected to dispersed
   data access and storage by maintaining honesty and secrecy across
   several cloud platforms. The purpose of this research is to develop a
   novel inter-server communication for securing a multi-cloud environment.
   We discuss several challenges associated with utilizing many clouds and
   offering solutions such as the Supersingular isogeny Diffie-Hellman
   (SIDH) algorithm to prevent sensitive messages from being intercepted
   during internal server communications, Attribute-based encryption with
   outsourced decryption (ABE-OD) for fine-grained access control, rekeying
   at user withdrawal, Blowfish for message encryption, Rivest, Shamir, and
   Adleman (RSA) for key encryption. Our suggested paradigm includes
   anexchange of keys methodology to strengthen server-to-server
   prerequisites for communications in addition to security for
   fine-grained data security and access control on systems for storing.
   The RSA technique is used in the suggested concept to encrypt secret
   keys, allowing the encrypted keys to be stored in the database proxy
   server. The computation times for the construction of the BLAKE2 hash,
   data encryption, data decryption, and SIDH key exchange were determined.
   We made use of many parameters, including hash generation time,
   encryption time, and decryption time. The outcomes of the parameters are
   hash generation time of 2 mb (45), 4 mb (167), 8 mb (301), 16 mb (421),
   22 mb (563), 28 mb (685), 32 mb (705), 36 mb (911), 42 mb (1027),
   encryption times of 2 mb (24), 4 mb (90), 8 mb (170), 16 mb (265), 22 mb
   (342), 28 mb (420), 32 mb (508), 36 mb (595), 42 mb (712), and
   decryption time of 2 mb (42), 4 mb (164), 8 mb (298), 16 mb (417), 22 mb
   (560), 28 mb (682), 32 mb (705), 36 mb (907), 42 mb (1024). Based on the
   inter-server communication system, the experiment results demonstrate
   the effectiveness of the recommended methodology in securing a
   multi-cloud environment.},
