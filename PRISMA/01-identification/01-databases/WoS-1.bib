   Zhou, Lan, Univ Newcastle, Adv Cyber Secur Engn Res Ctr, Callaghan, NSW 2308, Australia.
   Zhou, Lan, Amazon, Seattle, WA 98109 USA.},
DOI = {10.1109/TSC.2022.3194252},
ISSN = {1939-1374},
Keywords = {Cloud computing; Organizations; Standards organizations; Encryption;
   Security; Access control; Data models; Data encryption; role-based
   encryption; cloud security; data outsourcing; user revocation},
Keywords-Plus = {ATTRIBUTE-BASED ENCRYPTION; DATA ACCESS-CONTROL; IDENTITY-BASED
