@inproceedings{ WOS:000922379100001,
Author = {Kwon, Yejin and Park, Young B.},
Book-Group-Author = {IEEE},
Title = {A Study on Dynamic Role-Based User Service Authority Control and
   Real-Time Service Configuration},
Booktitle = {2018 INTERNATIONAL CONFERENCE ON PLATFORM TECHNOLOGY AND SERVICE
   (PLATCON18)},
Year = {2018},
Pages = {1-5},
Note = {International Conference on Platform Technology and Service (PlatCon),
   Jeju, SOUTH KOREA, JAN 29-31, 2018},
Abstract = {Recently, most of the software is provided in the form of a cloud
   computing environment or a web application depending on the needs of
   various user needs and the specialized research field and the individual
   dependent system. Unlike the past, there is an increasing need for
   various types of software convergence services that are customized for a
   user who provides an optional service environment in which a service can
   be used in combination according to a user's purpose and needs. In
   particular, a service is provided on a cloud system when a user
   accessing receives a service access authority for a certain period of
