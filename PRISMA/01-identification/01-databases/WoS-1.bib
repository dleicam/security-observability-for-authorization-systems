@inproceedings{ WOS:001315952700033,
Author = {Leander, Bjorn and Causevic, Aida and Hansson, Hans and Lindstrom, Tomas},
Editor = {Trubiani, C and Weyns, D and Zdun, U and Muccini, H and Avgeriou, P and Buhnova, B and Camara, J and Caporuscio, M and Franzago, M and Koziolek, A and Scandurra, P},
Title = {Access Control for Smart Manufacturing Systems},
Booktitle = {SOFTWARE ARCHITECTURE, ECSA 2020 TRACKS AND WORKSHOPS},
