@inproceedings{ WOS:000492150100318,
Author = {Ayache, Meryeme and Gawanmeh, Amjad and Al-Karaki, Jamal N.},
Book-Group-Author = {IEEE},
Title = {XBAC: A Unified Access Control Model for Heterogeneous Multi-Tenancy
   Cloud Environments},
Booktitle = {2019 15TH INTERNATIONAL WIRELESS COMMUNICATIONS \& MOBILE COMPUTING
   CONFERENCE (IWCMC)},
