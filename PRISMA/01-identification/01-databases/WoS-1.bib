@article{ WOS:000999311000014,
Author = {Khan, Hooria and Zahoor, Ehtesham and Akhtar, Sabina and Perrin, Olivier},
Title = {A Blockchain-Based Approach for Secure Data Migration From the Cloud to
   the Decentralized Storage Systems},
Journal = {INTERNATIONAL JOURNAL OF WEB SERVICES RESEARCH},
Year = {2022},
Volume = {19},
Number = {1},
Abstract = {The use of cloud computing has been on the rise. However, there are many
   challenges associated with the cloud, such as high bandwidth
   requirements, data security, vendor lock-in, and others. The recent rise
   of decentralized file systems (DFSs) can help mitigate some of these
   challenges. However, they have some limitations of their own, and the
   current solutions do not provide any mechanism for implementing access
   control policies. This becomes a hurdle for migrating sensitive data
   from the cloud as the associated authorization policies cannot be
   migrated to the DFSs. In this paper, the authors address the problem of
   migrating data and associated authorization policies from the cloud to
   the DFS. They have applied the approach on the content and policies from
   an actual cloud provider, and it migrates data from AWS S3 to the IPFS,
   and the resource-based authorization policies specified at AWS are added
   to a custom blockchain solution. The authors have provided
   implementation details to justify the practicality of the approach.},
