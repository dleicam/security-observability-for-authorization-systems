@article{ WOS:000449104500013,
Author = {Hu, Vincent C. and Kuhn, D. Richard and Ferraiolo, David F.},
Title = {Access Control for Emerging Distributed Systems},
Journal = {COMPUTER},
Year = {2018},
Volume = {51},
Number = {10},
Pages = {100-103},
Month = {OCT},
Abstract = {As big data, cloud computing, grid computing, and the Internet of Things
   reshape current data systems and practices, IT experts are keen to
   harness the power of distributed systems to boost security and prevent
   fraud. How can these systems' capabilities be used to improve processing
   without inflating risk?},
Type = {Article},
Affiliation = {Hu, VC (Corresponding Author), NIST, Comp Secur Div, Gaithersburg, MD 20899 USA.
