   Ren, Yongjun, Guangxi Normal Univ, Key Lab Educ Blockchain \& Intelligent Technol, Minist Educ, Guilin 541004, Peoples R China.},
DOI = {10.3390/electronics14193954},
Article-Number = {3954},
ISSN = {2079-9292},
Keywords = {Artificial Intelligence of Things; zero-trust; self-sovereign identity;
   selective disclosure; blockchain},
