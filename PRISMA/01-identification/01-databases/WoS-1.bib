Title = {Experiments with Protocols and Frameworks used in IoT},
Booktitle = {2018 12TH INTERNATIONAL CONFERENCE ON COMMUNICATIONS (COMM)},
Series = {IEEE International Conference on Communications},
Year = {2018},
Pages = {277-280},
Note = {12th IEEE International Conference on Communications (COMM), Bucharest,
   ROMANIA, JUN 14-16, 2018},
Abstract = {This paper presents practical solutions to implement communication
   protocols in IoT environments using ESP8266 and Raspberry Pi and several
   frameworks with focus on MQTT, Twitter API OAUTH, ZettaJS and Domoticz,
   with some considerations on the security aspects. Our objectives were to
   investigate how we can use different available frameworks in order to
   implement communication protocols. The steps from installation to
   development and final solutions were described in the paper. We found
   that the available software libraries combined with the ease of use of
   the frameworks permit the implementation of protocols that can be
   successfully used in practical implementations even in the conditions of
   limited hardware resources.},
