Title = {Preserving Anonymity in Cloud Environment},
Booktitle = {PROCEEDINGS OF THE 2018 INTERNATIONAL CONFERENCE ON COMPUTATIONAL
   TECHNIQUES, ELECTRONICS AND MECHANICAL SYSTEMS (CTEMS)},
Year = {2018},
Pages = {371-375},
Note = {1st International Conference on Computational Techniques, Electronics
   and Mechanical Systems (CTEMS), KLS Gote Inst Technol, Belagavi, INDIA,
   DEC 21-23, 2018},
Abstract = {Cloud computing is being used extensively for the storage of data by
   users and organizations. This data may contain sensitive information and
   it may be stored on cloud servers that are most likely to be in
   different domains and also geographically far apart. This raises concern
   about the security and integrity of the data. Also, users would want to
   remain anonymous while making any transactions in the cloud environment.
   In this paper, we present an anonymous access provision scheme using
   hashing and symmetric encryption algorithms. The proposed scheme helps
   in enhancing the security of the data and of the users as well as in
   maintaining their integrity and confidentiality without affecting
   computational complexity.},
