@article{ WOS:001196534500042,
Author = {Meng, Fei and Cheng, Leixiao},
Title = {STR-ABKS: Server-Aided Traceable and Revocable Attribute-Based
   Encryption With Keyword Search},
Journal = {IEEE INTERNET OF THINGS JOURNAL},
