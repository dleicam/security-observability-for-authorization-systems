@inproceedings{ WOS:001302657400081,
Author = {Berlato, Stefano and Rizzi, Matteo and Franzil, Matteo and Cretti,
   Silvio and De Matteis, Pietro and Carbone, Roberto},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Work-in-Progress: A Sidecar Proxy for Usable and Performance-Adaptable
   End-to-End Protection of Communications in Cloud Native Applications},
Booktitle = {9TH IEEE EUROPEAN SYMPOSIUM ON SECURITY AND PRIVACY WORKSHOPS, EUROS\&PW
   2024},
Series = {IEEE European Symposium on Security and Privacy Workshops},
Year = {2024},
Pages = {706-711},
Note = {9th IEEE European Symposium on Security and Privacy (EuroS and P), Univ
   Vienna, Fac Informat, Vienna, AUSTRIA, JUL 08-12, 2024},
Abstract = {The characteristics of cloud native applications - like the inherent
   decentralization, the intricate threat model, and the presence of highly
   dynamic and interconnected microservices - bring forth a number of
   challenges to the security of the (often sensitive) data exchanged in
   cloud native applications. Besides, data security is not absolute, and
   its achievement must be mindful of relevant performance and usability
   aspects (e.g., minimal overhead, transparency, automation,
   interoperability with external services). In this work-in-progress
   paper, we discuss the use of Cryptographic Access Control (CAC) in
   sidecar proxies as a means to guarantee End-to-End (E2E) protection - in
   terms of confidentiality and integrity - for communications in cloud
   native applications, as well as usability and adaptable performance.},
Type = {Proceedings Paper},
Affiliation = {Berlato, S (Corresponding Author), Fdn Bruno Kessler, Trento, Italy.
