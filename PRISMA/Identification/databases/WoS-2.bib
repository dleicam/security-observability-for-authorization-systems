@inproceedings{ WOS:000773951800058,
Author = {Shruti and Rani, Shalli},
Editor = {Abraham, A and Madureira, AM and Kaklauskas, A and Gandhi, N and Bajaj, A and Muda, AK and Kriksciuniene, D and Ferreira, JC},
Title = {Mitigating Security Problems in Fog Computing System},
Booktitle = {INNOVATIONS IN BIO-INSPIRED COMPUTING AND APPLICATIONS, IBICA 2021},
Series = {Lecture Notes in Networks and Systems},
Year = {2022},
Volume = {419},
Pages = {612-622},
Note = {12th International Conference on Innovations in Bio-Inspired Computing
   and Applications (IBICA) / 11th World Congress on Information and
   Communication Technologies (WICT), ELECTR NETWORK, DEC 16-18, 2021},
Abstract = {Fog computing model was designed to provide computing at network's edge
   among Internet of Things (IoT) devices. Its main purpose was to overcome
   the problems faced in cloud computing and provide services more
   effectively and efficiently. Being an extension of cloud computing, many
   security and privacy challenges that were faced by cloud computing are
   inherited by fog computing also. This paper presents different security
   and privacy challenges and work done by different researchers to
   overcome those challenges. Different techniques are represented with
   various metrices which they try to solve. We also proposed a method
   using ciphertext and shared key method to solve the problem of
   authentication and provide secure data sharing among the nodes. This
   method is supposed to be better than others in term of providing
   confidentiality, access control, authenticity and also protect from
   multiple splitting of private key.},
Type = {Proceedings Paper},
Affiliation = {Rani, S (Corresponding Author), Chitkara Univ, Chitkara Univ Inst Engn \& Technol, Rajpura, Punjab, India.
   Shruti, Goswami Ganesh Dutta Sanatan Dharma Coll, Chandigarh, India.
   Rani, Shalli, Chitkara Univ, Chitkara Univ Inst Engn \& Technol, Rajpura, Punjab, India.},
DOI = {10.1007/978-3-030-96299-9\_58},
