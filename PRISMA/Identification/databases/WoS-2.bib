Affiliation = {Gupta, S (Corresponding Author), Univ Petr \& Energy Studies, Sch Comp Sci \& Engn, Dept Cybernet, Dehra Dun, Uttarakhand, India.
   Gupta, Sunil; Bansiya, Akansha; Saini, Mansi; Sidhu, Amuleek, Univ Petr \& Energy Studies, Sch Comp Sci \& Engn, Dept Cybernet, Dehra Dun, Uttarakhand, India.},
