@inproceedings{ WOS:001327002400008,
Author = {Simwinga, Azwel and Phiri, Jackson},
Editor = {Yang, XS and Sherratt, S and Dey, N and Joshi, A},
Title = {Integration of Facial Recognition and Facemask Detection for Enhanced
   Access Control Systems: A Post-epidemic Solution},
Booktitle = {PROCEEDINGS OF NINTH INTERNATIONAL CONGRESS ON INFORMATION AND
   COMMUNICATION TECHNOLOGY, VOL 8, ICICT 2024},
Series = {Lecture Notes in Networks and Systems},
Year = {2024},
Volume = {1004},
Pages = {95-111},
Note = {9th International Congress on Information and Communication Technology
   (ICICT), London, ENGLAND, FEB 19-22, 2024},
Abstract = {This project aimed to enhance existing facemask identification
   technology by incorporating forward-compatible features, particularly
   focusing on facial recognition. Utilizing TensorFlow Lite, a model was
   developed and trained on 5092 photos, integrated into a Python program
   on a Raspberry Pi 4. The system authenticates users using the National
   Registration Card Number (NRC) and employs facial recognition before
   transitioning to the facemask detection module. Access is granted only
   to those complying with facemask rules. The API linkage enables
   real-time monitoring, reporting, and user access configuration. The
   system addresses contact tracing, records instances of mask removal, and
   is adaptable beyond pandemic contexts. With applications in various
   settings, it enhances security and access control, making it valuable
   for post-pandemic access control systems.},
