   Jia, Weijia, Beijing Normal Univ BNU Zhuhai, Inst Artificial Intelligence \& Future Networks, Zhuhai 519087, Peoples R China.},
DOI = {10.1109/TSC.2025.3583131},
ISSN = {1939-1374},
