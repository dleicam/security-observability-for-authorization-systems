@article{ WOS:000527415900003,
Author = {Zhang, Zongye and Zhou, Fucai and Qin, Shiyue and Jia, Qiang and Xu,
   Zifeng},
Title = {Privacy-Preserving Image Retrieval and Sharing in Social Multimedia
   Applications},
Journal = {IEEE ACCESS},
Year = {2020},
Volume = {8},
Pages = {66828-66838},
Abstract = {Every day social multimedia applications generate millions of images. To
   handle such huge amount of images, an optimal solution is using the
   public cloud, since it has powerful storage capability. Images usually
   contain a wealth of sensitive information, therefore social service
   providers need not only to provide services such as retrieval and
   sharing but also to protect the privacies of the images. In this paper,
   we propose a privacy-preserving scheme for content-based image retrieval
   and sharing in social multimedia applications. First, the users extract
   visual features from the images, and perform locality-sensitive hashing
   functions on visual features to generate image profile vectors. We then
   model the retrieval on the images as the equality search on the image
   profile vectors. To enable accurate and efficient retrieval, we design
   the secure index structure based on cuckoo hashing, which has constant
   lookup time. To meet the requirements of dynamic image updating, we
   enrich our service with image insertion and deletion. In order to reduce
   the key management overhead and the access control overhead in social
   applications, we process keys using secret sharing techniques to enable
   the users holding similar images to query and decrypt images
   independently. Finally we implement the prototype of the proposed
   scheme, and perform experiments over encrypted image databases.},
Type = {Article},
Affiliation = {Zhou, FC (Corresponding Author), Northeastern Univ, Software Coll, Shenyang 100819, Peoples R China.
   Zhang, Zongye; Zhou, Fucai; Jia, Qiang; Xu, Zifeng, Northeastern Univ, Software Coll, Shenyang 100819, Peoples R China.
   Qin, Shiyue, Northeastern Univ, Sch Comp Sci \& Engn, Shenyang 110819, Peoples R China.},
