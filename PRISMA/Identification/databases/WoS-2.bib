@article{ WOS:000419622600001,
Author = {di Vimercati, Sabrina De Capitani and Foresti, Sara and Paraboschi,
   Stefano and Pelosi, Gerardo and Samarati, Pierangela},
Title = {Enforcing authorizations while protecting access confidentiality},
Journal = {JOURNAL OF COMPUTER SECURITY},
Year = {2018},
Volume = {26},
Number = {2},
Pages = {143-175},
Abstract = {Cloud computing is the reference paradigm to provide data storage and
   management in a convenient and scalable manner. However, moving data to
   the cloud raises several issues, including the confidentiality of data
   and of accesses that are no more under the direct control of the data
   owner. The shuffle index has been proposed as a solution for addressing
   these issues when data are stored at an external third party.
   In this paper, we extend the shuffle index with support for access
   control, that is, for enforcing authorizations on data. Our approach is
   based on the use of selective encryption and on the organization of data
   and authorizations in two shuffle indexes. Owners regulate access to
   their data through authorizations that allow different users to access
   different portions of the data, while, at the same time, the
   confidentiality of accesses is guaranteed. The proposed approach also
   supports update operations over the outsourced data collection (i.e.,
   insertion, removal, and update) as well as of the access control policy
   (i.e., grant and revoke). Also, our approach protects the nature of each
   access operation, making revoke operations and resource removal
   operations indistinguishable by the storing server and/or observing
   users.},
Type = {Article},
Affiliation = {di Vimercati, SD (Corresponding Author), Univ Milan, Dipartimento Informat, Milan, Italy.
