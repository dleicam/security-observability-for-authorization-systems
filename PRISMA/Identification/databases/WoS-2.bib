@inproceedings{ WOS:001414377800095,
Author = {Chen, Jian and Hu, Shanwen and Cai, Zhiming},
Book-Group-Author = {IEEE},
Title = {UCAP: A Novel Attribute Matching Authentication Model using Knowledge
   Graph Approach},
Booktitle = {2024 CROSS STRAIT RADIO SCIENCE AND WIRELESS TECHNOLOGY CONFERENCE,
   CSRSWTC 2024},
Series = {Cross Strait Quad Regional Radio Science and Wireless Technology
   Conference},
Year = {2024},
Pages = {286-288},
Note = {2024 Cross Strait Radio Science and Wireless Technology Conference,
   PEOPLES R CHINA, NOV 04-07, 2024},
Abstract = {The exponential growth of big data and cloud computing has significantly
   expanded data collection and storage capabilities. However, traditional
   encryption methods often hinder efficient querying and matching
   operations, thereby limiting the potential of data applications. To
   address this challenge, this paper introduces the Universal Certified
   Attribute Pool (UCAP) model, a novel access control mechanism designed
   to ensure data privacy while enabling efficient attribute matching. The
   UCAP model operates within a knowledge graph -based attribute matching
   space. integrating attribute characteristics with information entropy
   metrics to establish a multi -tiered authorization framework. By
   leveraging graph neural network computing techniques, the model employs
   a scoring mechanism that enhances the accuracy and reliability of
   attribute matching. The UCAP model shows broad applicability in areas
   such as searchable encryption in cloud storage. medical record sharing
   among healthcare institutions, and secure data exchange between Internet
   of Things (loT) devices. This paper specifically demonstrates the
   model's effectiveness in cross -border digital identity attribute
   authentication, highlighting its superior scalability and response speed
   in fuzzy matching scenarios compared to traditional homomorphic and
   attribute -based encryption methods.},
Type = {Proceedings Paper},
Affiliation = {Cai, ZM (Corresponding Author), Macau Millennium Coll, Fac Digital Sci \& Technol, Macau, Peoples R China.
