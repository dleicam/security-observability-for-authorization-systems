@article{ WOS:000802059000001,
Author = {Sophia, S. Gnana and Thanammal, K. K. and Sujatha, S. S.},
Title = {Secure storage and accessing the data in cloud using optimized
   homomorphic encryption},
Journal = {JOURNAL OF CONTROL AND DECISION},
Year = {2023},
Volume = {10},
Number = {1, SI},
Pages = {90-98},
Month = {JAN 2},
Abstract = {Different efforts have been undertaken to customizing a security and
   privacy concern in cloud data access. Therefore, the security measures
   are reliable and the data access was verified as the major problem in
   the cloud environment. To overcome this problem, we proposed an
   efficient data access control using optimized homomorphic encryption
   (HE). Because users outsource their sensitive information to cloud
   providers, data security and access control is one of the most difficult
   ongoing cloud computing research projects. Existing solutions that rely
   on cryptographic technologies to address these security issues result in
   significant complexity for both data and cloud service providers. The
   experimental results show that the key generation is 7.6\% decreased by
   HE and 14.14\% less than the proposed method. The encryption time is
   11.34\% less than the optimized HE and 23.28\% decreased by ECC. The
   decryption time is 13.18\% and 24.07\% when compared with HE and ECC
   respectively.},
