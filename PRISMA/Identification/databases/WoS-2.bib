@article{ WOS:000700250400001,
Author = {Zhang, Ping and Chi, Huanhuan and Wang, Jiechang and Shang, Youlin},
Title = {Data Security Protocol with Blind Factor in Cloud Environment},
Journal = {INFORMATION},
Year = {2021},
Volume = {12},
Number = {9},
Month = {SEP},
Abstract = {Compared with the traditional system, cloud storage users have no direct
   control over their data, so users are most concerned about security for
   their data stored in the cloud. One security requirement is to resolve
   any threats from semi-trusted key third party managers. The proposed
   data security for cloud environment with semi-trusted third party
   (DaSCE) protocol has solved the security threat of key managers to some
   extent but has not achieved positive results. Based on this, this paper
   proposes a semi-trusted third-party data security protocol (ADSS), which
   can effectively remove this security threat by adding time stamp and
   blind factor to prevent key managers and intermediaries from
   intercepting and decrypting user data. Moreover, the ADSS protocol is
   proved to provide indistinguishable security under a chosen ciphertext
   attack. Finally, the performance evaluation and simulation of the
   protocol show that the ADSS security is greater than DaSCE, and the
   amount of time needed is lower than DaSCE.},
