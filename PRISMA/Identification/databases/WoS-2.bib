@article{ WOS:000488100900040,
Author = {Yang, Jie and Zhu, Haibin and Liu, Tieqiao},
Title = {Secure and economical multi-cloud storage policy with NSGA-II-C},
Journal = {APPLIED SOFT COMPUTING},
Year = {2019},
Volume = {83},
Month = {OCT},
Abstract = {Multi-cloud computing is an attractive technology for many reasons
   including user's data security. This work offers a solution to the
   problem relative to Multi-Cloud Storage (MCS), i.e., how to allocate
   partial data among different cloud service providers based on
   multi-objective optimization while maintaining a high degree of security
   and performance at the minimal storage cost. Non-dominated Sorting
   Genetic Algorithm II with a special process of Combinations (NSGA-II-C),
   is adopted to solve the problem. NSGA-II-C has better performance of
   generational distance and diversity by comparing with MOEA/D and SPEA2
   in solving the proposed problem based on the statistical analysis of
   experimental results. The proposed method is compared with the similar
   studies of MCS and single cloud storage. Experimental results show that
   the obtained optimal solution outperforms similar studies at security,
   cost and performance. In addition, the relations between objectives in
   the Pareto front are analyzed in detail. (C) 2019 Elsevier B.V. All
   rights reserved.},
Type = {Article},
