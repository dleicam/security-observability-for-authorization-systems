@inproceedings{ WOS:000720102500009,
Author = {Sukmana, Muhammad I. H. and Kohlen, Kai-Oliver and Goedecken, Carl and
   Schulze, Pascal and Meinel, Christoph},
Editor = {DiVimercati, SDC and Samarati, P},
Title = {Are You There, Moriarty? Feasibility Study of Internet-based Location
   for Location-based Access Control Systems},
Booktitle = {SECRYPT 2021: PROCEEDINGS OF THE 18TH INTERNATIONAL CONFERENCE ON
   SECURITY AND CRYPTOGRAPHY},
Year = {2021},
Pages = {111-124},
Note = {18th International Conference on Security and Cryptography (SECRYPT),
   ELECTR NETWORK, JUL 06-08, 2021},
Abstract = {As the Internet becomes more ubiquitous, everyone could access the data
   and services anytime, anywhere. However, it raises the challenge to
   enforce physical access control for the data or services to only be
   accessed in specific locations. Location-based access control (LBAC)
   systems could provide physical access control by only authorizing access
   to the services or data for the requesters at the allowed locations. In
   this paper, we continue our previous work and assess the feasibility of
   using Internet-based location for LBAC systems by inferring the
   information from the requester's Internet-connected device to determine
   whether the requester is in the allowed location. We develop
   Internet-based location access control (ILAC) system to determine and
   verify the requester's location using two delay-based geolocation
   algorithms and third-party open-source intelligence services. The
   evaluation conducted in the Amazon Mechanical Turk proves the
   Internet-based location has great potential as a location information
   input for LBAC systems with country-level accuracy.},
Type = {Proceedings Paper},
Affiliation = {Sukmana, MIH (Corresponding Author), Univ Potsdam, Hasso Plattner Inst, Potsdam, Germany.
   Sukmana, Muhammad I. H.; Kohlen, Kai-Oliver; Goedecken, Carl; Schulze, Pascal; Meinel, Christoph, Univ Potsdam, Hasso Plattner Inst, Potsdam, Germany.},
