@article{ WOS:001507841200001,
Author = {Devi, D. and Winster, S. Godfrey},
Title = {AZO-FMRGAformer: a hybrid model for cloud resource allocation using
   transformer-based time-series forecasting},
Journal = {SIGNAL IMAGE AND VIDEO PROCESSING},
Year = {2025},
Volume = {19},
Number = {9},
Month = {SEP},
Abstract = {The rapid expansion of cloud service providers has challenges such as
   privacy preservation and dynamic resource provisioning that occur due to
   its heterogeneity. The multiple users in the cloud computing environment
   lead to the delay in request and service selection. The traditional
   methods have some constraints which include trust management issues,
   service interruptions, security issues, and access control loss that
   lead to performance degradation. The existing resource allocation
   approaches often rely on one-dimensional outputs, which lead to
   inaccurate predictions and limited information, particularly when
   handling multi-dimensional and intricate resource requirements. Hence,
   this paper proposes a novel transformer-based approach named as American
   Zebra Optimized Fuzzy Multivariate Residual Gated Attention Transformer
   model for dynamic resource provisioning in a cloud computing
   environment. The GWA-T-12 Bit brains dataset is used in this paper, the
   tasks are gathered from the different users present in the cloud
   environment. The collected tasks are prioritized based on the diverse
   factors, including task size, latency sensitivity, deadline sensitivity,
   and network bandwidth. The Fuzzy logic based Priority Scheduler
   prioritizes the collected tasks that are grouped into three like Group
   P1, Group P2, and Group P3. The Multivariate Residual Gated Attention
   Transformer is implemented to forecast multivariate time-series data.
   For task scheduling, the American Zebra Optimization Algorithm is
   implemented for trust-aware multi-objective task scheduling. The
   time-series foresting and task scheduling experiments are conducted in
   this paper with diverse evaluation measures and comprehensive analysis.
   The results demonstrated that the proposed model surpassed the
   traditional techniques and achieved a higher success rate of 97.5\%,
   turnaround efficiency of 98.3\%, VM availability rate of 95.8\%, and
   lower makespan of 852 ms, load balance of 1.526, and RMSE of 6.573
   respectively.},
Type = {Article},
Affiliation = {Winster, SG (Corresponding Author), SRM Inst Sci \& Technol, Fac Engn \& Technol, Sch Comp, Dept Comp Technol, Chengalpattu 603203, Tamil Nadu, India.
