@inproceedings{ WOS:001420197400010,
Author = {Latoni, Anthony and Zhang, Xiaowen},
Book-Group-Author = {IEEE},
Title = {Enhancing Cybersecurity in Healthcare 5.0 Through Innovative Frameworks},
Booktitle = {2024 IEEE LONG ISLAND SYSTEMS, APPLICATIONS AND TECHNOLOGY CONFERENCE,
   LISAT 2024},
Year = {2024},
Note = {18th IEEE Long Island Systems, Applications and Technology Conference,
   Holtsville, NY, NOV 15, 2024},
Abstract = {Cybersecurity is becoming a more pressing concern as technology advances
   and patient and user data becomes more sensitive. In healthcare there is
   a transformative shift towards the Healthcare 5.0 domain. This paper
   explores the challenges posed by the integration of advanced
   technologies such as the Internet of Things, artificial intelligence,
   blockchain, and cloud computing in healthcare practices. Emphasizing the
   critical importance of securing patient data and ensuring the integrity
   of healthcare systems, the paper reviews existing frameworks and
   identifies their limitations, especially concerning emerging threats
   like blockchain-related attacks and malware. The study introduces and
   evaluates novel frameworks - AuthPrivacyChain, a blockchain-based
   solution ensuring confidentiality and integrity, a blockchain-empowered
   AAA (Authentication, Authorization, and Availability) scheme focused on
   access control, and zkCrowd, a hybrid blockchain for a crowdsourcing
   platform. We also give a case study on implementation of the security
   frameworks in an urgent care. The paper calls for future research to
   assess the practical implementation, scalability, and real-world
   effectiveness of these frameworks, emphasizing their potential to
   contribute to a resilient and patient-centric Healthcare 5.0
   cybersecurity ecosystem.},
Type = {Proceedings Paper},
