@inproceedings{ WOS:000886771000005,
Author = {Zhang, Jing and Cui, Jie and Zhong, Hong and Gu, Chengjie and Liu, Lu},
Editor = {Jensen, CS and Lim, EP and Yang, DN and Lee, WC and Tseng, VS and Kalogeraki, V and Huang, JW and Shen, CY},
Title = {Secure and Efficient Certificateless Provable Data Possession for
   Cloud-Based Data Management Systems},
Booktitle = {DATABASE SYSTEMS FOR ADVANCED APPLICATIONS (DASFAA 2021), PT I},
Series = {Lecture Notes in Computer Science},
Year = {2021},
Volume = {12681},
Pages = {71-87},
Note = {26th International Conference on Database Systems for Advanced
   Applications (DASFAA), ELECTR NETWORK, APR 11-14, 2021},
Abstract = {Cloud computing provides important data storage, processing and
   management functions for data owners who share their data with data
   users through cloud servers. Although cloud computing brings significant
   advantages to data owners, the data stored in the cloud also faces many
   internal/external security attacks. Existing certificateless data
   provider schemes have the following two common shortcomings, i.e., most
   of which use plaintext to store data and use the complex bilinear
   pairing operation. To address such shortcomings, this scheme proposes
   secure and efficient certificateless provable data possession for
   cloud-based data management systems. In our solution, the data owners
   and cloud servers need to register with the key generation center only
   once. To ensure the integrity of encrypted data, we use the public key
   of the cloud server to participate in signature calculation. Moreover,
   the third-party verifier can audit the integrity of ciphertext without
   downloading the whole encrypted data. Security analysis shows that our
   proposed scheme is provably secure under the random oracle model. An
   evaluation of performance shows that our proposed scheme is efficient in
   terms of computation and communication overheads.},
Type = {Proceedings Paper},
Affiliation = {Cui, J (Corresponding Author), Anhui Univ, Sch Comp Sci \& Technol, Hefei, Peoples R China.
