Title = {Integration Model for Face Registration Checkpoint},
Booktitle = {2024 21ST INTERNATIONAL JOINT CONFERENCE ON COMPUTER SCIENCE AND
   SOFTWARE ENGINEERING, JCSSE 2024},
Series = {International Joint Conference on Computer Science and Software
   Engineering},
Year = {2024},
Pages = {432-439},
Note = {21st International Joint Conference on Computer Science and Software
   Engineering (JCSSE), Phuket, THAILAND, JUN 19-22, 2024},
Abstract = {This study proposes a technique for improving identity verification at
   checkpoint units utilizing cloud-based face recognition technology,
   which involves a tablet PC with a webcam and a network as a checkpoint
   station. The system captures video images using WebRTC, while OpenCV-JS
   is a version specifically designed to function on web browsers that
   support WASM. The HAAR Cascade Classifier will be used to detect faces
   inside preprocessed images and post them to the server side through an
   API. The API will also recognize faces using Amazon Rekognition,
   resulting in a face ID to look for participant information from the
   MariaDB database. Participants authenticate themselves and log in; a
   message is sent to other relevant systems over MQTT. Before accessing
   the system, user permissions will be granted by integrating with OAuth
   2.0 to preserve security. Data on attendance events is gathered and
   visualized in Power BI dashboards. 126,183 samples, from 2019 to 2024,
   were used for system evaluation. The system has been utilized for
   several purposes, including verifying attendance at graduation
   ceremonies, requesting rights at the COVID-19 vaccination station, and
   verifying exam admission. The experiment revealed that the new approach
   could reduce the 33-second waiting time at the checkpoint to only 3
   seconds and, at the longest, no more than 7 seconds per attendee. The
   result is equivalent to a 91\% gain in efficiency.},
Type = {Proceedings Paper},
