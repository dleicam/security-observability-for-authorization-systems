@inproceedings{ WOS:001533792800086,
Author = {Abdul-Rahaim, Laith Ali and Mohammed, Hadeel Abdullah},
Book-Group-Author = {IEEE},
Title = {A multi-authority security system based on the cloud and Radio frequency
   identification systems},
Booktitle = {2025 7TH INTERNATIONAL CONGRESS ON HUMAN-COMPUTER INTERACTION,
   OPTIMIZATION AND ROBOTIC APPLICATIONS, ICHORA},
Series = {International Congress on Human-Computer Interaction Optimization and
   Robotic Applications},
Year = {2025},
Note = {7th International Congress on Human-Computer Interaction, Optimization
   and Robotic Applications-ICHORA, Ankara, TURKIYE, MAY 23-24, 2025},
Abstract = {Many services a person needs have been produced due to cloud computing.
   Safety, convenience, affordability, and other services are all factors
   to consider. In this study, a system was built and deployed that relies
   on cloud computing to deliver a specific service within the firm, such
   as the capacity to regulate, defend, and monitor a group of doors within
   the company building. Establishing a security system is difficult for
   modern cities since it impacts infrastructure resiliency and citizen
   quality perceptions. Because a lack of security can cause significant
   harm, several access control solutions are available based on available
   technologies. The proposed project aims to introduce an innovative
   security data-gathering and data-processing system related to a person's
   card by designing an automated door lock as a security feature.
   Simulation was used to design and implement the system, which was
   written in PHP. RFID (Radio Frequency Identification) technology could
   improve inventory accuracy. Increase data center security while lowering
   operational and auditing costs. To enhance the efficiency of building
   security, we can use cloud computing to control the saved database by
   adding, deleting, or exchanging the authorizing process from any device
   and anywhere. We used an RFID to read the cards and send them to a fog
   computer via an Arduino Uno for cloud processing and to give the manner
   to open or not open the door. Using RFID ID cards in the company's
   infrastructure can save time and effort. Security and preventing
   foreigners from entering restricted areas.},
