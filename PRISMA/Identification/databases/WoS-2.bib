@article{ WOS:000509476600181,
Author = {Xuan, Shichang and Zhang, Yibo and Tang, Hao and Chung, Ilyong and Wang,
   Wei and Yang, Wu},
Title = {Hierarchically Authorized Transactions for Massive Internet-of-Things
   Data Sharing Based on Multilayer Blockchain},
Journal = {APPLIED SCIENCES-BASEL},
Year = {2019},
Volume = {9},
Number = {23},
Month = {DEC},
Abstract = {With the arrival of the Internet of Things (IoT) era and the rise of Big
   Data, cloud computing, and similar technologies, data resources are
   becoming increasingly valuable. Organizations and users can perform all
   kinds of processing and analysis on the basis of massive IoT data, thus
   adding to their value. However, this is based on data-sharing
   transactions, and most existing work focuses on one aspect of data
   transactions, such as convenience, privacy protection, and auditing. In
   this paper, a data-sharing-transaction application based on blockchain
   technology is proposed, which comprehensively considers various types of
   performance, provides an efficient consistency mechanism, improves
   transaction verification, realizes high-performance concurrency, and has
   tamperproof functions. Experiments were designed to analyze the
   functions and storage of the proposed system.},
