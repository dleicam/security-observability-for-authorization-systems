@inproceedings{ WOS:000468915400008,
Author = {Gupta, Sagar},
Book-Group-Author = {IEEE},
Title = {Single Sign-On Beyond Corporate Boundaries},
Booktitle = {2018 8TH INTERNATIONAL CONFERENCE ON INTELLIGENT SYSTEMS, MODELLING AND
   SIMULATION (ISMS)},
Series = {Proceedings International Conference on Intelligent Systems Modelling
   Simulation},
Year = {2018},
Pages = {38-42},
Note = {8th International Conference on Intelligent Systems, Modelling and
   Simulation (ISMS), Kuala Lumpur, MALAYSIA, MAY 08-10, 2018},
Abstract = {In the current IT world, everyone owns multiple devices like laptops,
   tablets, and phones. The organization to which the person belongs
   provides some of these devices, and some are privately owned. A person
   who wants to port work from one device to another faces some limitations
   in terms of data security and IP infringements. This paper discusses the
   idea of creating a cloud-based single sign-on platform that can be used
   to seamlessly connect any device, be it personal or professional, to the
   corporate network without worrying about the data security and IP
   infringement issues. This brings new definition to the
   Bring-Your-Own-Device (BYOD) policies adopted by many organizations.
   Data security can be governed by a set of rules pre-defined by the
   organization on the platform to which the device needs to abide by
   before getting access. This paper highlights the architecture of
   building such a secured cloud platform to enable SSO (Single Sign -On)
   features beyond corporate boundaries.},
