@inproceedings{ WOS:000995421300041,
Author = {Wang, Sheng and Zhang, JuLing and Li, Yong and Zhang, LingHao and Zhang,
   Qing and Zhou, Jian},
Book-Group-Author = {IEEE},
Title = {Data Access Control Method of Power Terminal Based on Trust and
   Reputation},
Booktitle = {2022 6TH INTERNATIONAL SYMPOSIUM ON COMPUTER SCIENCE AND INTELLIGENT
   CONTROL, ISCSIC},
Year = {2022},
Pages = {211-215},
Note = {6th International Symposium on Computer Science and Intelligent Control
   (ISCSIC), ELECTR NETWORK, NOV 11-13, 2022},
Abstract = {Aiming at the problems of poor data confidentiality, complex
   communication overhead and large amount of computation in traditional
   power terminal data access control, a data access control method of
   power terminal based on trust and reputation was proposed. Firstly, a
   flexible data access control system of power terminal was designed based
   on cloud computing technology, and key generation, key segmentation,
   proxy re-encryption and decryption were adopted to obtain the trust
   level and user reputation of the end users. Then, the data access of
   power terminal was controlled. Finally, the security analysis and
   performance analysis of the user's trust and reputation evaluation
   results were carried out through the encryption system. Experimental
   results showed that the proposed method can effectively reduce the
   communication overhead and computational complexity of data access,
   improve data confidentiality, and reduce the application cost of power
   terminal equipment, and has stability and effectiveness.},
