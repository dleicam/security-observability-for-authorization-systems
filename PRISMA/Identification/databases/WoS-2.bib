@article{ WOS:001554488200044,
Author = {Wang, Luping and Yan, Chen and Wu, Hongjie and Zhu, Fa and Kumari, Saru
   and Alenazi, Mohammed J. F.},
Title = {A Privacy Protection Scheme for Consumer Electronics Data Based on
   Blockchain and AI},
Journal = {IEEE TRANSACTIONS ON CONSUMER ELECTRONICS},
Year = {2025},
Volume = {71},
Number = {2},
Pages = {5165-5172},
Month = {MAY},
Abstract = {As information technology advances, a significant amount of data related
   to consumer electronics has emerged, the consumer data is commonly
   stored on cloud servers, resulting in frequent data leaks and privacy
   breaches. To tackle these challenges, we propose a novel privacy
   protection scheme that combines encryption and blockchain technologies.
   This approach integrates Searchable Encryption, Blockchain, and
   Artificial Intelligence (AI) to facilitate efficient access control and
   policy enforcement. By employing a decentralized network structure, our
   scheme minimizes reliance on a central authority, thereby enhancing
   system security and reliability. User information is independently
   stored in both blockchain and cloud systems, with digital signatures
   ensuring data accuracy. To further bolster user privacy, we implement
   attribute-based encryption for access management and utilize AI for
   real-time monitoring of potential security threats and suspicious access
   patterns. Our scheme also features an attribute revocation mechanism to
   protect sensitive information from unauthorized access. Additionally,
   customized smart contracts promote equitable interactions between users
   and cloud service providers. Lastly, the theoretical analyses and
   experimental results validate that our solution is both secure and
   efficient in safeguarding consumer data, highlighting its significant
   innovative contributions to data privacy protection.},
