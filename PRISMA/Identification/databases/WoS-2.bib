@inproceedings{ WOS:000877002300006,
Author = {Hofer, Daniel and Nadschlaeger, Stefan and Mohamed, Aya and Kueng, Josef},
Editor = {Strauss, C and Cuzzocrea, A and Kotsis, G and Tjoa, AM and Khalil, I},
Title = {Extending Authorization Capabilities of Object Relational/Graph Mappers
   by Request Manipulation},
Booktitle = {DATABASE AND EXPERT SYSTEMS APPLICATIONS, DEXA 2022, PT II},
Series = {Lecture Notes in Computer Science},
Year = {2022},
Volume = {13427},
Pages = {71-83},
Note = {33rd International Conference on Database and Expert Systems
   Applications (DEXA), Vienna Univ Econ \& Business, Vienna, AUSTRIA, AUG
   22-24, 2022},
Abstract = {Enforcing authorization for web applications must be done on the server
   side. Thus, either the backend or the persistent storage are suitable
   layers. From a developer's point of view, we want to use a framework to
   automate creating persistent storage models and to map the entities
   between storage and backend. However, not all such frameworks offer
   sufficient authorization support. From a scientist's perspective, we
   want to generally combine the filtering capabilities of the persistent
   storage with the advantages of using a mapper framework. Therefore, we
   propose to intercept the communication between the backend and the
   mapper framework and thus provide a central point of authorization. This
   offers the advantage that developers are unlikely to inadvertently
   introduce security vulnerabilities. The request is modified by adding a
   filter to return only authorized entities. Filtering directly in the
   storage saves performance and bandwidth besides reducing development and
