@article{ WOS:001366719800001,
Author = {Malathi, P. and Devi, S. Suganthi and Jeya, J. Jospin},
Title = {Performance evaluation of secured storage access control system for
   public health records in cloud computing},
Journal = {INTERNATIONAL JOURNAL OF SYSTEM ASSURANCE ENGINEERING AND MANAGEMENT},
Year = {2024},
Month = {2024 NOV 29},
Abstract = {Cloud computing activities have grown exponentially today. Cloud
   computing is typically a service that is provided for computing as a
   service. It shares network or internet services, applications and info.
   Accordingly, resources and individuals are communicated via the Internet
   to the whole world regardless of where they are. This benefit from Cloud
   Computing has brought many sectors to satisfy the most critical consumer
   targets, including the healthcare industry and the financial sector. The
   proposed innovative mechanism for the closed sharing of private health
   data using attribute-based encryption in cloud computing. In view of
   partially truthful cloud storage, it can be contended that sufferers
   must have absolute control of their own privacy by encrypting their
   Public Health Record (PHR) files to allow fine-grained access to
   completely understand the patient-centric definition. The system tackles
   the specific difficulties of using a couple of owners and users of PHR.
   In this proposed work, we greatly minimize the difficulty of main
   administration while improving the assurances of privacy relative to
   previous works. As the results, the proposed scheme applies the
   Attribute Encryption Scheme (ABE) to encrypt the PHR data, so that
   patients can allow access to not only private customers, but also quite
   a variety of public domain clients with exclusive technical positions,
   credentials, and affiliations to gain the right of entry.},
