@article{ WOS:000604526300013,
Author = {Ke, Gang and Wang, Shi and Wu, Huan-huan},
Title = {Parallel incremental attribute-based encryption for mobile cloud data
   storage and sharing},
Journal = {JOURNAL OF AMBIENT INTELLIGENCE AND HUMANIZED COMPUTING},
Year = {2021},
Month = {2021 JAN 3},
Abstract = {Aiming at the problem of one to many communication scenarios in mobile
   cloud computing, a parallel incremental attribute-based encryption is
   proposed. An incremental attribute-based encryption scheme is brought,
   which is used to protect sensing data and share to many receivers
   securely and improve the access control ability further. To achieve a
   balance between efficiency and energy consumption, the scheme uses the
   idea of parallel computing, fully exploits the performance of existing
   mobile clients, and achieves a balance between efficiency and energy
   consumption. In the experiments, parallel computing can improve the
   efficiency of schemes, make full use of hardware resources, and improve
   the efficiency of the serial scheme by about 55\% in the best case.},
