@article{ WOS:001021675300001,
Author = {Anbumani, P. and Dhanapal, R. and Prasanna Venkatesan, G. K. D.},
Title = {PIRAP: AASM: An Advanced Attribute-Based Security Model for Enhancing
   Trustworthy Data Sharing in Cloud Computing},
Journal = {INTERNATIONAL JOURNAL OF COOPERATIVE INFORMATION SYSTEMS},
Year = {2024},
Volume = {33},
Number = {01},
Month = {MAR},
Abstract = {In today's world, cloud computing is widely used in various applications
   and services, which refers to the utilization of computational resources
   as per user requirements through the Internet. However, despite the
   numerous advancements in cloud services and applications, there are
   various security threats associated with it, mainly due to data
   outsourcing to third-party controlled data centers. In this context,
   this paper introduces a new model called Attribute-based Advanced
   Security Model (AASM) for Reliable Data Sharing in the Cloud. This model
   combines the Advanced Encryption Technique (AET) with Attribute-Based
   Signature (ABS) to ensure secure data sharing in the Cloud while
   efficiently controlling data access. The model enables encrypted access
   control from the data owner's side with advanced access privileges,
   ensuring user privacy with an anonymous authentication model using ABS.
   By implementing these measures, the model provides security for cloud
   providers and users while safeguarding against malicious attacks. The
   effectiveness of the proposed model is evaluated based on factors such
   as time complexities, security and accountability.},
Type = {Article},
Affiliation = {Anbumani, P (Corresponding Author), Karpagam Acad Higher Educ, Dept CSE, Coimbatore, India.
