@article{ WOS:000767856000023,
Author = {Ning, Jianting and Huang, Xinyi and Susilo, Willy and Liang, Kaitai and
   Liu, Ximeng and Zhang, Yinghui},
Title = {Dual Access Control for Cloud-Based Data Storage and Sharing},
Journal = {IEEE TRANSACTIONS ON DEPENDABLE AND SECURE COMPUTING},
Year = {2022},
