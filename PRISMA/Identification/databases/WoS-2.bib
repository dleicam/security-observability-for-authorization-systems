@article{ WOS:000467422300010,
Author = {Bhattacharjee, Tapasi and Maity, Santi P.},
Title = {Progressive and hierarchical share-in-share scheme over cloud},
Journal = {JOURNAL OF INFORMATION SECURITY AND APPLICATIONS},
Year = {2019},
Volume = {46},
Pages = {108-120},
Month = {JUN},
Abstract = {Recently sharing of secret information (image) before dissemination is
   gaining popularity as a means of reducing the vulnerability against the
   wide attacking surface on cloud computing. An integrated scheme
   comprising of secret image sharing (SIS) and data hiding is suggested
   here that offers progressive quality access control of the decoded
   images. This scheme is a (t,k,n)-hierarchical SIS technique that uses
   affine Boolean classification and compressed sensing (CS) in the share
   generation process. Prediction error representation of the secret image
   in spatial domain is explored to make the signal more sparse leading to
   CS reconstruction from less number of measurements. In the decoding
   process, an improved quality of the secret image is achieved with the
   involvement of `t' essential stego shares (ESSs) and `k-t' non-essential
   stego shares (NSSs) over `t' ESSs and `n-k' general shares (GSs). A
   large set of results illustrate the merits of the proposed method in
   terms of hierarchical access structure, flexible shadow size,
   progressive quality access on the decoded image and robustness against
   varieties of data manipulation. (C) 2019 Elsevier Ltd. All rights
   reserved.},
Type = {Article},
Affiliation = {Maity, SP (Corresponding Author), Indian Inst Engn Sci \& Technol, Dept Informat Technol, PO Bot Garden, Sibpur 711103, Howrah, India.
