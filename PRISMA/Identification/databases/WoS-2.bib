@inproceedings{ WOS:000454344100006,
Author = {Li Zhenlin and Zhang Wei and Ding Yitao and Bai Ping},
Editor = {Barolli, L and Zhang, M and Wang, XA},
Title = {A BGN Type Outsourcing the Decryption of CP-ABE Ciphertexts},
Booktitle = {ADVANCES IN INTERNETWORKING, DATA \& WEB TECHNOLOGIES, EIDWT-2017},
Series = {Lecture Notes on Data Engineering and Communications Technologies},
Year = {2018},
Volume = {6},
Pages = {54-63},
Note = {5th International Conference on Emerging Internetworking, Data and Web
   Technologies (EIDWT), Wuhan, PEOPLES R CHINA, JUN 10-11, 2017},
Abstract = {Cloud computing security is the key bottleneck that restricts its
   development, and access control on the result of cloud computing is a
   hot spot of current research. Based on the somewhat homomorphic
   encryption BGN and combined with Green's scheme that proposed
   outsourcing the decryption of CP-ABE (Ciphertext-Policy Attribute-Based
   Encryption) ciphertexts, we constructed a BGN type outsourcing the
   decryption of CP-ABE ciphertexts. In our construction, partial
   decryption of ciphertexts is outsourced to the cloud, and only users
   whose attribute meets the access policy will get the correct decryption.
   And the scheme supports arbitrary homomorphic additions and one
   homomorphic multiplication on ciphertexts. Finally, we prove its
   semantic security under the subgroup decision assumption and compare it
   with other schemes.},
