@inproceedings{ WOS:000467734100016,
Author = {Jasim, Anwar Chitheer and Tapus, Nicolae and Hassoon, Imad Ali},
Book-Group-Author = {IEEE},
Title = {Enabling a Multi-Level Users Management Policy in Cloud of Big Data},
Booktitle = {PROCEEDINGS OF THE 2018 10TH INTERNATIONAL CONFERENCE ON ELECTRONICS,
   COMPUTERS AND ARTIFICIAL INTELLIGENCE (ECAI)},
Series = {International Conference on Electronics Computers and Artificial
   Intelligence},
Year = {2018},
Note = {10th International Conference on Electronics, Computers and Artificial
   Intelligence (ECAI), Iasi, ROMANIA, JUN 28-30, 2018},
Abstract = {In computing, one of the rapidly growing technologies is cloud
   computing, which comes with great benefits, as well as with some
   drawbacks. One of the issues examined in the present paper is the secure
   clients' location sharing method, from the perspective of data integrity
   and authenticity. These are issues associated with sharing of data in
   cloud-based locations. The first aspect to analyze is the access
   mechanism, which raises security issues if it is not secured enough for
   sensitive data. Data stored in cloud (big data) is often accessed by
   third party, which increases the exposure to attacks. The privacy
   violation risks thus become higher. Cloud-stored data usually is
   processed or used by third party. Data owners (clients) must ensure
   information privacy of the stored or processed data. The solution
   proposed in this paper for cloud data management and classification is a
   schema organized on multiple levels and based on policy in order to
   increase reliability of cloud computing in terms of confidentiality of
   sensitive data. The paper is based on a solid security policy structure
   which follow the specifications and abilities. The algorithm presented
   in the paper efficiently provides data accuracy and validity with the
   employment and management of the outlined policies, complying to cloud
   customers' specifications and cloud providers' possibilities.},
