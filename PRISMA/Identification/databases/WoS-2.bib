Title = {Privacy-Aware Data Collection and Aggregation in IoT Enabled Fog
   Computing},
Booktitle = {ALGORITHMS AND ARCHITECTURES FOR PARALLEL PROCESSING, ICA3PP 2018, PT IV},
Series = {Lecture Notes in Computer Science},
Year = {2018},
Volume = {11337},
Pages = {581-590},
Note = {18th International Conference on Algorithms and Architectures for
   Parallel Processing (ICA3PP), Guangzhou, PEOPLES R CHINA, NOV 15-17,
   2018},
Abstract = {With the rapid development of the Internet of Things (IoT), a large
   number of IoT device data has flooded into cloud computing service
   centers, which has greatly increased the data processing task of cloud
   computing. To alleviate this situation, IoT enabled fog computing comes
   into being and it is necessary to aggregate the collected data of
   multiple IoT devices at the fog node. In this paper, we consider a
   privacy-aware data collection and aggregation scheme for fog computing.
   Although the fog node and the cloud control center are
   honest-but-curious, the proposed scheme also ensures that the data
   privacy will not be leaked. Our security and performance analysis
   indicates that the proposed scheme is secure and efficient in terms of
   computation and communication cost.},
