EISSN = {1863-2394},
Keywords = {Machine learning; Cloud security; Malicious threats},
Keywords-Plus = {INTRUSION DETECTION},
Research-Areas = {Computer Science},
Web-of-Science-Categories  = {Computer Science, Interdisciplinary Applications},
Author-Email = {eksdeal@gmail.com
   latha.tamilselvan94@gmail.com},
